--══════════════════════════════════════════════════════
--  KronUI Loader
--══════════════════════════════════════════════════════

-- ── 1. URL da lib no GitHub (raw) ────────────────────
local LIB_URL = "https://raw.githubusercontent.com/FabJheiny/Scripts/refs/heads/main/KronUi"

-- ── 2. Imagem do pill ────────────────────────────────
local PILL_IMAGE = "rbxassetid://78186286433275"

-- ── Carregamento ─────────────────────────────────────
local ok, result = pcall(function()
    return loadstring(game:HttpGet(LIB_URL))()
end)

if not ok then
    warn("[KronUI] Falha ao carregar a lib: " .. tostring(result))
    return
end

local KronUI = result

-- ── 3. Sua API aqui ──────────────────────────────────
local ui = KronUI.new("Minha Interface", PILL_IMAGE)

ui:AddSectionLabel("Geral")

ui:AddToggle("Modo turbo", false, function(state)
    print("Turbo:", state)
end)

ui:AddButton("Executar ação", function()
    print("Botão clicado!")
end)

ui:AddSlider("Velocidade", 0, 100, 50, function(v)
    print("Velocidade:", v)
end)

ui:AddDropdown("Mapa", { "Lobby", "Floresta", "Cidade", "Deserto" }, {}, function(sel)
    print("Selecionado:", table.concat(sel, ", "))
end)

ui:AddDivider()
ui:AddSectionLabel("Avançado")

ui:AddToggle("Debug", false, function(state)
    print("Debug:", state)
end)
