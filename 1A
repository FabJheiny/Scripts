        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        BorderSizePixel=0, Visible=false, Active=false,
    },area)
    tabBtns[i]=tb tabPages[i]=pg
    tb.MouseButton1Click:Connect(function() sw(i) end)

    local ef=o("Frame",{
        Size=UDim2.new(1,-16,1,-52), Position=UDim2.new(0,8,0,8),
        BackgroundColor3=C.BG2, BorderSizePixel=0,
    },pg)
    corner(ef,6) stroke(ef,1,C.BORDER)

    local lineAccent=o("Frame",{
        Size=UDim2.new(0,3,1,-2), Position=UDim2.new(0,0,0,1),
        BackgroundColor3=C.ACCENT, BorderSizePixel=0,
    },ef)
    corner(lineAccent,2)

    o("TextBox",{
        Size=UDim2.new(1,-12,1,-8), Position=UDim2.new(0,8,0,4),
        BackgroundTransparency=1,
        Text='print("Hello, World!")',
        PlaceholderText="-- insira seu script aqui",
        PlaceholderColor3=C.MUTED, TextColor3=C.TEXT,
        TextSize=11, Font=FONT,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Top,
        ClearTextOnFocus=false, MultiLine=true, TextWrapped=true,
    },ef)

    local editor = ef:FindFirstChildWhichIsA("TextBox")

    local bb=o("Frame",{
        Size=UDim2.new(1,-16,0,32), Position=UDim2.new(0,8,1,-42),
        BackgroundTransparency=1, BorderSizePixel=0, Active=false,
    },pg)
    o("UIListLayout",{
        FillDirection=Enum.FillDirection.Horizontal,
        HorizontalAlignment=Enum.HorizontalAlignment.Right,
        VerticalAlignment=Enum.VerticalAlignment.Center,
        Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder,
    },bb)

    local function mkBtn(txt,lo,accent)
        local b=o("TextButton",{
            Size=UDim2.new(0,74,0,24),
            BackgroundColor3=accent and C.ACCENT2 or C.BG2,
            BorderSizePixel=0, Text=txt, TextColor3=C.WHITE,
            TextSize=10, Font=FONT, AutoButtonColor=false, LayoutOrder=lo,
        },bb)
        corner(b,4) stroke(b,1,accent and C.ACCENT or C.BORDER)
        b.MouseEnter:Connect(function() b.BackgroundColor3=accent and C.ACCENT or C.BG3 end)
        b.MouseLeave:Connect(function() b.BackgroundColor3=accent and C.ACCENT2 or C.BG2 end)
        return b
    end

    local cBtn=mkBtn("Copy",1,false)
    local clBtn=mkBtn("Clear",2,false)
    local eBtn=mkBtn("Execute",3,true)

    cBtn.MouseButton1Click:Connect(function()
        if setclipboard then pcall(setclipboard,editor.Text) end
    end)
    clBtn.MouseButton1Click:Connect(function() editor.Text="" end)
    eBtn.MouseButton1Click:Connect(function()
        local code=editor.Text
        if code~="" then
            local fn,err=loadstring(code)
            if fn then pcall(fn) else warn("[Executor] "..tostring(err)) end
        end
    end)
end

-- ══ API Hub:Tab ══
function Hub:Tab(name)
    local i=#tabBtns+1
    local tb=makeTabBtn(name,i)
    local pg=o("Frame",{
        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        BorderSizePixel=0, Visible=false, Active=false,
    },area)

    local hotbar=o("Frame",{
        Size=UDim2.new(1,-12,0,22), Position=UDim2.new(0,6,0,6),
        BackgroundTransparency=1, BorderSizePixel=0, Active=false,
    },pg)

    local searchFrame=o("Frame",{
        Size=UDim2.new(0,130,1,0), BackgroundColor3=C.BG2, BorderSizePixel=0,
    },hotbar)
    corner(searchFrame,4) stroke(searchFrame,1,C.BORDER)

    o("TextBox",{
        Size=UDim2.new(1,-8,1,0), Position=UDim2.new(0,4,0,0),
        BackgroundTransparency=1,
        PlaceholderText="Search Script", PlaceholderColor3=C.MUTED,
        Text="", TextColor3=C.TEXT, TextSize=10, Font=FONT,
        ClearTextOnFocus=false, TextXAlignment=Enum.TextXAlignment.Left,
    },searchFrame)
    local search=searchFrame:FindFirstChildWhichIsA("TextBox")

    local countLbl=o("TextLabel",{
        Size=UDim2.new(1,-142,1,0), Position=UDim2.new(0,138,0,0),
        BackgroundTransparency=1, Text="Scripts: 0",
        TextColor3=C.MUTED, TextSize=9, Font=FONT,
        TextXAlignment=Enum.TextXAlignment.Right, Active=false,
    },hotbar)

    local GAP=6 local COLS=6 local ROWH=28
    local scroll=o("ScrollingFrame",{
        Size=UDim2.new(1,-12,1,-36), Position=UDim2.new(0,6,0,34),
        BackgroundTransparency=1, BorderSizePixel=0,
        ScrollBarThickness=2, ScrollBarImageColor3=C.ACCENT2,
        CanvasSize=UDim2.new(0,0,0,0), AutomaticCanvasSize=Enum.AutomaticSize.Y,
    },pg)
    o("UIPadding",{
        PaddingTop=UDim.new(0,GAP), PaddingLeft=UDim.new(0,GAP),
        PaddingRight=UDim.new(0,GAP), PaddingBottom=UDim.new(0,GAP),
    },scroll)
    o("UIGridLayout",{
        CellSize=UDim2.new(1/COLS,-(GAP*(COLS-1))/COLS,0,ROWH),
        CellPadding=UDim2.new(0,GAP,0,GAP),
        SortOrder=Enum.SortOrder.LayoutOrder,
        HorizontalAlignment=Enum.HorizontalAlignment.Left,
    },scroll)

    tabBtns[i]=tb tabPages[i]=pg
    tb.MouseButton1Click:Connect(function() sw(i) end)

    local allBtns={}
    local function updateCount()
        local v=0
        for _,b in ipairs(allBtns) do if b.Visible then v+=1 end end
        countLbl.Text="Scripts: "..v
    end

    search:GetPropertyChangedSignal("Text"):Connect(function()
        local q = search.Text:lower():gsub("%s+", "")
        for _, b in ipairs(allBtns) do
            if q == "" then
                b.Visible = true
            else
                local name = b.Name:lower():gsub("%s+", "")
                b.Visible = string.find(name, q, 1, true) ~= nil
            end
        end
        updateCount()
    end)

    local T={}
    function T:Button(txt,url)
        local b=o("TextButton",{
            Name=txt, BackgroundColor3=C.BG2, BorderSizePixel=0,
            Text=txt, TextColor3=C.TEXT, TextSize=9, Font=FONT,
            AutoButtonColor=false, TextWrapped=true, LineHeight=1.1,
        },scroll)
        corner(b,4) stroke(b,1,C.BORDER)
        b.MouseEnter:Connect(function() b.BackgroundColor3=C.ACCENT2 stroke(b,1,C.ACCENT) end)
        b.MouseLeave:Connect(function() b.BackgroundColor3=C.BG2    stroke(b,1,C.BORDER) end)
        local copyTxt='loadstring(game:HttpGet("'..url..'"))()'
        b.MouseButton1Click:Connect(function()
            openModal(txt,copyTxt,function() loadstring(game:HttpGet(url))() end)
        end)
        table.insert(allBtns,b)
        countLbl.Text="Scripts: "..#allBtns
        return self
    end
    return T
end

-- ══ DRAG (pill) ══
do
    local dragging, dragStart, startPos = false, nil, nil
    local dragMoved = false

    pillBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging=true dragMoved=false
            dragStart=inp.Position startPos=pill.Position
        end
    end)
    pillBtn.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging=false
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if dragging and (
            inp.UserInputType==Enum.UserInputType.MouseMovement or
            inp.UserInputType==Enum.UserInputType.Touch
        ) then
            local d=inp.Position-dragStart
            if math.abs(d.X)+math.abs(d.Y) > 2 then
                dragMoved=true
                pill.Position=UDim2.new(
                    startPos.X.Scale, startPos.X.Offset+d.X,
                    startPos.Y.Scale, startPos.Y.Offset+d.Y
                )
            end
        end
    end)

    pillBtn.MouseButton1Click:Connect(function()
        if dragMoved then return end
        win.Visible=true pill.Visible=false
    end)
end

UIS.InputBegan:Connect(function(inp,gp)
    if not gp and inp.KeyCode==Enum.KeyCode.RightShift then
        local v=not win.Visible
        win.Visible=v
        if v then pill.Visible=false end
    end
end)

return Hub
