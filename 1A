        BorderSizePixel=0, Text=name, TextColor3=C.MUTED,
        TextSize=11, Font=FONT, AutoButtonColor=false,
        LayoutOrder=idx, TextWrapped=true,
    },tlist)
    corner(tb,4)
    tb.MouseEnter:Connect(function()
        if cur~=idx then tb.BackgroundColor3=C.BG3 tb.BackgroundTransparency=0 tb.TextColor3=C.TEXT end
    end)
    tb.MouseLeave:Connect(function()
        if cur~=idx then tb.BackgroundTransparency=1 tb.TextColor3=C.MUTED end
    end)
    return tb
end

-- ══ HELPER: stepper ══
local function makeStepBar(parent, posX, posY, barW, barH, initVal, minV, maxV, labelTxt, onChanged)
    o("TextLabel",{
        Size=UDim2.new(0,barW,0,12),
        Position=UDim2.new(0,posX,0,posY),
        BackgroundTransparency=1, Text=labelTxt,
        TextColor3=C.MUTED, TextSize=9, Font=FONT,
        TextXAlignment=Enum.TextXAlignment.Center,
    },parent)

    local bar=o("Frame",{
        Size=UDim2.new(0,barW,0,barH),
        Position=UDim2.new(0,posX,0,posY+14),
        BackgroundColor3=C.BG3, BorderSizePixel=0,
    },parent)
    corner(bar,4) stroke(bar,1,C.BORDER)

    local bsz=barH local dv=1 local nw=barW-2*bsz-2*dv

    local plus=o("TextButton",{
        Size=UDim2.new(0,bsz,1,0), Position=UDim2.new(0,0,0,0),
        BackgroundColor3=C.BG3, BorderSizePixel=0,
        Text="+", TextColor3=C.WHITE, TextSize=13, Font=FONT, AutoButtonColor=false,
    },bar)
    corner(plus,4)

    local box=o("TextBox",{
        Size=UDim2.new(0,nw,1,0), Position=UDim2.new(0,bsz+dv,0,0),
        BackgroundTransparency=1, Text=tostring(initVal),
        TextColor3=C.TEXT, TextSize=10, Font=FONT,
        TextXAlignment=Enum.TextXAlignment.Center, ClearTextOnFocus=false,
    },bar)

    local minus=o("TextButton",{
        Size=UDim2.new(0,bsz,1,0), Position=UDim2.new(0,bsz+dv+nw+dv,0,0),
        BackgroundColor3=C.BG3, BorderSizePixel=0,
        Text="-", TextColor3=C.WHITE, TextSize=14, Font=FONT, AutoButtonColor=false,
    },bar)
    corner(minus,4)

    local cv=initVal
    local function apply(v)
        v=math.clamp(math.floor(v),minV,maxV)
        cv=v box.Text=tostring(v) onChanged(v)
    end
    plus.MouseButton1Click:Connect(function() apply(cv+1) end)
    minus.MouseButton1Click:Connect(function() apply(cv-1) end)
    box.FocusLost:Connect(function()
        local n=tonumber(box.Text)
        if n then apply(n) else box.Text=tostring(cv) end
    end)
    for _,btn in ipairs({plus,minus}) do
        btn.MouseEnter:Connect(function() btn.BackgroundColor3=C.ACCENT end)
        btn.MouseLeave:Connect(function() btn.BackgroundColor3=C.BG3 end)
    end
end

