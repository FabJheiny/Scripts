local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end
local function stroke(par, t, c)
    for _, ch in ipairs(par:GetChildren()) do
        if ch:IsA("UIStroke") then ch:Destroy() end
    end
    return o("UIStroke", {Color=c or C.BORDER, Thickness=t or 1, ApplyStrokeMode=Enum.ApplyStrokeMode.Border}, par)
end
local function corner(par, r)
    o("UICorner", {CornerRadius=UDim.new(0, r or 4)}, par)
end

