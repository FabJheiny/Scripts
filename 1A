    local searchFrame = o("Frame", {
        Size=UDim2.new(0,130,1,0),
        BackgroundColor3=C.BG2,
        BorderSizePixel=0,
    }, hotbar)
    corner(searchFrame, 4)
    stroke(searchFrame, 1, C.BORDER)

    local search = o("TextBox", {
        Size=UDim2.new(1,-8,1,0),
        Position=UDim2.new(0,4,0,0),
        BackgroundTransparency=1,
        PlaceholderText="Search Script",
        PlaceholderColor3=C.MUTED,
        Text="", TextColor3=C.TEXT,
        TextSize=10, Font=FONT,
        ClearTextOnFocus=false,
        TextXAlignment=Enum.TextXAlignment.Left,
    }, searchFrame)

    local countLbl = o("TextLabel", {
        Size=UDim2.new(1,-142,1,0),
        Position=UDim2.new(0,138,0,0),
        BackgroundTransparency=1,
        Text="Scripts: 0",
        TextColor3=C.MUTED, TextSize=9, Font=FONT,
        TextXAlignment=Enum.TextXAlignment.Right, Active=false,
    }, hotbar)

    local GAP=6 local COLS=6 local ROWH=28
    local scroll = o("ScrollingFrame", {
        Size=UDim2.new(1,-12,1,-36),
        Position=UDim2.new(0,6,0,34),
        BackgroundTransparency=1, BorderSizePixel=0,
        ScrollBarThickness=2,
        ScrollBarImageColor3=C.ACCENT2,
        CanvasSize=UDim2.new(0,0,0,0),
        AutomaticCanvasSize=Enum.AutomaticSize.Y,
    }, pg)
    o("UIPadding", {
        PaddingTop=UDim.new(0,GAP), PaddingLeft=UDim.new(0,GAP),
        PaddingRight=UDim.new(0,GAP), PaddingBottom=UDim.new(0,GAP),
    }, scroll)
    o("UIGridLayout", {
        CellSize=UDim2.new(1/COLS,-(GAP*(COLS-1))/COLS,0,ROWH),
        CellPadding=UDim2.new(0,GAP,0,GAP),
        SortOrder=Enum.SortOrder.LayoutOrder,
        HorizontalAlignment=Enum.HorizontalAlignment.Left,
    }, scroll)

    tabBtns[i]=tb tabPages[i]=pg
    tb.MouseButton1Click:Connect(function() sw(i) end)

    local allBtns = {}
    local function updateCount()
        local v = 0
        for _, b in ipairs(allBtns) do if b.Visible then v+=1 end end
        countLbl.Text = "Scripts: "..v
    end
    search:GetPropertyChangedSignal("Text"):Connect(function()
        local q = search.Text:lower()
        for _, b in ipairs(allBtns) do
            b.Visible = (q=="" or b.Name:lower():find(q,1,true)~=nil)
        end
        updateCount()
    end)

    local T = {}
    function T:Button(txt, url)
        local b = o("TextButton", {
            Name=txt,
            BackgroundColor3=C.BG2,
            BorderSizePixel=0,
            Text=txt, TextColor3=C.TEXT,
            TextSize=9, Font=FONT,
            AutoButtonColor=false,
            TextWrapped=true, LineHeight=1.1,
        }, scroll)
        corner(b, 4)
        stroke(b, 1, C.BORDER)
        b.MouseEnter:Connect(function()
            b.BackgroundColor3 = C.ACCENT2
            stroke(b, 1, C.ACCENT)
        end)
        b.MouseLeave:Connect(function()
            b.BackgroundColor3 = C.BG2
            stroke(b, 1, C.BORDER)
        end)
        local copyTxt = 'loadstring(game:HttpGet("'..url..'"))()'
        b.MouseButton1Click:Connect(function()
            openModal(txt, copyTxt, function()
                loadstring(game:HttpGet(url))()
            end)
        end)
        table.insert(allBtns, b)
        countLbl.Text = "Scripts: "..#allBtns
        return self
    end
    return T
end

