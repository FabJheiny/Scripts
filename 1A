local function applyPillScale(v)
    local factor = 0.7+(v-1)*0.06
    local pw = math.floor(64*factor)
    local ph = math.floor(20*factor)
    pill.Size = UDim2.new(0,pw,0,ph)
    for _,ch in ipairs(pill:GetChildren()) do
        if ch:IsA("UICorner") then ch.CornerRadius = UDim.new(0, math.floor(ph/2)) end
    end
    local ds = math.floor(ph*0.30)
    local dx = math.floor(pw*0.13)
    pillDot.Size     = UDim2.new(0,ds,0,ds)
    pillDot.Position = UDim2.new(0,dx,0.5,-math.floor(ds/2))
    local lx = dx+ds+math.floor(ds*0.5)
    local ts = math.max(7, math.floor(ph*0.45))
    pillLbl.Size     = UDim2.new(0,pw-lx-4,1,0)
    pillLbl.Position = UDim2.new(0,lx,0,0)
    pillLbl.TextSize = ts
end

applyPillScale(_G.HubPillScale)
