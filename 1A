-- ══ TABS ══
local tabBtns, tabPages, cur = {}, {}, nil

local function sw(idx)
    if cur == idx then return end
    if cur then
        tabBtns[cur].BackgroundColor3 = C.BG2
        tabBtns[cur].BackgroundTransparency = 1
        tabBtns[cur].TextColor3 = C.MUTED
    end
    cur = idx
    tabBtns[idx].BackgroundColor3 = C.ACCENT2
    tabBtns[idx].BackgroundTransparency = 0
    tabBtns[idx].TextColor3 = C.WHITE
    for j, p in ipairs(tabPages) do p.Visible = (j == idx) end
end

local function makeTabBtn(name, idx)
    local tb = o("TextButton", {
        Size=UDim2.new(1,0,0,28),
        BackgroundColor3=C.BG2,
        BackgroundTransparency=1,
        BorderSizePixel=0,
        Text=name, TextColor3=C.MUTED,
        TextSize=11, Font=FONT,
        AutoButtonColor=false,
        LayoutOrder=idx, TextWrapped=true,
    }, tlist)
    corner(tb, 4)
    tb.MouseEnter:Connect(function()
        if cur ~= idx then
            tb.BackgroundColor3 = C.BG3
            tb.BackgroundTransparency = 0
            tb.TextColor3 = C.TEXT
        end
    end)
    tb.MouseLeave:Connect(function()
        if cur ~= idx then
            tb.BackgroundTransparency = 1
            tb.TextColor3 = C.MUTED
        end
    end)
    return tb
end

