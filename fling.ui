local Players       = game:GetService("Players")
local RunService    = game:GetService("RunService")
local CoreGui       = game:GetService("CoreGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UIS           = game:GetService("UserInputService")
local Player        = Players.LocalPlayer

local BG    = Color3.fromRGB(28, 28, 32)
local PANEL = Color3.fromRGB(34, 34, 40)
local CARD  = Color3.fromRGB(40, 40, 48)
local HOVER = Color3.fromRGB(48, 48, 58)
local LINE  = Color3.fromRGB(58, 58, 70)
local DIM   = Color3.fromRGB(140, 140, 160)
local MID   = Color3.fromRGB(185, 185, 205)
local W     = Color3.fromRGB(235, 235, 245)
local FONT  = Enum.Font.GothamMedium

local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end
local function stroke(par, t, c)
    o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, par)
end
local function mkBtn(txt, parent, sz, pos)
    local b = o("TextButton", {
        Size = sz, Position = pos,
        BackgroundColor3 = CARD, BorderSizePixel = 0,
        Text = txt, TextColor3 = MID, TextSize = 10,
        Font = FONT, AutoButtonColor = false,
    }, parent)
    stroke(b, 1, LINE)
    o("UICorner", { CornerRadius = UDim.new(0, 5) }, b)
    b.MouseEnter:Connect(function() b.BackgroundColor3 = HOVER; b.TextColor3 = W end)
    b.MouseLeave:Connect(function() b.BackgroundColor3 = CARD;  b.TextColor3 = MID end)
    b.MouseButton1Down:Connect(function() b.BackgroundColor3 = Color3.fromRGB(52,52,62) end)
    b.MouseButton1Up:Connect(function()   b.BackgroundColor3 = HOVER end)
    return b
end

