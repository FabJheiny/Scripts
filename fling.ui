-- separador horizontal abaixo do topbar
o("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,0,topH),BackgroundColor3=W,BorderSizePixel=0,ZIndex=20},win)

-- Drag (hub style, via UIS)
do
    local dragging,dragStart,startPos=false,nil,nil
    top.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1
        or inp.UserInputType==Enum.UserInputType.Touch then
            dragging=true dragStart=inp.Position startPos=win.Position
        end
    end)
    top.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1
        or inp.UserInputType==Enum.UserInputType.Touch then dragging=false end
    end)
    UIS.InputChanged:Connect(function(inp)
        if dragging and (inp.UserInputType==Enum.UserInputType.MouseMovement
            or inp.UserInputType==Enum.UserInputType.Touch) then
            local d=inp.Position-dragStart
            win.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y)
        end
    end)
end

