local nw  = STEP_W - 2 * bsz - 2 * dv

local stepPlus = o("TextButton", {
    Size = UDim2.new(0, bsz, 1, 0),
    BackgroundColor3 = CARD, BorderSizePixel = 0,
    Text = "+", TextColor3 = MID, TextSize = 14, Font = FONT,
    AutoButtonColor = false, ZIndex = 11,
}, stepHolder)
o("Frame", {
    Size = UDim2.new(0, dv, 1, 0), Position = UDim2.new(0, bsz, 0, 0),
    BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 11,
}, stepHolder)
local stepBox = o("TextBox", {
    Size = UDim2.new(0, nw, 1, 0), Position = UDim2.new(0, bsz + dv, 0, 0),
    BackgroundTransparency = 1,
    Text = tostring(_G.FlingUIScale),
    TextColor3 = W, TextSize = 10, Font = FONT,
    TextXAlignment = Enum.TextXAlignment.Center,
    ClearTextOnFocus = false, ZIndex = 11,
}, stepHolder)
o("Frame", {
    Size = UDim2.new(0, dv, 1, 0), Position = UDim2.new(0, bsz + dv + nw, 0, 0),
    BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 11,
}, stepHolder)
local stepMinus = o("TextButton", {
    Size = UDim2.new(0, bsz, 1, 0), Position = UDim2.new(0, bsz + dv + nw + dv, 0, 0),
    BackgroundColor3 = CARD, BorderSizePixel = 0,
    Text = "−", TextColor3 = MID, TextSize = 14, Font = FONT,
    AutoButtonColor = false, ZIndex = 11,
}, stepHolder)

local stepCv = _G.FlingUIScale
local function stepApply(v)
    v = math.clamp(math.floor(v), 1, 35)
    stepCv = v; _G.FlingUIScale = v
    stepBox.Text = tostring(v)
    uiScaleObj.Scale = getUIScale(v)
end
stepPlus.MouseButton1Click:Connect(function()  stepApply(stepCv + 1) end)
stepMinus.MouseButton1Click:Connect(function() stepApply(stepCv - 1) end)
stepBox.FocusLost:Connect(function()
    local n = tonumber(stepBox.Text)
    if n then stepApply(n) else stepBox.Text = tostring(stepCv) end
end)
for _, btn in ipairs({ stepPlus, stepMinus }) do
    btn.MouseEnter:Connect(function() btn.TextColor3 = W end)
    btn.MouseLeave:Connect(function() btn.TextColor3 = MID end)
end

-- separador + X
o("Frame", {
