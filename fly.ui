local Services = {
    Players = game:GetService("Players"),
    RunService = game:GetService("RunService"),
    UserInputService = game:GetService("UserInputService"),
    CoreGui = game:GetService("CoreGui")
}

local Config = {
    Fly = {
        DefaultSpeed = 2,
        MinSpeed = 1,
        SpeedMultiplier = 25,
        BodyVelocityMaxForce = Vector3.new(9e9, 9e9, 9e9),
        BodyGyroMaxTorque = Vector3.new(9e9, 9e9, 9e9),
        GyroP = 42000,
        GyroD = 480
    },
    Camera = {
        TargetMaxZoom = 500,
        Mode = Enum.CameraMode.Classic
    },
    UI = {
        Name = "flygui",
        DisplayOrder = 2147483647,
        DefaultPosition = UDim2.new(0.05, 0, 0.4, 0),
        TextSize = 10,
        Font = Enum.Font.Code,
        B = Color3.fromRGB(0, 0, 0),
        W = Color3.fromRGB(255, 255, 255),
        D = Color3.fromRGB(15, 15, 15),
        G = Color3.fromRGB(50, 50, 50),
    },
    Physics = {
        CollisionParts = {"torso", "root", "leg", "head"},
        AccessoryTypes = {"Accessory", "Hat"}
    }
}

local State = {
    Flying = false,
    Noclip = false,
    FlySpeed = Config.Fly.DefaultSpeed,
    VerticalVector = 0,
    Dragging = false,
    DragInput = nil,
    DragStart = nil,
    StartPos = nil,
    GuiExists = true
}

local B    = Config.UI.B
local W    = Config.UI.W
local D    = Config.UI.D
local G    = Config.UI.G
local FONT = Config.UI.Font

local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end

local function stroke(par, t, c)
    o("UIStroke", {Color = c or W, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, par)
end

local function mkBtn(txt, parent, sz, pos)
    local b = o("TextButton", {
        Size = sz, Position = pos,
        BackgroundColor3 = B, BorderSizePixel = 0,
        Text = txt, TextColor3 = W,
        TextSize = Config.UI.TextSize, Font = FONT,
        AutoButtonColor = false,
    }, parent)
    stroke(b, 1)
    b.MouseEnter:Connect(function() b.BackgroundColor3 = D end)
    b.MouseLeave:Connect(function() b.BackgroundColor3 = B end)
    return b
end

local function mkDiv(parent, pos, sz)
    o("Frame", {
        Position = pos,
        Size = sz,
        BackgroundColor3 = W,
        BorderSizePixel = 0,
        ZIndex = 12,
    }, parent)
end

local CameraController = {}
CameraController.__index = CameraController

function CameraController.new(services, config, state)
    local self = setmetatable({}, CameraController)
    self.Services = services
    self.Config = config
    self.State = state
    self.LocalPlayer = services.Players.LocalPlayer
    return self
end

function CameraController:forceRelease()
    local player = self.LocalPlayer
    local config = self.Config.Camera
    if player.CameraMode ~= config.Mode then
        player.CameraMode = config.Mode
    end
    if player.CameraMaxZoomDistance ~= config.TargetMaxZoom then
        player.CameraMaxZoomDistance = config.TargetMaxZoom
    end
end

function CameraController:connectEvents()
    local player = self.LocalPlayer
    self.Connections = {
        CameraModeChanged = player:GetPropertyChangedSignal("CameraMode"):Connect(function()
            self:forceRelease()
        end),
        CameraMaxZoomChanged = player:GetPropertyChangedSignal("CameraMaxZoomDistance"):Connect(function()
            self:forceRelease()
        end),
        RenderStepped = self.Services.RunService.RenderStepped:Connect(function()
            self:forceRelease()
        end)
    }
    self:forceRelease()
end

function CameraController:cleanup()
    if self.Connections then
        for _, connection in pairs(self.Connections) do
            connection:Disconnect()
        end
        self.Connections = nil
    end
end

local MovementController = {}
MovementController.__index = MovementController

function MovementController.new(services, config, state)
    local self = setmetatable({}, MovementController)
    self.Services = services
    self.Config = config
    self.State = state
    return self
end

function MovementController:restoreNaturalCollision(char)
    if not char then return end
    local collisionParts = self.Config.Physics.CollisionParts
    local accessoryTypes = self.Config.Physics.AccessoryTypes
    for _, v in pairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            local name = v.Name:lower()
            local shouldCollide = false
            for _, part in ipairs(collisionParts) do
                if name:find(part) then
                    shouldCollide = true
                    break
                end
            end
            v.CanCollide = shouldCollide
            local parent = v.Parent
            if parent then
                for _, accType in ipairs(accessoryTypes) do
                    if parent:IsA(accType) then
                        v.Massless = true
                        v.CanTouch = false
                        break
                    end
                end
            end
        end
    end
end

function MovementController:resetPhysics(char)
    if not char then return end
    local hum = char:FindFirstChild("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if hum then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end
    if root then
        local codeVel = root:FindFirstChild("CodeVel")
        local codeGyro = root:FindFirstChild("CodeGyro")
        if codeVel then codeVel:Destroy() end
        if codeGyro then codeGyro:Destroy() end
        root.Velocity = Vector3.new(0, 0, 0)
    end
    self:restoreNaturalCollision(char)
end

function MovementController:updateNoclip()
    local char = self.Services.Players.LocalPlayer.Character
    if self.State.Noclip and char then
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end
end

function MovementController:updateFlight()
    local char = self.Services.Players.LocalPlayer.Character
    if self.State.Flying and char and char:FindFirstChild("HumanoidRootPart") then
        local root = char.HumanoidRootPart
        local hum = char.Humanoid
        local cam = workspace.CurrentCamera
        local config = self.Config.Fly
        local bv = root:FindFirstChild("CodeVel") or Instance.new("BodyVelocity", root)
        local bg = root:FindFirstChild("CodeGyro") or Instance.new("BodyGyro", root)
        bv.Name, bg.Name = "CodeVel", "CodeGyro"
        bv.MaxForce = config.BodyVelocityMaxForce
        bg.MaxTorque = config.BodyGyroMaxTorque
        bg.P = config.GyroP
        bg.D = config.GyroD
        hum.PlatformStand = true
        local moveDir = hum.MoveDirection
        local rel = cam.CFrame:VectorToObjectSpace(moveDir)
        local rawVel = (
            (cam.CFrame.LookVector * -rel.Z) +
            (cam.CFrame.RightVector * rel.X) +
            (Vector3.new(0, 1, 0) * self.State.VerticalVector)
        )
        bv.Velocity = (rawVel.Magnitude > 0) and
            (rawVel.Unit * (self.State.FlySpeed * config.SpeedMultiplier)) or
            Vector3.new(0, 0, 0)
        bg.CFrame = cam.CFrame
    end
end

function MovementController:connectEvents()
    self.Connections = {
        Stepped = self.Services.RunService.Stepped:Connect(function()
            self:updateNoclip()
        end),
        RenderStepped = self.Services.RunService.RenderStepped:Connect(function()
            self:updateFlight()
        end)
    }
end

function MovementController:cleanup()
    local char = self.Services.Players.LocalPlayer.Character
    if char then self:resetPhysics(char) end
    if self.Connections then
        for _, connection in pairs(self.Connections) do
            connection:Disconnect()
        end
        self.Connections = nil
    end
end

local UI = {}
UI.__index = UI

function UI.new(services, config, state)
    local self = setmetatable({}, UI)
    self.Services = services
    self.Config = config
    self.State = state
    self.Buttons = {}
    return self
end

function UI:createScreenGui()
    local sg = o("ScreenGui", {
        Name = self.Config.UI.Name,
        DisplayOrder = self.Config.UI.DisplayOrder,
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
    }, self.Services.Players.LocalPlayer:WaitForChild("PlayerGui"))
    return sg
end

function UI:build(movementController, screenGui)
    local topH = 24
    local fullH = 102

    local win = o("Frame", {
        Size = UDim2.new(0, 160, 0, fullH),
        Position = self.Config.UI.DefaultPosition,
        BackgroundColor3 = B,
        BorderSizePixel = 0,
        Active = true,
        ClipsDescendants = true,
    }, screenGui)
    stroke(win, 1)
    self.MainFrame = win

    -- Pill
    local pillSg = o("ScreenGui", {
        Name = self.Config.UI.Name .. "Pill",
        DisplayOrder = 9999,
        ResetOnSpawn = false,
    })
    local ok = pcall(function() pillSg.Parent = self.Services.CoreGui end)
    if not ok then pillSg.Parent = self.Services.Players.LocalPlayer:WaitForChild("PlayerGui") end

    local pill = o("Frame", {
        Name = "ReopenPill",
        Size = UDim2.new(0, 60, 0, 18),
        Position = UDim2.new(1, -66, 1, -36),
        BackgroundColor3 = B,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 200,
    }, pillSg)
    stroke(pill, 1)

    local pillBtn = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "> fly",
        TextSize = 9,
        Font = FONT,
        TextColor3 = W,
        BorderSizePixel = 0,
        ZIndex = 201,
    }, pill)
    self.Pill = pill

    local top = o("Frame", {
        Size = UDim2.new(1, 0, 0, topH),
        BackgroundColor3 = B,
        BorderSizePixel = 0,
        Active = true,
        ZIndex = 10,
    }, win)

    o("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1,
        Text = "> FLY <",
        TextColor3 = W,
        TextSize = 11,
        Font = FONT,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 10,
    }, top)

    mkDiv(top, UDim2.new(1, -66, 0, 0), UDim2.new(0, 1, 1, 0))
    mkDiv(top, UDim2.new(1, -33, 0, 0), UDim2.new(0, 1, 1, 0))

    local minimized = false

    local MinBtn = o("TextButton", {
        Size = UDim2.new(0, 32, 1, 0),
        Position = UDim2.new(1, -65, 0, 0),
        BackgroundColor3 = B, BorderSizePixel = 0,
        Text = "-", TextColor3 = W,
        TextSize = 18, Font = FONT,
        AutoButtonColor = false, ZIndex = 11,
    }, top)
    local XBtn = o("TextButton", {
        Size = UDim2.new(0, 32, 1, 0),
        Position = UDim2.new(1, -32, 0, 0),
        BackgroundColor3 = B, BorderSizePixel = 0,
        Text = "x", TextColor3 = W,
        TextSize = 14, Font = FONT,
        AutoButtonColor = false, ZIndex = 11,
    }, top)
    for _, b in ipairs({MinBtn, XBtn}) do
        b.MouseEnter:Connect(function() b.BackgroundColor3 = D end)
        b.MouseLeave:Connect(function() b.BackgroundColor3 = B end)
    end

    mkDiv(win, UDim2.new(0, 0, 0, topH), UDim2.new(1, 0, 0, 1))

    local body = o("Frame", {
        Size = UDim2.new(1, 0, 1, -topH - 1),
        Position = UDim2.new(0, 0, 0, topH + 1),
        BackgroundColor3 = B,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, win)

    local noclipBtn = mkBtn("NOCLIP: OFF", body,
        UDim2.new(1, 0, 0, 25), UDim2.new(0, 0, 0, 0))
    noclipBtn.Name = "NoclipBtn"

    mkDiv(body, UDim2.new(0, 0, 0, 25), UDim2.new(1, 0, 0, 1))

    local upBtn = mkBtn("↑", body, UDim2.new(0, 32, 0, 25), UDim2.new(0, 0, 0, 26))
    mkDiv(body, UDim2.new(0, 32, 0, 26), UDim2.new(0, 1, 0, 25))

    local plusBtn = mkBtn("+", body, UDim2.new(0, 48, 0, 25), UDim2.new(0, 33, 0, 26))
    mkDiv(body, UDim2.new(0, 81, 0, 26), UDim2.new(0, 1, 0, 25))

    local flyBtn = mkBtn("FLY: OFF", body, UDim2.new(0, 78, 0, 25), UDim2.new(0, 82, 0, 26))
    flyBtn.Name = "FlyBtn"

    mkDiv(body, UDim2.new(0, 0, 0, 51), UDim2.new(1, 0, 0, 1))

    local downBtn = mkBtn("↓", body, UDim2.new(0, 32, 0, 25), UDim2.new(0, 0, 0, 52))
    mkDiv(body, UDim2.new(0, 32, 0, 52), UDim2.new(0, 1, 0, 25))

    local minusBtn = mkBtn("-", body, UDim2.new(0, 48, 0, 25), UDim2.new(0, 33, 0, 52))
    mkDiv(body, UDim2.new(0, 81, 0, 52), UDim2.new(0, 1, 0, 25))

    local speedDisplay = mkBtn(tostring(self.State.FlySpeed), body,
        UDim2.new(0, 78, 0, 25), UDim2.new(0, 82, 0, 52))
    speedDisplay.Name = "SpeedDisplay"

    do
        local dragging, dragStart, startPos = false, nil, nil
        top.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = inp.Position
                startPos = win.Position
            end
        end)
        top.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        self.Services.UserInputService.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
            or inp.UserInputType == Enum.UserInputType.Touch) then
                local d = inp.Position - dragStart
                win.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
    end

    XBtn.MouseButton1Click:Connect(function()
        win.Visible = false
        pill.Visible = true
    end)

    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            win.Size = UDim2.new(0, 160, 0, topH)
            MinBtn.Text = "+"
        else
            win.Size = UDim2.new(0, 160, 0, fullH)
            MinBtn.Text = "-"
        end
    end)

    pillBtn.MouseButton1Click:Connect(function()
        win.Visible = true
        pill.Visible = false
    end)

    flyBtn.MouseButton1Click:Connect(function()
        self.State.Flying = not self.State.Flying
        if self.State.Flying then
            flyBtn.Text = "> FLY: ON"
            flyBtn.BackgroundColor3 = G
        else
            flyBtn.Text = "FLY: OFF"
            flyBtn.BackgroundColor3 = B
            movementController:resetPhysics(self.Services.Players.LocalPlayer.Character)
        end
    end)

    noclipBtn.MouseButton1Click:Connect(function()
        self.State.Noclip = not self.State.Noclip
        if self.State.Noclip then
            noclipBtn.Text = "> NOCLIP: ON"
            noclipBtn.BackgroundColor3 = G
        else
            noclipBtn.Text = "NOCLIP: OFF"
            noclipBtn.BackgroundColor3 = B
            movementController:restoreNaturalCollision(self.Services.Players.LocalPlayer.Character)
        end
    end)

    plusBtn.MouseButton1Click:Connect(function()
        self.State.FlySpeed = self.State.FlySpeed + 1
        speedDisplay.Text = tostring(self.State.FlySpeed)
    end)

    minusBtn.MouseButton1Click:Connect(function()
        self.State.FlySpeed = math.max(Config.Fly.MinSpeed, self.State.FlySpeed - 1)
        speedDisplay.Text = tostring(self.State.FlySpeed)
    end)

    upBtn.MouseButton1Down:Connect(function() self.State.VerticalVector = 1 end)
    upBtn.MouseButton1Up:Connect(function() self.State.VerticalVector = 0 end)
    downBtn.MouseButton1Down:Connect(function() self.State.VerticalVector = -1 end)
    downBtn.MouseButton1Up:Connect(function() self.State.VerticalVector = 0 end)

    self.ScreenGui = screenGui
    return self
end

function UI:cleanup()
    self.State.GuiExists = false
    if self.ScreenGui then
        self.ScreenGui:Destroy()
        self.ScreenGui = nil
    end
end

local MainController = {}
MainController.__index = MainController

function MainController.new()
    local self = setmetatable({}, MainController)
    self.CameraController = CameraController.new(Services, Config, State)
    self.MovementController = MovementController.new(Services, Config, State)
    self.UI = UI.new(Services, Config, State)
    local screenGui = self.UI:createScreenGui()
    self.UI:build(self.MovementController, screenGui)
    self.Connections = {}
    self:connectAll()
    return self
end

function MainController:connectAll()
    self.CameraController:connectEvents()
    self.MovementController:connectEvents()
    table.insert(self.Connections, self.CameraController.Connections)
    table.insert(self.Connections, self.MovementController.Connections)
end

function MainController:cleanup()
    if self.CameraController then self.CameraController:cleanup() end
    if self.MovementController then self.MovementController:cleanup() end
    if self.UI then self.UI:cleanup() end
    for _, connectionGroup in pairs(self.Connections) do
        if connectionGroup then
            for _, connection in pairs(connectionGroup) do
                if connection and connection.Disconnect then
                    connection:Disconnect()
                end
            end
        end
    end
end

local controller = MainController.new()

return function()
    controller:cleanup()
end
