-- ── Drag da janela ───────────────────────────────────────────────────────────
do
    local dragging, dragMoved, dragStart, startPos, _activeTouchId =
          false,    false,     nil,       nil,      nil

    top.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if dragging then return end
            dragging  = true
            dragMoved = false
            dragStart = inp.Position
            startPos  = win.Position
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if _activeTouchId ~= nil then return end
            _activeTouchId = inp
            dragging  = true
            dragMoved = false
            dragStart = inp.Position
            startPos  = win.Position
        end
    end)

    UIS.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.Touch
            and inp ~= _activeTouchId then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement
            and inp.UserInputType ~= Enum.UserInputType.Touch then return end
        local d = inp.Position - dragStart
        if math.abs(d.X) + math.abs(d.Y) > 2 then
            dragMoved    = true
            win.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)

    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging  = false
            dragMoved = false
            dragStart = nil
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if inp ~= _activeTouchId then return end
            dragging       = false
            dragMoved      = false
            dragStart      = nil
            _activeTouchId = nil
        end
    end)
end

