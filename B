-- Loop ESP
local espTimer = 0
RunService.Heartbeat:Connect(function(dt)
    espTimer = espTimer + dt
    local interval = InstaSettings.Enabled and CONFIG.ESP_Interval_Instant or CONFIG.ESP_Interval_Default
    if espTimer < interval then return end
    espTimer = 0

    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")

    if not myHRP then
        for _, d in pairs(espData) do
            d.WallIcon.Visible  = false
            d.NameLabel.Visible = false
            d.DistLabel.Visible = false
            if d.Highlight then d.Highlight.Enabled = false end
        end
        return
    end

    local useRGB = ui and ui._rgbActive
    local rgbColor
    if useRGB then
        local hue = (tick() * 0.3) % 1
        rgbColor = Color3.fromHSV(hue, 1, 1)
    end

    local myTeam = getMyTeam()
    local myPos  = myHRP.Position

    for player, d in pairs(espData) do
        local char = d.Character
        if not char or not char.Parent then
            d.WallIcon.Visible = false; d.NameLabel.Visible = false; d.DistLabel.Visible = false
            if d.Highlight then d.Highlight.Enabled = false end
            continue
        end

        local hum  = char:FindFirstChildOfClass("Humanoid")
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")
        if not hum or not hrp or not head or hum.Health <= 0 then
            d.WallIcon.Visible = false; d.NameLabel.Visible = false; d.DistLabel.Visible = false
            if d.Highlight then d.Highlight.Enabled = false end
            continue
        end

        local dist = (myPos - hrp.Position).Magnitude
        if dist > CONFIG.MaxESP_Distance then
            d.WallIcon.Visible = false; d.NameLabel.Visible = false; d.DistLabel.Visible = false
            if d.Highlight then d.Highlight.Enabled = false end
            continue
        end

        local _, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            d.WallIcon.Visible = false; d.NameLabel.Visible = false; d.DistLabel.Visible = false
            if d.Highlight then d.Highlight.Enabled = false end
            continue
        end

        local col
        if useRGB then
            col = rgbColor
        else
            if isAlly(player, myTeam) then
                col = getTeamColor()
            else
                col = getEnemyColor()
            end
        end

        local visible = isVisible(char, player)

        if Settings.Highlight and dist <= CONFIG.MaxHighlight_Dist then
            d.Highlight.Enabled      = true
            d.Highlight.FillColor    = col
            d.Highlight.OutlineColor = col
        else
            d.Highlight.Enabled = false
        end

        d.WallIcon.Visible = Settings.WallIcon and (not visible)

        if Settings.Name then
            d.NameLabel.Visible    = true
            d.NameLabel.Text       = player.Name
            d.NameLabel.TextColor3 = col
        else
            d.NameLabel.Visible = false
        end

        if Settings.Distance then
            d.DistLabel.Visible    = true
            d.DistLabel.Text       = math.floor(dist) .. "m"
            d.DistLabel.TextColor3 = useRGB and col or vividColor(col)
        else
            d.DistLabel.Visible = false
        end
    end
end)

-- Aimbot
local function getClosestTarget()
    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end

    local myTeam = getMyTeam()
    local fov    = AimbotSettings.FOV
    local halfX  = Camera.ViewportSize.X * 0.5
    local halfY  = Camera.ViewportSize.Y * 0.5
    local best, bestD = nil, math.huge

    -- Decide qual parte usar com base no dropdown
    local targetPartName = (AimbotSettings.TargetPart == "Torso") and "HumanoidRootPart" or "Head"

    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        local char = player.Character; if not char then continue end
        -- isAlly agora também considera os aliados manuais
        if isAlly(player, myTeam) then continue end

        local targetPart = char:FindFirstChild(targetPartName)
        if not targetPart then continue end

        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        local pos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
        if not onScreen then continue end

        local sx = pos.X - halfX
        local sy = pos.Y - halfY
        if math.sqrt(sx*sx + sy*sy) > fov then continue end

        local wd = (myHRP.Position - targetPart.Position).Magnitude
        if wd > CONFIG.Aimbot.MaxDistance then continue end

        if not AimbotSettings.IgnoreWall and not isVisible(char, player) then continue end

        if wd < bestD then
            bestD = wd
            best = targetPart
        end
    end
    return best
end

local cachedTarget = nil
RunService.Heartbeat:Connect(function()
    if not AimbotSettings.Enabled then cachedTarget = nil return end
    cachedTarget = getClosestTarget()
end)

-- Suavidade usando o valor do slider
local curSmooth   = AimbotSettings.Smoothness
local lastCamCF   = Camera.CFrame

RunService.RenderStepped:Connect(function()
    if not cachedTarget then
        lastCamCF = Camera.CFrame
        curSmooth = AimbotSettings.Smoothness
        return
    end

    local delta = (Camera.CFrame.LookVector - lastCamCF.LookVector).Magnitude
    if delta > CONFIG.Aimbot.DeltaBreakHigh then
        cachedTarget = nil
        curSmooth = 0
        lastCamCF = Camera.CFrame
        return
    end

    if delta > CONFIG.Aimbot.DeltaBreakLow then
        curSmooth = math.max(0, curSmooth - delta * CONFIG.Aimbot.PenaltySpeed)
    else
        curSmooth = curSmooth + (AimbotSettings.Smoothness - curSmooth) * CONFIG.Aimbot.RecoverySpeed
    end

    Camera.CFrame = Camera.CFrame:Lerp(
        CFrame.new(Camera.CFrame.Position, cachedTarget.Position), curSmooth
    )
    lastCamCF = Camera.CFrame
end)

