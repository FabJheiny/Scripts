local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")

local KronUI = {}
KronUI.__index = KronUI

local BG      = Color3.fromRGB(16, 14, 22)
local PANEL   = Color3.fromRGB(22, 19, 31)
local TABBAR  = Color3.fromRGB(19, 16, 27)
local CARD    = Color3.fromRGB(28, 24, 39)
local HOVER   = Color3.fromRGB(40, 34, 54)
local LINE    = Color3.fromRGB(54, 46, 70)
local ACCENT  = Color3.fromRGB(70, 60, 90)
local ACCENT2 = Color3.fromRGB(45, 40, 60)
local DIM     = Color3.fromRGB(150, 145, 165)
local MID     = Color3.fromRGB(195, 190, 215)
local W       = Color3.fromRGB(242, 240, 250)
local FONT    = Enum.Font.GothamMedium
local FONTB   = Enum.Font.GothamBold

local THEMES = {
    Dark     = { primary = Color3.fromRGB(110, 115, 135), secondary = Color3.fromRGB(70, 75, 90)  },
    Darkness = { primary = Color3.fromRGB(70, 60, 90),    secondary = Color3.fromRGB(45, 40, 60)  },
}

local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end

local function stroke(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, par)
end

local function strokeIn(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
    }, par)
end

local function corner(par, r)
    return o("UICorner", { CornerRadius = (r == "pill") and UDim.new(1, 0) or UDim.new(0, r or 8) }, par)
end

local function tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local EASE_OUT  = function(d) return TweenInfo.new(d or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) end
local EASE_BACK = function(d) return TweenInfo.new(d or 0.4,  Enum.EasingStyle.Back, Enum.EasingDirection.Out) end

local MENU_W, MENU_H   = 420, 260
local MIN_W,  MIN_H    = 320, 180
local MAX_W,  MAX_H    = 700, 500
local TOPBAR_H          = 32
local CORNER_R          = 14
local TABBAR_W          = 76

function KronUI.new(title, pillImage)
    local self = setmetatable({}, KronUI)

    self._accent  = ACCENT
    self._accent2 = ACCENT2

    self._themeItems     = {}
    self._themeGradients = {}
    self._themeCallbacks = {}
    self._xBtn           = nil

    self._tabs          = {}
    self._activeTabId = nil
    self._currentThemeName = "Darkness"

    function self:_registerThemeItem(obj, prop, role)
        table.insert(self._themeItems, {Object = obj, Property = prop, Role = role})
    end
    function self:_registerThemeGradient(grad)
        table.insert(self._themeGradients, grad)
    end
    function self:_registerThemeCallback(cb)
        table.insert(self._themeCallbacks, cb)
    end

    function self:SetAccent(primary, secondary)
        self._accent  = primary
        self._accent2 = secondary
        for _, item in ipairs(self._themeItems) do
            item.Object[item.Property] = (item.Role == "accent" and primary or secondary)
        end
        for _, grad in ipairs(self._themeGradients) do
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, secondary),
                ColorSequenceKeypoint.new(0.5, primary),
                ColorSequenceKeypoint.new(1, secondary),
            })
        end
        for _, cb in ipairs(self._themeCallbacks) do
            cb(primary, secondary)
        end
    end

    local player = Players.LocalPlayer
    local pg     = player:WaitForChild("PlayerGui", 10) or player.PlayerGui

    local old    = pg:FindFirstChild("KronUI_Lib")
    local oldBtn = CoreGui:FindFirstChild("KronUI_FloatBtn") or pg:FindFirstChild("KronUI_FloatBtn")
    if old    then old:Destroy()    end
    if oldBtn then oldBtn:Destroy() end

    self._connections = {}
    self._layoutOrder = 0

    _G.KronUIScale = _G.KronUIScale or 20
    local function getUIScale(s) return 0.45 + (s - 1) * 0.04 end

    self.gui = o("ScreenGui", {
        Name = "KronUI_Lib", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 10,
    }, pg)

    local clickSound = o("Sound", {
        SoundId = "rbxassetid://6895079853",
        Volume  = 0.6,
        RollOffMaxDistance = 0,
    }, self.gui)

    local function playClick() clickSound:Play() end
    self._playClick = playClick

    self.menuFrame = o("Frame", {
        Name = "MenuFrame",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ClipsDescendants = true,
    }, self.gui)
    corner(self.menuFrame, CORNER_R)
    stroke(self.menuFrame, 1, LINE)
    local menuAccentStroke = stroke(self.menuFrame, 1.5, self._accent, 0.6)
    self:_registerThemeItem(menuAccentStroke, "Color", "accent")

    local uiScaleObj = Instance.new("UIScale")
    uiScaleObj.Scale  = getUIScale(_G.KronUIScale)
    uiScaleObj.Parent = self.menuFrame
    self._uiScaleObj = uiScaleObj

    self._targetSize = Vector2.new(MENU_W, MENU_H)

    task.defer(function()
        tween(self.menuFrame, EASE_BACK(0.5), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
    end)

    local topBar = o("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, TOPBAR_H),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ZIndex = 10,
    }, self.menuFrame)
    corner(topBar, CORNER_R)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 1, -CORNER_R),
        BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 11,
    }, topBar)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(1, -CORNER_R, 1, -CORNER_R),
        BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 11,
    }, topBar)

    local titleBtn = o("TextButton", {
        Size = UDim2.new(1, -50, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = title or "Interface",
        TextColor3 = W, TextSize = 13, Font = FONTB,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        ZIndex = 10,
    }, topBar)

    titleBtn.MouseEnter:Connect(function()
        tween(titleBtn, EASE_OUT(0.12), { TextColor3 = self._accent })
    end)
    titleBtn.MouseLeave:Connect(function()
        tween(titleBtn, EASE_OUT(0.12), { TextColor3 = W })
    end)

    local shimmer = o("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = self._accent,
        BorderSizePixel = 0, ZIndex = 20,
    }, topBar)
    self:_registerThemeItem(shimmer, "BackgroundColor3", "accent")
    local shimmerGrad = o("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, self._accent2),
            ColorSequenceKeypoint.new(0.5, self._accent),
            ColorSequenceKeypoint.new(1, self._accent2),
        }),
        Offset = Vector2.new(-1, 0),
    }, shimmer)
    self:_registerThemeGradient(shimmerGrad)
    self._shimmerTween = TweenService:Create(
        shimmerGrad,
        TweenInfo.new(2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false),
        { Offset = Vector2.new(1, 0) }
    )
    self._shimmerTween:Play()

    local xBtn = o("TextButton", {
        Size = UDim2.new(0, 38, 1, 0), Position = UDim2.new(1, -38, 0, 0),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        Text = "×", TextColor3 = W, TextSize = 26, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, topBar)
    corner(xBtn, CORNER_R)
    for _, pos in ipairs({
        UDim2.new(0, 0, 0, 0),
        UDim2.new(0, 0, 1, -CORNER_R),
        UDim2.new(1, -CORNER_R, 1, -CORNER_R),
    }) do
        o("Frame", {
            Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
            Position = pos,
            BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 12,
        }, xBtn)
    end

    self._xBtn = xBtn

    xBtn.MouseEnter:Connect(function()
        tween(xBtn, EASE_OUT(0.1), { TextColor3 = self._accent })
    end)
    xBtn.MouseLeave:Connect(function()
        tween(xBtn, EASE_OUT(0.15), { TextColor3 = W })
    end)

    local topBarDragMoved = false

    do
        local dragging, dragStart, startPos, _activeTouchId =
            false, nil, nil, nil
        table.insert(self._connections, topBar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; topBarDragMoved = false
                dragStart = inp.Position; startPos = self.menuFrame.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true; topBarDragMoved = false
                dragStart = inp.Position; startPos = self.menuFrame.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                if d.Magnitude > 4 then topBarDragMoved = true end
                self.menuFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false; dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                dragging = false; _activeTouchId = nil
                dragStart = nil; startPos = nil
            end
        end))
    end

    self.contentFrame = o("Frame", {
        Size = UDim2.new(1, 0, 1, -TOPBAR_H),
        Position = UDim2.new(0, 0, 0, TOPBAR_H),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
    }, self.menuFrame)
    corner(self.contentFrame, CORNER_R)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, self.contentFrame)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(1, -CORNER_R, 0, 0),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, self.contentFrame)

    self.tabBar = o("Frame", {
        Name = "TabBar",
        Size = UDim2.new(0, TABBAR_W, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = TABBAR,
        BorderSizePixel = 0,
    }, self.contentFrame)
    corner(self.tabBar, CORNER_R)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = TABBAR, BorderSizePixel = 0,
    }, self.tabBar)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(1, -CORNER_R, 0, 0),
        BackgroundColor3 = TABBAR, BorderSizePixel = 0,
    }, self.tabBar)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(1, -CORNER_R, 1, -CORNER_R),
        BackgroundColor3 = TABBAR, BorderSizePixel = 0,
    }, self.tabBar)
    o("Frame", {
        Size = UDim2.new(0, 1, 1, 0),
        Position = UDim2.new(1, -1, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0,
    }, self.tabBar)

    self.tabList = o("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
    }, self.tabBar)
    self:_registerThemeItem(self.tabList, "ScrollBarImageColor3", "accent")
    o("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.tabList)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
        PaddingTop  = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
    }, self.tabList)

    self.pagesHolder = o("Frame", {
        Name = "PagesHolder",
        Size = UDim2.new(1, -TABBAR_W, 1, 0),
        Position = UDim2.new(0, TABBAR_W, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, self.contentFrame)

    do
        local HANDLE_SIZE = 26
        local handle = o("TextButton", {
            Name = "ResizeHandle",
            AnchorPoint = Vector2.new(1, 1),
            Size = UDim2.new(0, HANDLE_SIZE, 0, HANDLE_SIZE),
            Position = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false,
            ZIndex = 50,
        }, self.menuFrame)

        for i = 1, 3 do
            local off = i * 4
            o("Frame", {
                Size = UDim2.new(0, 8, 0, 1.5),
                Position = UDim2.new(1, -6 - off, 1, -6),
                Rotation = -45,
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundColor3 = LINE, BorderSizePixel = 0,
                Name = "Grip" .. i,
            }, handle)
        end
        self._resizeGrips = {}
        for _, c in ipairs(handle:GetChildren()) do
            if c.Name:match("^Grip") then table.insert(self._resizeGrips, c) end
        end
        local function setGripColor(col)
            for _, g in ipairs(self._resizeGrips) do g.BackgroundColor3 = col end
        end

        local resizing, resizeStart, startSize, activeTouchId =
            false, nil, nil, nil

        local gripActive = false
        local function refreshGripColor()
            setGripColor(gripActive and self._accent or LINE)
        end

        self:_registerThemeCallback(function()
            if gripActive then refreshGripColor() end
        end)

        handle.MouseEnter:Connect(function() gripActive = true; refreshGripColor() end)
        handle.MouseLeave:Connect(function()
            if not resizing then
                gripActive = false
                refreshGripColor()
            end
        end)

        local function applyResize(delta)
            local newW = math.clamp(startSize.X + delta.X, MIN_W, MAX_W)
            local newH = math.clamp(startSize.Y + delta.Y, MIN_H, MAX_H)
            self._targetSize = Vector2.new(newW, newH)
            self.menuFrame.Size = UDim2.new(0, newW, 0, newH)
        end

        table.insert(self._connections, handle.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if resizing then return end
                resizing = true
                resizeStart = inp.Position
                startSize = self._targetSize
                gripActive = true; refreshGripColor()
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if activeTouchId ~= nil then return end
                activeTouchId = inp
                resizing = true
                resizeStart = inp.Position
                startSize = self._targetSize
                gripActive = true; refreshGripColor()
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not resizing then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= activeTouchId then return end
            if isM or isT then
                applyResize(inp.Position - resizeStart)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if activeTouchId then return end
                resizing = false; resizeStart = nil; startSize = nil
                gripActive = false; refreshGripColor()
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= activeTouchId then return end
                resizing = false; activeTouchId = nil
                resizeStart = nil; startSize = nil
                gripActive = false; refreshGripColor()
            end
        end))
    end

    local POPUP_W, POPUP_H = 224, 186

    local clickCatcher = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false,
        Visible = false, ZIndex = 5,
    }, self.menuFrame)

    local popup = o("Frame", {
        Name = "SettingsPopup",
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0, 14, 0, TOPBAR_H + 8),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = false, ZIndex = 100,
    }, self.menuFrame)
    corner(popup, 10)
    stroke(popup, 1, LINE)

    o("TextLabel", {
        Size = UDim2.new(1, -20, 0, 18),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Text = "Configurações",
        Font = FONTB, TextSize = 12,
        TextColor3 = W,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 101,
    }, popup)

    o("TextLabel", {
        Size = UDim2.new(0, 100, 0, 14),
        Position = UDim2.new(0, 12, 0, 32),
        BackgroundTransparency = 1,
        Text = "Largura",
        Font = FONT, TextSize = 11,
        TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 101,
    }, popup)

    local wValue = o("TextLabel", {
        Size = UDim2.new(0, 60, 0, 14),
        Position = UDim2.new(1, -72, 0, 32),
        BackgroundTransparency = 1,
        Text = tostring(MENU_W),
        Font = FONTB, TextSize = 11,
        TextColor3 = self._accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 101,
    }, popup)
    self:_registerThemeItem(wValue, "TextColor3", "accent")

    o("TextLabel", {
        Size = UDim2.new(0, 100, 0, 14),
        Position = UDim2.new(0, 12, 0, 78),
        BackgroundTransparency = 1,
        Text = "Altura",
        Font = FONT, TextSize = 11,
        TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 101,
    }, popup)

    local hValue = o("TextLabel", {
        Size = UDim2.new(0, 60, 0, 14),
        Position = UDim2.new(1, -72, 0, 78),
        BackgroundTransparency = 1,
        Text = tostring(MENU_H),
        Font = FONTB, TextSize = 11,
        TextColor3 = self._accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 101,
    }, popup)
    self:_registerThemeItem(hValue, "TextColor3", "accent")

    local function makeDragBar(parent, yPos, minVal, maxVal, initialVal, valueLabel, onChange)
        local currentVal = initialVal
        local container = o("TextButton", {
            Size = UDim2.new(1, -24, 0, 20),
            Position = UDim2.new(0, 12, 0, yPos),
            BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false,
            ZIndex = 101,
        }, parent)

        local track = o("Frame", {
            Size = UDim2.new(1, 0, 0, 6),
            Position = UDim2.new(0, 0, 0.5, -3),
            BackgroundColor3 = LINE,
            BorderSizePixel = 0,
            ZIndex = 101,
        }, container)
        corner(track, "pill")

        local rel0 = (initialVal - minVal) / (maxVal - minVal)

        local fill = o("Frame", {
            Size = UDim2.new(rel0, 0, 1, 0),
            BackgroundColor3 = self._accent,
            BorderSizePixel = 0,
            ZIndex = 101,
        }, track)
        corner(fill, "pill")
        self:_registerThemeItem(fill, "BackgroundColor3", "accent")

        local knob = o("Frame", {
            Size = UDim2.new(0, 12, 0, 12),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(rel0, 0, 0.5, 0),
            BackgroundColor3 = W,
            BorderSizePixel = 0,
            ZIndex = 102,
        }, container)
        corner(knob, "pill")
        local knobStroke = stroke(knob, 1.5, self._accent)
        self:_registerThemeItem(knobStroke, "Color", "accent")

        local function apply(v)
            local rel = math.clamp((v - minVal) / (maxVal - minVal), 0, 1)
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, 0, 0.5, 0)
            valueLabel.Text = tostring(math.floor(v))
        end

        local resizing, resizeStart, startVal, activeTouchId = false, nil, nil, nil

        table.insert(self._connections, container.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if resizing then return end
                resizing = true
                resizeStart = inp.Position
                startVal = currentVal
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if activeTouchId ~= nil then return end
                activeTouchId = inp
                resizing = true
                resizeStart = inp.Position
                startVal = currentVal
            end
        end))

        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not resizing then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= activeTouchId then return end
            if isM or isT then
                local deltaPx = inp.Position.X - resizeStart.X
                local newVal = math.clamp(startVal + deltaPx, minVal, maxVal)
                currentVal = newVal
                apply(newVal)
                onChange(newVal)
            end
        end))

        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if activeTouchId then return end
                resizing = false; resizeStart = nil; startVal = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= activeTouchId then return end
                resizing = false; activeTouchId = nil
                resizeStart = nil; startVal = nil
            end
        end))

        return function(v)
            currentVal = math.clamp(v, minVal, maxVal)
            apply(currentVal)
        end
    end

    local wSetVal = makeDragBar(popup, 48, MIN_W, MAX_W, MENU_W, wValue, function(v)
        local newH = self._targetSize.Y
        self._targetSize = Vector2.new(v, newH)
        self.menuFrame.Size = UDim2.new(0, v, 0, newH)
    end)

    local hSetVal = makeDragBar(popup, 94, MIN_H, MAX_H, MENU_H, hValue, function(v)
        local newW = self._targetSize.X
        self._targetSize = Vector2.new(newW, v)
        self.menuFrame.Size = UDim2.new(0, newW, 0, v)
    end)

    o("TextLabel", {
