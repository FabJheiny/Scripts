    Enabled    = true,
    FOV        = 90,
    IgnoreWall = false,
    ShowFOV    = true,
    Smoothness = CONFIG.Aimbot.Smoothness,   -- controlado por slider
    TargetPart = "Head",                     -- controlado por dropdown
}
