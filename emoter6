-- ── BOTÕES DE EMOTE ───────────────────────────────────────────────────────────
local function criarBotaoEmote(emote, parent)
	local btn = o("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		Text = emote.text or emote.nome,
		TextSize = 9, Font = FONT,
		TextColor3 = MID,
		BackgroundColor3 = CARD,
		BorderSizePixel = 0,
		AutoButtonColor = false,
	}, parent)
	o("UICorner", { CornerRadius = UDim.new(0, 4) }, btn)
	stroke(btn, 1, LINE)

	local ativo = false
	local track = nil

	btn.MouseEnter:Connect(function()
		if not ativo then
			btn.BackgroundColor3 = HOVER
			btn.TextColor3 = W
		end
	end)
	btn.MouseLeave:Connect(function()
		if not ativo then
			btn.BackgroundColor3 = CARD
			btn.TextColor3 = MID
		end
	end)

	local function novaTrack()
		local char = player.Character
		if char then
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				local anim = Instance.new("Animation")
				anim.AnimationId = "rbxassetid://" .. emote.id
				return humanoid:LoadAnimation(anim)
			end
		end
		return nil
	end

	local function desativar()
		if track then track:Stop() track = nil end
		ativo = false
		btn.BackgroundColor3 = CARD
		btn.TextColor3 = MID
		btn.Text = emote.text or emote.nome
	end

	local function ativar()
		ativo = true
		btn.BackgroundColor3 = Color3.fromRGB(40, 55, 48)
		btn.TextColor3 = Color3.fromRGB(160, 210, 170)
		btn.Text = "> " .. (emote.text or emote.nome)
	end

	btn.MouseButton1Click:Connect(function()
		if emote.loop then
			ativo = not ativo
			if ativo then
				track = novaTrack()
				if not track then ativo = false return end
				ativar()
				track:Play(emote.fade or 0.1, emote.weight or 1, emote.speed or 1)
				task.spawn(function()
					while ativo do
						if not track or not track.IsPlaying then
							track = novaTrack()
							if track then
								track:Play(emote.fade or 0.1, emote.weight or 1, emote.speed or 1)
							else
								desativar() break
							end
						end
						task.wait()
					end
				end)
			else
				desativar()
			end
		else
			if ativo and track and track.IsPlaying then
				desativar()
			else
				track = novaTrack()
				if track then
					ativar()
					track:Play(emote.fade or 0.1, emote.weight or 1, emote.speed or 1)
					track.Stopped:Connect(function() desativar() end)
				end
			end
		end
	end)

	player.CharacterAdded:Connect(function() desativar() end)
	return btn
end

-- ── CARREGAR EMOTES ───────────────────────────────────────────────────────────
local function carregarEmotes(rigType)
	for _, child in ipairs(gradeContent:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	local lista = (rigType == Enum.HumanoidRigType.R15) and R15Buttons or R6Buttons
	for _, emote in ipairs(lista) do
		criarBotaoEmote(emote, gradeContent)
	end
	titulo.Text = (rigType == Enum.HumanoidRigType.R15) and "Emotes R15" or "Emotes R6"
	task.defer(atualizarCanvas)
end

local function atualizarRigType()
	local char = player.Character
	if char then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then carregarEmotes(humanoid.RigType) end
	end
end

if player.Character then
	atualizarRigType()
else
	player.CharacterAdded:Connect(atualizarRigType)
end

player.CharacterAdded:Connect(function(char)
	char:WaitForChild("Humanoid"):GetPropertyChangedSignal("RigType"):Connect(atualizarRigType)
end)

task.wait(0.1)
atualizarCanvas()

