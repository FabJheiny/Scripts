-- ── HELPERS ──────────────────────────────────────────────────────────────────
local function o(cls, props, par)
	local x = Instance.new(cls)
	for k, v in pairs(props) do x[k] = v end
	if par then x.Parent = par end
	return x
end

local function stroke(par, t, c)
	o("UIStroke", {
		Color = c or LINE, Thickness = t or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, par)
end

local function mkBtn(txt, parent, sz, pos)
	local b = o("TextButton", {
		Size = sz, Position = pos,
		BackgroundColor3 = CARD, BorderSizePixel = 0,
		Text = txt, TextColor3 = MID, TextSize = 10,
		Font = FONT, AutoButtonColor = false,
	}, parent)
	stroke(b, 1, LINE)
	o("UICorner", { CornerRadius = UDim.new(0, 5) }, b)
	b.MouseEnter:Connect(function()
		b.BackgroundColor3 = HOVER; b.TextColor3 = W
	end)
	b.MouseLeave:Connect(function()
		b.BackgroundColor3 = CARD; b.TextColor3 = MID
	end)
	b.MouseButton1Down:Connect(function()
		b.BackgroundColor3 = Color3.fromRGB(52, 52, 62)
	end)
	b.MouseButton1Up:Connect(function()
		b.BackgroundColor3 = HOVER
	end)
	return b
end

