-- ── Função para criar botão (agora ativo = branco) ─────────────────
local function criarBotaoEmote(emote, parent)
	local btn = Instance.new("TextButton", parent)
	btn.Size = UDim2.new(1, 0, 1, 0)
	btn.Text = emote.text or emote.nome
	btn.TextSize = 8
	btn.Font = Enum.Font.SourceSansBold
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)   -- texto branco padrão
	btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30) -- fundo escuro inativo
	btn.BorderSizePixel = 0
	btn.AutoButtonColor = false

	local stroke = Instance.new("UIStroke", btn)
	stroke.Color = Color3.fromRGB(120, 120, 120)
	stroke.Thickness = 1
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

	local ativo = false
	local track = nil
	local corOff = Color3.fromRGB(30, 30, 30)      -- fundo escuro
	local corOn = Color3.fromRGB(255, 255, 255)    -- fundo branco ao ativar
	local textoOff = Color3.fromRGB(255, 255, 255) -- texto branco
	local textoOn = Color3.fromRGB(0, 0, 0)        -- texto preto (contraste)

	-- Hover
	btn.MouseEnter:Connect(function()
		if not ativo then
			btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
		end
		stroke.Color = Color3.fromRGB(255, 255, 255)
	end)
	btn.MouseLeave:Connect(function()
		if not ativo then
			btn.BackgroundColor3 = corOff
		end
		stroke.Color = Color3.fromRGB(120, 120, 120)
	end)

	local function novaTrack()
		local char = player.Character
		if char then
			local humanoid = char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				local anim = Instance.new("Animation")
				anim.AnimationId = "rbxassetid://" .. emote.id
				return humanoid:LoadAnimation(anim)
			end
		end
		return nil
	end

	local function desativar()
		if track then
			track:Stop()
			track = nil
		end
		ativo = false
		btn.BackgroundColor3 = corOff
		btn.TextColor3 = textoOff
	end

	btn.MouseButton1Click:Connect(function()
		if emote.loop then
			ativo = not ativo
			if ativo then
				track = novaTrack()
				if not track then
					ativo = false
					return
				end
				btn.BackgroundColor3 = corOn
				btn.TextColor3 = textoOn
				track:Play(emote.fade or 0.1, emote.weight or 1, emote.speed or 1)

				task.spawn(function()
					while ativo do
						if not track or not track.IsPlaying then
							track = novaTrack()
							if track then
								track:Play(emote.fade or 0.1, emote.weight or 1, emote.speed or 1)
							else
								desativar()
								break
							end
						end
						task.wait()
					end
				end)
			else
				desativar()
			end
		else
			if ativo and track and track.IsPlaying then
				desativar()
			else
				track = novaTrack()
				if track then
					ativo = true
					btn.BackgroundColor3 = corOn
					btn.TextColor3 = textoOn
					track:Play(emote.fade or 0.1, emote.weight or 1, emote.speed or 1)
					track.Stopped:Connect(function()
						desativar()
					end)
				end
			end
		end
	end)

	player.CharacterAdded:Connect(function()
		desativar()
	end)

	return btn
end

-- ── Carregar emotes conforme RigType ──────────────────────────────────
local function carregarEmotes(rigType)
	for _, child in ipairs(gradeContent:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local lista = (rigType == Enum.HumanoidRigType.R15) and R15Buttons or R6Buttons
	for _, emote in ipairs(lista) do
		criarBotaoEmote(emote, gradeContent)
	end

	titulo.Text = (rigType == Enum.HumanoidRigType.R15) and "Emotes R15" or "Emotes R6"
end

local function atualizarRigType()
	local char = player.Character
	if char then
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid then
			carregarEmotes(humanoid.RigType)
		end
	end
end

if player.Character then
	atualizarRigType()
else
	player.CharacterAdded:Connect(atualizarRigType)
end

player.CharacterAdded:Connect(function(char)
	char:WaitForChild("Humanoid"):GetPropertyChangedSignal("RigType"):Connect(atualizarRigType)
end)

