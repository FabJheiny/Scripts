	return string.format("%d, %d, %d", math.round(p.X), math.round(p.Y), math.round(p.Z))
end

local function refreshWaypointPopup()
	for i = 1, WP_MAX do
		local wp = waypoints[i]
		local entry = wpButtons[i]
		if wp then
			entry.rowFrame.Visible = true
			entry.label.Text = wp.name or formatCoords(wp.cframe)
			entry.editBox.Visible = false
			entry.label.Visible = true
		else
			entry.rowFrame.Visible = false
			entry.editBox.Visible = false
			entry.label.Visible = true
		end
	end

	local n = #waypoints
	local contentH = 0
	if n > 0 then
		contentH = n * WP_ROW_HEIGHT + (n - 1) * WP_ROW_GAP
	end
	wpScroll.CanvasSize = UDim2.new(0, 0, 0, contentH)
end

