local extraHoldToken = 0

pillBtn3.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
	or input.UserInputType == Enum.UserInputType.Touch then
		extraHolding = true
		extraHoldToken += 1
		local myToken = extraHoldToken
		task.delay(VALUE_POPUP_HOLD_TIME, function()
