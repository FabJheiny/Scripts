		pressActive = false
	end

	b.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			if editBox.Visible then return end
			if not waypoints[i] then return end

			pressActive    = true
			pressStartPos  = Vector2.new(input.Position.X, input.Position.Y)
			pressStartCanY = wpScroll.CanvasPosition.Y
		end
	end)

	track(UIS.InputChanged:Connect(function(input)
		if not pressActive then return end
		if input.UserInputType ~= Enum.UserInputType.Touch
		and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end

		local cur = Vector2.new(input.Position.X, input.Position.Y)
		if (cur - pressStartPos).Magnitude > WP_SCROLL_THRESHOLD then
			cancelPress()
		end
	end))

	b.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
			if not pressActive then return end

			local endPos = Vector2.new(input.Position.X, input.Position.Y)
			if (endPos - pressStartPos).Magnitude > WP_SCROLL_THRESHOLD then
				cancelPress()
				return
			end
			if math.abs(wpScroll.CanvasPosition.Y - pressStartCanY) > 1 then
