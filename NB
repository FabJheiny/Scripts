	x = math.clamp(x, VALUE_TAIL + 4, math.max(VALUE_TAIL + 4, vp.X - VALUE_POPUP_W - VALUE_TAIL - 4))

	local y = ap.Y + asz.Y + VALUE_POPUP_GAP + VALUE_EXTRA_DOWN
	y = math.clamp(y, 4, math.max(4, vp.Y - VALUE_POPUP_H - 4))

	setTailSide(tails, onLeft)
	frame.Position = UDim2.new(0, x, 0, y)
	frame.Visible = true
	valueBlocker.Visible = true
	valueOpenedAt = os.clock()

	activeValuePopup = { frame = frame, box = box, kind = kind }
	if kind == "fly" then
		extraMenuOpen = true
	end
end

