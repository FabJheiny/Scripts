local RobloxUI = {}
RobloxUI.__index = RobloxUI

local B    = Color3.fromRGB(0,0,0)
local W    = Color3.fromRGB(255,255,255)
local D    = Color3.fromRGB(15,15,15)
local G    = Color3.fromRGB(50,50,50)
local FONT = Enum.Font.Code

local function o(cls,props,par)
    local x=Instance.new(cls)
    for k,v in pairs(props) do x[k]=v end
    if par then x.Parent=par end
    return x
end
local function stroke(par,t,c)
    o("UIStroke",{Color=c or W,Thickness=t or 1,
        ApplyStrokeMode=Enum.ApplyStrokeMode.Border},par)
end

function RobloxUI.new(title, version)
    local self = setmetatable({}, RobloxUI)

    local Players = game:GetService("Players")
    local UIS     = game:GetService("UserInputService")
    local CoreGui = game:GetService("CoreGui")
    local player  = Players.LocalPlayer
    local pg      = player:WaitForChild("PlayerGui",10) or player.PlayerGui

    local old    = pg:FindFirstChild("RobloxUI_Lib")
    local oldBtn = CoreGui:FindFirstChild("RobloxUI_FloatBtn")
        or pg:FindFirstChild("RobloxUI_FloatBtn")
    if old    then old:Destroy()    end
    if oldBtn then oldBtn:Destroy() end

    self._connections = {}
    self._UIS = UIS

    self.gui = o("ScreenGui",{
        Name="RobloxUI_Lib",ResetOnSpawn=false,
        IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Global,
        DisplayOrder=10,
    },pg)

    self.menuFrame = o("Frame",{
        Name="MenuFrame",
        Size=UDim2.new(0,480,0,340),
        Position=UDim2.new(.5,-240,.5,-170),
        BackgroundColor3=B,BackgroundTransparency=0,
        BorderSizePixel=0,Active=true,
        ClipsDescendants=true,
    },self.gui)
    stroke(self.menuFrame,1)

    -- ── TOPBAR ──────────────────────────────
    local topH=28
    local topBar=o("Frame",{
        Name="TopBar",
        Size=UDim2.new(1,0,0,topH),
        BackgroundColor3=B,BackgroundTransparency=0,
        BorderSizePixel=0,Active=true,ZIndex=10,
    },self.menuFrame)

    o("TextLabel",{
        Size=UDim2.new(1,-70,1,0),Position=UDim2.new(0,10,0,0),
        BackgroundTransparency=1,
        Text=(title or "SPECTRA").." "..(version or "v1.0"),
        TextColor3=W,TextSize=13,Font=FONT,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=10,
    },topBar)

    o("Frame",{
        Size=UDim2.new(0,1,1,0),Position=UDim2.new(1,-33,0,0),
        BackgroundColor3=W,BorderSizePixel=0,ZIndex=12,
    },topBar)

    local xBtn=o("TextButton",{
        Size=UDim2.new(0,32,1,0),Position=UDim2.new(1,-32,0,0),
        BackgroundColor3=B,BorderSizePixel=0,
        Text="x",TextColor3=W,TextSize=14,Font=FONT,
        AutoButtonColor=false,ZIndex=11,
    },topBar)
    xBtn.MouseEnter:Connect(function() xBtn.BackgroundColor3=D end)
    xBtn.MouseLeave:Connect(function() xBtn.BackgroundColor3=B end)

    o("Frame",{
        Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,0,topH),
        BackgroundColor3=W,BorderSizePixel=0,ZIndex=20,
    },self.menuFrame)

    -- ── DRAG (janela) ────────────────────────
    do
        local dragging,dragStart,startPos=false,nil,nil
        table.insert(self._connections,topBar.InputBegan:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.MouseButton1
            or inp.UserInputType==Enum.UserInputType.Touch then
                dragging=true dragStart=inp.Position startPos=self.menuFrame.Position
            end
        end))
        table.insert(self._connections,topBar.InputEnded:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.MouseButton1
            or inp.UserInputType==Enum.UserInputType.Touch then
                dragging=false
            end
        end))
        table.insert(self._connections,UIS.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType==Enum.UserInputType.MouseMovement
                or inp.UserInputType==Enum.UserInputType.Touch) then
                local d=inp.Position-dragStart
                self.menuFrame.Position=UDim2.new(
                    startPos.X.Scale,startPos.X.Offset+d.X,
                    startPos.Y.Scale,startPos.Y.Offset+d.Y)
            end
        end))
    end

    -- ── CONTENT ─────────────────────────────
    self.contentFrame=o("Frame",{
        Size=UDim2.new(1,0,1,-topH-1),
        Position=UDim2.new(0,0,0,topH+1),
        BackgroundTransparency=1,
    },self.menuFrame)

    local function makeHeader(xScale)
        return o("TextLabel",{
            Size=UDim2.new(1/3,0,0,18),
            Position=UDim2.new(xScale,0,0,0),
            BackgroundTransparency=1,Text="",
            Font=FONT,TextSize=11,
            TextColor3=W,
        },self.contentFrame)
    end
    self.leftTabLabel  = makeHeader(0)
    self.rightTabLabel = makeHeader(1/3)
    self.thirdTabLabel = makeHeader(2/3)

    local function makeContainer(xScale)
        local c=o("ScrollingFrame",{
            Size=UDim2.new(1/3,-12,1,-22),
            Position=UDim2.new(xScale,6,0,20),
            BackgroundTransparency=1,BorderSizePixel=0,
            ScrollBarThickness=2,ScrollBarImageColor3=G,
            AutomaticCanvasSize=Enum.AutomaticSize.Y,
            CanvasSize=UDim2.new(),Visible=true,
        },self.contentFrame)
        o("UIListLayout",{Padding=UDim.new(0,4)},c)
        o("UIPadding",{
            PaddingLeft=UDim.new(0,2),
            PaddingRight=UDim.new(0,2),
            PaddingTop=UDim.new(0,2),
        },c)
        return c
    end
    self.leftContainer  = makeContainer(0)
    self.rightContainer = makeContainer(1/3)
    self.thirdContainer = makeContainer(2/3)

    o("Frame",{
        Size=UDim2.new(0,1,1,-8),Position=UDim2.new(1/3,0,0,4),
        BackgroundColor3=W,BackgroundTransparency=0,BorderSizePixel=0,
    },self.contentFrame)
    o("Frame",{
        Size=UDim2.new(0,1,1,-8),Position=UDim2.new(2/3,0,0,4),
        BackgroundColor3=W,BackgroundTransparency=0,BorderSizePixel=0,
    },self.contentFrame)

    -- ── PILL ────────────────────────────────
    self.btnGui = o("ScreenGui",{
        Name="RobloxUI_FloatBtn",ResetOnSpawn=false,
        IgnoreGuiInset=true,ZIndexBehavior=Enum.ZIndexBehavior.Global,
        DisplayOrder=9999,
    })
    local okPill = pcall(function() self.btnGui.Parent = CoreGui end)
    if not okPill then self.btnGui.Parent = pg end

    local pill=o("Frame",{
        Name="PillUI",
        Size=UDim2.new(0,60,0,18),
        Position=UDim2.new(1,-66,1,-256),
        BackgroundColor3=B,BorderSizePixel=0,
        Visible=false,ZIndex=200,
    },self.btnGui)
    stroke(pill,1)
    self._pill=pill

    local pillBtn=o("TextButton",{
        Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
        Text="> ui",TextSize=9,Font=FONT,
        TextColor3=W,BorderSizePixel=0,ZIndex=201,
    },pill)

    xBtn.MouseButton1Click:Connect(function()
        self.menuFrame.Visible=false
        pill.Visible=true
    end)

    table.insert(self._connections,pillBtn.MouseButton1Click:Connect(function()
        self.menuFrame.Visible=true
        pill.Visible=false
    end))

    return self
end

function RobloxUI:Destroy()
    for _,conn in ipairs(self._connections) do conn:Disconnect() end
    self._connections={}
    if self.gui    then self.gui:Destroy()    end
    if self.btnGui then self.btnGui:Destroy() end
end

function RobloxUI:_getContainer(side)
    if side=="left"  then return self.leftContainer  end
    if side=="right" then return self.rightContainer end
    if side=="third" then return self.thirdContainer end
    return self.leftContainer
end

function RobloxUI:AddToggle(side,text,default,callback)
    local container=self:_getContainer(side)
    local state=default or false

    local btn=o("TextButton",{
        Size=UDim2.new(1,-4,0,26),
        BackgroundColor3=B,BackgroundTransparency=0,
        BorderSizePixel=0,AutoButtonColor=false,Text="",
    },container)
    stroke(btn,1)

    local dot=o("Frame",{
        Size=UDim2.new(0,7,0,7),
        Position=UDim2.new(0,8,0.5,-3.5),
        BackgroundColor3=G,BorderSizePixel=0,
    },btn)

    local label=o("TextLabel",{
        BackgroundTransparency=1,
        Position=UDim2.new(0,22,0,0),
        Size=UDim2.new(1,-28,1,0),
        Font=FONT,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,
        Text=text,
    },btn)

    local function refresh()
        if state then
            dot.BackgroundColor3=W
            label.TextColor3=W
        else
            dot.BackgroundColor3=G
            label.TextColor3=G
        end
    end
    refresh()

    btn.MouseEnter:Connect(function() if not state then btn.BackgroundColor3=D end end)
    btn.MouseLeave:Connect(function() if not state then btn.BackgroundColor3=B end end)

    table.insert(self._connections,btn.MouseButton1Click:Connect(function()
        state=not state
        btn.BackgroundColor3=state and D or B
        refresh()
        if callback then task.spawn(callback,state) end
    end))

    return {
        SetState=function(v) state=v refresh() end,
        GetState=function() return state end,
    }
end

function RobloxUI:AddButton(side,text,callback)
    local container=self:_getContainer(side)

    local btn=o("TextButton",{
        Size=UDim2.new(1,-4,0,26),
        BackgroundColor3=B,BackgroundTransparency=0,
        BorderSizePixel=0,AutoButtonColor=false,
        Font=FONT,TextSize=10,
        Text=text,TextColor3=W,
    },container)
    stroke(btn,1)

    btn.MouseEnter:Connect(function() btn.BackgroundColor3=D end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3=B end)
    table.insert(self._connections,btn.MouseButton1Down:Connect(function()
        btn.BackgroundColor3=Color3.fromRGB(25,25,25)
    end))
    table.insert(self._connections,btn.MouseButton1Up:Connect(function()
        btn.BackgroundColor3=D
    end))
    table.insert(self._connections,btn.MouseButton1Click:Connect(function()
        if callback then task.spawn(callback) end
    end))

    return btn
end

function RobloxUI:AddSlider(side,text,min,max,default,callback)
    local container=self:_getContainer(side)
    local UIS=self._UIS
    local value=math.clamp(default or min,min,max)
    local dragging=false

    local holder=o("Frame",{
        Size=UDim2.new(1,-4,0,44),
        BackgroundTransparency=1,
    },container)

    local label=o("TextLabel",{
        BackgroundTransparency=1,
        Size=UDim2.new(1,0,0,16),
        Font=FONT,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextColor3=W,
    },holder)

    local track=o("Frame",{
        Size=UDim2.new(1,0,0,4),
        Position=UDim2.new(0,0,0,26),
        BackgroundColor3=G,BackgroundTransparency=0,
        BorderSizePixel=0,
    },holder)
    stroke(track,1)

    local fill=o("Frame",{
        Size=UDim2.new(0,0,1,0),
        BackgroundColor3=W,BackgroundTransparency=0,
        BorderSizePixel=0,
    },track)

    local knob=o("Frame",{
        Size=UDim2.new(0,8,0,8),
        AnchorPoint=Vector2.new(.5,.5),
        Position=UDim2.new(0,0,.5,0),
        BackgroundColor3=W,BorderSizePixel=0,
    },track)
    stroke(knob,1)

    local function redraw()
        local rel=(value-min)/(max-min)
        fill.Size=UDim2.new(rel,0,1,0)
        knob.Position=UDim2.new(rel,0,.5,0)
        label.Text=text..": "..tostring(math.floor(value))
    end

    local function update(x)
        local rel=math.clamp((x-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        value=math.floor(min+(max-min)*rel)
        redraw()
        if callback then task.spawn(callback,value) end
    end

    redraw()

    table.insert(self._connections,track.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1
        or inp.UserInputType==Enum.UserInputType.Touch then
            dragging=true update(inp.Position.X)
        end
    end))
    table.insert(self._connections,knob.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1
        or inp.UserInputType==Enum.UserInputType.Touch then
            dragging=true
        end
    end))
    table.insert(self._connections,UIS.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType==Enum.UserInputType.MouseMovement
        or inp.UserInputType==Enum.UserInputType.Touch then
            update(inp.Position.X)
        end
    end))
    table.insert(self._connections,UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1
        or inp.UserInputType==Enum.UserInputType.Touch then
            dragging=false
        end
    end))

    return {
        GetValue=function() return value end,
        SetValue=function(v) value=math.clamp(v,min,max) redraw() end,
    }
end

function RobloxUI:SetTabNames(left,right,third)
    if self.leftTabLabel  then self.leftTabLabel.Text  = left  or "" end
    if self.rightTabLabel then self.rightTabLabel.Text = right or "" end
    if self.thirdTabLabel then self.thirdTabLabel.Text = third or "" end
end

_G.RobloxUI = RobloxUI
return RobloxUI
