-- ScriptHub.lua | Cronos Hub
local Hub = {}
local LP = game:GetService("Players").LocalPlayer
local UIS = game:GetService("UserInputService")
local PG = LP:WaitForChild("PlayerGui")
local B = Color3.fromRGB(0,0,0)
local W = Color3.fromRGB(255,255,255)
local D = Color3.fromRGB(15,15,15)
local G = Color3.fromRGB(50,50,50)
local DT = Color3.fromRGB(180,180,180)

local function o(cls,props,par)
    local x=Instance.new(cls)
    for k,v in pairs(props) do x[k]=v end
    if par then x.Parent=par end
    return x
end
local function stroke(par,t,c)
    o("UIStroke",{Color=c or W,Thickness=t or 1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},par)
end

local sg = o("ScreenGui",{Name="CronosHub",ResetOnSpawn=false,IgnoreGuiInset=true,DisplayOrder=100},PG)

local win = o("Frame",{
    Size=UDim2.new(0,680,0,310),
    Position=UDim2.new(.5,-340,.5,-155),
    BackgroundColor3=B,
    BorderSizePixel=0,
    Active=true,
    ClipsDescendants=true,
    Visible=true,
},sg)
stroke(win,1)

local top = o("Frame",{Size=UDim2.new(1,0,0,24),BackgroundColor3=B,BorderSizePixel=0},win)
o("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,1,-1),BackgroundColor3=G,BorderSizePixel=0},top)

o("TextLabel",{
    Size=UDim2.new(1,-60,1,0),Position=UDim2.new(0,8,0,0),
    BackgroundTransparency=1,Text="Cronos Hub",
    TextColor3=W,TextSize=11,Font=Enum.Font.SourceSansBold,
    TextXAlignment=Enum.TextXAlignment.Left,
},top)

local minBtn = o("TextButton",{
    Size=UDim2.new(0,18,0,14),Position=UDim2.new(1,-40,0.5,-7),
    BackgroundColor3=B,BorderSizePixel=0,
    Text="-",TextColor3=W,TextSize=13,Font=Enum.Font.SourceSansBold,AutoButtonColor=false,
},top)

local xBtn = o("TextButton",{
    Size=UDim2.new(0,18,0,14),Position=UDim2.new(1,-20,0.5,-7),
    BackgroundColor3=B,BorderSizePixel=0,
    Text="x",TextColor3=W,TextSize=10,Font=Enum.Font.SourceSansBold,AutoButtonColor=false,
},top)

do local d,ds,sp
    top.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then d=true ds=i.Position sp=win.Position end end)
    top.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then d=false end end)
    UIS.InputChanged:Connect(function(i) if d and i.UserInputType==Enum.UserInputType.MouseMovement then local dt=i.Position-ds win.Position=UDim2.new(sp.X.Scale,sp.X.Offset+dt.X,sp.Y.Scale,sp.Y.Offset+dt.Y) end end)
end

local body
local mini = false
local fullH, miniH = 310, 24

minBtn.MouseButton1Click:Connect(function()
    mini = not mini
    if mini then
        win.Size=UDim2.new(0,680,0,miniH)
        minBtn.Text="+"
    else
        win.Size=UDim2.new(0,680,0,fullH)
        minBtn.Text="-"
    end
end)

xBtn.MouseButton1Click:Connect(function()
    win.Visible=false
    _G.CronosHubPill.Visible=true
end)

body = o("Frame",{
    Size=UDim2.new(1,0,1,-24),
    Position=UDim2.new(0,0,0,24),
    BackgroundColor3=B,
    BorderSizePixel=0,
    ClipsDescendants=true,
},win)

local tcol = o("Frame",{
    Size=UDim2.new(0,90,1,0),
    BackgroundColor3=B,
    BorderSizePixel=0,
},body)
o("Frame",{Size=UDim2.new(0,1,1,0),Position=UDim2.new(1,0,0,0),BackgroundColor3=G,BorderSizePixel=0},tcol)

local tlist = o("ScrollingFrame",{
    Size=UDim2.new(1,0,1,0),
    BackgroundTransparency=1,BorderSizePixel=0,
    ScrollBarThickness=0,
    CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,
},tcol)
o("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder},tlist)

local area = o("Frame",{
    Size=UDim2.new(1,-91,1,0),
    Position=UDim2.new(0,91,0,0),
    BackgroundColor3=B,
    BorderSizePixel=0,
    ClipsDescendants=true,
},body)

local tabBtns,tabPages,cur = {},{},nil

local function sw(i)
    if cur==i then return end
    if cur then
        tabBtns[cur].BackgroundColor3=B
        tabBtns[cur].TextColor3=DT
    end
    cur=i
    tabBtns[i].BackgroundColor3=D
    tabBtns[i].TextColor3=W
    for j,p in ipairs(tabPages) do p.Visible=(j==i) end
end

function Hub:Tab(name)
    local i = #tabBtns+1

    local tb = o("TextButton",{
        Size=UDim2.new(1,0,0,28),
        BackgroundColor3= i==1 and D or B,
        BorderSizePixel=0,
        Text=name,
        TextColor3= i==1 and W or DT,
        TextSize=10,
        Font=Enum.Font.SourceSansBold,
        AutoButtonColor=false,
        LayoutOrder=i,
        TextWrapped=true,
    },tlist)
    o("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,1,-1),BackgroundColor3=G,BorderSizePixel=0},tb)

    local pg = o("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=B,BorderSizePixel=0,Visible=i==1},area)

    -- Hotbar: searchbar + contador na mesma linha
    local hotbar = o("Frame",{
        Size=UDim2.new(1,0,0,26),
        Position=UDim2.new(0,0,0,0),
        BackgroundColor3=B,
        BorderSizePixel=0,
    },pg)
    o("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,1,-1),BackgroundColor3=G,BorderSizePixel=0},hotbar)

    local searchW = 120
    local search = o("TextBox",{
        Size=UDim2.new(0,searchW,1,0),
        Position=UDim2.new(0,0,0,0),
        BackgroundColor3=B,
        BorderSizePixel=0,
        PlaceholderText="Search Script",
        PlaceholderColor3=Color3.fromRGB(90,90,90),
        Text="",
        TextColor3=W,
        TextSize=11,
        Font=Enum.Font.SourceSans,
        ClearTextOnFocus=false,
        TextXAlignment=Enum.TextXAlignment.Left,
    },hotbar)
    stroke(search,1,W)
    o("UIPadding",{PaddingLeft=UDim.new(0,6)},search)

    local countLbl = o("TextLabel",{
        Size=UDim2.new(1,-searchW-8,1,0),
        Position=UDim2.new(0,searchW+6,0,0),
        BackgroundTransparency=1,
        Text="Scripts: 0",
        TextColor3=DT,
        TextSize=10,
        Font=Enum.Font.SourceSans,
        TextXAlignment=Enum.TextXAlignment.Right,
    },hotbar)
    o("UIPadding",{PaddingRight=UDim.new(0,6)},countLbl)

    local scroll = o("ScrollingFrame",{
        Size=UDim2.new(1,0,1,-26),
        Position=UDim2.new(0,0,0,26),
        BackgroundTransparency=1,BorderSizePixel=0,
        ScrollBarThickness=2,ScrollBarImageColor3=G,
        CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,
    },pg)
    o("UIGridLayout",{
        CellSize=UDim2.new(0,80,0,28),
        CellPadding=UDim2.new(0,6,0,6),
        SortOrder=Enum.SortOrder.LayoutOrder,
        HorizontalAlignment=Enum.HorizontalAlignment.Center,
        FillDirectionMaxCells=0,
    },scroll)
    o("UIPadding",{PaddingTop=UDim.new(0,6),PaddingLeft=UDim.new(0,6),PaddingRight=UDim.new(0,6),PaddingBottom=UDim.new(0,6)},scroll)

    tabBtns[i]=tb tabPages[i]=pg if i==1 then cur=1 end
    tb.MouseButton1Click:Connect(function() sw(i) end)

    local allBtns = {}

    local function updateCount()
        local visible = 0
        for _,b in ipairs(allBtns) do
            if b.Visible then visible += 1 end
        end
        countLbl.Text = "Scripts: " .. visible
    end

    search:GetPropertyChangedSignal("Text"):Connect(function()
        local q = search.Text:lower()
        for _,b in ipairs(allBtns) do
            b.Visible = (q=="" or b.Name:lower():find(q,1,true)~=nil)
        end
        updateCount()
    end)

    local T={}
    function T:Button(txt,cb)
        local b = o("TextButton",{
            Name=txt,
            BackgroundColor3=D,
            BorderSizePixel=0,
            Text=txt,
            TextColor3=W,
            TextSize=10,
            Font=Enum.Font.SourceSans,
            AutoButtonColor=false,
            TextWrapped=true,
            LineHeight=1.1,
        },scroll)
        stroke(b,1)
        b.MouseEnter:Connect(function() b.BackgroundColor3=Color3.fromRGB(25,25,25) end)
        b.MouseLeave:Connect(function() b.BackgroundColor3=D end)
        b.MouseButton1Click:Connect(function() if cb then pcall(cb) end end)
        table.insert(allBtns,b)
        countLbl.Text = "Scripts: " .. #allBtns
        return self
    end
    return T
end

local pill = o("Frame",{
    Name="Pill",
    Size=UDim2.new(0,54,0,18),
    Position=UDim2.new(1,-60,1,-400),
    BackgroundColor3=B,
    BorderSizePixel=0,
    Visible=false,
    ZIndex=200,
},sg)
stroke(pill,1)
_G.CronosHubPill = pill

local pillBtn = o("TextButton",{
    Size=UDim2.new(1,0,1,0),
    BackgroundTransparency=1,
    Text="> cronos",
    TextSize=9,
    Font=Enum.Font.SourceSansBold,
    TextColor3=W,
    BorderSizePixel=0,
    ZIndex=201,
},pill)

pillBtn.MouseButton1Click:Connect(function()
    win.Visible=true
    pill.Visible=false
end)

UIS.InputBegan:Connect(function(i,gp)
    if not gp and i.KeyCode==Enum.KeyCode.RightShift then
        local v = not win.Visible
        win.Visible=v
        if v then pill.Visible=false end
    end
end)

return Hub
