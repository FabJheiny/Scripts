local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")

local KronUI = {}
KronUI.__index = KronUI

local BG      = Color3.fromRGB(16, 14, 22)
local PANEL   = Color3.fromRGB(22, 19, 31)
local CARD    = Color3.fromRGB(28, 24, 39)
local HOVER   = Color3.fromRGB(40, 34, 54)
local LINE    = Color3.fromRGB(54, 46, 70)
local ACCENT  = Color3.fromRGB(150, 90, 255)
local ACCENT2 = Color3.fromRGB(95, 60, 200)
local DIM     = Color3.fromRGB(150, 145, 165)
local MID     = Color3.fromRGB(195, 190, 215)
local W       = Color3.fromRGB(242, 240, 250)
local FONT    = Enum.Font.GothamMedium
local FONTB   = Enum.Font.GothamBold

local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end

local function stroke(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, par)
end

local function corner(par, r)
    return o("UICorner", { CornerRadius = (r == "pill") and UDim.new(1, 0) or UDim.new(0, r or 8) }, par)
end

local function tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local EASE_OUT  = function(d) return TweenInfo.new(d or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) end
local EASE_BACK = function(d) return TweenInfo.new(d or 0.4,  Enum.EasingStyle.Back, Enum.EasingDirection.Out) end

-- ════════════════════════════════════════════════════
-- KronUI.new(title, pillImage)
--   pillImage → "rbxassetid://XXXXXXX" ou só o ID numérico
-- ════════════════════════════════════════════════════
function KronUI.new(title, pillImage)
    local self = setmetatable({}, KronUI)

    local player = Players.LocalPlayer
    local pg     = player:WaitForChild("PlayerGui", 10) or player.PlayerGui

    local old    = pg:FindFirstChild("KronUI_Lib")
    local oldBtn = CoreGui:FindFirstChild("KronUI_FloatBtn") or pg:FindFirstChild("KronUI_FloatBtn")
    if old    then old:Destroy()    end
    if oldBtn then oldBtn:Destroy() end

    self._connections = {}
    self._layoutOrder = 0

    _G.KronUIScale = _G.KronUIScale or 10
    local function getUIScale(s) return 0.45 + (s - 1) * 0.04 end

    self.gui = o("ScreenGui", {
        Name = "KronUI_Lib", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 10,
    }, pg)

    -- ── Som de clique ─────────────────────────────────
    local clickSound = o("Sound", {
        SoundId = "rbxassetid://6895079853",
        Volume  = 0.6,
        RollOffMaxDistance = 0,
    }, self.gui)

    local function playClick()
        clickSound:Play()
    end
    self._playClick = playClick   -- acessível nos métodos

    -- ── Janela principal ─────────────────────────────
    local MENU_W, MENU_H = 250, 340
    self.menuFrame = o("Frame", {
        Name = "MenuFrame",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ClipsDescendants = true,
    }, self.gui)
    corner(self.menuFrame, 14)
    stroke(self.menuFrame, 1, LINE)
    stroke(self.menuFrame, 1.5, ACCENT, 0.6)

    local uiScaleObj = Instance.new("UIScale")
    uiScaleObj.Scale  = getUIScale(_G.KronUIScale)
    uiScaleObj.Parent = self.menuFrame

    task.defer(function()
        tween(self.menuFrame, EASE_BACK(0.5), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
    end)

    -- ── TopBar ────────────────────────────────────────
    local topH     = 32
    local CORNER_R = 14
    local topBar = o("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, topH),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ZIndex = 10,
    }, self.menuFrame)
    corner(topBar, CORNER_R)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 1, -CORNER_R),
        BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 11,
    }, topBar)

    o("TextLabel", {
        Size = UDim2.new(1, -150, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = title or "Interface",
        TextColor3 = W, TextSize = 13, Font = FONTB,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 10,
    }, topBar)

    -- ── Shimmer ──────────────────────────────────────
    local shimmer = o("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = ACCENT,
        BorderSizePixel = 0, ZIndex = 20,
    }, topBar)
    local shimmerGrad = o("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, ACCENT2),
            ColorSequenceKeypoint.new(0.5, ACCENT),
            ColorSequenceKeypoint.new(1, ACCENT2),
        }),
        Offset = Vector2.new(-1, 0),
    }, shimmer)
    self._shimmerTween = TweenService:Create(
        shimmerGrad,
        TweenInfo.new(2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false),
        { Offset = Vector2.new(1, 0) }
    )
    self._shimmerTween:Play()

    -- ── Stepper de escala ────────────────────────────
    local STEP_W, STEP_H = 62, 18
    local stepHolder = o("Frame", {
        Size = UDim2.new(0, STEP_W, 0, STEP_H),
        Position = UDim2.new(1, -(33 + 8 + STEP_W), 0.5, -STEP_H / 2),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10,
        ClipsDescendants = true,
    }, topBar)
    stroke(stepHolder, 1, LINE).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    corner(stepHolder, 6)

    local bsz = STEP_H
    local dv  = 1
    local nw  = STEP_W - 2 * bsz - 2 * dv

    local stepPlus = o("TextButton", {
        Size = UDim2.new(0, bsz, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = "+", TextColor3 = MID, TextSize = 14, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, stepHolder)
    o("Frame", {
        Size = UDim2.new(0, dv, 1, 0), Position = UDim2.new(0, bsz, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 11,
    }, stepHolder)
    local stepBox = o("TextBox", {
        Size = UDim2.new(0, nw, 1, 0), Position = UDim2.new(0, bsz + dv, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(_G.KronUIScale),
        TextColor3 = W, TextSize = 10, Font = FONT,
        TextXAlignment = Enum.TextXAlignment.Center,
        ClearTextOnFocus = false, ZIndex = 11,
    }, stepHolder)
    o("Frame", {
        Size = UDim2.new(0, dv, 1, 0), Position = UDim2.new(0, bsz + dv + nw, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 11,
    }, stepHolder)
    local stepMinus = o("TextButton", {
        Size = UDim2.new(0, bsz, 1, 0), Position = UDim2.new(0, bsz + dv + nw + dv, 0, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = "−", TextColor3 = MID, TextSize = 14, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, stepHolder)

    local stepCv = _G.KronUIScale
    local function stepApply(v)
        v = math.clamp(math.floor(v), 1, 35)
        stepCv = v; _G.KronUIScale = v
        stepBox.Text = tostring(v)
        tween(uiScaleObj, EASE_OUT(0.12), { Scale = getUIScale(v) })
    end
    stepPlus.MouseButton1Click:Connect(function()  stepApply(stepCv + 1) end)
    stepMinus.MouseButton1Click:Connect(function() stepApply(stepCv - 1) end)
    stepBox.FocusLost:Connect(function()
        local n = tonumber(stepBox.Text)
        if n then stepApply(n) else stepBox.Text = tostring(stepCv) end
    end)
    for _, btn in ipairs({ stepPlus, stepMinus }) do
        btn.MouseEnter:Connect(function() btn.TextColor3 = ACCENT end)
        btn.MouseLeave:Connect(function() btn.TextColor3 = MID end)
    end

    o("Frame", {
        Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -33, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 12,
    }, topBar)

    local xBtn = o("TextButton", {
        Size = UDim2.new(0, 32, 1, 0), Position = UDim2.new(1, -32, 0, 0),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        Text = "×", TextColor3 = DIM, TextSize = 17, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, topBar)
    corner(xBtn, CORNER_R)
    for _, pos in ipairs({
        UDim2.new(0, 0, 0, 0),
        UDim2.new(0, 0, 1, -CORNER_R),
        UDim2.new(1, -CORNER_R, 1, -CORNER_R),
    }) do
        o("Frame", {
            Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
            Position = pos,
            BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 12,
        }, xBtn)
    end
    xBtn.MouseEnter:Connect(function() xBtn.TextColor3 = ACCENT end)
    xBtn.MouseLeave:Connect(function() xBtn.TextColor3 = DIM end)

    -- ── Drag da janela ────────────────────────────────
    do
        local dragging, dragStart, startPos, _activeTouchId =
            false, nil, nil, nil
        table.insert(self._connections, topBar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true
                dragStart = inp.Position; startPos = self.menuFrame.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true
                dragStart = inp.Position; startPos = self.menuFrame.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                self.menuFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false; dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                dragging = false; _activeTouchId = nil
                dragStart = nil; startPos = nil
            end
        end))
    end

    -- ── Conteúdo ──────────────────────────────────────
    self.contentFrame = o("Frame", {
        Size = UDim2.new(1, 0, 1, -topH),
        Position = UDim2.new(0, 0, 0, topH),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
    }, self.menuFrame)
    corner(self.contentFrame, CORNER_R)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, self.contentFrame)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(1, -CORNER_R, 0, 0),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, self.contentFrame)

    self.container = o("ScrollingFrame", {
        Size = UDim2.new(1, -8, 1, -6),
        Position = UDim2.new(0, 4, 0, 4),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = ACCENT,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
        Visible = true,
    }, self.contentFrame)
    o("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.container)
    o("UIPadding", {
        PaddingLeft   = UDim.new(0, 3),
        PaddingRight  = UDim.new(0, 3),
        PaddingTop    = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
    }, self.container)

    -- ── Pill flutuante ────────────────────────────────
    self.btnGui = o("ScreenGui", {
        Name = "KronUI_FloatBtn", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 9999,
    })
    local okPill = pcall(function() self.btnGui.Parent = CoreGui end)
    if not okPill then self.btnGui.Parent = pg end

    local PILL_SIZE = 46
    local pill = o("Frame", {
        Name = "PillUI",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(1, -46, 1, -242),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = false, ZIndex = 200,
    }, self.btnGui)
    corner(pill, "pill")
    stroke(pill, 1, LINE)
    local pillGlow = stroke(pill, 1.5, ACCENT, 0.55)
    self._pill = pill

    self._breatheTween = TweenService:Create(
        pillGlow,
        TweenInfo.new(1.3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        { Transparency = 0.9 }
    )
    self._breatheTween:Play()

    local resolvedImage = tostring(pillImage or "rbxassetid://78186286433275")
    if not resolvedImage:find("rbxassetid://") then
        resolvedImage = "rbxassetid://" .. resolvedImage
    end

    local pillIcon = o("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 32, 0, 32),
        BackgroundTransparency = 1,
        Image = resolvedImage,
        ImageColor3 = W,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = 201,
    }, pill)

    local pillBtn = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false,
        BorderSizePixel = 0, ZIndex = 202,
    }, pill)
    pillBtn.MouseEnter:Connect(function() tween(pillIcon, EASE_OUT(0.12), { ImageColor3 = ACCENT }) end)
    pillBtn.MouseLeave:Connect(function() tween(pillIcon, EASE_OUT(0.12), { ImageColor3 = W }) end)

    -- ── Press FX na pill ──────────────────────────────
    local pillScale = o("UIScale", { Scale = 1 }, pill)
    pillBtn.MouseButton1Down:Connect(function()
        tween(pillScale, EASE_OUT(0.08), { Scale = 0.9 })
    end)
    pillBtn.MouseButton1Up:Connect(function()
        tween(pillScale, EASE_OUT(0.12), { Scale = 1 })
    end)
    pillBtn.MouseLeave:Connect(function()
        tween(pillScale, EASE_OUT(0.12), { Scale = 1 })
    end)

    -- ── Frost burst na pill ───────────────────────────
    local function frostBurst()
        -- pill e ring têm o mesmo pai (btnGui) e o mesmo AnchorPoint (0.5, 0.5)
        -- → usar pill.Position diretamente sobrepõe perfeitamente
        local ring = o("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = pill.Position,
            Size = UDim2.new(0, PILL_SIZE, 0, PILL_SIZE),
            BackgroundTransparency = 1,
            ZIndex = 250,
        }, self.btnGui)
        corner(ring, "pill")
        local rStroke = stroke(ring, 2, ACCENT)
        tween(ring, EASE_OUT(0.45), {
            Size = UDim2.new(0, PILL_SIZE + 60, 0, PILL_SIZE + 60),
        })
        tween(rStroke, EASE_OUT(0.45), { Transparency = 1 })
        task.delay(0.45, function() ring:Destroy() end)
    end

    -- ── Transições abrir/fechar ───────────────────────
    local function showPill()
        pill.Visible = true
        pill.Size = UDim2.new(0, 0, 0, 0)
        tween(pill, EASE_BACK(0.35), { Size = UDim2.new(0, PILL_SIZE, 0, PILL_SIZE) })
    end
    local function hidePill()
        local t = tween(pill, EASE_OUT(0.18), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function() if pill.Size.X.Offset <= 1 then pill.Visible = false end end)
    end
    local function showMenu()
        self.menuFrame.Visible = true
        self.menuFrame.Size = UDim2.new(0, 0, 0, 0)
        tween(self.menuFrame, EASE_BACK(0.4), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
    end
    local function hideMenu()
        local t = tween(self.menuFrame, EASE_OUT(0.2), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function() if self.menuFrame.Size.X.Offset <= 1 then self.menuFrame.Visible = false end end)
    end

    xBtn.MouseButton1Click:Connect(function()
        playClick()
        hideMenu()
        showPill()
    end)

    -- ── Drag da pill ──────────────────────────────────
    do
        local dragging, dragMoved, dragStart, startPos, _activeTouchId =
            false, false, nil, nil, nil
        table.insert(self._connections, pillBtn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = pill.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = pill.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                if d.Magnitude > 4 then dragMoved = true end
                pill.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if not dragging then return end
                dragging = false
                if not dragMoved then
                    playClick()
                    frostBurst()
                    hidePill()
                    showMenu()
                end
                dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                local wasMoved = dragMoved
                dragging = false; dragMoved = false
                _activeTouchId = nil; dragStart = nil; startPos = nil
                if not wasMoved then
                    playClick()
                    frostBurst()
                    hidePill()
                    showMenu()
                end
            end
        end))
    end

    return self
end

-- ════════════════════════════════════════════════════
function KronUI:Destroy()
    for _, conn in ipairs(self._connections) do conn:Disconnect() end
    self._connections = {}
    if self._breatheTween then self._breatheTween:Cancel() end
    if self._shimmerTween then self._shimmerTween:Cancel() end
    if self.gui    then self.gui:Destroy()    end
    if self.btnGui then self.btnGui:Destroy() end
end

function KronUI:_nextOrder()
    self._layoutOrder = self._layoutOrder + 1
    return self._layoutOrder
end

-- ── Seção / Divisor ──────────────────────────────────
function KronUI:AddSectionLabel(text)
    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    o("Frame", {
        Size = UDim2.new(0, 3, 0, 12),
        Position = UDim2.new(0, 2, 0.5, -6),
        BackgroundColor3 = ACCENT, BorderSizePixel = 0,
    }, holder)
    o("TextLabel", {
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = string.upper(text or ""),
        Font = FONTB, TextSize = 10,
        TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)
end

function KronUI:AddDivider()
    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 12),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    local line = o("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0,
    }, holder)
    o("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.5, 0.3),
            NumberSequenceKeypoint.new(1, 1),
        }),
    }, line)
end

-- ── Toggle ────────────────────────────────────────────
function KronUI:AddToggle(text, default, callback)
    local state = default or false

    local btn = o("TextButton", {
        Size = UDim2.new(1, -4, 0, 32),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, AutoButtonColor = false, Text = "",
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    local btnStroke = stroke(btn, 1, LINE)
    corner(btn, 8)

    local label = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -54, 1, 0),
        Font = FONT, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = text,
    }, btn)

    local trackW, trackH = 30, 14
    local track = o("Frame", {
        Size = UDim2.new(0, trackW, 0, trackH),
        Position = UDim2.new(1, -(trackW + 10), 0.5, -trackH / 2),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, btn)
    corner(track, "pill")
    local trackStroke = stroke(track, 1, LINE)

    local knob = o("Frame", {
        Size = UDim2.new(0, 10, 0, 10),
        Position = UDim2.new(0, 2, 0.5, -5),
        BackgroundColor3 = DIM, BorderSizePixel = 0,
    }, track)
    corner(knob, "pill")

    local function refresh(animate)
        local ti = EASE_OUT(animate and 0.16 or 0)
        if state then
            tween(knob, ti, { Position = UDim2.new(1, -12, 0.5, -5), BackgroundColor3 = W })
            tween(track, ti, { BackgroundColor3 = ACCENT2 })
            tween(trackStroke, ti, { Color = ACCENT })
            tween(btnStroke, ti, { Color = ACCENT2, Transparency = 0.4 })
            label.TextColor3 = W
        else
            tween(knob, ti, { Position = UDim2.new(0, 2, 0.5, -5), BackgroundColor3 = DIM })
            tween(track, ti, { BackgroundColor3 = PANEL })
            tween(trackStroke, ti, { Color = LINE })
            tween(btnStroke, ti, { Color = LINE, Transparency = 0 })
            label.TextColor3 = DIM
        end
    end
    refresh(false)

    btn.MouseEnter:Connect(function() if not state then btn.BackgroundColor3 = HOVER end end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = CARD end)

    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        self._playClick()
        state = not state
        refresh(true)
        if callback then task.spawn(callback, state) end
    end))

    return {
        SetState = function(v) state = v refresh(true) end,
        GetState = function() return state end,
    }
end

-- ── Botão (ripple) ────────────────────────────────────
function KronUI:AddButton(text, callback)
    local btn = o("TextButton", {
        Size = UDim2.new(1, -4, 0, 32),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, AutoButtonColor = false, ClipsDescendants = true,
        Font = FONT, TextSize = 12,
        Text = text, TextColor3 = MID,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    local btnStroke = stroke(btn, 1, LINE)
    corner(btn, 8)

    local function ripple(x, y)
        local r = o("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, x, 0, y),
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = ACCENT,
            BackgroundTransparency = 0.55,
            BorderSizePixel = 0, ZIndex = 5,
        }, btn)
        corner(r, "pill")
        local maxD = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 1.6
        local t = tween(r, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = UDim2.new(0, maxD, 0, maxD), BackgroundTransparency = 1 })
        t.Completed:Connect(function() r:Destroy() end)
    end

    btn.MouseEnter:Connect(function()
        tween(btn, EASE_OUT(0.12), { BackgroundColor3 = HOVER })
        tween(btnStroke, EASE_OUT(0.12), { Color = ACCENT })
        btn.TextColor3 = W
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, EASE_OUT(0.12), { BackgroundColor3 = CARD })
        tween(btnStroke, EASE_OUT(0.12), { Color = LINE })
        btn.TextColor3 = MID
    end)

    table.insert(self._connections, btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            local x = inp.Position.X - btn.AbsolutePosition.X
            local y = inp.Position.Y - btn.AbsolutePosition.Y
            ripple(x, y)
        end
    end))
    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        self._playClick()
        if callback then task.spawn(callback) end
    end))
    return btn
end

-- ── Slider ────────────────────────────────────────────
function KronUI:AddSlider(text, min, max, default, callback)
    local value       = math.clamp(default or min, min, max)
    local dragging    = false
    local activeTouch = nil

    local holder = o("Frame", {
        Size = UDim2.new(1, -4, 0, 50),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    stroke(holder, 1, LINE)
    corner(holder, 8)

    local label = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 2),
        Size = UDim2.new(1, -16, 0, 26),
        Font = FONT, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = MID,
    }, holder)

    local track = o("Frame", {
        Size = UDim2.new(1, -24, 0, 4),
        Position = UDim2.new(0, 12, 0, 36),
        BackgroundColor3 = LINE,
        BorderSizePixel = 0,
    }, holder)
    corner(track, "pill")

    local fill = o("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = ACCENT, BorderSizePixel = 0,
    }, track)
    corner(fill, "pill")
    o("UIGradient", { Color = ColorSequence.new(ACCENT2, ACCENT) }, fill)

    local knob = o("Frame", {
        Size = UDim2.new(0, 11, 0, 11),
        AnchorPoint = Vector2.new(.5, .5),
        Position = UDim2.new(0, 0, .5, 0),
        BackgroundColor3 = W, BorderSizePixel = 0,
    }, track)
    corner(knob, "pill")
    stroke(knob, 1.5, ACCENT)

    local bubble = o("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 1),
        Size = UDim2.new(0, 30, 0, 18),
        BackgroundColor3 = ACCENT,
        Text = "", TextColor3 = W, Font = FONTB, TextSize = 10,
        Visible = false, ZIndex = 6,
    }, track)
    corner(bubble, 5)

    local function redraw()
        local rel = (value - min) / (max - min)
        fill.Size       = UDim2.new(rel, 0, 1, 0)
        knob.Position   = UDim2.new(rel, 0, .5, 0)
        label.Text      = text .. "   " .. tostring(math.floor(value))
        bubble.Position = UDim2.new(rel, 0, 0, -8)
        bubble.Text     = tostring(math.floor(value))
    end

    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel)
        redraw()
        if callback then task.spawn(callback, value) end
    end

    redraw()

    table.insert(self._connections, track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; bubble.Visible = true; update(inp.Position.X)
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if activeTouch ~= nil then return end
            activeTouch = inp; dragging = true; bubble.Visible = true; update(inp.Position.X)
        end
    end))
    table.insert(self._connections, knob.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; bubble.Visible = true
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if activeTouch ~= nil then return end
            activeTouch = inp; dragging = true; bubble.Visible = true
        end
    end))
    table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement then
            update(inp.Position.X)
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if inp ~= activeTouch then return end
            update(inp.Position.X)
        end
    end))
    table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if activeTouch then return end
            dragging = false; bubble.Visible = false
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if inp ~= activeTouch then return end
            dragging = false; activeTouch = nil; bubble.Visible = false
        end
    end))

    return {
        GetValue = function() return value end,
        SetValue = function(v) value = math.clamp(v, min, max) redraw() end,
    }
end

-- ── Dropdown ──────────────────────────────────────────
function KronUI:AddDropdown(text, options, defaults, callback)
    options = options or {}
    local selected = {}
    if defaults then
        for _, v in ipairs(defaults) do selected[v] = true end
    end
    local open = false

    local holder = o("Frame", {
        Size = UDim2.new(1, -4, 0, 32),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, ClipsDescendants = true,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    stroke(holder, 1, LINE)
    corner(holder, 8)

    local head = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        AutoButtonColor = false, Text = "",
    }, holder)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -54, 1, 0),
        Font = FONT, TextSize = 12, TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = text,
    }, head)

    local countBadge = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -54, 0, 0),
        Size = UDim2.new(0, 24, 1, 0),
        Font = FONTB, TextSize = 11, TextColor3 = ACCENT,
        TextXAlignment = Enum.TextXAlignment.Right,
        Text = "",
    }, head)

    local arrow = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -26, 0, 0),
        Size = UDim2.new(0, 20, 1, 0),
        Font = FONTB, TextSize = 11, TextColor3 = DIM,
        TextXAlignment = Enum.TextXAlignment.Center,
        Text = "▼", Rotation = 0,
    }, head)

    local LIST_MAX_H = 132
    local listWrap = o("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 32),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, holder)

    local list = o("ScrollingFrame", {
        Size = UDim2.new(1, -8, 1, -6),
        Position = UDim2.new(0, 4, 0, 2),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = ACCENT,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
    }, listWrap)
    o("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, list)

    local ROW_H = 26
    local function updateBadge()
        local n = 0
        for _ in pairs(selected) do n = n + 1 end
        countBadge.Text = n > 0 and tostring(n) or ""
    end

    local rows = {}
    for i, opt in ipairs(options) do
        local row = o("TextButton", {
            Size = UDim2.new(1, 0, 0, ROW_H),
            BackgroundColor3 = PANEL,
            BorderSizePixel = 0, AutoButtonColor = false, Text = "",
            LayoutOrder = i,
        }, list)
        corner(row, 6)
        local rowStroke = stroke(row, 1, LINE)

        local box = o("Frame", {
            Size = UDim2.new(0, 13, 0, 13),
            Position = UDim2.new(0, 8, 0.5, -6.5),
            BackgroundColor3 = PANEL, BorderSizePixel = 0,
        }, row)
        corner(box, 4)
        local boxStroke = stroke(box, 1, LINE)
        local check = o("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "✓", Font = FONTB, TextSize = 10,
            TextColor3 = W, TextTransparency = 1,
        }, box)

        local optLabel = o("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 28, 0, 0),
            Size = UDim2.new(1, -34, 1, 0),
            Font = FONT, TextSize = 11, TextColor3 = MID,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = tostring(opt),
        }, row)

        local function refreshRow(animate)
            local ti = EASE_OUT(animate and 0.14 or 0)
            if selected[opt] then
                tween(box, ti, { BackgroundColor3 = ACCENT2 })
                tween(boxStroke, ti, { Color = ACCENT })
                tween(check, ti, { TextTransparency = 0 })
                tween(rowStroke, ti, { Color = ACCENT2, Transparency = 0.4 })
                optLabel.TextColor3 = W
            else
                tween(box, ti, { BackgroundColor3 = PANEL })
                tween(boxStroke, ti, { Color = LINE })
                tween(check, ti, { TextTransparency = 1 })
                tween(rowStroke, ti, { Color = LINE, Transparency = 0 })
                optLabel.TextColor3 = MID
            end
        end
        refreshRow(false)

        row.MouseEnter:Connect(function() if not selected[opt] then row.BackgroundColor3 = HOVER end end)
        row.MouseLeave:Connect(function() row.BackgroundColor3 = PANEL end)

        table.insert(self._connections, row.MouseButton1Click:Connect(function()
            self._playClick()
            selected[opt] = not selected[opt] or nil
            refreshRow(true)
            updateBadge()
            if callback then
                local out = {}
                for k in pairs(selected) do table.insert(out, k) end
                task.spawn(callback, out)
            end
        end))

        rows[opt] = { refresh = refreshRow }
    end
    updateBadge()

    local listH = math.min(#options * (ROW_H + 4) + 4, LIST_MAX_H)

    local function setOpen(v)
        open = v
        local ti = EASE_OUT(0.2)
        tween(listWrap, ti, { Size = UDim2.new(1, 0, 0, open and listH or 0) })
        tween(arrow, ti, { Rotation = open and 180 or 0 })
    end

    head.MouseEnter:Connect(function() if not open then holder.BackgroundColor3 = HOVER end end)
    head.MouseLeave:Connect(function() if not open then holder.BackgroundColor3 = CARD end end)

    table.insert(self._connections, head.MouseButton1Click:Connect(function()
        self._playClick()
        setOpen(not open)
    end))

    return {
        GetSelected = function()
            local out = {}
            for k in pairs(selected) do table.insert(out, k) end
            return out
        end,
        SetSelected = function(list2)
            selected = {}
            for _, v in ipairs(list2) do selected[v] = true end
            for _, r in pairs(rows) do r.refresh(true) end
            updateBadge()
        end,
        Close = function() setOpen(false) end,
    }
end

return KronUI
