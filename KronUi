function Builders.Toggle(self, parent, text, default, callback, desc)
    local state = default or false
    local card = newCard(parent, "TextButton", self:_nextOrder(), 36)
    card.AutomaticSize = Enum.AutomaticSize.Y

    local body = o("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    }, card)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 62),
        PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 9),
    }, body)
    o("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, body)

    local label = o("TextLabel", {
        Size = UDim2.new(1, 0, 0, 18), AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1, Text = text, Font = FONTM, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, LayoutOrder = 1,
    }, body)
    if desc then
        o("TextLabel", {
            Size = UDim2.new(1, 0, 0, 14), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, Text = desc, Font = FONT, TextSize = 11,
            TextColor3 = DIM, TextXAlignment = Enum.TextXAlignment.Left,
            TextWrapped = true, LayoutOrder = 2,
        }, body)
    end

    local track = o("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 38, 0, 20), BorderSizePixel = 0,
    }, card)
    corner(track, "pill")
    local knob = o("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.new(0, 14, 0, 14),
        BorderSizePixel = 0,
    }, track)
    corner(knob, "pill")

    local function refresh(animate)
        local pos = state and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
        if animate then tween(knob, FAST(0.1), { Position = pos }) else knob.Position = pos end
        knob.BackgroundColor3  = state and W or MID
        track.BackgroundColor3 = state and ACCENT or OFF
        label.TextColor3       = state and W or MID
    end
    refresh(false)

    hover(card,
        function() card.BackgroundColor3 = HOVER end,
        function() card.BackgroundColor3 = CARD end)

    table.insert(self._connections, card.MouseButton1Click:Connect(function()
        state = not state
        refresh(true)
        if callback then task.spawn(callback, state) end
    end))

    return {
        SetState = function(v) state = v refresh(true) end,
        GetState = function() return state end,
    }
end

function Builders.Button(self, parent, text, callback)
    local btn = newCard(parent, "TextButton", self:_nextOrder(), 34)
    btn.Font, btn.TextSize, btn.Text, btn.TextColor3 = FONTM, 13, text, MID
    local s = stroke(btn, 1, LINE, 0.5, true)

    hover(btn,
        function() btn.BackgroundColor3 = HOVER; s.Color = ACCENT; btn.TextColor3 = W end,
        function() btn.BackgroundColor3 = CARD;  s.Color = LINE;   btn.TextColor3 = MID end)

    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        if callback then task.spawn(callback) end
    end))
    return btn
end

function Builders.Slider(self, parent, text, min, max, default, callback)
    local value = math.clamp(default or min, min, max)
    local card = newCard(parent, "Frame", self:_nextOrder(), 52)

    o("TextLabel", {
        Position = UDim2.new(0, 12, 0, 6), Size = UDim2.new(1, -70, 0, 20),
        BackgroundTransparency = 1, Text = text, Font = FONTM, TextSize = 13,
        TextColor3 = MID, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, card)
    local valLbl = o("TextLabel", {
        Position = UDim2.new(1, -58, 0, 6), Size = UDim2.new(0, 46, 0, 20),
        BackgroundTransparency = 1, Font = FONTM, TextSize = 13, TextColor3 = W,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, card)

    local track = o("Frame", {
        Position = UDim2.new(0, 12, 0, 36), Size = UDim2.new(1, -24, 0, 4),
        BackgroundColor3 = OFF, BorderSizePixel = 0,
    }, card)
    corner(track, "pill")
    local fill = o("Frame", { BackgroundColor3 = ACCENT, BorderSizePixel = 0 }, track)
    corner(fill, "pill")
    local knob = o("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 12, 0, 12),
        BackgroundColor3 = W, BorderSizePixel = 0,
    }, track)
    corner(knob, "pill")

    local function redraw()
        local rel = (value - min) / (max - min)
        fill.Size     = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        valLbl.Text   = tostring(value)
    end
    redraw()

    local grabber = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 26), Position = UDim2.new(0, 0, 0.5, -13),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    }, track)

    bindDrag(self._connections, grabber, {
        onMove = function(input)
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local nv = math.floor(min + (max - min) * rel + 0.5)
            if nv == value then return end
            value = nv
            redraw()
            if callback then task.spawn(callback, value) end
        end,
    })

    return {
        GetValue = function() return value end,
        SetValue = function(v) value = math.clamp(v, min, max) redraw() end,
    }
end

local function buildDropdown(self, parent, text, options, default, callback, multi)
    options = options or {}
    local selected
    local selectedSet = {}
    local open, rows, listH = false, {}, 0
    local LIST_MAX_H, ROW_H = 132, 28
    local EMPTY_H = 44 -- NOVO: altura da área quando não há itens

    if multi then
        for _, d in ipairs(default or {}) do
            if table.find(options, d) then selectedSet[d] = true end
        end
    elseif default and table.find(options, default) then
        selected = default
    end

    local function isSel(opt)
        if multi then return selectedSet[opt] == true end
        return selected == opt
    end

    local function getValue()
        if not multi then return selected end
        local sel = {}
        for opt in pairs(selectedSet) do table.insert(sel, opt) end
        table.sort(sel)
        return sel
    end

    local holder = newCard(parent, "Frame", self:_nextOrder(), 36)
    holder.AutomaticSize = Enum.AutomaticSize.Y
    holder.ClipsDescendants = true

    local head = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1,
        AutoButtonColor = false, Text = "",
    }, holder)
    o("TextLabel", {
        Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -120, 1, 0),
        BackgroundTransparency = 1, Text = text, Font = FONTM, TextSize = 13,
        TextColor3 = MID, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, head)
    local selLabel = o("TextLabel", {
        Position = UDim2.new(1, -108, 0, 0), Size = UDim2.new(0, 80, 1, 0),
        BackgroundTransparency = 1, Font = FONT, TextSize = 12, TextColor3 = W,
        TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
    }, head)
    local arrow = o("TextLabel", {
        Position = UDim2.new(1, -26, 0, 0), Size = UDim2.new(0, 20, 1, 0),
        BackgroundTransparency = 1, Font = FONTM, TextSize = 12, TextColor3 = DIM, Text = "▼",
    }, head)

    local listWrap = o("Frame", {
        Position = UDim2.new(0, 0, 0, 36), Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1, ClipsDescendants = true,
    }, holder)
    local list = o("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageColor3 = LINE,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(1, 0, 0, 0),
    }, listWrap)
    o("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, list)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
        PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 6),
    }, list)

    local function updateText()
        if not multi then selLabel.Text = selected or "" return end
        local sel = getValue()
        selLabel.Text = (#sel == 0 and "") or (#sel == 1 and sel[1]) or (#sel .. " sel.")
    end

    local function refreshRow(opt)
        local d = rows[opt]; if not d then return end
        local on = isSel(opt)
        d.box.BackgroundColor3 = on and ACCENT or DARK
        d.boxStroke.Color      = on and ACCENT or LINE
        d.check.TextTransparency = on and 0 or 1
        d.label.TextColor3     = on and W or MID
    end
    local function refreshAll() for opt in pairs(rows) do refreshRow(opt) end end

    local function setOpen(v)
        open = v
        tween(listWrap, FAST(0.12), { Size = UDim2.new(1, 0, 0, open and listH or 0) })
        tween(arrow, FAST(0.12), { Rotation = open and 180 or 0 })
    end

    local function buildRows(optList)
        -- NOVO: também remove o label "no items" de uma construção anterior
        for _, ch in ipairs(list:GetChildren()) do
            if ch:IsA("TextButton") or ch.Name == "EmptyLabel" then ch:Destroy() end
        end
        rows = {}
        for opt in pairs(selectedSet) do
            if not table.find(optList, opt) then selectedSet[opt] = nil end
        end

        -- NOVO: estado vazio
        if #optList == 0 then
            o("TextLabel", {
                Name = "EmptyLabel",
                Size = UDim2.new(1, 0, 0, EMPTY_H - 10),
                BackgroundTransparency = 1,
                Text = "no items",
                Font = FONT, TextSize = 13, TextColor3 = DIM,
                TextXAlignment = Enum.TextXAlignment.Center,
                TextYAlignment = Enum.TextYAlignment.Center,
                LayoutOrder = 1,
            }, list)
            updateText()
            return EMPTY_H
        end

        for i, opt in ipairs(optList) do
            local row = o("TextButton", {
                Size = UDim2.new(1, 0, 0, ROW_H), BackgroundColor3 = DARK,
                BackgroundTransparency = 0.5, BorderSizePixel = 0,
                AutoButtonColor = false, Text = "", LayoutOrder = i,
            }, list)
            corner(row, ROW_R)

            local box = o("Frame", {
                Position = UDim2.new(0, 8, 0.5, -7), Size = UDim2.new(0, 14, 0, 14),
                BackgroundColor3 = DARK, BorderSizePixel = 0,
            }, row)
            corner(box, 3)
            local boxStroke = stroke(box, 1, LINE)
            local check = o("TextLabel", {
                Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "✓",
                Font = FONTM, TextSize = 10, TextColor3 = DARK, TextTransparency = 1,
            }, box)
            local lbl = o("TextLabel", {
                Position = UDim2.new(0, 30, 0, 0), Size = UDim2.new(1, -36, 1, 0),
                BackgroundTransparency = 1, Font = FONT, TextSize = 12, TextColor3 = MID,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(opt),
            }, row)

            rows[opt] = { box = box, boxStroke = boxStroke, check = check, label = lbl }

            hover(row,
                function() row.BackgroundTransparency = 0.2 end,
                function() row.BackgroundTransparency = 0.5 end)

            row.MouseButton1Click:Connect(function()
                if multi then
                    selectedSet[opt] = (not selectedSet[opt]) or nil
                    refreshRow(opt)
                else
                    selected = (selected ~= opt) and opt or nil
                    refreshAll()
                    setOpen(false)
                end
                updateText()
                if callback then task.spawn(callback, getValue()) end
            end)
        end

        refreshAll()
        updateText()
        return math.min(#optList * (ROW_H + 4) + 8, LIST_MAX_H)
    end

    hover(head,
        function() if not open then holder.BackgroundColor3 = HOVER end end,
        function() holder.BackgroundColor3 = CARD end)
    table.insert(self._connections, head.MouseButton1Click:Connect(function()
        setOpen(not open)
    end))

    listH = buildRows(options)

    local api = { Frame = holder, Close = function() setOpen(false) end }
    if multi then
        api.GetSelected = getValue
        api.SetSelected = function(newSel)
            selectedSet = {}
            for _, opt in ipairs(newSel or {}) do
                if rows[opt] then selectedSet[opt] = true end
            end
            refreshAll()
            updateText()
        end
        api.UpdateOptions = function(newOptions)
            if open then setOpen(false) end
            options = newOptions or {}
            listH = buildRows(options)
        end
    else
        api.GetSelected = function() return selected end
        api.SetSelected = function(opt)
            selected = (opt and table.find(options, opt)) and opt or nil
            refreshAll()
            updateText()
        end
    end
    return api
end

function Builders.Dropdown(self, parent, text, options, default, callback)
    return buildDropdown(self, parent, text, options, default, callback, false)
end

function Builders.MultiDropdown(self, parent, text, options, defaults, callback)
    return buildDropdown(self, parent, text, options, defaults, callback, true)
end

for kind in pairs(Builders) do
    if kind ~= "SectionLabel" then
        KronUI["Add" .. kind] = function(self, ...)
            local tab = self:_EnsureWriteTab()
            return tab["Add" .. kind](tab, ...)
        end
    end
end

function KronUI:AddSectionLabel(text, icon)
    return self:_OpenTab(toTabLabel(text), icon)
end

return KronUI
