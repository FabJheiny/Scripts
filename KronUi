local function pickFont(name, fallback)
    local ok, f = pcall(function() return Enum.Font[name] end)
    return ok and f or fallback
end
local FONT  = pickFont("BuilderSans", Enum.Font.Gotham)
local FONTM = pickFont("BuilderSansMedium", Enum.Font.GothamMedium)

local MENU_W, MENU_H = 440, 270
local MIN_W,  MIN_H  = 340, 200
local MAX_W,  MAX_H  = 720, 520
local TOPBAR_H       = 44
local MARGIN         = 8
local CORNER_R       = 10
local CARD_R         = 6
local ROW_R          = 4
local TABBAR_W       = 120
local PILL_W, PILL_H = 150, 42
local GRIP_HIT_SIZE  = 26
local TAB_ICON_SIZE  = 32
local TAB_BTN_H      = 44

local function FAST(d) return TweenInfo.new(d or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) end

local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if (cls == "TextLabel" or cls == "TextButton" or cls == "TextBox")
        and x.AutoLocalize ~= false then
        x.AutoLocalize = false
    end
    if par then x.Parent = par end
    return x
end

local function stroke(par, t, c, transp, inner)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1, Transparency = transp or 0,
        ApplyStrokeMode = inner and Enum.ApplyStrokeMode.Contextual or Enum.ApplyStrokeMode.Border,
    }, par)
end

local function corner(par, r)
    return o("UICorner", { CornerRadius = (r == "pill") and UDim.new(1, 0) or UDim.new(0, r or CARD_R) }, par)
end

local activeTweens = setmetatable({}, { __mode = "k" })
local function tween(obj, info, props)
    local prev = activeTweens[obj]
    if prev then pcall(function() prev:Cancel() end) end
    local t = TweenService:Create(obj, info, props)
    activeTweens[obj] = t
    t:Play()
    t.Completed:Connect(function()
        if activeTweens[obj] == t then activeTweens[obj] = nil end
    end)
    return t
end

local function hover(obj, on, off)
    obj.MouseEnter:Connect(on)
    obj.MouseLeave:Connect(off)
end

local function asset(id)
    if not id then return nil end
    id = tostring(id)
    if id:find("rbxassetid://") or id:find("http") then return id end
    return "rbxassetid://" .. id
end

local function moveUDim2(obj)
    return function(_, state, delta)
        obj.Position = UDim2.new(
            state.X.Scale, state.X.Offset + delta.X,
            state.Y.Scale, state.Y.Offset + delta.Y)
    end
end

local function bindDrag(connections, button, opts)
    local deadzone    = opts.deadzone or 4
    local dragging, moved = false, false
    local startPos, state, activeTouch

    local function begin(input)
        if dragging then return end
        dragging, moved, startPos = true, false, input.Position
        state = opts.onBegin and opts.onBegin(input) or nil
        if opts.onMove then opts.onMove(input, state, Vector2.new(0, 0)) end
    end

    local function move(input)
        if not dragging then return end
        local delta = input.Position - startPos
        if delta.Magnitude > deadzone then moved = true end
        if opts.onMove then opts.onMove(input, state, delta) end
    end

    local function finish()
        if not dragging then return end
        dragging = false
        if opts.onEnd then opts.onEnd(state, moved) end
        startPos, state = nil, nil
    end

    table.insert(connections, button.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            begin(inp)
        elseif inp.UserInputType == Enum.UserInputType.Touch and not activeTouch then
            activeTouch = inp
            begin(inp)
        end
    end))
    table.insert(connections, UserInputService.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement
            or (inp.UserInputType == Enum.UserInputType.Touch and inp == activeTouch) then
            move(inp)
        end
    end))
    table.insert(connections, UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if not activeTouch then finish() end
        elseif inp.UserInputType == Enum.UserInputType.Touch and inp == activeTouch then
            activeTouch = nil
            finish()
        end
    end))
end

local function newCard(parent, class, order, height)
    local c = o(class, {
        Size = UDim2.new(1, 0, 0, height),
        BackgroundColor3 = CARD, BackgroundTransparency = CARD_T,
        BorderSizePixel = 0, LayoutOrder = order,
    }, parent)
    if class == "TextButton" then
        c.AutoButtonColor = false
        c.Text = ""
    end
    corner(c, CARD_R)
    return c
end

function KronUI.new(title, pillImage, opts)
    opts = opts or {}
    local self = setmetatable({}, KronUI)
    self._tabs        = {}
    self._activeTabId = nil
    self._connections = {}
    self._layoutOrder = 0
    self._settingsActive = false
    self._prevTabId   = nil
    self._destroyed   = false
    self._onClose     = opts.OnClose
    self._confirmClose= opts.ConfirmClose or false

    local player = Players.LocalPlayer
    local pg     = player:WaitForChild("PlayerGui", 10) or player.PlayerGui

    local old    = pg:FindFirstChild("KronUI_Lib")
    local oldBtn = CoreGui:FindFirstChild("KronUI_FloatBtn") or pg:FindFirstChild("KronUI_FloatBtn")
    if old    then old:Destroy()    end
    if oldBtn then oldBtn:Destroy() end

    self.gui = o("ScreenGui", {
        Name = "KronUI_Lib", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Global, DisplayOrder = 10,
        AutoLocalize = false,
    }, pg)

    self.menuFrame = o("Frame", {
        Name = "MenuFrame",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = BG, BackgroundTransparency = MENU_T,
        BorderSizePixel = 0, Active = true,
        ClipsDescendants = true,
    }, self.gui)
    corner(self.menuFrame, CORNER_R)
    stroke(self.menuFrame, 1, LINE, 0.45)
    o("UIScale", { Scale = UI_SCALE }, self.menuFrame)

    self._targetSize = Vector2.new(MENU_W, MENU_H)
    task.defer(function()
        if self._destroyed then return end
        tween(self.menuFrame, FAST(0.16), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
    end)

    local toggleMenu

    local topBar = o("Frame", {
        Name = "TopBar", Size = UDim2.new(1, 0, 0, TOPBAR_H),
        BackgroundTransparency = 1, Active = true, ZIndex = 10,
    }, self.menuFrame)

    local LEFT_BTN_SIZE = 36
    local LEFT_IMG_SIZE = 28
    local leftBtn = o("Frame", {
    AnchorPoint = Vector2.new(0, 0.5),
    Position = UDim2.new(0, 12, 0.5, 0),
    Size = UDim2.new(0, LEFT_BTN_SIZE, 0, LEFT_BTN_SIZE),
    BackgroundTransparency = 1, ZIndex = 12,
}, topBar)
    local leftImg = o("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, LEFT_IMG_SIZE, 0, LEFT_IMG_SIZE),
        BackgroundTransparency = 1,
        Image = asset(opts.SettingsIcon or DEFAULT_SETTINGS_ICON),
        ImageColor3 = W, ScaleType = Enum.ScaleType.Fit, ZIndex = 13,
    }, leftBtn)

    local titleX = 12 + LEFT_BTN_SIZE + 6
    local hasSub = opts.Subtitle ~= nil
    o("TextLabel", {
        Position = UDim2.new(0, titleX, 0, hasSub and 6 or 0),
        Size = UDim2.new(1, -titleX - 100, 0, hasSub and 18 or TOPBAR_H),
        BackgroundTransparency = 1, Text = title or "Interface",
        Font = FONTM, TextSize = 14, TextColor3 = W,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 11,
    }, topBar)
    if hasSub then
        o("TextLabel", {
            Position = UDim2.new(0, titleX, 0, 23),
            Size = UDim2.new(1, -titleX - 100, 0, 14),
            BackgroundTransparency = 1, Text = opts.Subtitle,
            Font = FONT, TextSize = 11, TextColor3 = DIM,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 11,
        }, topBar)
    end

    local function topButton(glyph, icon, xOff, cb)
        local b = o("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, xOff, 0.5, 0),
            Size = UDim2.new(0, 40, 0, 40),
            BackgroundTransparency = 1,
            Text = icon and "" or glyph, Font = FONTM,
            TextSize = icon and 18 or 24,
            TextColor3 = DIM, AutoButtonColor = false, ZIndex = 12,
        }, topBar)
        local img
        if icon then
            img = o("ImageLabel", {
                AnchorPoint = Vector2.new(0.5, 0.5),
                Position = UDim2.new(0.5, 0, 0.5, 0),
                Size = UDim2.new(0, 20, 0, 20), BackgroundTransparency = 1,
                Image = asset(icon), ImageColor3 = DIM, ZIndex = 13,
            }, b)
        end
        hover(b,
            function() b.TextColor3 = W; if img then img.ImageColor3 = W end end,
            function() b.TextColor3 = DIM; if img then img.ImageColor3 = DIM end end)
        table.insert(self._connections, b.MouseButton1Click:Connect(function()
            cb()
        end))
        return b
    end

    topButton("×", opts.CloseIcon, -8, function()
        if self._confirmClose then
            self:_ConfirmClose()
        else
            self:Destroy()
        end
    end)
    topButton("–", opts.MinimizeIcon, -54, function() toggleMenu() end)

    bindDrag(self._connections, topBar, {
        onBegin = function() return self.menuFrame.Position end,
        onMove  = moveUDim2(self.menuFrame),
    })

    self.tabBar = o("Frame", {
        Name = "TabBar", Size = UDim2.new(0, TABBAR_W, 1, -TOPBAR_H - MARGIN),
        Position = UDim2.new(0, 0, 0, TOPBAR_H), BackgroundTransparency = 1,
    }, self.menuFrame)

    self.tabList = o("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 0, ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(1, 0, 0, 0),
    }, self.tabBar)
    o("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, self.tabList)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 4), PaddingTop = UDim.new(0, 2),
    }, self.tabList)

    self.contentFrame = o("Frame", {
        Name = "ContentFrame",
        Size = UDim2.new(1, -TABBAR_W - MARGIN, 1, -TOPBAR_H - MARGIN),
        Position = UDim2.new(0, TABBAR_W, 0, TOPBAR_H),
        BackgroundTransparency = 1, ClipsDescendants = true,
    }, self.menuFrame)

    self.pagesHolder = o("Frame", {
        Name = "PagesHolder", Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, ClipsDescendants = true,
    }, self.contentFrame)

    local gripHit = o("TextButton", {
        Name = "ResizeHit",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, 0, 1, 0),
        Size = UDim2.new(0, GRIP_HIT_SIZE, 0, GRIP_HIT_SIZE),
        BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, ZIndex = 60,
    }, self.menuFrame)

    bindDrag(self._connections, gripHit, {
        onBegin = function() return self._targetSize end,
        onMove  = function(_, size, delta)
            local w = math.clamp(size.X + delta.X / UI_SCALE, MIN_W, MAX_W)
            local h = math.clamp(size.Y + delta.Y / UI_SCALE, MIN_H, MAX_H)
            self._targetSize = Vector2.new(w, h)
            self.menuFrame.Size = UDim2.new(0, w, 0, h)
        end,
    })

    self.btnGui = o("ScreenGui", {
        Name = "KronUI_FloatBtn", ResetOnSpawn = false, IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Global, DisplayOrder = 9999,
        AutoLocalize = false,
    })
    if not pcall(function() self.btnGui.Parent = CoreGui end) then
        self.btnGui.Parent = pg
    end

    local function clampPillPos(pos)
        local vp = workspace.CurrentCamera.ViewportSize
        local halfW, halfH = PILL_W / 2, PILL_H / 2
        local cx = math.clamp(pos.X.Scale * vp.X + pos.X.Offset, halfW, vp.X - halfW)
        local cy = math.clamp(pos.Y.Scale * vp.Y + pos.Y.Offset, halfH, vp.Y - halfH)
        return UDim2.new(0, cx, 0, cy)
    end

    -- === PILL HORIZONTAL (HUD) ===
    local pill = o("Frame", {
        Name = "PillUI",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, PILL_W, 0, PILL_H),
        Position = clampPillPos(UDim2.new(0.5, 0, 1, -70)),
        BackgroundColor3 = BG,
        BackgroundTransparency = MENU_T,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 200,
        Visible = false,
    }, self.btnGui)
    corner(pill, "pill")
    stroke(pill, 1, LINE, 0.45)
    self._pill = pill

    local pillIcon = o("ImageLabel", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 12, 0.5, 0),
        Size = UDim2.new(0, 22, 0, 22),
        BackgroundTransparency = 1,
        Image = asset(pillImage or "78186286433275"),
        ImageColor3 = W,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = 201,
    }, pill)

    local pillLabel = o("TextLabel", {
        Position = UDim2.new(0, 44, 0, 0),
        Size = UDim2.new(1, -52, 1, 0),
        BackgroundTransparency = 1,
        Text = title or "PHANTOM",
        Font = FONTM,
        TextSize = 13,
        TextColor3 = W,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 201,
    }, pill)

    local pillBtn = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 202,
    }, pill)
    hover(pillBtn,
        function()
            pillIcon.ImageColor3  = ACCENT
            pillLabel.TextColor3  = ACCENT
        end,
        function()
            pillIcon.ImageColor3  = W
            pillLabel.TextColor3  = W
        end)

    toggleMenu = function()
        local m = self.menuFrame
        if m.Visible then
            local t = tween(m, FAST(0.12), { Size = UDim2.new(0, 0, 0, 0) })
            t.Completed:Connect(function()
                if m.Size.X.Offset <= 1 then
                    m.Visible = false
                    pill.Visible = true
                end
            end)
        else
            local vp, pos = workspace.CurrentCamera.ViewportSize, m.Position
            local cx = pos.X.Scale * vp.X + pos.X.Offset
            local cy = pos.Y.Scale * vp.Y + pos.Y.Offset
            if cx < 0 or cx > vp.X or cy < 0 or cy > vp.Y then
                m.Position = UDim2.new(0.5, 0, 0.5, 0)
            end
            pill.Visible = false
            m.Visible = true
            m.Size = UDim2.new(0, 0, 0, 0)
            tween(m, FAST(0.16), { Size = UDim2.new(0, self._targetSize.X, 0, self._targetSize.Y) })
        end
    end

    bindDrag(self._connections, pillBtn, {
        onBegin = function() return pill.Position end,
        onMove  = function(_, state, delta)
            pill.Position = clampPillPos(UDim2.new(
                state.X.Scale, state.X.Offset + delta.X,
                state.Y.Scale, state.Y.Offset + delta.Y))
        end,
        onEnd = function(_, moved)
            if not moved then toggleMenu() end
        end,
    })

    return self
end

function KronUI:_ConfirmClose()
    if self._confirmDialog then return end

    local overlay = o("TextButton", {
        Name = "ConfirmOverlay",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = DARK, BackgroundTransparency = 0.35,
        BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        ZIndex = 900,
    }, self.menuFrame)
    corner(overlay, CORNER_R)

    local card = o("TextButton", {
        Name = "ConfirmCard",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 260, 0, 106),
        BackgroundColor3 = BG, BackgroundTransparency = 0,
        BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        ZIndex = 901,
    }, overlay)
    corner(card, CORNER_R)
    stroke(card, 1, LINE, 0.35)

    o("TextLabel", {
        Position = UDim2.new(0, 0, 0, 20),
        Size = UDim2.new(1, 0, 0, 22),
        BackgroundTransparency = 1, Text = "UNLOAD",
        Font = FONTM, TextSize = 15, TextColor3 = W,
        ZIndex = 902,
    }, card)

    local row = o("Frame", {
        Position = UDim2.new(0, 16, 1, -48),
        Size = UDim2.new(1, -32, 0, 34),
        BackgroundTransparency = 1, ZIndex = 902,
    }, card)
    o("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, row)

    local function mkBtn(text, order, accent)
        local b = o("TextButton", {
            Size = UDim2.new(0.5, -4, 1, 0),
            BackgroundColor3 = accent and RED or CARD,
            BackgroundTransparency = accent and 0.15 or CARD_T,
            BorderSizePixel = 0, Text = text,
            Font = FONTM, TextSize = 12,
            TextColor3 = accent and W or MID,
            AutoButtonColor = false,
            LayoutOrder = order, ZIndex = 903,
        }, row)
        corner(b, CARD_R)
        if not accent then stroke(b, 1, LINE, 0.5, true) end
        return b
    end

    local cancelBtn  = mkBtn("CANCELAR", 1, false)
    local confirmBtn = mkBtn("UNLOAD",   2, true)

    local function closeDialog()
        overlay:Destroy()
        self._confirmDialog = nil
    end

    cancelBtn.MouseButton1Click:Connect(closeDialog)
    confirmBtn.MouseButton1Click:Connect(function()
        closeDialog()
        self:Destroy()
    end)

    self._confirmDialog = overlay
end

function KronUI:Destroy()
    if self._destroyed then return end
    self._destroyed = true

    if self._onClose then
        local ok, err = pcall(self._onClose)
        if not ok then warn("[KronUI] OnClose error: " .. tostring(err)) end
    end

    for _, c in ipairs(self._connections) do
        pcall(function() c:Disconnect() end)
    end
    self._connections = {}

    if self.gui    then self.gui:Destroy()    end
    if self.btnGui then self.btnGui:Destroy() end
end

function KronUI:_nextOrder()
    self._layoutOrder += 1
    return self._layoutOrder
end

function KronUI:_SelectTab(id)
    if self._settingsPage then self._settingsPage.Visible = false end
    self._settingsActive = false
    self._prevTabId = nil

    if self._activeTabId == id then return end
    self._activeTabId = id
    for _, t in ipairs(self._tabs) do
        local on = (t.id == id)
        t.page.Visible = on
        t.btn.BackgroundTransparency = on and CARD_T or 1
        t.label.TextColor3 = on and W or DIM
        if t.icon then t.icon.ImageColor3 = on and W or DIM end
    end
end

function KronUI:AddTab(name, icon)
    name = name or ("TAB " .. (#self._tabs + 1))
    self._nextTabId = (self._nextTabId or 0) + 1
    local id = self._nextTabId

    local btn = o("TextButton", {
        Size = UDim2.new(1, 0, 0, TAB_BTN_H), BackgroundColor3 = CARD, BackgroundTransparency = 1,
        BorderSizePixel = 0, AutoButtonColor = false, Text = "", LayoutOrder = id,
    }, self.tabList)
    corner(btn, CARD_R)

    local iconLbl
    if icon then
        iconLbl = o("ImageLabel", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0),
            Size = UDim2.new(0, TAB_ICON_SIZE, 0, TAB_ICON_SIZE), BackgroundTransparency = 1,
            Image = asset(icon), ImageColor3 = DIM, ScaleType = Enum.ScaleType.Fit,
        }, btn)
    end

    local label = o("TextLabel", {
        Position = UDim2.new(0, icon and 40 or 10, 0, 0),
        Size = UDim2.new(1, icon and -44 or -14, 1, 0),
        BackgroundTransparency = 1, Text = name, Font = FONTM, TextSize = 12,
        TextColor3 = DIM, TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, btn)

    hover(btn,
        function() if self._activeTabId ~= id then btn.BackgroundTransparency = 0.65 end end,
        function() if self._activeTabId ~= id then btn.BackgroundTransparency = 1 end end)

    local page = o("ScrollingFrame", {
        Size = UDim2.new(1, -4, 1, -4), Position = UDim2.new(0, 2, 0, 2),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageColor3 = LINE,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(1, 0, 0, 0),
        Visible = false,
    }, self.pagesHolder)
    o("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, page)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 6),
        PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 4),
    }, page)

    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        self:_SelectTab(id)
    end))

    local tabHandle = { Frame = page, Id = id, Name = name }
    for kind, build in pairs(self._Builders) do
        tabHandle["Add" .. kind] = function(_, ...) return build(self, page, ...) end
    end
    tabHandle.SetIcon = function(_, newIcon)
        if not iconLbl then
            iconLbl = o("ImageLabel", {
                AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0),
                Size = UDim2.new(0, TAB_ICON_SIZE, 0, TAB_ICON_SIZE), BackgroundTransparency = 1,
                ImageColor3 = (self._activeTabId == id) and W or DIM,
                ScaleType = Enum.ScaleType.Fit,
            }, btn)
            label.Position = UDim2.new(0, 40, 0, 0)
            label.Size = UDim2.new(1, -44, 1, 0)
        end
        iconLbl.Image = asset(newIcon)
        iconLbl.ImageColor3 = (self._activeTabId == id) and W or DIM
    end

    table.insert(self._tabs, {
        id = id, name = name, btn = btn, label = label, icon = iconLbl, page = page,
    })
    if not self._activeTabId then self:_SelectTab(id) end
    return tabHandle
end

local function toTabLabel(text)
    text = tostring(text or ""):gsub("[\128-\255]", "")
    text = text:gsub("^%W+", ""):gsub("%W+$", "")
    if text == "" then return "TAB" end
    return text:upper()
end

function KronUI:_OpenTab(label, icon)
    self._writeTab = self:AddTab(label, icon)
    return self._writeTab
end

function KronUI:_EnsureWriteTab()
    return self._writeTab or self:_OpenTab("GENERAL")
end

function KronUI:_EnsureSettingsPage()
    if self._settingsPage then return self._settingsPage end
    local page = o("ScrollingFrame", {
        Name = "SettingsPage",
        Size = UDim2.new(1, -4, 1, -4), Position = UDim2.new(0, 2, 0, 2),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageColor3 = LINE,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(1, 0, 0, 0),
        Visible = false,
    }, self.pagesHolder)
    o("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, page)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 6),
        PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 4),
    }, page)
    self._settingsPage = page
    self.Settings = { Frame = page, Id = -1, Name = "SETTINGS" }
    for kind, build in pairs(self._Builders) do
        self.Settings["Add" .. kind] = function(_, ...) return build(self, page, ...) end
    end
    return page
end

function KronUI:_ToggleSettings()
    local page = self:_EnsureSettingsPage()

    if self._settingsActive then
        page.Visible = false
        self._settingsActive = false
        if self._prevTabId then
            local prev = self._prevTabId
            self._prevTabId = nil
            self._activeTabId = nil
            self:_SelectTab(prev)
        end
        return
    end

    self._prevTabId = self._activeTabId
    self._activeTabId = nil
    self._settingsActive = true
    for _, t in ipairs(self._tabs) do
        t.page.Visible = false
        t.btn.BackgroundTransparency = 1
        t.label.TextColor3 = DIM
        if t.icon then t.icon.ImageColor3 = DIM end
    end
    page.Visible = true
end

function KronUI:OpenSettings()
    if not self._settingsActive then self:_ToggleSettings() end
end
function KronUI:CloseSettings()
    if self._settingsActive then self:_ToggleSettings() end
end

