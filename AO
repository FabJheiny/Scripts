local tabBtns,tabPages,cur={},{},nil
local function sw(idx)
    if cur==idx then return end
    if cur then tabBtns[cur].BackgroundColor3=B tabBtns[cur].TextColor3=DT end
    cur=idx
    tabBtns[idx].BackgroundColor3=D tabBtns[idx].TextColor3=W
    for j,p in ipairs(tabPages) do p.Visible=(j==idx) end
end

