local _mCb,_mTxt = nil,nil
local function closeModal()
    modal.Visible=false _mCb=nil _mTxt=nil
end
local function openModal(displayTxt,copyTxt,cb)
    _mCb=cb _mTxt=copyTxt
    mTitle.Text=displayTxt
    modal.Visible=true
end

modalBg.MouseButton1Click:Connect(closeModal)
