-- ── API pública ───────────────────────────────────────────────────────
function Hub:Tab(name)
    local i=#tabBtns+1
    local tb=o("TextButton",{
        Size=UDim2.new(1,0,0,28),
        BackgroundColor3=B,BorderSizePixel=0,
        Text=name,TextColor3=DT,TextSize=10,
        Font=Enum.Font.SourceSansBold,AutoButtonColor=false,
        LayoutOrder=i,TextWrapped=true,
    },tlist)
    o("Frame",{Size=UDim2.new(1,0,0,1),Position=UDim2.new(0,0,1,-1),BackgroundColor3=G,BorderSizePixel=0},tb)

    local pg=o("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=B,BorderSizePixel=0,Visible=false},area)

    local hotbar=o("Frame",{Size=UDim2.new(1,0,0,20),BackgroundColor3=B,BorderSizePixel=0},pg)

    local searchW=120
    local search=o("TextBox",{
        Size=UDim2.new(0,searchW,1,0),BackgroundColor3=B,BorderSizePixel=0,
        PlaceholderText="Search Script",PlaceholderColor3=Color3.fromRGB(90,90,90),
        Text="",TextColor3=W,TextSize=11,Font=Enum.Font.SourceSans,
        ClearTextOnFocus=false,TextXAlignment=Enum.TextXAlignment.Left,
    },hotbar)
    o("UIPadding",{PaddingLeft=UDim.new(0,6)},search)

    local countLbl=o("TextLabel",{
        Size=UDim2.new(1,-searchW-8,1,0),Position=UDim2.new(0,searchW+6,0,0),
        BackgroundTransparency=1,Text="Scripts: 0",TextColor3=DT,
        TextSize=10,Font=Enum.Font.SourceSans,TextXAlignment=Enum.TextXAlignment.Right,
    },hotbar)
    o("UIPadding",{PaddingRight=UDim.new(0,6)},countLbl)

    local GAP=6 local COLS=6 local ROWH=28
    local scroll=o("ScrollingFrame",{
        Size=UDim2.new(1,0,1,-20),Position=UDim2.new(0,0,0,20),
        BackgroundTransparency=1,BorderSizePixel=0,
        ScrollBarThickness=2,ScrollBarImageColor3=G,
        CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y,
    },pg)
    o("UIPadding",{
        PaddingTop=UDim.new(0,GAP),PaddingLeft=UDim.new(0,GAP),
        PaddingRight=UDim.new(0,GAP),PaddingBottom=UDim.new(0,GAP),
    },scroll)
    o("UIGridLayout",{
        CellSize=UDim2.new(1/COLS,-(GAP*(COLS-1))/COLS,0,ROWH),
        CellPadding=UDim2.new(0,GAP,0,GAP),
        SortOrder=Enum.SortOrder.LayoutOrder,
        HorizontalAlignment=Enum.HorizontalAlignment.Left,
    },scroll)

    tabBtns[i]=tb tabPages[i]=pg
    tb.MouseButton1Click:Connect(function() sw(i) end)

    local allBtns={}
    local function updateCount()
        local v=0 for _,b in ipairs(allBtns) do if b.Visible then v+=1 end end
        countLbl.Text="Scripts: "..v
    end
    search:GetPropertyChangedSignal("Text"):Connect(function()
        local q=search.Text:lower()
        for _,b in ipairs(allBtns) do
            b.Visible=(q=="" or b.Name:lower():find(q,1,true)~=nil)
        end
        updateCount()
    end)

    local T={}
    function T:Button(txt,url)
        local b=o("TextButton",{
            Name=txt,BackgroundColor3=D,BorderSizePixel=0,
            Text=txt,TextColor3=W,TextSize=10,Font=Enum.Font.SourceSans,
            AutoButtonColor=false,TextWrapped=true,LineHeight=1.1,
        },scroll)
        stroke(b,1)
        b.MouseEnter:Connect(function() b.BackgroundColor3=Color3.fromRGB(25,25,25) end)
        b.MouseLeave:Connect(function() b.BackgroundColor3=D end)
        local copyTxt='loadstring(game:HttpGet("'..url..'"))()'
        b.MouseButton1Click:Connect(function()
            openModal(txt,copyTxt,function() loadstring(game:HttpGet(url))() end)
        end)
        table.insert(allBtns,b)
        countLbl.Text="Scripts: "..#allBtns
        return self
    end
    return T
end

