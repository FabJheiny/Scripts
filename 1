    }, holder)
    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -60, 1, 0),
        Font = FONT, TextSize = 12, TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = text or "",
    }, labelRow)
    local pctLabel = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -52, 0, 0),
        Size = UDim2.new(0, 46, 1, 0),
        Font = FONTB, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = color,
        Text = string.format("%.0f%%", (value/max)*100),
    }, labelRow)

    local track = o("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 0, 30),
        BackgroundColor3 = LINE,
        BorderSizePixel = 0,
    }, holder)
    corner(track, "pill")

    local fill = o("Frame", {
        Size = UDim2.new(value/max, 0, 1, 0),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
    }, track)
    corner(fill, "pill")
    local fillGrad = o("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   lerpColor(color, Color3.fromRGB(0,0,0), 0.3)),
            ColorSequenceKeypoint.new(1,   lerpColor(color, W, 0.15)),
        }),
    }, fill)

    local fillShimmer = o("Frame", {
        Size = UDim2.new(0, 20, 1, 0),
        Position = UDim2.new(-0.2, 0, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = false,
        ZIndex = 2,
    }, fill)
    o("UIGradient", {
        Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255,255,255)) }),
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 1) }),
        Rotation = 15,
    }, fillShimmer)
    local shimmerT2 = TweenService:Create(fillShimmer,
        TweenInfo.new(1.8, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false),
        { Position = UDim2.new(1.2, 0, 0, 0) })
    shimmerT2:Play()

    return {
        SetValue = function(v, animated)
            v = math.clamp(v, 0, max)
            value = v
            local rel = v / max
            pctLabel.Text = string.format("%.0f%%", rel * 100)
            if animated ~= false then
                tween(fill, EASE_SINE(0.3), { Size = UDim2.new(rel, 0, 1, 0) })
            else
                fill.Size = UDim2.new(rel, 0, 1, 0)
            end
        end,
        GetValue  = function() return value end,
        SetColor  = function(c)
            color = c
            fill.BackgroundColor3  = c
            pctLabel.TextColor3    = c
        end,
    }
end

-- ══════════════ COLOR PICKER ══════════════
function KronUI:AddColorPicker(text, default, callback)
    local currentColor = default or Color3.fromRGB(255, 0, 0)
    local h, s, v = Color3.toHSV(currentColor)
    local open = false

    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.Y,
        ClipsDescendants = true,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    strokeIn(holder, 1, LINE); corner(holder, 8)

    local head = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        AutoButtonColor = false, Text = "",
    }, holder)
    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -80, 1, 0),
        Font = FONT, TextSize = 12, TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = text or "Cor",
    }, head)

    local swatch = o("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -36, 0.5, 0),
        Size = UDim2.new(0, 24, 0, 18),
        BackgroundColor3 = currentColor,
        BorderSizePixel = 0,
    }, head)
    strokeIn(swatch, 1.5, LINE); corner(swatch, 5)

    local arrow = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -28, 0, 0),
        Size = UDim2.new(0, 22, 1, 0),
        Font = FONTB, TextSize = 14, TextColor3 = DIM,
        TextXAlignment = Enum.TextXAlignment.Center,
        Text = "▾", Rotation = 0,
    }, head)

    local picker = o("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 34),
        BackgroundTransparency = 1, ClipsDescendants = true,
    }, holder)

    local PICKER_H = 130
    local pickerContent = o("Frame", {
        Size = UDim2.new(1, 0, 0, PICKER_H),
        BackgroundTransparency = 1,
    }, picker)
    o("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8),
        PaddingTop = UDim.new(0, 6) }, pickerContent)

    local svBox = o("ImageLabel", {
        Size = UDim2.new(1, -50, 0, 80),
        BackgroundColor3 = Color3.fromHSV(h, 1, 1),
        BorderSizePixel = 0,
        Image = "rbxassetid://4155801252",
        ImageColor3 = Color3.fromRGB(255, 255, 255),
        ClipsDescendants = true,
    }, pickerContent)
    corner(svBox, 5)
    local svCursor = o("Frame", {
        Size = UDim2.new(0, 10, 0, 10),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(s, 0, 1-v, 0),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        BorderSizePixel = 0, ZIndex = 5,
    }, svBox)
    corner(svCursor, "pill")
    stroke(svCursor, 1.5, Color3.fromRGB(0,0,0))

    local svBtn = o("TextButton", { Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, Text = "", ZIndex = 6 }, svBox)

    local hueBar = o("ImageLabel", {
        Position = UDim2.new(1, -42, 0, 0),
        Size = UDim2.new(0, 12, 0, 80),
        BackgroundColor3 = Color3.fromRGB(255,255,255),
        Image = "rbxassetid://4155801252",
        ScaleType = Enum.ScaleType.Stretch,
        Rotation = 270,
        BorderSizePixel = 0,
        ClipsDescendants = false,
    }, pickerContent)
    corner(hueBar, 5)
    local hueGrad = o("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,    Color3.fromHSV(0,1,1)),
            ColorSequenceKeypoint.new(0.167,Color3.fromHSV(0.167,1,1)),
            ColorSequenceKeypoint.new(0.333,Color3.fromHSV(0.333,1,1)),
            ColorSequenceKeypoint.new(0.5,  Color3.fromHSV(0.5,1,1)),
            ColorSequenceKeypoint.new(0.667,Color3.fromHSV(0.667,1,1)),
            ColorSequenceKeypoint.new(0.833,Color3.fromHSV(0.833,1,1)),
            ColorSequenceKeypoint.new(1,    Color3.fromHSV(1,1,1)),
        }),
    }, hueBar)
    local hueCursor = o("Frame", {
        Size = UDim2.new(1, 4, 0, 3),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 1-h, 0),
        BackgroundColor3 = W,
        BorderSizePixel = 0, ZIndex = 5,
    }, hueBar)
    corner(hueCursor, 2)
    stroke(hueCursor, 1, Color3.fromRGB(0,0,0))
    local hueBtn = o("TextButton", { Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, Text = "", ZIndex = 6 }, hueBar)

    local hexRow = o("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        Position = UDim2.new(0, 0, 0, 86),
        BackgroundTransparency = 1,
    }, pickerContent)
    o("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(0, 30, 1, 0),
        Font = FONTB, TextSize = 10, TextColor3 = DIM,
        Text = "HEX",
    }, hexRow)
    local hexBox = o("Frame", {
        Position = UDim2.new(0, 34, 0, 4),
        Size = UDim2.new(1, -34, 0, 20),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, hexRow)
    corner(hexBox, 5); strokeIn(hexBox, 1, LINE)
    local hexInput = o("TextBox", {
        Position = UDim2.new(0, 6, 0, 0),
        Size = UDim2.new(1, -10, 1, 0),
        BackgroundTransparency = 1,
        Text = string.format("#%02X%02X%02X",
            math.floor(currentColor.R*255),
            math.floor(currentColor.G*255),
            math.floor(currentColor.B*255)),
        Font = FONT, TextSize = 11, TextColor3 = W,
        ClearTextOnFocus = false,
    }, hexBox)

    local function applyColor(col)
        currentColor = col
        h, s, v = Color3.toHSV(col)
        swatch.BackgroundColor3 = col
        svBox.BackgroundColor3  = Color3.fromHSV(h, 1, 1)
        svCursor.Position = UDim2.new(s, 0, 1-v, 0)
        hueCursor.Position = UDim2.new(0.5, 0, 1-h, 0)
        hexInput.Text = string.format("#%02X%02X%02X",
            math.floor(col.R*255), math.floor(col.G*255), math.floor(col.B*255))
        if callback then task.spawn(callback, col) end
    end

    local svDragging = false
    svBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or
           inp.UserInputType == Enum.UserInputType.Touch then
            svDragging = true
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then svDragging = false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if not svDragging then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement and
           inp.UserInputType ~= Enum.UserInputType.Touch then return end
        local rX = math.clamp((inp.Position.X - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
        local rY = math.clamp((inp.Position.Y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
        s = rX; v = 1 - rY
        applyColor(Color3.fromHSV(h, s, v))
    end)
    svBtn.MouseButton1Down:Connect(function(x, y)
        svDragging = true
        local rX = math.clamp((x - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
        local rY = math.clamp((y - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
        s = rX; v = 1 - rY
        applyColor(Color3.fromHSV(h, s, v))
    end)

    local hueDragging = false
    hueBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 or
           inp.UserInputType == Enum.UserInputType.Touch then
            hueDragging = true
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then hueDragging = false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if not hueDragging then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseMovement and
           inp.UserInputType ~= Enum.UserInputType.Touch then return end
        local rY = math.clamp((inp.Position.Y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
        h = 1 - rY
        applyColor(Color3.fromHSV(h, s, v))
    end)
    hueBtn.MouseButton1Down:Connect(function(x, y)
        hueDragging = true
        local rY = math.clamp((y - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
        h = 1 - rY
        applyColor(Color3.fromHSV(h, s, v))
    end)

    hexInput.FocusLost:Connect(function(enter)
        if not enter then return end
        local hex = hexInput.Text:gsub("#", ""):sub(1, 6)
        if #hex == 6 then
            local r = tonumber(hex:sub(1,2), 16)
            local g = tonumber(hex:sub(3,4), 16)
            local b = tonumber(hex:sub(5,6), 16)
            if r and g and b then
                applyColor(Color3.fromRGB(r, g, b))
            end
        end
    end)

    head.MouseButton1Click:Connect(function()
        self._playClick()
        open = not open
        local ti = EASE_EXP(0.22)
        tween(picker, ti, { Size = UDim2.new(1, 0, 0, open and PICKER_H or 0) })
        tween(arrow, ti, { Rotation = open and 180 or 0 })
    end)

    return {
        GetColor  = function() return currentColor end,
        SetColor  = function(c) applyColor(c) end,
    }
end

-- ══════════════ LABEL ══════════════
function KronUI:AddLabel(text, subtext, icon)
    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, subtext and 42 or 32),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    strokeIn(holder, 1, LINE); corner(holder, 8)

    local startX = icon and 36 or 12
    if icon then
        o("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0.5, -10),
            Size = UDim2.new(0, 20, 0, 20),
            Font = FONTB, TextSize = 16,
            Text = icon, TextColor3 = self._accent,
        }, holder)
    end

    local mainLabel = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, startX, 0, subtext and 6 or 0),
        Size = UDim2.new(1, -(startX+8), 0, 18),
        Font = FONTB, TextSize = 12, TextColor3 = W,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = text or "",
    }, holder)

    local subLabel = subtext and o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, startX, 0, 22),
        Size = UDim2.new(1, -(startX+8), 0, 14),
        Font = FONT, TextSize = 10, TextColor3 = DIM,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = subtext,
    }, holder) or nil

    self:_registerThemeCallback(function(p)
        if icon then
            local ic = holder:FindFirstChildWhichIsA("TextLabel")
            if ic then ic.TextColor3 = p end
        end
    end)

    return {
        SetText    = function(t) mainLabel.Text = t end,
        SetSubtext = function(t) if subLabel then subLabel.Text = t end end,
        SetIcon    = function(i)
            local ic = holder:FindFirstChildWhichIsA("TextLabel")
            if ic then ic.Text = i end
        end,
    }
end

