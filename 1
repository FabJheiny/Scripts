--  TEMA VISUAL (SWATCHES)
-- ══════════════════════════════════════════════════════
function KronUI:_AddThemeSwatches()
    local themes = {
        { name="Roxo",    p=Color3.fromRGB(150,90,255),  s=Color3.fromRGB(95,60,200)  },
        { name="Azul",    p=Color3.fromRGB(50,120,255),  s=Color3.fromRGB(30,80,200)  },
        { name="Ciano",   p=Color3.fromRGB(40,210,210),  s=Color3.fromRGB(20,160,160) },
        { name="Verde",   p=Color3.fromRGB(80,220,80),   s=Color3.fromRGB(40,170,40)  },
        { name="Amarelo", p=Color3.fromRGB(255,210,50),  s=Color3.fromRGB(200,160,30) },
        { name="Laranja", p=Color3.fromRGB(255,140,30),  s=Color3.fromRGB(200,100,20) },
        { name="Vermelho",p=Color3.fromRGB(255,60,60),   s=Color3.fromRGB(200,30,30)  },
        { name="Rosa",    p=Color3.fromRGB(255,100,180), s=Color3.fromRGB(200,60,140) },
        { name="Branco",  p=Color3.fromRGB(242,240,250), s=Color3.fromRGB(195,190,215)},
    }

    local SWATCH = 22; local COLS = 9; local GAP = 4
    local rowW = COLS*(SWATCH+GAP)-GAP

    local holder = o("Frame", {
        Size=UDim2.new(1,0,0,SWATCH+8),
        BackgroundTransparency=1, LayoutOrder=self:_nextOrder(),
    }, self.container)

    local inner = o("Frame", {
        AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0.5,0,0.5,0),
        Size=UDim2.new(0,rowW,0,SWATCH),
        BackgroundTransparency=1,
    }, holder)
    o("UIListLayout", {
        FillDirection=Enum.FillDirection.Horizontal,
        Padding=UDim.new(0,GAP), SortOrder=Enum.SortOrder.LayoutOrder,
    }, inner)

    local swatchButtons = {}
    local selectedIdx   = 1 -- Roxo por padrão

    local function selectSwatch(idx)
        selectedIdx = idx
        for i, data in ipairs(swatchButtons) do
            local isActive = (i==idx)
            tween(data.ring, EASE_OUT(0.15), {
                BackgroundTransparency = isActive and 0 or 1,
            })
            tween(data.scale, EASE_BACK(0.2), {
                Scale = isActive and 1.12 or 1,
            })
        end
        self:SetAccent(themes[idx].p, themes[idx].s)
    end

    for i, theme in ipairs(themes) do
        local wrap = o("Frame", {
            Size=UDim2.new(0,SWATCH,0,SWATCH),
            BackgroundTransparency=1, LayoutOrder=i,
        }, inner)

        local dot = o("TextButton", {
            Size=UDim2.new(1,-4,1,-4),
            AnchorPoint=Vector2.new(0.5,0.5),
            Position=UDim2.new(0.5,0,0.5,0),
            BackgroundColor3=theme.p,
            BorderSizePixel=0, Text="", AutoButtonColor=false,
        }, wrap)
        corner(dot,"pill")

        local ring = o("Frame", {
            AnchorPoint=Vector2.new(0.5,0.5),
            Position=UDim2.new(0.5,0,0.5,0),
            Size=UDim2.new(1,0,1,0),
            BackgroundTransparency=1, BorderSizePixel=0,
        }, wrap)
        corner(ring,"pill")
        local rStroke = stroke(ring, 2, theme.p, 1)

        local sc = o("UIScale",{Scale=1}, wrap)

        swatchButtons[i] = { ring=rStroke, scale=sc, dot=dot }

        dot.MouseEnter:Connect(function()
            if i~=selectedIdx then
                tween(sc, EASE_OUT(0.12), {Scale=1.08})
                tween(rStroke, EASE_OUT(0.12), {Transparency=0.4})
            end
        end)
        dot.MouseLeave:Connect(function()
            if i~=selectedIdx then
                tween(sc, EASE_OUT(0.12), {Scale=1})
                tween(rStroke, EASE_OUT(0.12), {Transparency=1})
            end
        end)
        dot.MouseButton1Click:Connect(function()
            playClick()
            selectSwatch(i)
        end)
    end

    selectSwatch(1)
end

-- ══════════════════════════════════════════════════════
--  SISTEMA DE NOTIFICAÇÕES (TOAST)
-- ══════════════════════════════════════════════════════
function KronUI:Notify(opts)
    opts = opts or {}
    local title    = opts.title    or "Notificação"
    local desc     = opts.desc     or ""
    local ntype    = opts.type     or "info"
    local duration = opts.duration or 3

    local typeColors = {
        info    = INFO,
        success = SUCCESS,
        warn    = WARN,
        error   = ERROR,
    }
    local typeIcons = {
        info = "ℹ", success = "✓", warn = "⚠", error = "✕",
    }
    local col  = typeColors[ntype] or INFO
    local icon = typeIcons[ntype]  or "ℹ"

    -- limitar a 4 simultaneas (remove a mais antiga)
    if self._notifCount >= 4 then
        local first = self._notifStack:FindFirstChildWhichIsA("Frame")
        if first then first:Destroy() end
        self._notifCount = math.max(0, self._notifCount-1)
    end

    self._notifOrder = self._notifOrder + 1
    self._notifCount = self._notifCount + 1

    local NOTIF_H = 58 + (desc~="" and 16 or 0)

    local card = o("Frame", {
        Size=UDim2.new(1,0,0,NOTIF_H),
        BackgroundColor3=CARD, BorderSizePixel=0,
        ClipsDescendants=true,
        BackgroundTransparency=1,
        LayoutOrder=self._notifOrder,
    }, self._notifStack)
    corner(card,10)
    strokeIn(card,1,LINE)

    -- barra lateral colorida
    o("Frame", {
        Size=UDim2.new(0,3,1,0),
        BackgroundColor3=col, BorderSizePixel=0,
    }, card)
    corner(o("Frame",{
        Size=UDim2.new(0,3,1,0), BackgroundColor3=col, BorderSizePixel=0,
    }, card),"pill")

    -- ícone
    o("TextLabel", {
        Position=UDim2.new(0,10,0,8), Size=UDim2.new(0,20,0,20),
        BackgroundTransparency=1, Text=icon,
        Font=FONTB, TextSize=14, TextColor3=col,
        TextXAlignment=Enum.TextXAlignment.Center,
    }, card)

    -- título
    o("TextLabel", {
        Position=UDim2.new(0,34,0,8), Size=UDim2.new(1,-44,0,18),
        BackgroundTransparency=1, Text=title,
        Font=FONTB, TextSize=12, TextColor3=W,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextTruncate=Enum.TextTruncate.AtEnd,
    }, card)

    -- descrição
    if desc ~= "" then
        o("TextLabel", {
            Position=UDim2.new(0,34,0,26), Size=UDim2.new(1,-44,0,14),
            BackgroundTransparency=1, Text=desc,
            Font=FONT, TextSize=11, TextColor3=DIM,
            TextXAlignment=Enum.TextXAlignment.Left,
            TextTruncate=Enum.TextTruncate.AtEnd,
        }, card)
    end

    -- barra de progresso de duração
    local progTrack = o("Frame", {
        Position=UDim2.new(0,10,1,-6), Size=UDim2.new(1,-20,0,2),
        BackgroundColor3=LINE, BorderSizePixel=0,
    }, card)
    corner(progTrack,"pill")
    local progFill = o("Frame", {
        Size=UDim2.new(1,0,1,0), BackgroundColor3=col, BorderSizePixel=0,
    }, progTrack)
    corner(progFill,"pill")

    -- entrada animada (slide + fade)
    tween(card, EASE_OUT(0.3), { BackgroundTransparency=0 })
    local cardScale = o("UIScale",{Scale=0.9}, card)
    tween(cardScale, EASE_BACK(0.35), {Scale=1})

    -- barra de progresso depletando
    tween(progFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size=UDim2.new(0,0,1,0)})

    -- saída
    task.delay(duration, function()
        if not card or not card.Parent then return end
        local t = tween(card, EASE_OUT(0.25), {BackgroundTransparency=1, Size=UDim2.new(1,0,0,0)})
        tween(cardScale, EASE_OUT(0.25), {Scale=0.92})
        t.Completed:Connect(function()
            if card and card.Parent then card:Destroy() end
            self._notifCount = math.max(0, self._notifCount-1)
        end)
    end)
end

