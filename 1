local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")
local RunService       = game:GetService("RunService")
local TextService      = game:GetService("TextService")

local KronUI = {}
KronUI.__index = KronUI

local BG      = Color3.fromRGB(10, 8, 16)
local PANEL   = Color3.fromRGB(16, 13, 26)
local CARD    = Color3.fromRGB(22, 18, 34)
local CARD2   = Color3.fromRGB(26, 22, 40)
local HOVER   = Color3.fromRGB(34, 28, 52)
local HOVER2  = Color3.fromRGB(42, 36, 62)
local LINE    = Color3.fromRGB(50, 42, 68)
local LINE2   = Color3.fromRGB(66, 56, 88)
local ACCENT  = Color3.fromRGB(140, 80, 255)
local ACCENT2 = Color3.fromRGB(90, 50, 200)
local ACCENT3 = Color3.fromRGB(180, 120, 255)
local DIM     = Color3.fromRGB(130, 122, 150)
local MID     = Color3.fromRGB(180, 174, 200)
local W       = Color3.fromRGB(240, 238, 252)
local SUCCESS = Color3.fromRGB(80, 220, 120)
local ERROR   = Color3.fromRGB(255, 75, 90)
local WARNING = Color3.fromRGB(255, 185, 50)
local INFO    = Color3.fromRGB(60, 180, 255)
local FONT    = Enum.Font.GothamMedium
local FONTB   = Enum.Font.GothamBold

local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end

local function stroke(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, par)
end

local function strokeIn(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
    }, par)
end

local function corner(par, r)
    return o("UICorner", { CornerRadius = (r == "pill") and UDim.new(1, 0) or UDim.new(0, r or 8) }, par)
end

local function shadow(par, size, transp)
    local s = o("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, size or 4),
        Size = UDim2.new(1, (size or 12) * 2, 1, (size or 12) * 2),
        BackgroundTransparency = 1,
        Image = "rbxassetid://6014261993",
        ImageColor3 = Color3.fromRGB(0, 0, 0),
        ImageTransparency = transp or 0.5,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(49, 49, 450, 450),
        ZIndex = par.ZIndex and (par.ZIndex - 1) or 0,
    }, par)
    return s
end

local function tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function lerpColor(a, b, t)
    return Color3.new(
        lerp(a.R, b.R, t),
        lerp(a.G, b.G, t),
        lerp(a.B, b.B, t)
    )
end

local function HSVtoRGB(h, s, v)
    return Color3.fromHSV(h, s, v)
end

local EASE_OUT  = function(d) return TweenInfo.new(d or 0.18, Enum.EasingStyle.Quad,   Enum.EasingDirection.Out)  end
local EASE_BACK = function(d) return TweenInfo.new(d or 0.4,  Enum.EasingStyle.Back,   Enum.EasingDirection.Out)  end
local EASE_IN   = function(d) return TweenInfo.new(d or 0.18, Enum.EasingStyle.Quad,   Enum.EasingDirection.In)   end
local EASE_SINE = function(d) return TweenInfo.new(d or 0.3,  Enum.EasingStyle.Sine,   Enum.EasingDirection.Out)  end
local EASE_EXP  = function(d) return TweenInfo.new(d or 0.3,  Enum.EasingStyle.Expo,   Enum.EasingDirection.Out)  end
local EASE_SPING = function(d) return TweenInfo.new(d or 0.5, Enum.EasingStyle.Spring, Enum.EasingDirection.Out)  end

-- ══════════════ CONSTRUTOR ══════════════
function KronUI.new(title, pillImage, config)
    local self = setmetatable({}, KronUI)
    config = config or {}

    self._accent  = ACCENT
    self._accent2 = ACCENT2
    self._accent3 = ACCENT3

    self._themeItems     = {}
    self._themeGradients = {}
    self._themeCallbacks = {}
    self._connections    = {}
    self._layoutOrder    = 0
    self._tabs           = {}
    self._activeTab      = nil
    self._notifCount     = 0
    self._tooltips       = {}

    function self:_registerThemeItem(obj, prop, role)
        table.insert(self._themeItems, {Object = obj, Property = prop, Role = role})
    end
    function self:_registerThemeGradient(grad)
        table.insert(self._themeGradients, grad)
    end
    function self:_registerThemeCallback(cb)
        table.insert(self._themeCallbacks, cb)
    end

    function self:SetAccent(primary, secondary, tertiary)
        self._accent  = primary
        self._accent2 = secondary or lerpColor(primary, Color3.fromRGB(30,20,60), 0.4)
        self._accent3 = tertiary  or lerpColor(primary, W, 0.3)
        for _, item in ipairs(self._themeItems) do
            local role = item.Role
            item.Object[item.Property] =
                role == "accent"  and self._accent  or
                role == "accent2" and self._accent2 or
                role == "accent3" and self._accent3 or primary
        end
        for _, grad in ipairs(self._themeGradients) do
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0,   self._accent2),
                ColorSequenceKeypoint.new(0.5, self._accent),
                ColorSequenceKeypoint.new(1,   self._accent2),
            })
        end
        for _, cb in ipairs(self._themeCallbacks) do
            pcall(cb, primary, secondary, tertiary)
        end
    end

    local player = Players.LocalPlayer
    local pg     = player:WaitForChild("PlayerGui", 10) or player.PlayerGui

    local old    = pg:FindFirstChild("KronUI_Lib")
    local oldBtn = CoreGui:FindFirstChild("KronUI_FloatBtn") or pg:FindFirstChild("KronUI_FloatBtn")
    local oldNot = CoreGui:FindFirstChild("KronUI_Notifs")  or pg:FindFirstChild("KronUI_Notifs")
    if old    then old:Destroy()    end
    if oldBtn then oldBtn:Destroy() end
    if oldNot then oldNot:Destroy() end

    _G.KronUIScale = _G.KronUIScale or 10
    local function getUIScale(s) return 0.42 + (s - 1) * 0.04 end

    self.gui = o("ScreenGui", {
        Name = "KronUI_Lib", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 10,
    }, pg)

    self.notifGui = o("ScreenGui", {
        Name = "KronUI_Notifs", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 99999,
    })
    local okNotif = pcall(function() self.notifGui.Parent = CoreGui end)
    if not okNotif then self.notifGui.Parent = pg end

    local notifStack = o("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -14, 1, -14),
        Size = UDim2.new(0, 260, 1, -28),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, self.notifGui)
    o("UIListLayout", {
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Vertical,
    }, notifStack)
    self._notifStack = notifStack

    local clickSound = o("Sound", { SoundId = "rbxassetid://6895079853", Volume = 0.5 }, self.gui)
    local notifSound = o("Sound", { SoundId = "rbxassetid://9120386436", Volume = 0.4 }, self.gui)
    local openSound  = o("Sound", { SoundId = "rbxassetid://6026984224", Volume = 0.35}, self.gui)
    local closeSound = o("Sound", { SoundId = "rbxassetid://6026984224", Volume = 0.3 }, self.gui)

    self._playClick  = function() pcall(function() clickSound:Play() end) end
    self._playNotif  = function() pcall(function() notifSound:Play() end) end
    self._playOpen   = function() pcall(function() openSound:Play()  end) end
    self._playClose  = function() pcall(function() closeSound:Play() end) end

