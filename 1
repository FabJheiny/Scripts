-- ══════════════ TOOLTIP ══════════════
function KronUI:_showTooltip(text, target)
    self:_hideTooltip()
    if not text or text == "" then return end
    if not self._tooltipFrame then
        self._tooltipFrame = o("Frame", {
            AnchorPoint = Vector2.new(0.5, 1),
            Size = UDim2.new(0, 0, 0, 22),
            BackgroundColor3 = Color3.fromRGB(30, 26, 44),
            BorderSizePixel = 0, ZIndex = 1000,
            AutomaticSize = Enum.AutomaticSize.X,
        }, self.gui)
        corner(self._tooltipFrame, 5)
        stroke(self._tooltipFrame, 1, LINE)
        o("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, self._tooltipFrame)
        self._tooltipLabel = o("TextLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Font = FONT, TextSize = 11, TextColor3 = MID,
        }, self._tooltipFrame)
    end
    self._tooltipLabel.Text = text
    local abs = target.AbsolutePosition
    local sz  = target.AbsoluteSize
    self._tooltipFrame.Position = UDim2.new(0, abs.X + sz.X/2, 0, abs.Y - 4)
    self._tooltipFrame.Visible = true
    tween(self._tooltipFrame, EASE_OUT(0.12), { BackgroundTransparency = 0 })
end

function KronUI:_hideTooltip()
    if self._tooltipFrame then
        self._tooltipFrame.Visible = false
    end
end

-- ══════════════ NOTIFICAÇÃO ══════════════
function KronUI:Notify(opts)
    opts = opts or {}
    local title    = opts.Title    or "Notificação"
    local message  = opts.Message  or ""
    local duration = opts.Duration or 4
    local ntype    = opts.Type     or "info"
    local icon     = opts.Icon     or (ntype == "success" and "✅" or ntype == "error" and "❌" or ntype == "warning" and "⚠️" or "ℹ️")

    local typeColor = ntype == "success" and SUCCESS or ntype == "error" and ERROR or ntype == "warning" and WARNING or INFO

    self._notifCount = self._notifCount + 1
    local badgeN = self._notifCount
    self._notifBadge.Visible = true
    self._notifBadgeLabel.Text = tostring(badgeN > 9 and "9+" or badgeN)
    tween(self._notifBadge, EASE_BACK(0.2), { Size = UDim2.new(0, 16, 0, 16) })

    local card = o("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = Color3.fromRGB(16, 13, 28),
        BackgroundTransparency = 0.08,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        AutomaticSize = Enum.AutomaticSize.None,
        LayoutOrder = self._notifCount,
    }, self._notifStack)
    corner(card, 10)
    stroke(card, 1.5, typeColor, 0.5)

    local colorBar = o("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = typeColor,
        BorderSizePixel = 0,
    }, card)
    corner(colorBar, 2)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 6),
        Size = UDim2.new(0, 20, 0, 20),
        Font = FONTB, TextSize = 16,
        Text = icon, TextColor3 = typeColor,
        ZIndex = 2,
    }, card)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 38, 0, 6),
        Size = UDim2.new(1, -48, 0, 16),
        Font = FONTB, TextSize = 12, TextColor3 = W,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = title, ZIndex = 2,
    }, card)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 38, 0, 22),
        Size = UDim2.new(1, -48, 0, 28),
        Font = FONT, TextSize = 11, TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        Text = message, ZIndex = 2,
    }, card)

    local timerTrack = o("Frame", {
        Position = UDim2.new(0, 3, 1, -3),
        Size = UDim2.new(1, -6, 0, 2),
        BackgroundColor3 = LINE,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, card)
    corner(timerTrack, "pill")
    local timerFill = o("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = typeColor,
        BorderSizePixel = 0,
    }, timerTrack)
    corner(timerFill, "pill")

    self._playNotif()

    local TARGET_H = message ~= "" and 62 or 38
    tween(card, EASE_BACK(0.32), { Size = UDim2.new(1, 0, 0, TARGET_H) })

    task.delay(0.1, function()
        tween(timerFill, TweenInfo.new(duration - 0.1, Enum.EasingStyle.Linear),
            { Size = UDim2.new(0, 0, 1, 0) })
    end)

    task.delay(duration, function()
        tween(card, EASE_IN(0.25), { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 })
        task.delay(0.28, function()
            card:Destroy()
            self._notifCount = math.max(0, self._notifCount - 1)
            if self._notifCount == 0 then
                self._notifBadge.Visible = false
            else
                self._notifBadgeLabel.Text = tostring(self._notifCount > 9 and "9+" or self._notifCount)
            end
        end)
    end)

    local closeBtn = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "", ZIndex = 5,
    }, card)
    closeBtn.MouseButton1Click:Connect(function()
        tween(card, EASE_IN(0.2), { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 })
        task.delay(0.22, function()
            card:Destroy()
            self._notifCount = math.max(0, self._notifCount - 1)
            if self._notifCount == 0 then self._notifBadge.Visible = false end
        end)
    end)

    return card
end

return KronUI
