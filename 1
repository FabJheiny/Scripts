local FONTB   = Enum.Font.GothamBold

-- ── Utilitários ──────────────────────────────────────
local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end

local function stroke(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, par)
end

local function strokeIn(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
    }, par)
end

local function corner(par, r)
    return o("UICorner", {
        CornerRadius = (r == "pill") and UDim.new(1, 0) or UDim.new(0, r or 8)
    }, par)
end

local function tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play(); return t
end

local EASE_OUT  = function(d) return TweenInfo.new(d or 0.18, Enum.EasingStyle.Quad,  Enum.EasingDirection.Out) end
local EASE_BACK = function(d) return TweenInfo.new(d or 0.4,  Enum.EasingStyle.Back,  Enum.EasingDirection.Out) end
local EASE_SINE = function(d) return TweenInfo.new(d or 0.25, Enum.EasingStyle.Sine,  Enum.EasingDirection.InOut) end

-- ── HSV helpers ──────────────────────────────────────
local function hsvToRgb(h, s, v)
    if s == 0 then return Color3.new(v, v, v) end
    local i = math.floor(h * 6)
    local f = h * 6 - i; local p = v*(1-s); local q = v*(1-f*s); local t2 = v*(1-(1-f)*s)
    local r, g, b
    local m = i % 6
    if m == 0 then r,g,b = v,t2,p
    elseif m == 1 then r,g,b = q,v,p
    elseif m == 2 then r,g,b = p,v,t2
    elseif m == 3 then r,g,b = p,q,v
    elseif m == 4 then r,g,b = t2,p,v
    else r,g,b = v,p,q end
    return Color3.new(r,g,b)
end

local function rgbToHsv(c)
    local r,g,b = c.R, c.G, c.B
    local max = math.max(r,g,b); local min = math.min(r,g,b); local d = max-min
    local h,s,v = 0, (max==0 and 0 or d/max), max
    if d ~= 0 then
        if max == r then h = (g-b)/d % 6
        elseif max == g then h = (b-r)/d + 2
        else h = (r-g)/d + 4 end
        h = h / 6
    end
    return h, s, v
end

local function colorToHex(c)
    return string.format("%02X%02X%02X",
        math.floor(c.R*255+.5), math.floor(c.G*255+.5), math.floor(c.B*255+.5))
end

local function hexToColor(hex)
    hex = hex:gsub("#","")
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1,2),16)
    local g = tonumber(hex:sub(3,4),16)
    local b = tonumber(hex:sub(5,6),16)
    if not (r and g and b) then return nil end
    return Color3.fromRGB(r,g,b)
end

-- ══════════════════════════════════════════════════════
--  CONSTRUTOR PRINCIPAL
-- ══════════════════════════════════════════════════════
function KronUI.new(title, pillImage)
    local self = setmetatable({}, KronUI)

    self._accent  = ACCENT
    self._accent2 = ACCENT2

    self._themeItems     = {}
    self._themeGradients = {}
    self._themeCallbacks = {}
    self._connections    = {}
    self._layoutOrder    = 0

    -- tabs
    self._tabs       = {}     -- {name, icon, btn, inkMark, container, layoutOrder}
    self._activeTab  = nil
    self._tabMode    = false  -- true quando AddTab() é chamado

    function self:_registerThemeItem(obj, prop, role)
        table.insert(self._themeItems, {Object=obj, Property=prop, Role=role})
    end
    function self:_registerThemeGradient(grad)
        table.insert(self._themeGradients, grad)
    end
    function self:_registerThemeCallback(cb)
        table.insert(self._themeCallbacks, cb)
    end

    function self:SetAccent(primary, secondary)
        self._accent  = primary
        self._accent2 = secondary
        for _, item in ipairs(self._themeItems) do
            item.Object[item.Property] = (item.Role=="accent" and primary or secondary)
        end
        for _, grad in ipairs(self._themeGradients) do
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0,   secondary),
                ColorSequenceKeypoint.new(0.5, primary),
                ColorSequenceKeypoint.new(1,   secondary),
            })
        end
        for _, cb in ipairs(self._themeCallbacks) do cb(primary, secondary) end
    end

    -- ── Setup PlayerGui ───────────────────────────────
    local player = Players.LocalPlayer
    local pg     = player:WaitForChild("PlayerGui", 10) or player.PlayerGui
    local old    = pg:FindFirstChild("KronUI_Lib")
    local oldBtn = CoreGui:FindFirstChild("KronUI_FloatBtn") or pg:FindFirstChild("KronUI_FloatBtn")
    local oldNot = CoreGui:FindFirstChild("KronUI_Notify") or pg:FindFirstChild("KronUI_Notify")
    if old    then old:Destroy()    end
    if oldBtn then oldBtn:Destroy() end
    if oldNot then oldNot:Destroy() end

    _G.KronUIScale = _G.KronUIScale or 10
    local function getUIScale(s) return 0.45 + (s-1)*0.04 end

    self.gui = o("ScreenGui", {
        Name = "KronUI_Lib", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 10,
    }, pg)

    local clickSound = o("Sound", {
        SoundId = "rbxassetid://6895079853", Volume = 0.6, RollOffMaxDistance = 0,
    }, self.gui)
    local function playClick() clickSound:Play() end
    self._playClick = playClick

    -- ── Notification ScreenGui (separado, alta prioridade) ─
    self._notifGui = o("ScreenGui", {
        Name = "KronUI_Notify", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 9998,
    })
    local okN = pcall(function() self._notifGui.Parent = CoreGui end)
    if not okN then self._notifGui.Parent = pg end

    local notifStack = o("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position    = UDim2.new(1, -14, 1, -14),
        Size        = UDim2.new(0, 280, 1, -28),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, self._notifGui)
    o("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        FillDirection = Enum.FillDirection.Vertical,
    }, notifStack)
    self._notifStack = notifStack
    self._notifCount = 0
    self._notifOrder = 0

    -- ── Menu principal ────────────────────────────────
    local MENU_W, MENU_H = 260, 360
    local CORNER_R = 14
    local topH     = 32

    self.menuFrame = o("Frame", {
        Name = "MenuFrame",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ClipsDescendants = true,
    }, self.gui)
    corner(self.menuFrame, CORNER_R)
    stroke(self.menuFrame, 1, LINE)
    local menuAccentStroke = stroke(self.menuFrame, 1.5, self._accent, 0.6)
    self:_registerThemeItem(menuAccentStroke, "Color", "accent")

    -- sombra de profundidade
    local shadow = o("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 6),
        Size = UDim2.new(1, 20, 1, 20),
        BackgroundColor3 = Color3.new(0,0,0),
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0, ZIndex = -1,
    }, self.menuFrame)
    corner(shadow, CORNER_R+4)
    o("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.3),
            NumberSequenceKeypoint.new(1, 1),
        }),
        Rotation = 90,
    }, shadow)

    local uiScaleObj = o("UIScale", { Scale = getUIScale(_G.KronUIScale) }, self.menuFrame)

    task.defer(function()
        tween(self.menuFrame, EASE_BACK(0.5), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
    end)

    -- ── TopBar ────────────────────────────────────────
    local topBar = o("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, topH),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ZIndex = 10,
    }, self.menuFrame)
    corner(topBar, CORNER_R)
    -- tapar canto inferior esquerdo/direito
    o("Frame", { Size=UDim2.new(0,CORNER_R,0,CORNER_R), Position=UDim2.new(0,0,1,-CORNER_R),
        BackgroundColor3=BG, BorderSizePixel=0, ZIndex=11 }, topBar)

    o("TextLabel", {
        Size=UDim2.new(1,-150,1,0), Position=UDim2.new(0,14,0,0),
        BackgroundTransparency=1, Text=title or "Interface",
        TextColor3=W, TextSize=13, Font=FONTB,
        TextXAlignment=Enum.TextXAlignment.Left, ZIndex=10,
    }, topBar)

    -- shimmer line
    local shimmer = o("Frame", {
        Size=UDim2.new(1,0,0,2), Position=UDim2.new(0,0,1,-2),
        BackgroundColor3=self._accent, BorderSizePixel=0, ZIndex=20,
    }, topBar)
    self:_registerThemeItem(shimmer, "BackgroundColor3", "accent")
    local shimmerGrad = o("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   self._accent2),
            ColorSequenceKeypoint.new(0.5, self._accent),
            ColorSequenceKeypoint.new(1,   self._accent2),
        }), Offset = Vector2.new(-1,0),
    }, shimmer)
    self:_registerThemeGradient(shimmerGrad)
    self._shimmerTween = TweenService:Create(shimmerGrad,
        TweenInfo.new(2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false),
        { Offset = Vector2.new(1,0) })
    self._shimmerTween:Play()

    -- UI scale stepper
    local STEP_W, STEP_H = 62, 18
    local stepHolder = o("Frame", {
        Size=UDim2.new(0,STEP_W,0,STEP_H),
        Position=UDim2.new(1,-(33+8+STEP_W),0.5,-STEP_H/2),
        BackgroundTransparency=1, BorderSizePixel=0, ZIndex=10, ClipsDescendants=true,
    }, topBar)
    stroke(stepHolder, 1, LINE).ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    corner(stepHolder, 6)

    local bsz = STEP_H; local dv = 1; local nw = STEP_W - 2*bsz - 2*dv
    local stepPlus = o("TextButton", {
        Size=UDim2.new(0,bsz,1,0), BackgroundTransparency=1, BorderSizePixel=0,
        Text="+", TextColor3=MID, TextSize=14, Font=FONTB, AutoButtonColor=false, ZIndex=11,
    }, stepHolder)
    o("Frame", { Size=UDim2.new(0,dv,1,0), Position=UDim2.new(0,bsz,0,0),
        BackgroundColor3=LINE, BorderSizePixel=0, ZIndex=11 }, stepHolder)
    local stepBox = o("TextBox", {
        Size=UDim2.new(0,nw,1,0), Position=UDim2.new(0,bsz+dv,0,0),
        BackgroundTransparency=1, Text=tostring(_G.KronUIScale),
        TextColor3=W, TextSize=10, Font=FONT,
        TextXAlignment=Enum.TextXAlignment.Center,
        ClearTextOnFocus=false, ZIndex=11,
    }, stepHolder)
    o("Frame", { Size=UDim2.new(0,dv,1,0), Position=UDim2.new(0,bsz+dv+nw,0,0),
        BackgroundColor3=LINE, BorderSizePixel=0, ZIndex=11 }, stepHolder)
    local stepMinus = o("TextButton", {
        Size=UDim2.new(0,bsz,1,0), Position=UDim2.new(0,bsz+dv+nw+dv,0,0),
        BackgroundTransparency=1, BorderSizePixel=0,
        Text="−", TextColor3=MID, TextSize=14, Font=FONTB, AutoButtonColor=false, ZIndex=11,
    }, stepHolder)

    local stepCv = _G.KronUIScale
    local function stepApply(v)
        v = math.clamp(math.floor(v), 1, 35)
        stepCv=v; _G.KronUIScale=v; stepBox.Text=tostring(v)
        tween(uiScaleObj, EASE_OUT(0.12), { Scale=getUIScale(v) })
    end
    stepPlus.MouseButton1Click:Connect(function()  stepApply(stepCv+1) end)
    stepMinus.MouseButton1Click:Connect(function() stepApply(stepCv-1) end)
    stepBox.FocusLost:Connect(function()
        local n = tonumber(stepBox.Text)
        if n then stepApply(n) else stepBox.Text=tostring(stepCv) end
    end)
    for _, btn in ipairs({stepPlus, stepMinus}) do
        btn.MouseEnter:Connect(function() btn.TextColor3=self._accent end)
        btn.MouseLeave:Connect(function() btn.TextColor3=MID end)
    end
    self:_registerThemeCallback(function(p)
        if stepPlus.TextColor3 ~= MID then stepPlus.TextColor3=p end
        if stepMinus.TextColor3 ~= MID then stepMinus.TextColor3=p end
    end)

    -- separador + X button
    o("Frame", { Size=UDim2.new(0,1,1,0), Position=UDim2.new(1,-33,0,0),
        BackgroundColor3=LINE, BorderSizePixel=0, ZIndex=12 }, topBar)
    local xBtn = o("TextButton", {
        Size=UDim2.new(0,32,1,0), Position=UDim2.new(1,-32,0,0),
        BackgroundColor3=BG, BorderSizePixel=0,
        Text="×", TextColor3=DIM, TextSize=17, Font=FONTB,
        AutoButtonColor=false, ZIndex=11,
    }, topBar)
    corner(xBtn, CORNER_R)
    for _, pos in ipairs({ UDim2.new(0,0,0,0), UDim2.new(0,0,1,-CORNER_R), UDim2.new(1,-CORNER_R,1,-CORNER_R) }) do
        o("Frame", { Size=UDim2.new(0,CORNER_R,0,CORNER_R), Position=pos,
            BackgroundColor3=BG, BorderSizePixel=0, ZIndex=12 }, xBtn)
    end
    xBtn.MouseEnter:Connect(function() tween(xBtn, EASE_OUT(0.1), {TextColor3=ERROR}) end)
    xBtn.MouseLeave:Connect(function() tween(xBtn, EASE_OUT(0.1), {TextColor3=DIM})   end)

    -- dragging do menu
    do
        local dragging, dragStart, startPos, _tid = false, nil, nil, nil
        table.insert(self._connections, topBar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging=true; dragStart=inp.Position; startPos=self.menuFrame.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _tid then return end
                _tid=inp; dragging=true; dragStart=inp.Position; startPos=self.menuFrame.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType==Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType==Enum.UserInputType.Touch
            if isT and inp~=_tid then return end
            if isM or isT then
                local d = inp.Position - dragStart
                self.menuFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset+d.X,
                    startPos.Y.Scale, startPos.Y.Offset+d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.MouseButton1 then
                dragging=false; dragStart=nil; startPos=nil
            elseif inp.UserInputType==Enum.UserInputType.Touch then
                if inp~=_tid then return end
                dragging=false; _tid=nil; dragStart=nil; startPos=nil
            end
        end))
    end

    -- ── ContentFrame ──────────────────────────────────
    self.contentFrame = o("Frame", {
        Size=UDim2.new(1,0,1,-topH), Position=UDim2.new(0,0,0,topH),
        BackgroundColor3=PANEL, BorderSizePixel=0,
    }, self.menuFrame)
    corner(self.contentFrame, CORNER_R)
    o("Frame", { Size=UDim2.new(0,CORNER_R,0,CORNER_R), Position=UDim2.new(0,0,0,0),
        BackgroundColor3=PANEL, BorderSizePixel=0 }, self.contentFrame)
    o("Frame", { Size=UDim2.new(0,CORNER_R,0,CORNER_R), Position=UDim2.new(1,-CORNER_R,0,0),
        BackgroundColor3=PANEL, BorderSizePixel=0 }, self.contentFrame)

    -- Área de tabs header (inicialmente oculta)
    self._tabBar = o("Frame", {
        Name="TabBar",
        Size=UDim2.new(1,0,0,30),
        Position=UDim2.new(0,0,0,0),
        BackgroundColor3=BG,
        BorderSizePixel=0, Visible=false,
    }, self.contentFrame)
    strokeIn(self._tabBar, 1, LINE, 0.5)
    o("UIListLayout", {
        FillDirection=Enum.FillDirection.Horizontal,
        SortOrder=Enum.SortOrder.LayoutOrder,
        Padding=UDim.new(0,0),
    }, self._tabBar)

    -- ink-bar debaixo da tab ativa
    self._inkBar = o("Frame", {
        Size=UDim2.new(0,60,0,2),
        Position=UDim2.new(0,0,1,-2),
        BackgroundColor3=self._accent,
        BorderSizePixel=0, ZIndex=5,
    }, self._tabBar)
    self:_registerThemeItem(self._inkBar, "BackgroundColor3", "accent")

    -- Container padrão (sem tabs)
    self.container = o("ScrollingFrame", {
        Size=UDim2.new(1,-4,1,-6), Position=UDim2.new(0,2,0,4),
        BackgroundTransparency=1, BorderSizePixel=0,
        ScrollBarThickness=3, ScrollBarImageColor3=self._accent,
        ScrollingDirection=Enum.ScrollingDirection.Y,
        ElasticBehavior=Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize=Enum.AutomaticSize.Y,
        CanvasSize=UDim2.new(1,0,0,0), Visible=true,
    }, self.contentFrame)
    self:_registerThemeItem(self.container, "ScrollBarImageColor3", "accent")
    o("UIListLayout", { Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder }, self.container)
    o("UIPadding", {
        PaddingLeft=UDim.new(0,6), PaddingRight=UDim.new(0,6),
        PaddingTop=UDim.new(0,4),  PaddingBottom=UDim.new(0,4),
    }, self.container)

    -- ── Float Pill ────────────────────────────────────
    self.btnGui = o("ScreenGui", {
        Name="KronUI_FloatBtn", ResetOnSpawn=false,
        IgnoreGuiInset=true, ZIndexBehavior=Enum.ZIndexBehavior.Global,
        DisplayOrder=9999,
    })
    local okPill = pcall(function() self.btnGui.Parent=CoreGui end)
    if not okPill then self.btnGui.Parent=pg end

    local PILL_SIZE = 46
    local pill = o("Frame", {
        Name="PillUI",
        AnchorPoint=Vector2.new(0.5,0.5),
        Size=UDim2.new(0,0,0,0),
        Position=UDim2.new(1,-46,1,-242),
        BackgroundColor3=BG, BorderSizePixel=0,
        ClipsDescendants=true, Visible=false, ZIndex=200,
    }, self.btnGui)
    corner(pill, "pill")
    stroke(pill, 1, LINE)
    local pillGlow = stroke(pill, 1.5, self._accent, 0.55)
    self:_registerThemeItem(pillGlow, "Color", "accent")
    self._pill = pill

    self._breatheTween = TweenService:Create(pillGlow,
        TweenInfo.new(1.3,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),
        { Transparency=0.9 })
    self._breatheTween:Play()

    local resolvedImage = tostring(pillImage or "rbxassetid://78186286433275")
    if not resolvedImage:find("rbxassetid://") then
        resolvedImage = "rbxassetid://" .. resolvedImage
    end
    local pillIcon = o("ImageLabel", {
        AnchorPoint=Vector2.new(0.5,0.5), Position=UDim2.new(0.5,0,0.5,0),
        Size=UDim2.new(0,32,0,32), BackgroundTransparency=1,
        Image=resolvedImage, ImageColor3=W, ScaleType=Enum.ScaleType.Fit, ZIndex=201,
    }, pill)

    local pillBtn = o("TextButton", {
        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        Text="", AutoButtonColor=false, BorderSizePixel=0, ZIndex=202,
    }, pill)
    pillBtn.MouseEnter:Connect(function() tween(pillIcon,EASE_OUT(0.12),{ImageColor3=self._accent}) end)
    pillBtn.MouseLeave:Connect(function() tween(pillIcon,EASE_OUT(0.12),{ImageColor3=W}) end)

    local pillScale = o("UIScale",{Scale=1}, pill)
    pillBtn.MouseButton1Down:Connect(function() tween(pillScale,EASE_OUT(0.08),{Scale=0.9}) end)
    pillBtn.MouseButton1Up:Connect(function()   tween(pillScale,EASE_OUT(0.12),{Scale=1})   end)
    pillBtn.MouseLeave:Connect(function()       tween(pillScale,EASE_OUT(0.12),{Scale=1})   end)

    -- frost burst aprimorado: 3 anéis concêntricos
    local function frostBurst()
        for i = 1, 3 do
            task.delay((i-1)*0.09, function()
                local ring = o("Frame", {
                    AnchorPoint=Vector2.new(0.5,0.5),
                    Position=pill.Position,
                    Size=UDim2.new(0,PILL_SIZE,0,PILL_SIZE),
                    BackgroundTransparency=1, ZIndex=250,
                }, self.btnGui)
                corner(ring,"pill")
                local rStroke = stroke(ring, 3-i, self._accent)
                tween(ring, EASE_OUT(0.5), { Size=UDim2.new(0,PILL_SIZE+50+i*20,0,PILL_SIZE+50+i*20) })
                tween(rStroke, EASE_OUT(0.5), { Transparency=1 })
                task.delay(0.5, function() ring:Destroy() end)
            end)
        end
    end

    local function showPill()
        pill.Visible=true; pill.Size=UDim2.new(0,0,0,0)
        tween(pill, EASE_BACK(0.35), { Size=UDim2.new(0,PILL_SIZE,0,PILL_SIZE) })
    end
    local function hidePill()
        local t=tween(pill,EASE_OUT(0.18),{Size=UDim2.new(0,0,0,0)})
        t.Completed:Connect(function() if pill.Size.X.Offset<=1 then pill.Visible=false end end)
    end
    local function showMenu()
        self.menuFrame.Visible=true; self.menuFrame.Size=UDim2.new(0,0,0,0)
        tween(self.menuFrame, EASE_BACK(0.4), { Size=UDim2.new(0,MENU_W,0,MENU_H) })
    end
    local function hideMenu()
        local t=tween(self.menuFrame,EASE_OUT(0.2),{Size=UDim2.new(0,0,0,0)})
        t.Completed:Connect(function() if self.menuFrame.Size.X.Offset<=1 then self.menuFrame.Visible=false end end)
    end

    xBtn.MouseButton1Click:Connect(function()
        playClick(); hideMenu(); showPill()
    end)

    do
        local dragging, dragMoved, dragStart, startPos, _tid = false, false, nil, nil, nil
        table.insert(self._connections, pillBtn.InputBegan:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging=true; dragMoved=false; dragStart=inp.Position; startPos=pill.Position
            elseif inp.UserInputType==Enum.UserInputType.Touch then
                if _tid then return end
                _tid=inp; dragging=true; dragMoved=false; dragStart=inp.Position; startPos=pill.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM=inp.UserInputType==Enum.UserInputType.MouseMovement
            local isT=inp.UserInputType==Enum.UserInputType.Touch
            if isT and inp~=_tid then return end
            if isM or isT then
                local d=inp.Position-dragStart
                if d.Magnitude>4 then dragMoved=true end
                pill.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,
                    startPos.Y.Scale,startPos.Y.Offset+d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType==Enum.UserInputType.MouseButton1 then
                if not dragging then return end; dragging=false
                if not dragMoved then playClick(); frostBurst(); hidePill(); showMenu() end
                dragStart=nil; startPos=nil
            elseif inp.UserInputType==Enum.UserInputType.Touch then
                if inp~=_tid then return end
                local wm=dragMoved; dragging=false; dragMoved=false
                _tid=nil; dragStart=nil; startPos=nil
                if not wm then playClick(); frostBurst(); hidePill(); showMenu() end
            end
        end))
    end

    -- ── Seção de tema → swatches visuais ─────────────
    self:AddSectionLabel("🎨 Theme")
    self:_AddThemeSwatches()

    return self
end

