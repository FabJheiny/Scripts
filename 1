--  SISTEMA DE ABAS
-- ══════════════════════════════════════════════════════
function KronUI:AddTab(name, icon)
    if not self._tabMode then
        -- primeira tab: esconder container padrão, mostrar tab bar
        self._tabMode = true
        self.container.Visible = false
        self._tabBar.Visible = true
    end

    local tabIndex = #self._tabs + 1
    local TAB_H   = 30

    -- botão da tab
    local tabBtn = o("TextButton", {
        Size=UDim2.new(0,70,1,0),
        BackgroundColor3=BG,
        BorderSizePixel=0, AutoButtonColor=false, Text="",
        ZIndex=4, LayoutOrder=tabIndex,
    }, self._tabBar)

    local iconStr = (icon and icon~="") and (icon.." ") or ""
    o("TextLabel", {
        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        Text=iconStr..name, Font=FONT, TextSize=11, TextColor3=DIM,
        TextXAlignment=Enum.TextXAlignment.Center, ZIndex=5,
    }, tabBtn)

    -- ink mark individual (escondido — usamos o inkBar global)
    local inkMark = o("Frame", {
        Size=UDim2.new(1,0,0,2),
        Position=UDim2.new(0,0,1,-2),
        BackgroundColor3=self._accent,
        BackgroundTransparency=1,
        BorderSizePixel=0, ZIndex=6,
    }, tabBtn)
    self:_registerThemeItem(inkMark, "BackgroundColor3", "accent")

    -- container desta tab
    local tabContainer = o("ScrollingFrame", {
        Size=UDim2.new(1,-4,1,-TAB_H-4),
        Position=UDim2.new(0,2,0,TAB_H+2),
        BackgroundTransparency=1, BorderSizePixel=0,
        ScrollBarThickness=3, ScrollBarImageColor3=self._accent,
        ScrollingDirection=Enum.ScrollingDirection.Y,
        ElasticBehavior=Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize=Enum.AutomaticSize.Y,
        CanvasSize=UDim2.new(1,0,0,0), Visible=false,
    }, self.contentFrame)
    self:_registerThemeItem(tabContainer, "ScrollBarImageColor3", "accent")
    o("UIListLayout", { Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder }, tabContainer)
    o("UIPadding", {
        PaddingLeft=UDim.new(0,6), PaddingRight=UDim.new(0,6),
        PaddingTop=UDim.new(0,4),  PaddingBottom=UDim.new(0,4),
    }, tabContainer)

    local tabData = {
        name=name, icon=icon, btn=tabBtn, inkMark=inkMark,
        container=tabContainer, layoutOrder=0, index=tabIndex,
    }
    table.insert(self._tabs, tabData)

    -- clicar na tab
    tabBtn.MouseButton1Click:Connect(function()
        self:_SelectTab(tabIndex)
    end)

    -- selecionar automaticamente a primeira
    if tabIndex == 1 then
        self:_SelectTab(1)
    end

    -- Tab object com todos os métodos de widget delegando ao container correto
    local Tab = {}
    for k, v in pairs(KronUI) do
        if type(v)=="function" and k~="new" and k~="AddTab" then
            Tab[k] = function(_, ...)
                local oldContainer = self.container
                local oldOrder     = self._layoutOrder
                self.container    = tabContainer
                self._layoutOrder = tabData.layoutOrder
                local result = v(self, ...)
                tabData.layoutOrder = self._layoutOrder
                self.container    = oldContainer
                self._layoutOrder = oldOrder
                return result
            end
        end
    end
    Tab._tabData = tabData
    Tab._ui      = self
    setmetatable(Tab, { __index = self })

    return Tab
end

function KronUI:_SelectTab(idx)
    local tabs = self._tabs
    if not tabs[idx] then return end

    -- esconder anterior
    if self._activeTab then
        local prev = tabs[self._activeTab]
        if prev then
            prev.container.Visible = false
            tween(prev.btn:FindFirstChildWhichIsA("TextLabel"),
                EASE_OUT(0.15), {TextColor3=DIM})
            tween(prev.inkMark, EASE_OUT(0.15), {BackgroundTransparency=1})
        end
    end

    self._activeTab = idx
    local cur = tabs[idx]
    cur.container.Visible = true
    tween(cur.btn:FindFirstChildWhichIsA("TextLabel"),
        EASE_OUT(0.15), {TextColor3=W})
    tween(cur.inkMark, EASE_OUT(0.15), {BackgroundTransparency=0})

    -- mover ink bar global
    local btnAbsX = cur.btn.AbsolutePosition.X - self._tabBar.AbsolutePosition.X
    local btnAbsW = cur.btn.AbsoluteSize.X
    tween(self._inkBar, EASE_OUT(0.22), {
        Position=UDim2.new(0,btnAbsX,1,-2),
        Size=UDim2.new(0,btnAbsW,0,2),
    })
end

