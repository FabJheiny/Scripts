-- ── Input ─────────────────────────────────────────────
function KronUI:AddInput(text, placeholder, callback)
    local holder = o("Frame", {
        Size=UDim2.new(1,0,0,52), BackgroundColor3=CARD,
        BorderSizePixel=0, LayoutOrder=self:_nextOrder(),
    }, self.container)
    local hStroke = strokeIn(holder,1,LINE)
    corner(holder,8)

    o("TextLabel",{
        BackgroundTransparency=1, Position=UDim2.new(0,12,0,4),
        Size=UDim2.new(1,-16,0,16),
        Font=FONTB, TextSize=10, TextColor3=MID,
        TextXAlignment=Enum.TextXAlignment.Left,
        Text=string.upper(text or ""),
    }, holder)

    local inputBg = o("Frame",{
        Position=UDim2.new(0,8,0,22), Size=UDim2.new(1,-16,0,22),
        BackgroundColor3=PANEL, BorderSizePixel=0,
    }, holder)
    corner(inputBg,6)
    local inputStroke = strokeIn(inputBg,1,LINE)

    local tb = o("TextBox",{
        Position=UDim2.new(0,8,0,0), Size=UDim2.new(1,-16,1,0),
        BackgroundTransparency=1, Font=FONT, TextSize=11,
        TextColor3=W, PlaceholderText=placeholder or "",
        PlaceholderColor3=DIM, ClearTextOnFocus=false,
        TextXAlignment=Enum.TextXAlignment.Left,
        BorderSizePixel=0,
    }, inputBg)

    tb.Focused:Connect(function()
        tween(inputStroke, EASE_OUT(0.15), {Color=self._accent, Transparency=0})
        tween(hStroke,     EASE_OUT(0.15), {Color=self._accent2, Transparency=0.5})
    end)
    tb.FocusLost:Connect(function(enterPressed)
        tween(inputStroke, EASE_OUT(0.15), {Color=LINE, Transparency=0})
        tween(hStroke,     EASE_OUT(0.15), {Color=LINE, Transparency=0})
        if callback then task.spawn(callback, tb.Text, enterPressed) end
    end)
    self:_registerThemeCallback(function(p, s)
        if tb:IsFocused() then
            inputStroke.Color = p; hStroke.Color = s
        end
    end)

    return {
        GetText  = function()  return tb.Text end,
        SetText  = function(t) tb.Text=t end,
        Focus    = function()  tb:CaptureFocus() end,
        Unfocus  = function()  tb:ReleaseFocus() end,
    }
end

-- ── Textarea ──────────────────────────────────────────
function KronUI:AddTextarea(text, placeholder, rows, callback)
    rows = math.clamp(rows or 3, 2, 7)
    local ROW_PX = 18
    local totalH = 24 + rows*ROW_PX + 8

    local holder = o("Frame", {
        Size=UDim2.new(1,0,0,totalH), BackgroundColor3=CARD,
        BorderSizePixel=0, LayoutOrder=self:_nextOrder(),
    }, self.container)
    local hStroke = strokeIn(holder,1,LINE)
    corner(holder,8)

    o("TextLabel",{
        BackgroundTransparency=1, Position=UDim2.new(0,12,0,4),
        Size=UDim2.new(1,-16,0,16),
        Font=FONTB, TextSize=10, TextColor3=MID,
        TextXAlignment=Enum.TextXAlignment.Left,
        Text=string.upper(text or ""),
    }, holder)

    local inputBg = o("Frame",{
        Position=UDim2.new(0,8,0,22),
        Size=UDim2.new(1,-16,0,rows*ROW_PX+4),
        BackgroundColor3=PANEL, BorderSizePixel=0,
    }, holder)
    corner(inputBg,6)
    local inputStroke = strokeIn(inputBg,1,LINE)

    local tb = o("TextBox",{
        Position=UDim2.new(0,8,0,4), Size=UDim2.new(1,-16,1,-8),
        BackgroundTransparency=1, Font=FONT, TextSize=11,
        TextColor3=W, PlaceholderText=placeholder or "",
        PlaceholderColor3=DIM, ClearTextOnFocus=false,
        TextXAlignment=Enum.TextXAlignment.Left,
        TextYAlignment=Enum.TextYAlignment.Top,
        MultiLine=true, TextWrapped=true,
        BorderSizePixel=0,
    }, inputBg)

    tb.Focused:Connect(function()
        tween(inputStroke, EASE_OUT(0.15), {Color=self._accent, Transparency=0})
        tween(hStroke,     EASE_OUT(0.15), {Color=self._accent2, Transparency=0.5})
    end)
    tb.FocusLost:Connect(function(enterPressed)
        tween(inputStroke, EASE_OUT(0.15), {Color=LINE, Transparency=0})
        tween(hStroke,     EASE_OUT(0.15), {Color=LINE, Transparency=0})
        if callback then task.spawn(callback, tb.Text, enterPressed) end
    end)

    return {
        GetText  = function()  return tb.Text end,
        SetText  = function(t) tb.Text=t end,
    }
end

-- ── Keybind ───────────────────────────────────────────
function KronUI:AddKeybind(text, defaultKey, callback)
    local currentKey = defaultKey or Enum.KeyCode.Unknown
    local listening  = false

    local holder = o("TextButton", {
        Size=UDim2.new(1,0,0,32), BackgroundColor3=CARD,
        BorderSizePixel=0, AutoButtonColor=false, Text="",
        LayoutOrder=self:_nextOrder(),
    }, self.container)
    local hStroke = strokeIn(holder,1,LINE)
    corner(holder,8)

    o("TextLabel",{
        BackgroundTransparency=1, Position=UDim2.new(0,12,0,0),
        Size=UDim2.new(1,-80,1,0),
        Font=FONT, TextSize=12, TextColor3=MID,
        TextXAlignment=Enum.TextXAlignment.Left, Text=text,
    }, holder)

    local badge = o("Frame",{
        AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-10,0.5,0),
        Size=UDim2.new(0,64,0,20),
        BackgroundColor3=PANEL, BorderSizePixel=0,
    }, holder)
    corner(badge,6)
    local badgeStroke = strokeIn(badge,1,LINE)

    local badgeLbl = o("TextLabel",{
        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        Font=FONTB, TextSize=10, TextColor3=MID,
        TextXAlignment=Enum.TextXAlignment.Center, Text="...",
    }, badge)

    local function updateBadge()
        if listening then
            badgeLbl.Text      = "[ Pressione ]"
            badgeLbl.TextSize  = 8
            badgeLbl.TextColor3 = self._accent
            tween(badgeStroke, EASE_OUT(0.15), {Color=self._accent})
            tween(badge, EASE_OUT(0.15), {BackgroundColor3=self._accent2})
            -- pulso
            TweenService:Create(badgeStroke,
                TweenInfo.new(0.6,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,-1,true),
                {Transparency=0.5}):Play()
        else
            local keyName = (currentKey==Enum.KeyCode.Unknown) and "Nenhum"
                or currentKey.Name:gsub("^Left","L"):gsub("^Right","R")
            badgeLbl.Text       = keyName
            badgeLbl.TextSize   = 10
            badgeLbl.TextColor3 = W
            badgeStroke.Transparency = 0
            tween(badgeStroke, EASE_OUT(0.15), {Color=LINE})
            tween(badge, EASE_OUT(0.15), {BackgroundColor3=PANEL})
        end
    end
    self:_registerThemeCallback(function() updateBadge() end)
    updateBadge()

    holder.MouseEnter:Connect(function()
        tween(hStroke,EASE_OUT(0.12),{Color=self._accent2,Transparency=0.4})
    end)
    holder.MouseLeave:Connect(function()
        if not listening then tween(hStroke,EASE_OUT(0.12),{Color=LINE,Transparency=0}) end
    end)

    holder.MouseButton1Click:Connect(function()
        self._playClick()
        listening = not listening
        updateBadge()
    end)

    table.insert(self._connections, UserInputService.InputBegan:Connect(function(inp, processed)
        if not listening then return end
        if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if inp.KeyCode == Enum.KeyCode.Escape then
            listening=false; updateBadge(); return
        end
        currentKey = inp.KeyCode
        listening  = false
        updateBadge()
        if callback then task.spawn(callback, currentKey) end
    end))

    return {
        GetKey   = function()  return currentKey end,
        SetKey   = function(k) currentKey=k updateBadge() end,
        GetName  = function()
            return (currentKey==Enum.KeyCode.Unknown) and "Nenhum" or currentKey.Name
        end,
    }
end

-- ── ProgressBar ───────────────────────────────────────
function KronUI:AddProgressBar(text, value, maxVal)
    value  = value  or 0
    maxVal = maxVal or 100

    local holder = o("Frame",{
        Size=UDim2.new(1,0,0,44), BackgroundColor3=CARD,
        BorderSizePixel=0, LayoutOrder=self:_nextOrder(),
    }, self.container)
    strokeIn(holder,1,LINE); corner(holder,8)

    local labelRow = o("Frame",{
        Size=UDim2.new(1,0,0,22), BackgroundTransparency=1,
    }, holder)
    o("TextLabel",{BackgroundTransparency=1, Position=UDim2.new(0,12,0,0),
        Size=UDim2.new(1,-60,1,0), Font=FONT, TextSize=12, TextColor3=MID,
        TextXAlignment=Enum.TextXAlignment.Left, Text=text},labelRow)
    local pctLbl = o("TextLabel",{BackgroundTransparency=1,
        Position=UDim2.new(1,-50,0,0), Size=UDim2.new(0,44,1,0),
        Font=FONTB, TextSize=11, TextColor3=self._accent,
        TextXAlignment=Enum.TextXAlignment.Right},labelRow)
    self:_registerThemeItem(pctLbl,"TextColor3","accent")

    local track = o("Frame",{
        Size=UDim2.new(1,-24,0,6), Position=UDim2.new(0,12,0,30),
        BackgroundColor3=LINE, BorderSizePixel=0,
    }, holder)
    corner(track,"pill")

    local fill = o("Frame",{
        Size=UDim2.new(0,0,1,0), BackgroundColor3=self._accent,
        BorderSizePixel=0, ClipsDescendants=true,
    }, track)
    corner(fill,"pill")
    local fillGrad = o("UIGradient",{
        Color=ColorSequence.new(self._accent2,self._accent),
    }, fill)
    self:_registerThemeGradient(fillGrad)

    -- glint animado
    local glint = o("Frame",{
        Size=UDim2.new(0,40,1,0), Position=UDim2.new(-0.5,0,0,0),
        BackgroundTransparency=1, BorderSizePixel=0,
    }, fill)
    o("UIGradient",{
        Rotation=90,
        Transparency=NumberSequence.new({
            NumberSequenceKeypoint.new(0,1),
            NumberSequenceKeypoint.new(0.5,0.5),
            NumberSequenceKeypoint.new(1,1),
        }),
        Color=ColorSequence.new(Color3.new(1,1,1),Color3.new(1,1,1)),
    }, glint)
    local function loopGlint()
        glint.Position=UDim2.new(-0.5,0,0,0)
        local t=tween(glint, TweenInfo.new(1.4,Enum.EasingStyle.Sine),
            {Position=UDim2.new(1.5,0,0,0)})
        t.Completed:Connect(function()
            task.delay(0.8, loopGlint)
        end)
    end
    loopGlint()

    self:_registerThemeCallback(function(primary, secondary)
        fill.BackgroundColor3 = primary
        pctLbl.TextColor3     = primary
        fillGrad.Color = ColorSequence.new(secondary, primary)
    end)

    local function redraw()
        local rel = math.clamp(value/maxVal, 0, 1)
        tween(fill, EASE_OUT(0.25), {Size=UDim2.new(rel,0,1,0)})
        pctLbl.Text = math.floor(rel*100).."%"
    end
    redraw()

    return {
        SetValue = function(v)
            value = math.clamp(v, 0, maxVal); redraw()
        end,
        GetValue = function() return value end,
        SetMax   = function(m)
            maxVal=m; redraw()
        end,
    }
end

-- ── ColorPicker ───────────────────────────────────────
function KronUI:AddColorPicker(text, defaultColor, callback)
    local hue, sat, bri = rgbToHsv(defaultColor or self._accent)
    local currentColor = defaultColor or self._accent
    local open = false

    local PICKER_H = 140

    local holder = o("Frame",{
        Size=UDim2.new(1,0,0,32), AutomaticSize=Enum.AutomaticSize.Y,
        BackgroundColor3=CARD, BorderSizePixel=0, ClipsDescendants=true,
        LayoutOrder=self:_nextOrder(),
    }, self.container)
    local hStroke = strokeIn(holder,1,LINE)
    corner(holder,8)

    -- cabeçalho
    local head = o("TextButton",{
        Size=UDim2.new(1,0,0,32), BackgroundTransparency=1,
        AutoButtonColor=false, Text="",
    }, holder)
    o("TextLabel",{BackgroundTransparency=1, Position=UDim2.new(0,12,0,0),
        Size=UDim2.new(1,-60,1,0), Font=FONT, TextSize=12, TextColor3=MID,
        TextXAlignment=Enum.TextXAlignment.Left, Text=text}, head)

    -- preview dot
    local preview = o("Frame",{
        AnchorPoint=Vector2.new(1,0.5), Position=UDim2.new(1,-36,0.5,0),
        Size=UDim2.new(0,16,0,16), BackgroundColor3=currentColor, BorderSizePixel=0,
    }, head)
    corner(preview,"pill"); stroke(preview,1,LINE)

    local arrow = o("TextLabel",{BackgroundTransparency=1, Position=UDim2.new(1,-26,0,0),
        Size=UDim2.new(0,20,1,0), Font=FONTB, TextSize=16, TextColor3=DIM,
        TextXAlignment=Enum.TextXAlignment.Center, Text="▼", Rotation=0}, head)

    -- painel do picker (colapsável)
    local pickerWrap = o("Frame",{
        Size=UDim2.new(1,0,0,0), Position=UDim2.new(0,0,0,32),
        BackgroundTransparency=1, ClipsDescendants=true,
    }, holder)

    local pickerInner = o("Frame",{
        Size=UDim2.new(1,-16,0,PICKER_H),
        AnchorPoint=Vector2.new(0.5,0), Position=UDim2.new(0.5,0,0,6),
        BackgroundTransparency=1,
    }, pickerWrap)

    -- SV square (saturação × brilho)
    local SV_W, SV_H = 120, 90
    local svBox = o("ImageLabel",{
        Size=UDim2.new(0,SV_W,0,SV_H), Position=UDim2.new(0,0,0,0),
        BackgroundColor3=Color3.fromHSV(hue,1,1),
        BorderSizePixel=0,
        Image="rbxassetid://0", -- filled by gradients
    }, pickerInner)
    corner(svBox,4)

    -- white left-to-right gradient
    local svGradH = o("UIGradient",{
        Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0,Color3.new(1,1,1)),
            ColorSequenceKeypoint.new(1,Color3.new(1,1,1)),
        }),
        Transparency=NumberSequence.new({
            NumberSequenceKeypoint.new(0,0),
            NumberSequenceKeypoint.new(1,1),
        }),
    }, svBox)

    -- black bottom gradient overlay
    local svOverlay = o("Frame",{
        Size=UDim2.new(1,0,1,0), BackgroundTransparency=1,
        BorderSizePixel=0,
    }, svBox)
    o("UIGradient",{
        Rotation=90,
        Color=ColorSequence.new(Color3.new(0,0,0),Color3.new(0,0,0)),
        Transparency=NumberSequence.new({
            NumberSequenceKeypoint.new(0,1),
            NumberSequenceKeypoint.new(1,0),
        }),
    }, svOverlay)

    -- knob SV
    local svKnob = o("Frame",{
        Size=UDim2.new(0,10,0,10), AnchorPoint=Vector2.new(0.5,0.5),
        BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, ZIndex=5,
    }, svBox)
    corner(svKnob,"pill"); stroke(svKnob,1.5,Color3.new(1,1,1))

    -- hue bar
    local HUE_W = 14
    local hueBar = o("Frame",{
        Size=UDim2.new(0,HUE_W,0,SV_H),
        Position=UDim2.new(0,SV_W+6,0,0),
        BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0,
    }, pickerInner)
    corner(hueBar,4)
    o("UIGradient",{
        Rotation=90,
        Color=ColorSequence.new({
            ColorSequenceKeypoint.new(0,    Color3.fromHSV(0,1,1)),
            ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17,1,1)),
            ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33,1,1)),
            ColorSequenceKeypoint.new(0.5,  Color3.fromHSV(0.5,1,1)),
            ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67,1,1)),
            ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83,1,1)),
            ColorSequenceKeypoint.new(1,    Color3.fromHSV(1,1,1)),
        }),
    }, hueBar)

    local hueKnob = o("Frame",{
        Size=UDim2.new(1,4,0,6), AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.new(0.5,0,0,0),
        BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, ZIndex=5,
    }, hueBar)
    corner(hueKnob,"pill"); stroke(hueKnob,1,Color3.new(0,0,0),0.3)

    -- hex input
    local hexBg = o("Frame",{
        Size=UDim2.new(0,SV_W,0,22),
        Position=UDim2.new(0,0,0,SV_H+6),
        BackgroundColor3=PANEL, BorderSizePixel=0,
    }, pickerInner)
    corner(hexBg,5); strokeIn(hexBg,1,LINE)
    o("TextLabel",{BackgroundTransparency=1, Position=UDim2.new(0,6,0,0),
        Size=UDim2.new(0,14,1,0), Font=FONTB, TextSize=11, TextColor3=DIM,
        TextXAlignment=Enum.TextXAlignment.Left, Text="#"}, hexBg)
    local hexBox = o("TextBox",{
        Position=UDim2.new(0,16,0,0), Size=UDim2.new(1,-20,1,0),
        BackgroundTransparency=1, Font=FONT, TextSize=11,
        TextColor3=W, ClearTextOnFocus=false,
        TextXAlignment=Enum.TextXAlignment.Left,
        MaxVisibleGraphemes=6,
    }, hexBg)

    -- preview grande (color patch ao lado do hex)
    local bigPreview = o("Frame",{
        Size=UDim2.new(0,HUE_W,0,22),
        Position=UDim2.new(0,SV_W+6,0,SV_H+6),
        BackgroundColor3=currentColor, BorderSizePixel=0,
    }, pickerInner)
    corner(bigPreview,5); stroke(bigPreview,1,LINE)

    local draggingSV  = false
    local draggingHue = false

    local function refreshAll()
        currentColor = hsvToRgb(hue,sat,bri)
        svBox.BackgroundColor3 = Color3.fromHSV(hue,1,1)
        svKnob.Position = UDim2.new(sat,0,1-bri,0)
        hueKnob.Position = UDim2.new(0.5,0,hue,0)
        preview.BackgroundColor3    = currentColor
        bigPreview.BackgroundColor3 = currentColor
        hexBox.Text = colorToHex(currentColor)
        if callback then task.spawn(callback, currentColor) end
    end
    refreshAll()

    local function svFromPos(ax, ay)
        local rel_s = math.clamp((ax - svBox.AbsolutePosition.X) / svBox.AbsoluteSize.X, 0, 1)
        local rel_v = 1 - math.clamp((ay - svBox.AbsolutePosition.Y) / svBox.AbsoluteSize.Y, 0, 1)
        sat=rel_s; bri=rel_v; refreshAll()
    end
    local function hueFromPos(ay)
        hue = math.clamp((ay - hueBar.AbsolutePosition.Y) / hueBar.AbsoluteSize.Y, 0, 1)
        refreshAll()
    end

    table.insert(self._connections, svBox.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1
        or inp.UserInputType==Enum.UserInputType.Touch then
            draggingSV=true; svFromPos(inp.Position.X, inp.Position.Y)
        end
    end))
    table.insert(self._connections, hueBar.InputBegan:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1
        or inp.UserInputType==Enum.UserInputType.Touch then
            draggingHue=true; hueFromPos(inp.Position.Y)
        end
    end))
    table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseMovement
        or inp.UserInputType==Enum.UserInputType.Touch then
            if draggingSV  then svFromPos(inp.Position.X, inp.Position.Y)  end
            if draggingHue then hueFromPos(inp.Position.Y) end
        end
    end))
    table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1
        or inp.UserInputType==Enum.UserInputType.Touch then
            draggingSV=false; draggingHue=false
        end
    end))

    hexBox.FocusLost:Connect(function()
        local c = hexToColor(hexBox.Text)
        if c then
            hue,sat,bri = rgbToHsv(c)
            refreshAll()
        else
            hexBox.Text = colorToHex(currentColor)
        end
    end)

    local function setOpen(v)
        open=v
        local ti=EASE_OUT(0.2)
        tween(pickerWrap,ti,{Size=UDim2.new(1,0,0,open and (PICKER_H+12) or 0)})
        tween(arrow,ti,{Rotation=open and 180 or 0})
        if open then
            tween(hStroke,ti,{Color=self._accent2,Transparency=0.4})
        else
            tween(hStroke,ti,{Color=LINE,Transparency=0})
        end
    end
    head.MouseEnter:Connect(function() if not open then holder.BackgroundColor3=HOVER end end)
    head.MouseLeave:Connect(function() if not open then holder.BackgroundColor3=CARD  end end)
    table.insert(self._connections, head.MouseButton1Click:Connect(function()
        self._playClick(); setOpen(not open)
    end))

    self:_registerThemeCallback(function()
        if open then hStroke.Color=self._accent2 end
    end)

    return {
        GetColor = function() return currentColor end,
        SetColor = function(c)
            hue,sat,bri=rgbToHsv(c); refreshAll()
        end,
        Close = function() setOpen(false) end,
    }
end

