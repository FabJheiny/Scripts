    corner(topBar, CORNER_R)

    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 1, -CORNER_R),
        BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 11,
    }, topBar)
    o("Frame", {
        Size = UDim2.new(1, 0, 0, CORNER_R),
        Position = UDim2.new(0, 0, 1, -CORNER_R),
        BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 11,
    }, topBar)

    local topIcon = o("ImageLabel", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(0, 10, 0.5, -9),
        BackgroundTransparency = 1,
        Image = tostring(pillImage or "rbxassetid://78186286433275"),
        ImageColor3 = self._accent,
        ZIndex = 12,
    }, topBar)
    self:_registerThemeItem(topIcon, "ImageColor3", "accent")

    o("TextLabel", {
        Size = UDim2.new(1, -160, 1, 0),
        Position = UDim2.new(0, 34, 0, 0),
        BackgroundTransparency = 1,
        Text = title or "Interface",
        TextColor3 = W, TextSize = 13, Font = FONTB,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 12,
    }, topBar)

    local shimmer = o("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = self._accent,
        BorderSizePixel = 0, ZIndex = 20,
    }, topBar)
    self:_registerThemeItem(shimmer, "BackgroundColor3", "accent")
    local shimmerGrad = o("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   self._accent2),
            ColorSequenceKeypoint.new(0.45, self._accent),
            ColorSequenceKeypoint.new(0.55, self._accent3),
            ColorSequenceKeypoint.new(1,   self._accent2),
        }),
        Offset = Vector2.new(-1.2, 0),
    }, shimmer)
    self:_registerThemeGradient(shimmerGrad)
    local shimmerT = TweenService:Create(shimmerGrad,
        TweenInfo.new(2.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, false),
        { Offset = Vector2.new(1.2, 0) })
    shimmerT:Play()
    self._shimmerTween = shimmerT

    local STEP_W, STEP_H = 60, 18
    local stepHolder = o("Frame", {
        Size = UDim2.new(0, STEP_W, 0, STEP_H),
        Position = UDim2.new(1, -(36 + 8 + STEP_W), 0.5, -STEP_H / 2),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10,
        ClipsDescendants = true,
    }, topBar)
    strokeIn(stepHolder, 1, LINE)
    corner(stepHolder, 6)
    local bsz = STEP_H
    local dv  = 1
    local nw  = STEP_W - 2 * bsz - 2 * dv
    local stepPlus = o("TextButton", {
        Size = UDim2.new(0, bsz, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = "+", TextColor3 = MID, TextSize = 14, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, stepHolder)
    o("Frame", { Size = UDim2.new(0, dv, 1, 0), Position = UDim2.new(0, bsz, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 11 }, stepHolder)
    local stepBox = o("TextBox", {
        Size = UDim2.new(0, nw, 1, 0), Position = UDim2.new(0, bsz + dv, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(_G.KronUIScale),
        TextColor3 = W, TextSize = 10, Font = FONT,
        TextXAlignment = Enum.TextXAlignment.Center,
        ClearTextOnFocus = false, ZIndex = 11,
    }, stepHolder)
    o("Frame", { Size = UDim2.new(0, dv, 1, 0), Position = UDim2.new(0, bsz + dv + nw, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 11 }, stepHolder)
    local stepMinus = o("TextButton", {
        Size = UDim2.new(0, bsz, 1, 0), Position = UDim2.new(0, bsz + dv + nw + dv, 0, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = "−", TextColor3 = MID, TextSize = 14, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, stepHolder)
    local stepCv = _G.KronUIScale
    local function stepApply(v)
        v = math.clamp(math.floor(v), 1, 35)
        stepCv = v; _G.KronUIScale = v
        stepBox.Text = tostring(v)
        tween(uiScaleObj, EASE_OUT(0.14), { Scale = getUIScale(v) })
    end
    stepPlus.MouseButton1Click:Connect(function()  stepApply(stepCv + 1) end)
    stepMinus.MouseButton1Click:Connect(function() stepApply(stepCv - 1) end)
    stepBox.FocusLost:Connect(function()
        local n = tonumber(stepBox.Text)
        if n then stepApply(n) else stepBox.Text = tostring(stepCv) end
    end)
    for _, btn in ipairs({stepPlus, stepMinus}) do
        btn.MouseEnter:Connect(function() btn.TextColor3 = self._accent end)
        btn.MouseLeave:Connect(function() btn.TextColor3 = MID end)
        self:_registerThemeCallback(function(p) btn.TextColor3 = MID end)
    end

    o("Frame", {
        Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -35, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 12,
    }, topBar)

    local xBtn = o("TextButton", {
        Size = UDim2.new(0, 34, 1, 0), Position = UDim2.new(1, -34, 0, 0),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        Text = "×", TextColor3 = DIM, TextSize = 18, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, topBar)
    corner(xBtn, CORNER_R)
    for _, pos in ipairs({
        UDim2.new(0, 0, 0, 0),
        UDim2.new(0, 0, 1, -CORNER_R),
        UDim2.new(1, -CORNER_R, 1, -CORNER_R),
    }) do
        o("Frame", { Size = UDim2.new(0, CORNER_R, 0, CORNER_R), Position = pos,
            BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 12 }, xBtn)
    end
    xBtn.MouseEnter:Connect(function()
        tween(xBtn, EASE_OUT(0.1), { BackgroundColor3 = Color3.fromRGB(80,20,30) })
        xBtn.TextColor3 = ERROR
    end)
    xBtn.MouseLeave:Connect(function()
        tween(xBtn, EASE_OUT(0.15), { BackgroundColor3 = BG })
        xBtn.TextColor3 = DIM
    end)

    do
        local dragging, dragStart, startPos, _tid = false, nil, nil, nil
        table.insert(self._connections, topBar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; dragStart = inp.Position; startPos = self.menuFrame.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _tid ~= nil then return end
                _tid = inp; dragging = true; dragStart = inp.Position; startPos = self.menuFrame.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _tid then return end
            if isM or isT then
                local d = inp.Position - dragStart
                self.menuFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false; dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _tid then return end
                dragging = false; _tid = nil; dragStart = nil; startPos = nil
            end
        end))
    end

    self.tabBar = o("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, topH),
        BackgroundColor3 = BG,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = false,
    }, self.menuFrame)
    o("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Left,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.tabBar)
    o("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6) }, self.tabBar)
    local tabBarLine = o("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = LINE,
        BorderSizePixel = 0, ZIndex = 5,
    }, self.tabBar)

    self.contentArea = o("Frame", {
        Size = UDim2.new(1, 0, 1, -topH),
        Position = UDim2.new(0, 0, 0, topH),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, self.menuFrame)
    corner(self.contentArea, CORNER_R)
    o("Frame", { Size = UDim2.new(0, CORNER_R, 0, CORNER_R), Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = PANEL, BorderSizePixel = 0 }, self.contentArea)
    o("Frame", { Size = UDim2.new(0, CORNER_R, 0, CORNER_R), Position = UDim2.new(1, -CORNER_R, 0, 0),
        BackgroundColor3 = PANEL, BorderSizePixel = 0 }, self.contentArea)

    self.container = o("ScrollingFrame", {
        Size = UDim2.new(1, -4, 1, -6),
        Position = UDim2.new(0, 2, 0, 4),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
        Visible = true,
    }, self.contentArea)
    self:_registerThemeItem(self.container, "ScrollBarImageColor3", "accent")
    o("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, self.container)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
        PaddingTop = UDim.new(0, 4),  PaddingBottom = UDim.new(0, 4),
    }, self.container)

    self.btnGui = o("ScreenGui", {
        Name = "KronUI_FloatBtn", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 9999,
    })
    local okPill = pcall(function() self.btnGui.Parent = CoreGui end)
    if not okPill then self.btnGui.Parent = pg end

    local PILL_SIZE = 48
    local pill = o("Frame", {
        Name = "PillUI",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(1, -52, 1, -248),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        ClipsDescendants = false, Visible = false, ZIndex = 200,
    }, self.btnGui)
    corner(pill, "pill")
    local pillBorderOuter = stroke(pill, 1, LINE)
    local pillBorderInner = stroke(pill, 1.8, self._accent, 0.45)
    self:_registerThemeItem(pillBorderInner, "Color", "accent")
    self._pill = pill

    local pillGlow = o("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(1.4, 0, 1.4, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundTransparency = 1,
        ZIndex = 199,
    }, pill)
    corner(pillGlow, "pill")
    local pillGlowStroke = stroke(pillGlow, 3, self._accent, 0.8)
    self:_registerThemeItem(pillGlowStroke, "Color", "accent")
    local breatheT = TweenService:Create(pillGlowStroke,
        TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        { Transparency = 0.97 })
    breatheT:Play()
    self._breatheTween = breatheT

    local resolvedImage = tostring(pillImage or "rbxassetid://78186286433275")
    if not resolvedImage:find("rbxassetid://") then
        resolvedImage = "rbxassetid://" .. resolvedImage
    end
    local pillIcon = o("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 28, 0, 28),
        BackgroundTransparency = 1,
        Image = resolvedImage,
        ImageColor3 = W,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = 202,
    }, pill)
    local pillBtn = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false,
        BorderSizePixel = 0, ZIndex = 203,
    }, pill)
    pillBtn.MouseEnter:Connect(function() tween(pillIcon, EASE_OUT(0.12), { ImageColor3 = self._accent }) end)
    pillBtn.MouseLeave:Connect(function() tween(pillIcon, EASE_OUT(0.15), { ImageColor3 = W }) end)
    local pillScale = o("UIScale", { Scale = 1 }, pill)
    pillBtn.MouseButton1Down:Connect(function()  tween(pillScale, EASE_OUT(0.08), { Scale = 0.88 }) end)
    pillBtn.MouseButton1Up:Connect(function()    tween(pillScale, EASE_BACK(0.2), { Scale = 1 })   end)
    pillBtn.MouseLeave:Connect(function()        tween(pillScale, EASE_OUT(0.15), { Scale = 1 })   end)

    local notifBadge = o("Frame", {
        Name = "NotifBadge",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 4, 0, -4),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundColor3 = ERROR,
        BorderSizePixel = 0,
        Visible = false, ZIndex = 205,
    }, pill)
    corner(notifBadge, "pill")
    local notifBadgeLabel = o("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "0", Font = FONTB, TextSize = 10,
        TextColor3 = W, ZIndex = 206,
    }, notifBadge)
    self._notifBadge      = notifBadge
    self._notifBadgeLabel = notifBadgeLabel

    local function frostBurst()
        for i = 1, 2 do
            task.delay(i * 0.06, function()
                local ring = o("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = pill.Position,
                    Size = UDim2.new(0, PILL_SIZE, 0, PILL_SIZE),
                    BackgroundTransparency = 1, ZIndex = 250,
                }, self.btnGui)
                corner(ring, "pill")
                local rStroke = stroke(ring, 2, self._accent)
                tween(ring, EASE_OUT(0.55), { Size = UDim2.new(0, PILL_SIZE + 70, 0, PILL_SIZE + 70) })
                tween(rStroke, EASE_OUT(0.55), { Transparency = 1 })
                task.delay(0.55, function() ring:Destroy() end)
            end)
        end
    end

    local function showPill()
        pill.Visible = true
        pill.Size = UDim2.new(0, 0, 0, 0)
        tween(pill, EASE_BACK(0.38), { Size = UDim2.new(0, PILL_SIZE, 0, PILL_SIZE) })
    end
    local function hidePill()
        local t = tween(pill, EASE_OUT(0.2), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function() if pill.Size.X.Offset <= 1 then pill.Visible = false end end)
    end
    local function showMenu()
        self.menuFrame.Visible = true
        self.menuFrame.Size    = UDim2.new(0, 0, 0, 0)
        tween(self.menuFrame, EASE_BACK(0.45), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
        self._playOpen()
    end
    local function hideMenu()
        local t = tween(self.menuFrame, EASE_OUT(0.22), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function() if self.menuFrame.Size.X.Offset <= 1 then self.menuFrame.Visible = false end end)
        self._playClose()
    end

    xBtn.MouseButton1Click:Connect(function()
        self._playClick()
        hideMenu()
        showPill()
    end)

    do
        local dragging, dragMoved, dragStart, startPos, _tid = false, false, nil, nil, nil
        table.insert(self._connections, pillBtn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; dragMoved = false; dragStart = inp.Position; startPos = pill.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _tid ~= nil then return end
                _tid = inp; dragging = true; dragMoved = false; dragStart = inp.Position; startPos = pill.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _tid then return end
            if isM or isT then
                local d = inp.Position - dragStart
                if d.Magnitude > 5 then dragMoved = true end
                pill.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                                          startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if not dragging then return end
                dragging = false
                if not dragMoved then self._playClick(); frostBurst(); hidePill(); showMenu() end
                dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _tid then return end
                local wasMoved = dragMoved
                dragging = false; dragMoved = false; _tid = nil; dragStart = nil; startPos = nil
                if not wasMoved then self._playClick(); frostBurst(); hidePill(); showMenu() end
            end
        end))
    end

    self:AddSectionLabel("🎨 Tema")
    self:AddThemeDropdown()

    return self
end

