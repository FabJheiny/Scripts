-- Tabs
local tabBtns,tabPages,cur={},{},nil
local function sw(idx)
    if cur==idx then return end
    if cur then tabBtns[cur].BackgroundColor3=B tabBtns[cur].TextColor3=W end
    cur=idx tabBtns[idx].BackgroundColor3=B tabBtns[idx].TextColor3=W
    for j,p in ipairs(tabPages) do p.Visible=(j==idx) end
end
local function makeTabBtn(name,idx)
    local tb=o("TextButton",{
        Size=UDim2.new(1,0,0,30),BackgroundColor3=B,BorderSizePixel=0,
        Text=name,TextColor3=W,TextSize=14,Font=FONT_MAIN,
        AutoButtonColor=false,LayoutOrder=idx,TextWrapped=true,
    },tlist)
    stroke(tb,1)
    tb.MouseEnter:Connect(function() if cur~=idx then tb.BackgroundColor3=Color3.fromRGB(10,10,10) end end)
    tb.MouseLeave:Connect(function() if cur~=idx then tb.BackgroundColor3=B end end)
    return tb
end

