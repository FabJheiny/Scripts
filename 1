-- ══════════════ DESTROY ══════════════
function KronUI:Destroy()
    for _, conn in ipairs(self._connections) do pcall(function() conn:Disconnect() end) end
    self._connections = {}
    if self._breatheTween then self._breatheTween:Cancel() end
    if self._shimmerTween  then self._shimmerTween:Cancel()  end
    if self.gui            then self.gui:Destroy()            end
    if self.btnGui         then self.btnGui:Destroy()         end
    if self.notifGui       then self.notifGui:Destroy()       end
end

function KronUI:_nextOrder()
    self._layoutOrder = self._layoutOrder + 1
    return self._layoutOrder
end

-- ══════════════ TABS ══════════════
function KronUI:AddTab(name, icon)
    local TAB_H = 30
    if not self._tabBarVisible then
        self._tabBarVisible = true
        self.tabBar.Visible = true
        self.tabBar.Size    = UDim2.new(1, 0, 0, TAB_H)
        self.contentArea.Size     = UDim2.new(1, 0, 1, -(36 + TAB_H))
        self.contentArea.Position = UDim2.new(0, 0, 0, 36 + TAB_H)
        self.container.Visible = false
    end

    local tabBtn = o("TextButton", {
        Size = UDim2.new(0, 80, 1, 0),
        BackgroundTransparency = 1,
        AutoButtonColor = false, Text = "",
        LayoutOrder = #self._tabs + 1,
    }, self.tabBar)
    o("TextLabel", {
        Size = UDim2.new(1, 0, 1, -2),
        BackgroundTransparency = 1,
        Text = (icon and icon .. " " or "") .. name,
        Font = FONTB, TextSize = 11,
        TextColor3 = DIM,
    }, tabBtn)
    local tabUnder = o("Frame", {
        Size = UDim2.new(0, 0, 0, 2),
        Position = UDim2.new(0.5, 0, 1, -1),
        AnchorPoint = Vector2.new(0.5, 0),
        BackgroundColor3 = self._accent,
        BorderSizePixel = 0,
    }, tabBtn)
    self:_registerThemeItem(tabUnder, "BackgroundColor3", "accent")

    local tabContainer = o("ScrollingFrame", {
        Size = UDim2.new(1, -4, 1, -6),
        Position = UDim2.new(0, 2, 0, 4),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
        Visible = false,
    }, self.contentArea)
    self:_registerThemeItem(tabContainer, "ScrollBarImageColor3", "accent")
    o("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, tabContainer)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
        PaddingTop = UDim.new(0, 4),  PaddingBottom = UDim.new(0, 4),
    }, tabContainer)

    local tabData = {
        name = name,
        btn = tabBtn,
        under = tabUnder,
        container = tabContainer,
        label = tabBtn:FindFirstChildWhichIsA("TextLabel"),
    }
    table.insert(self._tabs, tabData)

    local function activateTab(td)
        for _, t in ipairs(self._tabs) do
            local isActive = t == td
            t.container.Visible = isActive
            tween(t.under, EASE_OUT(0.18), { Size = isActive and UDim2.new(0.7, 0, 0, 2) or UDim2.new(0, 0, 0, 2) })
            if t.label then
                t.label.TextColor3 = isActive and W or DIM
                t.label.Font = isActive and FONTB or FONT
            end
        end
        self._activeTab   = td
        self.container    = td.container
    end

    tabBtn.MouseButton1Click:Connect(function()
        self._playClick()
        activateTab(tabData)
    end)

    if #self._tabs == 1 then
        activateTab(tabData)
    end

    return {
        Select = function() activateTab(tabData) end,
        Container = tabContainer,
    }
end

