    self:_registerThemeItem(menuBorderInner, "Color", "accent")

    local uiScaleObj = o("UIScale", { Scale = getUIScale(_G.KronUIScale) }, self.menuFrame)

    task.defer(function()
        tween(self.menuFrame, EASE_BACK(0.55), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
