-- ══════════════ TOGGLE ══════════════
function KronUI:AddToggle(text, default, callback, tooltip)
    local state = default or false

    local btn = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, AutoButtonColor = false, Text = "",
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    local btnStroke = strokeIn(btn, 1, LINE)
    corner(btn, 8)

    local label = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -58, 1, 0),
        Font = FONT, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = text,
    }, btn)

    local trackW, trackH = 32, 16
    local track = o("Frame", {
        Size = UDim2.new(0, trackW, 0, trackH),
        Position = UDim2.new(1, -(trackW + 10), 0.5, -trackH / 2),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, btn)
    corner(track, "pill")
    local trackStroke = stroke(track, 1, LINE)

    local knob = o("Frame", {
        Size = UDim2.new(0, 11, 0, 11),
        Position = UDim2.new(0, 2, 0.5, -5.5),
        BackgroundColor3 = DIM, BorderSizePixel = 0,
    }, track)
    corner(knob, "pill")
    local knobShadow = o("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 1),
        Size = UDim2.new(1.4, 0, 1.4, 0),
        BackgroundTransparency = 1,
        ZIndex = knob.ZIndex and (knob.ZIndex - 1) or 0,
    }, knob)
    corner(knobShadow, "pill")

    local function refresh(animate)
        local ti = EASE_SINE(animate and 0.18 or 0)
        if state then
            tween(knob,       ti, { Position = UDim2.new(1, -13, 0.5, -5.5), BackgroundColor3 = W })
            tween(track,      ti, { BackgroundColor3 = self._accent2 })
            tween(trackStroke,ti, { Color = self._accent })
            tween(btnStroke,  ti, { Color = self._accent2, Transparency = 0.35 })
            label.TextColor3 = W
        else
            tween(knob,       ti, { Position = UDim2.new(0, 2, 0.5, -5.5), BackgroundColor3 = DIM })
            tween(track,      ti, { BackgroundColor3 = PANEL })
            tween(trackStroke,ti, { Color = LINE })
            tween(btnStroke,  ti, { Color = LINE, Transparency = 0 })
            label.TextColor3 = DIM
        end
    end
    refresh(false)
    self:_registerThemeCallback(function() refresh(false) end)

    btn.MouseEnter:Connect(function()
        if not state then
            tween(btn, EASE_OUT(0.1), { BackgroundColor3 = HOVER })
        end
        if tooltip then self:_showTooltip(tooltip, btn) end
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, EASE_OUT(0.12), { BackgroundColor3 = CARD })
        self:_hideTooltip()
    end)

    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        self._playClick()
        state = not state
        refresh(true)
        if callback then task.spawn(callback, state) end
    end))

    return {
        SetState  = function(v)    state = v; refresh(true)  end,
        GetState  = function()     return state              end,
        SetText   = function(t)    label.Text = t            end,
    }
end

-- ══════════════ BUTTON ══════════════
function KronUI:AddButton(text, callback, style, tooltip)
    local isGhost   = style == "ghost"
    local isDanger  = style == "danger"
    local isSuccess = style == "success"
    local isPrimary = style == "primary"

    local baseColor  = isPrimary and self._accent2 or CARD
    local textColor  = isDanger and ERROR or isSuccess and SUCCESS or MID
    local hoverBG    = isPrimary and self._accent or HOVER

    local btn = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = isGhost and Color3.fromRGB(0,0,0) or baseColor,
        BackgroundTransparency = isGhost and 1 or 0,
        BorderSizePixel = 0, AutoButtonColor = false, ClipsDescendants = true,
        Font = FONTB, TextSize = 12,
        Text = text, TextColor3 = isPrimary and W or textColor,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    local btnStroke = strokeIn(btn, isDanger and 1.5 or isSuccess and 1.5 or 1,
        isDanger and ERROR or isSuccess and SUCCESS or isGhost and LINE or LINE)
    corner(btn, 8)

    if isPrimary then
        local bg = o("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, self._accent2),
                ColorSequenceKeypoint.new(1, self._accent),
            }),
            Rotation = 90,
        }, btn)
        self:_registerThemeCallback(function(p, s)
            bg.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, s or self._accent2),
                ColorSequenceKeypoint.new(1, p),
            })
        end)
    end

    local function ripple(x, y)
        local r = o("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, x, 0, y),
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = isPrimary and W or self._accent,
            BackgroundTransparency = isPrimary and 0.7 or 0.5,
            BorderSizePixel = 0, ZIndex = 5,
        }, btn)
        corner(r, "pill")
        local maxD = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2
        local t = tween(r, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = UDim2.new(0, maxD, 0, maxD), BackgroundTransparency = 1 })
        t.Completed:Connect(function() r:Destroy() end)
    end

    btn.MouseEnter:Connect(function()
        tween(btn, EASE_OUT(0.12), { BackgroundColor3 = isDanger and Color3.fromRGB(60,15,20) or isSuccess and Color3.fromRGB(20,55,30) or HOVER })
        tween(btnStroke, EASE_OUT(0.12), { Color = isDanger and ERROR or isSuccess and SUCCESS or self._accent })
        btn.TextColor3 = isPrimary and W or isDanger and ERROR or isSuccess and SUCCESS or W
        if tooltip then self:_showTooltip(tooltip, btn) end
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, EASE_OUT(0.14), { BackgroundColor3 = isGhost and Color3.fromRGB(0,0,0) or baseColor })
        tween(btnStroke, EASE_OUT(0.14), { Color = isDanger and ERROR or isSuccess and SUCCESS or isGhost and LINE or LINE })
        btn.TextColor3 = isPrimary and W or textColor
        self:_hideTooltip()
    end)

    table.insert(self._connections, btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            local x = inp.Position.X - btn.AbsolutePosition.X
            local y = inp.Position.Y - btn.AbsolutePosition.Y
            ripple(x, y)
        end
    end))
    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        self._playClick()
        if callback then task.spawn(callback) end
    end))

    return {
        SetText = function(t) btn.Text = t end,
        SetEnabled = function(v)
            btn.Active = v
            btn.BackgroundTransparency = v and 0 or 0.5
            btn.TextTransparency = v and 0 or 0.5
        end,
    }
end

-- ══════════════ SLIDER ══════════════
function KronUI:AddSlider(text, min, max, default, callback, step)
    local value       = math.clamp(default or min, min, max)
    local dragging    = false
    local activeTouch = nil
    local stepSize    = step or 1

    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    strokeIn(holder, 1, LINE)
    corner(holder, 8)

    local labelText = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 2),
        Size = UDim2.new(1, -80, 0, 28),
        Font = FONT, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = MID,
    }, holder)

    local valueLabel = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -60, 0, 2),
        Size = UDim2.new(0, 54, 0, 28),
        Font = FONTB, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextColor3 = self._accent,
    }, holder)
    self:_registerThemeItem(valueLabel, "TextColor3", "accent")

    local track = o("Frame", {
        Size = UDim2.new(1, -24, 0, 5),
        Position = UDim2.new(0, 12, 0, 38),
        BackgroundColor3 = LINE,
        BorderSizePixel = 0,
    }, holder)
    corner(track, "pill")

    local fill = o("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = self._accent, BorderSizePixel = 0,
    }, track)
    corner(fill, "pill")
    local fillGrad = o("UIGradient", {
        Color = ColorSequence.new(self._accent2, self._accent3)
    }, fill)
    self:_registerThemeGradient(fillGrad)

    local knob = o("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = W, BorderSizePixel = 0,
    }, track)
    corner(knob, "pill")
    local knobStroke = stroke(knob, 2, self._accent)
    self:_registerThemeItem(knobStroke, "Color", "accent")
    local knobScale = o("UIScale", { Scale = 1 }, knob)

    local bubble = o("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 1),
        Size = UDim2.new(0, 36, 0, 20),
        BackgroundColor3 = self._accent,
        Text = "", TextColor3 = W, Font = FONTB, TextSize = 10,
        Visible = false, ZIndex = 8,
    }, track)
    self:_registerThemeItem(bubble, "BackgroundColor3", "accent")
    corner(bubble, 5)

    self:_registerThemeCallback(function(primary, secondary, tertiary)
        fill.BackgroundColor3 = primary
        fillGrad.Color = ColorSequence.new(secondary or primary, tertiary or primary)
        knobStroke.Color = primary
        bubble.BackgroundColor3 = primary
        valueLabel.TextColor3 = primary
    end)

    local function snap(v)
        if stepSize > 1 then
            return math.floor(v / stepSize + 0.5) * stepSize
        end
        return v
    end

    local function redraw()
        local rel = (value - min) / (max - min)
        fill.Size       = UDim2.new(rel, 0, 1, 0)
        knob.Position   = UDim2.new(rel, 0, 0.5, 0)
        labelText.Text  = text
        valueLabel.Text = tostring(snap(value))
        bubble.Position = UDim2.new(rel, 0, 0, -10)
        bubble.Text     = tostring(snap(value))
    end

    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel)
        redraw()
        if callback then task.spawn(callback, snap(value)) end
    end

    redraw()

    table.insert(self._connections, track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; bubble.Visible = true
            tween(knobScale, EASE_OUT(0.1), { Scale = 1.25 })
            update(inp.Position.X)
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if activeTouch ~= nil then return end
            activeTouch = inp; dragging = true; bubble.Visible = true
            tween(knobScale, EASE_OUT(0.1), { Scale = 1.25 })
            update(inp.Position.X)
        end
    end))
    table.insert(self._connections, knob.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; bubble.Visible = true
            tween(knobScale, EASE_OUT(0.1), { Scale = 1.25 })
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if activeTouch ~= nil then return end
            activeTouch = inp; dragging = true; bubble.Visible = true
            tween(knobScale, EASE_OUT(0.1), { Scale = 1.25 })
        end
    end))
    table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement then
            update(inp.Position.X)
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if inp ~= activeTouch then return end
            update(inp.Position.X)
        end
    end))
    table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if activeTouch then return end
            dragging = false; bubble.Visible = false
            tween(knobScale, EASE_OUT(0.15), { Scale = 1 })
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if inp ~= activeTouch then return end
            dragging = false; activeTouch = nil; bubble.Visible = false
            tween(knobScale, EASE_OUT(0.15), { Scale = 1 })
        end
    end))

    return {
        GetValue = function() return snap(value)             end,
        SetValue = function(v)
            value = math.clamp(v, min, max)
            redraw()
        end,
    }
end

-- ══════════════ DROPDOWN ══════════════
function KronUI:AddDropdown(text, options, default, callback)
    options = options or {}
    local selected = nil
    if default and type(default) == "string" and table.find(options, default) then
        selected = default
    end
    local open = false

    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, ClipsDescendants = true,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    strokeIn(holder, 1, LINE)
    corner(holder, 8)

    local head = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1,
        AutoButtonColor = false, Text = "",
    }, holder)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -60, 1, 0),
        Font = FONT, TextSize = 12, TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = text,
    }, head)

    local selectedLabel = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -58, 0, 0),
        Size = UDim2.new(0, 34, 1, 0),
        Font = FONTB, TextSize = 11, TextColor3 = self._accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = selected or "",
    }, head)
    self:_registerThemeItem(selectedLabel, "TextColor3", "accent")

    local arrow = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -28, 0, 0),
        Size = UDim2.new(0, 22, 1, 0),
        Font = FONTB, TextSize = 14, TextColor3 = DIM,
        TextXAlignment = Enum.TextXAlignment.Center,
        Text = "▾", Rotation = 0,
    }, head)

    local LIST_MAX_H = 140
    local listWrap = o("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 34),
        BackgroundTransparency = 1, ClipsDescendants = true,
    }, holder)

    local list = o("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
    }, listWrap)
    self:_registerThemeItem(list, "ScrollBarImageColor3", "accent")
    o("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, list)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
        PaddingTop = UDim.new(0, 3),  PaddingBottom = UDim.new(0, 3),
    }, list)

    local ROW_H = 28
    local rows  = {}

    local function updateRowColors(animate)
        for opt, data in pairs(rows) do
            local row      = data.row
            local check    = row:FindFirstChild("Check")
            local box      = row:FindFirstChild("Box")
            local boxStroke = box and box:FindFirstChild("UIStroke")
            local rowStroke = row:FindFirstChild("UIStroke")
            local optLabel  = row:FindFirstChild("Label")
            local ti = EASE_OUT(animate and 0.14 or 0)
            if opt == selected then
                tween(box, ti, { BackgroundColor3 = self._accent2 })
                if boxStroke then tween(boxStroke, ti, { Color = self._accent }) end
                if check    then tween(check, ti, { TextTransparency = 0 }) end
                if rowStroke then tween(rowStroke, ti, { Color = self._accent2, Transparency = 0.4 }) end
                if optLabel  then optLabel.TextColor3 = W end
                tween(row, ti, { BackgroundColor3 = Color3.fromRGB(30, 24, 46) })
            else
                tween(box, ti, { BackgroundColor3 = PANEL })
                if boxStroke then tween(boxStroke, ti, { Color = LINE }) end
                if check    then tween(check, ti, { TextTransparency = 1 }) end
                if rowStroke then tween(rowStroke, ti, { Color = LINE, Transparency = 0 }) end
                if optLabel  then optLabel.TextColor3 = MID end
                tween(row, ti, { BackgroundColor3 = PANEL })
            end
        end
    end

    self:_registerThemeCallback(function()
        updateRowColors(false)
        selectedLabel.TextColor3   = self._accent
        list.ScrollBarImageColor3  = self._accent
    end)

    local setOpen
    for i, opt in ipairs(options) do
        local row = o("TextButton", {
            Size = UDim2.new(1, 0, 0, ROW_H),
            BackgroundColor3 = PANEL,
            BorderSizePixel = 0, AutoButtonColor = false, Text = "",
            LayoutOrder = i,
        }, list)
        corner(row, 5)
        strokeIn(row, 1, LINE)

        local box = o("Frame", { Name = "Box",
            Size = UDim2.new(0, 13, 0, 13),
            Position = UDim2.new(0, 8, 0.5, -6.5),
            BackgroundColor3 = PANEL, BorderSizePixel = 0 }, row)
        corner(box, 4)
        stroke(box, 1, LINE)
        o("TextLabel", { Name = "Check",
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
            Text = "✓", Font = FONTB, TextSize = 10,
            TextColor3 = W, TextTransparency = 1 }, box)
        o("TextLabel", { Name = "Label",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 28, 0, 0),
            Size = UDim2.new(1, -34, 1, 0),
            Font = FONT, TextSize = 11, TextColor3 = MID,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = tostring(opt) }, row)

        rows[opt] = { row = row }

        row.MouseEnter:Connect(function() if selected ~= opt then row.BackgroundColor3 = HOVER end end)
        row.MouseLeave:Connect(function() row.BackgroundColor3 = PANEL end)

        table.insert(self._connections, row.MouseButton1Click:Connect(function()
            self._playClick()
            selected = (selected == opt) and nil or opt
            selectedLabel.Text = selected or ""
            updateRowColors(true)
            if callback then task.spawn(callback, selected) end
            if setOpen then setOpen(false) end
        end))
    end

    updateRowColors(false)
    local listH = math.min(#options * (ROW_H + 3) + 6, LIST_MAX_H)

    setOpen = function(v)
        open = v
        local ti = EASE_EXP(0.22)
        tween(listWrap, ti, { Size = UDim2.new(1, 0, 0, open and listH or 0) })
        tween(arrow, ti, { Rotation = open and 180 or 0 })
        tween(holder, ti, { BackgroundColor3 = open and CARD2 or CARD })
    end

    head.MouseEnter:Connect(function() if not open then tween(holder, EASE_OUT(0.1), { BackgroundColor3 = HOVER }) end end)
    head.MouseLeave:Connect(function() if not open then tween(holder, EASE_OUT(0.12), { BackgroundColor3 = CARD }) end end)

    table.insert(self._connections, head.MouseButton1Click:Connect(function()
        self._playClick()
        setOpen(not open)
    end))

    return {
        Frame      = holder,
        GetSelected = function() return selected end,
        SetSelected = function(opt)
            selected = (opt and table.find(options, opt)) and opt or nil
            selectedLabel.Text = selected or ""
            updateRowColors(true)
        end,
        Close = function() setOpen(false) end,
    }
end

-- ══════════════ MULTI-DROPDOWN ══════════════
function KronUI:AddMultiDropdown(text, options, defaults, callback)
    options  = options  or {}
    defaults = defaults or {}
    local selectedSet = {}
    for _, def in ipairs(defaults) do
        if table.find(options, def) then selectedSet[def] = true end
    end
    local open = false; local rows = {}; local listH = 0
    local LIST_MAX_H = 140; local ROW_H = 28

    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = CARD, BorderSizePixel = 0, ClipsDescendants = true,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    strokeIn(holder, 1, LINE); corner(holder, 8)

    local head = o("TextButton", { Size = UDim2.new(1, 0, 0, 34),
        BackgroundTransparency = 1, AutoButtonColor = false, Text = "" }, holder)
    o("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -60, 1, 0), Font = FONT, TextSize = 12, TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
        Text = text }, head)
    local selectedLabel = o("TextLabel", { BackgroundTransparency = 1,
        Position = UDim2.new(1, -58, 0, 0), Size = UDim2.new(0, 34, 1, 0),
        Font = FONTB, TextSize = 11, TextColor3 = self._accent,
        TextXAlignment = Enum.TextXAlignment.Right, Text = "" }, head)
    self:_registerThemeItem(selectedLabel, "TextColor3", "accent")
    local arrow = o("TextLabel", { BackgroundTransparency = 1,
        Position = UDim2.new(1, -28, 0, 0), Size = UDim2.new(0, 22, 1, 0),
        Font = FONTB, TextSize = 14, TextColor3 = DIM,
        TextXAlignment = Enum.TextXAlignment.Center, Text = "▾", Rotation = 0 }, head)
    local listWrap = o("Frame", { Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 34),
        BackgroundTransparency = 1, ClipsDescendants = true }, holder)
    local list = o("ScrollingFrame", { Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0) }, listWrap)
    self:_registerThemeItem(list, "ScrollBarImageColor3", "accent")
    o("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, list)
    o("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4),
        PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3) }, list)

    local function updateRowState(opt, animate)
        local data = rows[opt]; if not data then return end
        local row = data.row
        local box     = row:FindFirstChild("Box")
        local boxStk  = box and box:FindFirstChild("UIStroke")
        local check   = row:FindFirstChild("Check")
        local rowStk  = row:FindFirstChild("UIStroke")
        local lbl     = row:FindFirstChild("Label")
        local isSel   = selectedSet[opt] ~= nil
        local ti      = EASE_OUT(animate and 0.14 or 0)
        if isSel then
            tween(box, ti, { BackgroundColor3 = self._accent2 })
            if boxStk  then tween(boxStk,  ti, { Color = self._accent }) end
            if check   then tween(check,   ti, { TextTransparency = 0 }) end
            if rowStk  then tween(rowStk,  ti, { Color = self._accent2, Transparency = 0.4 }) end
            if lbl     then lbl.TextColor3 = W end
            tween(row, ti, { BackgroundColor3 = Color3.fromRGB(30, 24, 46) })
        else
            tween(box, ti, { BackgroundColor3 = PANEL })
            if boxStk  then tween(boxStk,  ti, { Color = LINE }) end
            if check   then tween(check,   ti, { TextTransparency = 1 }) end
            if rowStk  then tween(rowStk,  ti, { Color = LINE, Transparency = 0 }) end
            if lbl     then lbl.TextColor3 = MID end
            tween(row, ti, { BackgroundColor3 = PANEL })
        end
    end

    local function updateAllRows(animate)
        for opt in pairs(rows) do updateRowState(opt, animate) end
    end

    local function rebuildSelectionText()
        local sel = {}
        for opt, flag in pairs(selectedSet) do if flag then table.insert(sel, opt) end end
        table.sort(sel)
        selectedLabel.Text = #sel == 0 and "" or #sel == 1 and sel[1] or (#sel .. " sel.")
    end

    self:_registerThemeCallback(function()
        updateAllRows(false)
        selectedLabel.TextColor3  = self._accent
        list.ScrollBarImageColor3 = self._accent
    end)

    local function buildRows(optList)
        for _, child in ipairs(list:GetChildren()) do
            if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then child:Destroy() end
        end
        rows = {}
        for opt in pairs(selectedSet) do
            if not table.find(optList, opt) then selectedSet[opt] = nil end
        end
        for i, opt in ipairs(optList) do
            local row = o("TextButton", { Size = UDim2.new(1, 0, 0, ROW_H),
                BackgroundColor3 = PANEL, BorderSizePixel = 0,
                AutoButtonColor = false, Text = "", LayoutOrder = i }, list)
            corner(row, 5); strokeIn(row, 1, LINE)
            local box = o("Frame", { Name = "Box",
                Size = UDim2.new(0, 13, 0, 13), Position = UDim2.new(0, 8, 0.5, -6.5),
                BackgroundColor3 = PANEL, BorderSizePixel = 0 }, row)
            corner(box, 4); stroke(box, 1, LINE)
            o("TextLabel", { Name = "Check", Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1, Text = "✓", Font = FONTB, TextSize = 10,
                TextColor3 = W, TextTransparency = 1 }, box)
            o("TextLabel", { Name = "Label", BackgroundTransparency = 1,
                Position = UDim2.new(0, 28, 0, 0), Size = UDim2.new(1, -34, 1, 0),
                Font = FONT, TextSize = 11, TextColor3 = MID,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(opt) }, row)
            rows[opt] = { row = row }
            row.MouseEnter:Connect(function() if not selectedSet[opt] then row.BackgroundColor3 = HOVER end end)
            row.MouseLeave:Connect(function() row.BackgroundColor3 = PANEL end)
            row.MouseButton1Click:Connect(function()
                self._playClick()
                if selectedSet[opt] then selectedSet[opt] = nil else selectedSet[opt] = true end
                updateRowState(opt, true); rebuildSelectionText()
                if callback then
                    local selList = {}
                    for k, flag in pairs(selectedSet) do if flag then table.insert(selList, k) end end
                    table.sort(selList); task.spawn(callback, selList)
                end
            end)
        end
        listH = math.min(#optList * (ROW_H + 3) + 6, LIST_MAX_H)
        updateAllRows(false); rebuildSelectionText()
    end

    buildRows(options)

    local function setOpen(v)
        open = v
        local ti = EASE_EXP(0.22)
        tween(listWrap, ti, { Size = UDim2.new(1, 0, 0, open and listH or 0) })
        tween(arrow, ti, { Rotation = open and 180 or 0 })
        tween(holder, ti, { BackgroundColor3 = open and CARD2 or CARD })
    end

    head.MouseEnter:Connect(function() if not open then tween(holder, EASE_OUT(0.1), { BackgroundColor3 = HOVER }) end end)
    head.MouseLeave:Connect(function() if not open then tween(holder, EASE_OUT(0.12), { BackgroundColor3 = CARD }) end end)
    table.insert(self._connections, head.MouseButton1Click:Connect(function()
        self._playClick(); setOpen(not open)
    end))

    return {
        Frame = holder,
        GetSelected = function()
            local sel = {}
            for opt, flag in pairs(selectedSet) do if flag then table.insert(sel, opt) end end
            table.sort(sel); return sel
        end,
        SetSelected = function(newSel)
            selectedSet = {}
            if newSel then
                for _, opt in ipairs(newSel) do if rows[opt] then selectedSet[opt] = true end end
            end
            updateAllRows(true); rebuildSelectionText()
        end,
        UpdateOptions = function(newOptions)
            if open then setOpen(false) end
            buildRows(newOptions or {})
        end,
        Close = function() setOpen(false) end,
    }
end

-- ══════════════ TEXT INPUT ══════════════
function KronUI:AddTextInput(text, placeholder, default, callback, clearOnFocus)
    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
        ClipsDescendants = false,
    }, self.container)
    local holderStroke = strokeIn(holder, 1, LINE)
    corner(holder, 8)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 4),
        Size = UDim2.new(1, -24, 0, 16),
        Font = FONTB, TextSize = 9,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = self._accent,
        Text = string.upper(text or ""),
        -- LetterSpacing removido: não é propriedade válida no executor
    }, holder)
    self:_registerThemeCallback(function(p) holder:FindFirstChildWhichIsA("TextLabel").TextColor3 = p end)

    local inputBg = o("Frame", {
        Position = UDim2.new(0, 8, 0, 22),
        Size = UDim2.new(1, -16, 0, 26),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
    }, holder)
    corner(inputBg, 6)
    local inputStroke = strokeIn(inputBg, 1, LINE)

    local inputBox = o("TextBox", {
        Position = UDim2.new(0, 8, 0, 0),
        Size = UDim2.new(1, -16, 1, 0),
        BackgroundTransparency = 1,
        Text = default or "",
        PlaceholderText = placeholder or "Digite aqui...",
        PlaceholderColor3 = DIM,
        TextColor3 = W,
        Font = FONT, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = clearOnFocus or false,
        ClipsDescendants = true,
    }, inputBg)

    local charCount = o("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0, 28, 1, 0),
        BackgroundTransparency = 1,
        Text = "0", Font = FONT, TextSize = 9,
        TextColor3 = DIM,
        TextXAlignment = Enum.TextXAlignment.Right,
        Visible = false,
    }, inputBg)

    inputBox:GetPropertyChangedSignal("Text"):Connect(function()
        charCount.Text = tostring(#inputBox.Text)
        charCount.Visible = inputBox:IsFocused()
    end)

    inputBox.Focused:Connect(function()
        tween(inputStroke, EASE_OUT(0.14), { Color = self._accent })
        tween(holderStroke, EASE_OUT(0.14), { Color = self._accent, Transparency = 0.6 })
        charCount.Visible = true
        charCount.Text = tostring(#inputBox.Text)
    end)
    inputBox.FocusLost:Connect(function(entered)
        tween(inputStroke, EASE_OUT(0.14), { Color = LINE })
        tween(holderStroke, EASE_OUT(0.14), { Color = LINE, Transparency = 0 })
        charCount.Visible = false
        if callback and entered then task.spawn(callback, inputBox.Text) end
    end)

    return {
        GetText  = function()  return inputBox.Text end,
        SetText  = function(t) inputBox.Text = t   end,
        Focus    = function()  inputBox:CaptureFocus() end,
        Blur     = function()  inputBox:ReleaseFocus() end,
    }
end

-- ══════════════ KEYBIND ══════════════
function KronUI:AddKeybind(text, default, callback)
    local currentKey = default or Enum.KeyCode.Unknown
    local listening  = false

    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    strokeIn(holder, 1, LINE); corner(holder, 8)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -100, 1, 0),
        Font = FONT, TextSize = 12, TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = text,
    }, holder)

    local keyBtn = o("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0, 72, 0, 22),
        BackgroundColor3 = PANEL,
        AutoButtonColor = false, BorderSizePixel = 0,
        Font = FONTB, TextSize = 11,
        Text = currentKey ~= Enum.KeyCode.Unknown and currentKey.Name or "...",
        TextColor3 = self._accent,
    }, holder)
    corner(keyBtn, 5)
    local keyStroke = strokeIn(keyBtn, 1, self._accent, 0.5)
    self:_registerThemeItem(keyStroke, "Color", "accent")
    self:_registerThemeItem(keyBtn, "TextColor3", "accent")

    local function setKey(kc)
        currentKey = kc
        keyBtn.Text = kc ~= Enum.KeyCode.Unknown and kc.Name or "Nenhum"
        tween(keyBtn, EASE_OUT(0.1), { BackgroundColor3 = PANEL })
        tween(keyStroke, EASE_OUT(0.1), { Transparency = 0.5 })
        keyBtn.TextColor3 = self._accent
        listening = false
        if callback then task.spawn(callback, kc) end
    end

    keyBtn.MouseButton1Click:Connect(function()
        if listening then
            setKey(Enum.KeyCode.Unknown); return
        end
        listening = true
        keyBtn.Text = "..."
        tween(keyBtn, EASE_OUT(0.1), { BackgroundColor3 = self._accent2 })
        tween(keyStroke, EASE_OUT(0.1), { Transparency = 0 })
        keyBtn.TextColor3 = W
    end)

    table.insert(self._connections, UserInputService.InputBegan:Connect(function(inp, gp)
        if not listening or gp then return end
        if inp.UserInputType == Enum.UserInputType.Keyboard then
            setKey(inp.KeyCode)
        end
    end))

    return {
        GetKey   = function() return currentKey end,
        SetKey   = function(kc) setKey(kc)     end,
        Callback = callback,
    }
end

