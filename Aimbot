local RobloxUI = {}
RobloxUI.__index = RobloxUI

local BG     = Color3.fromRGB(28, 28, 32)
local PANEL  = Color3.fromRGB(34, 34, 40)
local CARD   = Color3.fromRGB(40, 40, 48)
local HOVER  = Color3.fromRGB(48, 48, 58)
local LINE   = Color3.fromRGB(58, 58, 70)
local DIM    = Color3.fromRGB(140, 140, 160)
local MID    = Color3.fromRGB(185, 185, 205)
local W      = Color3.fromRGB(235, 235, 245)
local FONT   = Enum.Font.GothamMedium

local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end
local function stroke(par, t, c)
    o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, par)
end

function RobloxUI.new(title, version)
    local self = setmetatable({}, RobloxUI)

    local Players = game:GetService("Players")
    local UIS     = game:GetService("UserInputService")
    local CoreGui = game:GetService("CoreGui")
    local player  = Players.LocalPlayer
    local pg      = player:WaitForChild("PlayerGui", 10) or player.PlayerGui

    local old    = pg:FindFirstChild("RobloxUI_Lib")
    local oldBtn = CoreGui:FindFirstChild("RobloxUI_FloatBtn") or pg:FindFirstChild("RobloxUI_FloatBtn")
    if old    then old:Destroy()    end
    if oldBtn then oldBtn:Destroy() end

    self._connections = {}
    self._UIS         = UIS
    self._layoutOrder = 0

    _G.RobloxUIScale = _G.RobloxUIScale or 10
    local function getUIScale(s) return 0.45 + (s - 1) * 0.04 end

    self.gui = o("ScreenGui", {
        Name = "RobloxUI_Lib", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 10,
    }, pg)

    self.menuFrame = o("Frame", {
        Name = "MenuFrame",
        Size = UDim2.new(0, 245, 0, 330),
        Position = UDim2.new(.5, -122, .5, -165),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ClipsDescendants = true,
    }, self.gui)
    stroke(self.menuFrame, 1, LINE)
    o("UICorner", { CornerRadius = UDim.new(0, 6) }, self.menuFrame)

    local uiScaleObj = Instance.new("UIScale")
    uiScaleObj.Scale  = getUIScale(_G.RobloxUIScale)
    uiScaleObj.Parent = self.menuFrame

    -- ── TopBar ───────────────────────────────────
    local topH   = 30
    local topBar = o("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, topH),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ZIndex = 10,
    }, self.menuFrame)

    o("TextLabel", {
        Size = UDim2.new(1, -150, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = title or "ESP/AIMBOT",
        TextColor3 = W, TextSize = 12, Font = FONT,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 10,
    }, topBar)

    o("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 12,
    }, topBar)

    -- ── GuiSize stepper ──────────────────────────
    local STEP_W = 62
    local STEP_H = 18
    local stepX  = -(33 + 6 + STEP_W)

    local stepHolder = o("Frame", {
        Size = UDim2.new(0, STEP_W, 0, STEP_H),
        Position = UDim2.new(1, stepX, 0.5, -STEP_H / 2),
        BackgroundColor3 = CARD, BorderSizePixel = 0, ZIndex = 10,
    }, topBar)
    stroke(stepHolder, 1, LINE)
    o("UICorner", { CornerRadius = UDim.new(0, 4) }, stepHolder)

    local bsz = STEP_H
    local dv  = 1
    local nw  = STEP_W - 2 * bsz - 2 * dv

    local stepPlus = o("TextButton", {
        Size = UDim2.new(0, bsz, 1, 0),
        BackgroundColor3 = CARD, BorderSizePixel = 0,
        Text = "+", TextColor3 = MID, TextSize = 14, Font = FONT,
        AutoButtonColor = false, ZIndex = 11,
    }, stepHolder)
    o("Frame", {
        Size = UDim2.new(0, dv, 1, 0), Position = UDim2.new(0, bsz, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 11,
    }, stepHolder)
    local stepBox = o("TextBox", {
        Size = UDim2.new(0, nw, 1, 0), Position = UDim2.new(0, bsz + dv, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(_G.RobloxUIScale),
        TextColor3 = W, TextSize = 10, Font = FONT,
        TextXAlignment = Enum.TextXAlignment.Center,
        ClearTextOnFocus = false, ZIndex = 11,
    }, stepHolder)
    o("Frame", {
        Size = UDim2.new(0, dv, 1, 0), Position = UDim2.new(0, bsz + dv + nw, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 11,
    }, stepHolder)
    local stepMinus = o("TextButton", {
        Size = UDim2.new(0, bsz, 1, 0), Position = UDim2.new(0, bsz + dv + nw + dv, 0, 0),
        BackgroundColor3 = CARD, BorderSizePixel = 0,
        Text = "−", TextColor3 = MID, TextSize = 14, Font = FONT,
        AutoButtonColor = false, ZIndex = 11,
    }, stepHolder)

    local stepCv = _G.RobloxUIScale
    local function stepApply(v)
        v = math.clamp(math.floor(v), 1, 35)
        stepCv = v; _G.RobloxUIScale = v
        stepBox.Text = tostring(v)
        uiScaleObj.Scale = getUIScale(v)
    end
    stepPlus.MouseButton1Click:Connect(function()  stepApply(stepCv + 1) end)
    stepMinus.MouseButton1Click:Connect(function() stepApply(stepCv - 1) end)
    stepBox.FocusLost:Connect(function()
        local n = tonumber(stepBox.Text)
        if n then stepApply(n) else stepBox.Text = tostring(stepCv) end
    end)
    for _, btn in ipairs({ stepPlus, stepMinus }) do
        btn.MouseEnter:Connect(function() btn.TextColor3 = W end)
        btn.MouseLeave:Connect(function() btn.TextColor3 = MID end)
    end

    o("Frame", {
        Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -33, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 12,
    }, topBar)

    local xBtn = o("TextButton", {
        Size = UDim2.new(0, 32, 1, 0), Position = UDim2.new(1, -32, 0, 0),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        Text = "×", TextColor3 = DIM, TextSize = 16, Font = FONT,
        AutoButtonColor = false, ZIndex = 11,
    }, topBar)
    xBtn.MouseEnter:Connect(function() xBtn.TextColor3 = W end)
    xBtn.MouseLeave:Connect(function() xBtn.TextColor3 = DIM end)

    -- ── Drag do menu ──────────────────────────────
    do
        local dragging, dragMoved, dragStart, startPos, _activeTouchId =
            false, false, nil, nil, nil
        table.insert(self._connections, topBar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = self.menuFrame.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = self.menuFrame.Position
            end
        end))
        table.insert(self._connections, UIS.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                if math.abs(d.X) + math.abs(d.Y) > 2 then
                    dragMoved = true
                    self.menuFrame.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + d.X,
                        startPos.Y.Scale, startPos.Y.Offset + d.Y)
                end
            end
        end))
        table.insert(self._connections, UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if not dragging then return end
                dragging = false; dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                dragging = false; dragMoved = false
                _activeTouchId = nil; dragStart = nil; startPos = nil
            end
        end))
    end

    -- ── Content ───────────────────────────────────
    self.contentFrame = o("Frame", {
        Size = UDim2.new(1, 0, 1, -topH),
        Position = UDim2.new(0, 0, 0, topH),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
    }, self.menuFrame)

    self.container = o("ScrollingFrame", {
        Size = UDim2.new(1, -8, 1, -6),
        Position = UDim2.new(0, 4, 0, 4),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = LINE,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(),
        Visible = true,
    }, self.contentFrame)
    o("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.container)
    o("UIPadding", {
        PaddingLeft   = UDim.new(0, 2),
        PaddingRight  = UDim.new(0, 2),
        PaddingTop    = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
    }, self.container)

    -- ── Pill ──────────────────────────────────────
    self.btnGui = o("ScreenGui", {
        Name = "RobloxUI_FloatBtn", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 9999,
    })
    local okPill = pcall(function() self.btnGui.Parent = CoreGui end)
    if not okPill then self.btnGui.Parent = pg end

    local pill = o("Frame", {
        Name = "PillUI",
        Size = UDim2.new(0, 80, 0, 20),
        Position = UDim2.new(1, -86, 1, -252),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        Visible = false, ZIndex = 200,
    }, self.btnGui)
    stroke(pill, 1, LINE)
    o("UICorner", { CornerRadius = UDim.new(0, 5) }, pill)
    self._pill = pill

    local pillBtn = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "esp/aimbot",
        TextSize = 9, Font = FONT,
        TextColor3 = DIM, BorderSizePixel = 0, ZIndex = 201,
    }, pill)
    pillBtn.MouseEnter:Connect(function() pillBtn.TextColor3 = W end)
    pillBtn.MouseLeave:Connect(function() pillBtn.TextColor3 = DIM end)

    xBtn.MouseButton1Click:Connect(function()
        self.menuFrame.Visible = false
        pill.Visible = true
    end)

    -- ── Drag da pill ──────────────────────────────
    do
        local dragging, dragMoved, dragStart, startPos, _activeTouchId =
            false, false, nil, nil, nil
        table.insert(self._connections, pillBtn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = pill.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = pill.Position
            end
        end))
        table.insert(self._connections, UIS.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                if math.abs(d.X) + math.abs(d.Y) > 2 then
                    dragMoved = true
                    pill.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + d.X,
                        startPos.Y.Scale, startPos.Y.Offset + d.Y)
                end
            end
        end))
        table.insert(self._connections, UIS.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if not dragging then return end
                dragging = false
                if not dragMoved then
                    self.menuFrame.Visible = true
                    pill.Visible = false
                end
                dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                local wasMoved = dragMoved
                dragging = false; dragMoved = false
                _activeTouchId = nil; dragStart = nil; startPos = nil
                if not wasMoved then
                    self.menuFrame.Visible = true
                    pill.Visible = false
                end
            end
        end))
    end

    return self
end

function RobloxUI:Destroy()
    for _, conn in ipairs(self._connections) do conn:Disconnect() end
    self._connections = {}
    if self.gui    then self.gui:Destroy()    end
    if self.btnGui then self.btnGui:Destroy() end
end

function RobloxUI:_nextOrder()
    self._layoutOrder = self._layoutOrder + 1
    return self._layoutOrder
end

function RobloxUI:AddSectionLabel(text)
    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    o("TextLabel", {
        Size = UDim2.new(1, -8, 1, 0),
        Position = UDim2.new(0, 4, 0, 0),
        BackgroundTransparency = 1,
        Text = string.upper(text or ""),
        Font = FONT, TextSize = 10,
        TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)
    o("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = LINE, BorderSizePixel = 0,
    }, holder)
end

function RobloxUI:AddDivider()
    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 10),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    o("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0,
    }, holder)
end

function RobloxUI:AddToggle(side, text, default, callback)
    local state = default or false
    local TS    = game:GetService("TweenService")

    local btn = o("TextButton", {
        Size = UDim2.new(1, -4, 0, 30),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, AutoButtonColor = false, Text = "",
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    stroke(btn, 1, LINE)
    o("UICorner", { CornerRadius = UDim.new(0, 5) }, btn)

    local label = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 11, 0, 0),
        Size = UDim2.new(1, -52, 1, 0),
        Font = FONT, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = text,
    }, btn)

    local trackW, trackH = 28, 12
    local track = o("Frame", {
        Size = UDim2.new(0, trackW, 0, trackH),
        Position = UDim2.new(1, -(trackW + 10), 0.5, -trackH / 2),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, btn)
    o("UICorner", { CornerRadius = UDim.new(1, 0) }, track)
    stroke(track, 1, LINE)

    local knob = o("Frame", {
        Size = UDim2.new(0, 8, 0, 8),
        Position = UDim2.new(0, 2, 0.5, -4),
        BackgroundColor3 = DIM, BorderSizePixel = 0,
    }, track)
    o("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

    local function refresh(animate)
        if state then
            label.TextColor3 = W
            if animate then
                TS:Create(knob,  TweenInfo.new(0.12), { Position = UDim2.new(1, -10, 0.5, -4), BackgroundColor3 = W }):Play()
                TS:Create(track, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(60, 62, 75) }):Play()
            else
                knob.Position          = UDim2.new(1, -10, 0.5, -4)
                knob.BackgroundColor3  = W
                track.BackgroundColor3 = Color3.fromRGB(60, 62, 75)
            end
        else
            label.TextColor3 = DIM
            if animate then
                TS:Create(knob,  TweenInfo.new(0.12), { Position = UDim2.new(0, 2, 0.5, -4), BackgroundColor3 = DIM }):Play()
                TS:Create(track, TweenInfo.new(0.12), { BackgroundColor3 = PANEL }):Play()
            else
                knob.Position          = UDim2.new(0, 2, 0.5, -4)
                knob.BackgroundColor3  = DIM
                track.BackgroundColor3 = PANEL
            end
        end
    end
    refresh(false)

    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = HOVER end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = CARD end)

    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        state = not state
        refresh(true)
        if callback then task.spawn(callback, state) end
    end))

    return {
        SetState = function(v) state = v refresh(false) end,
        GetState = function() return state end,
    }
end

function RobloxUI:AddButton(side, text, callback)
    local btn = o("TextButton", {
        Size = UDim2.new(1, -4, 0, 30),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, AutoButtonColor = false,
        Font = FONT, TextSize = 11,
        Text = text, TextColor3 = MID,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    stroke(btn, 1, LINE)
    o("UICorner", { CornerRadius = UDim.new(0, 5) }, btn)

    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = HOVER; btn.TextColor3 = W end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = CARD;  btn.TextColor3 = MID end)
    table.insert(self._connections, btn.MouseButton1Down:Connect(function()
        btn.BackgroundColor3 = Color3.fromRGB(52, 52, 62)
    end))
    table.insert(self._connections, btn.MouseButton1Up:Connect(function()
        btn.BackgroundColor3 = HOVER
    end))
    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        if callback then task.spawn(callback) end
    end))
    return btn
end

function RobloxUI:AddSlider(side, text, min, max, default, callback)
    local UIS      = self._UIS
    local value    = math.clamp(default or min, min, max)
    local dragging = false

    local holder = o("Frame", {
        Size = UDim2.new(1, -4, 0, 48),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    stroke(holder, 1, LINE)
    o("UICorner", { CornerRadius = UDim.new(0, 5) }, holder)

    local label = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 11, 0, 0),
        Size = UDim2.new(1, -14, 0, 26),
        Font = FONT, TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = MID,
    }, holder)

    local track = o("Frame", {
        Size = UDim2.new(1, -22, 0, 3),
        Position = UDim2.new(0, 11, 0, 34),
        BackgroundColor3 = LINE,
        BorderSizePixel = 0,
    }, holder)
    o("UICorner", { CornerRadius = UDim.new(1, 0) }, track)

    local fill = o("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = W,
        BorderSizePixel = 0,
    }, track)
    o("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

    local knob = o("Frame", {
        Size = UDim2.new(0, 9, 0, 9),
        AnchorPoint = Vector2.new(.5, .5),
        Position = UDim2.new(0, 0, .5, 0),
        BackgroundColor3 = W, BorderSizePixel = 0,
    }, track)
    o("UICorner", { CornerRadius = UDim.new(1, 0) }, knob)

    local function redraw()
        local rel = (value - min) / (max - min)
        fill.Size     = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, .5, 0)
        label.Text    = text .. "   " .. tostring(math.floor(value))
    end

    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel)
        redraw()
        if callback then task.spawn(callback, value) end
    end

    redraw()

    table.insert(self._connections, track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true update(inp.Position.X)
        end
    end))
    table.insert(self._connections, knob.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end))
    table.insert(self._connections, UIS.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch then
            update(inp.Position.X)
        end
    end))
    table.insert(self._connections, UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))

    return {
        GetValue = function() return value end,
        SetValue = function(v) value = math.clamp(v, min, max) redraw() end,
    }
end

_G.RobloxUI = RobloxUI

