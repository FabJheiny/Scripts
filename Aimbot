local LIB_URL    = "https://raw.githubusercontent.com/FabJheiny/Scripts/refs/heads/main/3"
local PILL_IMAGE = "rbxassetid://78186286433275"

local ok, result = pcall(function()
    return loadstring(game:HttpGet(LIB_URL))()
end)

if not ok then
    warn("[KronUI] Falha ao carregar a lib: " .. tostring(result))
    return
end

local KronUI = result

-- ══════════════════════════════════════════════
--  SETUP
-- ══════════════════════════════════════════════
local Players     = game:GetService("Players")
local RunService  = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera      = workspace.CurrentCamera

local Settings = {
    Highlight = true,
    Name      = false,
    Distance  = true,
    WallIcon  = true,
}
local AimbotSettings = { Enabled = true, FOV = 90, IgnoreWall = false, ShowFOV = true }
local InstaSettings  = { Enabled = false }
local IgnoreList     = {}

local ui
local ignoreDropdown  = nil
local allIgnoreFrames = {}
local uiReady         = false

-- ══════════════════════════════════════════════
--  IGNORE — helpers
-- ══════════════════════════════════════════════
local function getPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(names, p.Name) end
    end
    return names
end

local function onDropdownSelection(selectedNames)
    IgnoreList = {}
    for _, name in ipairs(selectedNames) do
        IgnoreList[name] = true
    end
end

local function rebuildIgnoreDropdown()
    if not ui then return end

    -- 1. Salva o LayoutOrder do frame atual antes de destruir
    local savedOrder = nil
    if ignoreDropdown and ignoreDropdown.Frame and ignoreDropdown.Frame.Parent then
        savedOrder = ignoreDropdown.Frame.LayoutOrder
    end

    -- 2. Destrói TODOS os frames registrados (evita acúmulo)
    for _, frame in ipairs(allIgnoreFrames) do
        if frame and frame.Parent then
            frame:Destroy()
        end
    end
    table.clear(allIgnoreFrames)
    ignoreDropdown = nil

    -- 3. Remove da IgnoreList quem já saiu do servidor
    local playerNames = getPlayerNames()
    local nameSet = {}
    for _, n in ipairs(playerNames) do nameSet[n] = true end
    for name in pairs(IgnoreList) do
        if not nameSet[name] then IgnoreList[name] = nil end
    end

    -- 4. Monta lista das seleções que ainda são válidas
    local validSelected = {}
    for name in pairs(IgnoreList) do
        table.insert(validSelected, name)
    end

    -- 5. Cria UM novo dropdown
    ignoreDropdown = ui:AddMultiDropdown(
        "Selecionar Jogadores", playerNames, validSelected, onDropdownSelection
    )

    -- 6. Registra o frame novo e restaura a posição exata
    if ignoreDropdown and ignoreDropdown.Frame then
        table.insert(allIgnoreFrames, ignoreDropdown.Frame)
        if savedOrder then
            ignoreDropdown.Frame.LayoutOrder = savedOrder
        end
    end
end

-- Debounce — evita rebuilds em rafada
local rebuildPending = false
local function scheduleRebuild()
    if not uiReady or rebuildPending then return end
    rebuildPending = true
    task.delay(0.3, function()
        rebuildPending = false
        rebuildIgnoreDropdown()
    end)
end

-- ══════════════════════════════════════════════
--  UI
-- ══════════════════════════════════════════════
local function buildUI()
    if ui then return end
    ui = KronUI.new("ESP/AIMBOT", PILL_IMAGE)

    -- ESP
    ui:AddSectionLabel("👁️ ESP")
    ui:AddToggle("Esp do Corpo",     Settings.Highlight, function(s) Settings.Highlight = s end)
    ui:AddToggle("Esp do Nome",      Settings.Name,      function(s) Settings.Name      = s end)
    ui:AddToggle("Esp de Distância", Settings.Distance,  function(s) Settings.Distance  = s end)
    ui:AddToggle("Ícone de Parede",  Settings.WallIcon,  function(s) Settings.WallIcon  = s end)
    ui:AddDivider()

    -- AIMBOT
    ui:AddSectionLabel("🎯 AIMBOT")
    ui:AddSlider("FOV", 20, 500, AimbotSettings.FOV, function(v) AimbotSettings.FOV = v end)
    ui:AddToggle("Aimbot",             AimbotSettings.Enabled,    function(s) AimbotSettings.Enabled    = s end)
    ui:AddToggle("Círculo FOV",        AimbotSettings.ShowFOV,    function(s) AimbotSettings.ShowFOV    = s end)
    ui:AddToggle("Ignorar Paredes",    AimbotSettings.IgnoreWall, function(s) AimbotSettings.IgnoreWall = s end)
    ui:AddToggle("Aimbot Instantâneo", InstaSettings.Enabled,     function(s) InstaSettings.Enabled     = s end)
    ui:AddDivider()

    -- IGNORE
    ui:AddSectionLabel("🚫 IGNORE")

    -- Dropdown inicial
    ignoreDropdown = ui:AddMultiDropdown(
        "Selecionar Jogadores", getPlayerNames(), {}, onDropdownSelection
    )
    -- Registra o frame inicial na lista
    if ignoreDropdown and ignoreDropdown.Frame then
        table.insert(allIgnoreFrames, ignoreDropdown.Frame)
    end

    -- Botão de reload manual (backup)
    ui:AddButton("🔄 Recarregar Jogadores", function()
        task.defer(rebuildIgnoreDropdown)
    end)
end

buildUI()
uiReady = true  -- libera o auto-refresh só depois da UI estar montada

-- Auto-refresh quando jogadores entram/saem
Players.PlayerAdded:Connect(function()
    scheduleRebuild()
end)
Players.PlayerRemoving:Connect(function()
    task.delay(0.1, scheduleRebuild)  -- pequeno delay para o jogador já sair de GetPlayers()
end)

-- ══════════════════════════════════════════════
--  CORES / VISIBILIDADE
-- ══════════════════════════════════════════════
local myTeamCache, teamCacheTime = nil, 0
local function getMyTeam()
    if tick() - teamCacheTime > 2 then
        myTeamCache = LocalPlayer.Team
        teamCacheTime = tick()
    end
    return myTeamCache
end

local visCache   = {}
local BODY_PARTS = { "Head", "HumanoidRootPart", "UpperTorso" }

local function isVisible(char, player)
    local cache     = visCache[player]
    local cacheTime = InstaSettings.Enabled and 0.1 or 0.5
    if cache and tick() - cache.t < cacheTime then return cache.v end
    local filter = RaycastParams.new()
    filter.FilterType = Enum.RaycastFilterType.Blacklist
    local filterList  = { LocalPlayer.Character, Camera }
    if char then table.insert(filterList, char) end
    filter.FilterDescendantsInstances = filterList
    filter.IgnoreWater = true
    local origin  = Camera.CFrame.Position
    local visible = false
    for _, name in ipairs(BODY_PARTS) do
        local part = char:FindFirstChild(name)
        if not part then continue end
        local ray = workspace:Raycast(origin, part.Position - origin, filter)
        if not ray or char:IsAncestorOf(ray.Instance) then visible = true; break end
    end
    visCache[player] = { v = visible, t = tick() }
    return visible
end

-- ══════════════════════════════════════════════
--  CONSTANTES
-- ══════════════════════════════════════════════
local ESP_FONT  = Enum.Font.GothamBold
local ESP_TSIZE = 12
local ICON_TEXT = "👁"
local TEAM_COL  = Color3.fromRGB(130, 220, 150)
local ENEMY_COL = Color3.fromRGB(255, 100, 100)
local NEUT_COL  = Color3.fromRGB(220, 220, 235)
local VIS_ON    = { Fill = 0.5, Outline = 0.2 }

local function vividColor(c)
    local h, s, v = Color3.toHSV(c)
    s = math.min(1, s * 1.25)
    v = math.min(1, v * 1.15)
    return Color3.fromHSV(h, s, v)
end

-- ══════════════════════════════════════════════
--  ESP DATA
-- ══════════════════════════════════════════════
local espData = {}

local function makeSlot(parent, order, col)
    local lbl = Instance.new("TextLabel", parent)
    lbl.BackgroundTransparency = 1
    lbl.AutomaticSize          = Enum.AutomaticSize.X
    lbl.Size                   = UDim2.new(0, 0, 1, 0)
    lbl.Text                   = ""
    lbl.Visible                = false
    lbl.Font                   = ESP_FONT
    lbl.TextSize               = ESP_TSIZE
    lbl.TextColor3             = col or Color3.new(1, 1, 1)
    lbl.TextStrokeColor3       = Color3.new(0, 0, 0)
    lbl.TextStrokeTransparency = 0
    lbl.TextXAlignment         = Enum.TextXAlignment.Left
    lbl.TextYAlignment         = Enum.TextYAlignment.Center
    lbl.LayoutOrder            = order
    return lbl
end

local function destroyESP(player)
    local d = espData[player]
    if not d then return end
    if d.BB        then d.BB:Destroy()        end
    if d.Highlight then d.Highlight:Destroy() end
    espData[player]  = nil
    visCache[player] = nil
end

local function createESP(player, char)
    if player == LocalPlayer then return end
    destroyESP(player)

    local head = char:WaitForChild("Head", 5)
    if not head then return end

    local bb = Instance.new("BillboardGui", head)
    bb.Size                  = UDim2.new(0, 300, 0, 18)
    bb.StudsOffsetWorldSpace = Vector3.new(0, 4.4, 0)
    bb.AlwaysOnTop           = true
    bb.LightInfluence        = 0

    local frame = Instance.new("Frame", bb)
    frame.BackgroundTransparency = 1
    frame.Size                   = UDim2.new(1, 0, 1, 0)
    frame.AutomaticSize          = Enum.AutomaticSize.X

    local layout = Instance.new("UIListLayout", frame)
    layout.FillDirection       = Enum.FillDirection.Horizontal
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment   = Enum.VerticalAlignment.Center
    layout.Padding             = UDim.new(0, 4)
    layout.SortOrder           = Enum.SortOrder.LayoutOrder

    local wallLbl = makeSlot(frame, 1, Color3.fromRGB(255, 165, 0))
    local nameLbl = makeSlot(frame, 2, Color3.new(1, 1, 1))
    local distLbl = makeSlot(frame, 3, Color3.new(1, 1, 1))

    wallLbl.Text = ICON_TEXT

    local existingHL = char:FindFirstChild("ESP_Highlight")
    if existingHL then existingHL:Destroy() end

    local hl = Instance.new("Highlight")
    hl.Name                = "ESP_Highlight"
    hl.FillTransparency    = 0.6
    hl.OutlineTransparency = 0
    hl.Enabled             = false
    hl.Adornee             = char
    hl.Parent              = char

    espData[player] = {
        BB        = bb,
        WallIcon  = wallLbl,
        NameLabel = nameLbl,
        DistLabel = distLbl,
        Highlight = hl,
        Character = char,
    }
end

local function setupPlayer(player)
    player.CharacterAdded:Connect(function(char)
        task.wait(0.4)
        createESP(player, char)
    end)
    player.CharacterRemoving:Connect(function()
        destroyESP(player)
    end)
    if player.Character then
        createESP(player, player.Character)
    end
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(p) destroyESP(p) end)

-- ══════════════════════════════════════════════
--  LOOP ESP
-- ══════════════════════════════════════════════
local espTimer = 0

RunService.Heartbeat:Connect(function(dt)
    espTimer = espTimer + dt
    local espInterval = InstaSettings.Enabled and 0.05 or 0.1
    if espTimer < espInterval then return end
    espTimer = 0

    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")

    local function hideAll(d)
        d.WallIcon.Visible  = false
        d.NameLabel.Visible = false
        d.DistLabel.Visible = false
        if d.Highlight then d.Highlight.Enabled = false end
    end

    if not myHRP then
        for _, d in pairs(espData) do hideAll(d) end
        return
    end

    local myTeam = getMyTeam()
    local myPos  = myHRP.Position

    for player, d in pairs(espData) do
        local char = d.Character
        if not char or not char.Parent then hideAll(d) continue end

        local hum  = char:FindFirstChildOfClass("Humanoid")
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        local head = char:FindFirstChild("Head")

        if not hum or not hrp or not head or hum.Health <= 0 then
            hideAll(d) continue
        end

        local dist = (myPos - hrp.Position).Magnitude
        if dist > 3000 then hideAll(d) continue end

        local _, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then hideAll(d) continue end

        local col
        if IgnoreList[player.Name] then
            col = TEAM_COL
        elseif myTeam == nil then
            col = NEUT_COL
        elseif player.Team == myTeam then
            col = TEAM_COL
        else
            col = ENEMY_COL
        end

        local visible = isVisible(char, player)

        if Settings.Highlight and dist <= 700 then
            d.Highlight.Enabled             = true
            d.Highlight.FillColor           = col
            d.Highlight.OutlineColor        = col
            d.Highlight.FillTransparency    = VIS_ON.Fill
            d.Highlight.OutlineTransparency = VIS_ON.Outline
        else
            d.Highlight.Enabled = false
        end

        d.WallIcon.Visible = Settings.WallIcon and (not visible)

        if Settings.Name then
            d.NameLabel.Visible    = true
            d.NameLabel.Text       = player.Name
            d.NameLabel.TextColor3 = col
        else
            d.NameLabel.Visible = false
        end

        if Settings.Distance then
            d.DistLabel.Visible    = true
            d.DistLabel.Text       = math.floor(dist) .. "m"
            d.DistLabel.TextColor3 = vividColor(col)
        else
            d.DistLabel.Visible = false
        end
    end
end)

-- ══════════════════════════════════════════════
--  AIMBOT
-- ══════════════════════════════════════════════
local function getClosestTarget()
    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    local myTeam = getMyTeam()
    local fov    = AimbotSettings.FOV
    local halfX  = Camera.ViewportSize.X * 0.5
    local halfY  = Camera.ViewportSize.Y * 0.5
    local best, bestD = nil, math.huge
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if IgnoreList[player.Name] then continue end
        local char = player.Character; if not char then continue end
        if myTeam and player.Team == myTeam then continue end
        local head = char:FindFirstChild("Head")
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        if not head or not hrp then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end
        local sx = pos.X - halfX; local sy = pos.Y - halfY
        if math.sqrt(sx*sx + sy*sy) > fov then continue end
        local wd = (myHRP.Position - hrp.Position).Magnitude
        if wd > 2000 then continue end
        if not AimbotSettings.IgnoreWall and not isVisible(char, player) then continue end
        if wd < bestD then bestD = wd; best = head end
    end
    return best
end

local cachedTarget = nil
RunService.Heartbeat:Connect(function()
    if not AimbotSettings.Enabled then cachedTarget = nil return end
    cachedTarget = getClosestTarget()
end)

local BASE_SMOOTH = 0.9
local curSmooth   = BASE_SMOOTH
local lastCamCF   = Camera.CFrame

RunService.RenderStepped:Connect(function()
    if not cachedTarget then
        lastCamCF = Camera.CFrame; curSmooth = BASE_SMOOTH; return
    end
    local delta = (Camera.CFrame.LookVector - lastCamCF.LookVector).Magnitude
    if delta > 0.25 then
        cachedTarget = nil; curSmooth = 0; lastCamCF = Camera.CFrame; return
    end
    if delta > 0.15 then
        curSmooth = math.max(0, curSmooth - delta * 3.5)
    else
        curSmooth = curSmooth + (BASE_SMOOTH - curSmooth) * 0.05
    end
    Camera.CFrame = Camera.CFrame:Lerp(
        CFrame.new(Camera.CFrame.Position, cachedTarget.Position), curSmooth)
    lastCamCF = Camera.CFrame
end)

