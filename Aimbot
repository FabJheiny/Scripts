local myTeamCache, teamCacheTime = nil, 0
local function getMyTeam()
    if tick() - teamCacheTime > 2 then
        myTeamCache = LocalPlayer.Team; teamCacheTime = tick()
    end
    return myTeamCache
end

local visCache   = {}
local BODY_PARTS = { "Head", "HumanoidRootPart", "UpperTorso" }

local function isVisible(char, player)
    local cache = visCache[player]
    if cache and tick() - cache.t < 0.5 then return cache.v end
    local filter = RaycastParams.new()
    filter.FilterType = Enum.RaycastFilterType.Blacklist
    local filterList = { LocalPlayer.Character, Camera }
    if char then table.insert(filterList, char) end
    filter.FilterDescendantsInstances = filterList
    filter.IgnoreWater = true
    local origin  = Camera.CFrame.Position
    local visible = false
    for _, name in ipairs(BODY_PARTS) do
        local part = char:FindFirstChild(name)
        if not part then continue end
        local ray = workspace:Raycast(origin, part.Position - origin, filter)
        if not ray or char:IsAncestorOf(ray.Instance) then visible = true break end
    end
    visCache[player] = { v = visible, t = tick() }
    return visible
end

local espData   = {}
local VIS_ON    = { Color = Color3.fromRGB(220, 220, 235), Fill = 0.5, Outline = 0.2 }
local TEAM_COL  = Color3.fromRGB(160, 210, 170)
local ENEMY_COL = Color3.fromRGB(220, 60, 60)

local function destroyESP(player)
    local d = espData[player]
    if not d then return end
    if d.Billboard then d.Billboard:Destroy() end
    if d.Highlight  then d.Highlight:Destroy()  end
    espData[player] = nil; visCache[player] = nil
end

local function createESP(player, char)
    if player == LocalPlayer then return end
    destroyESP(player)
    local head = char:WaitForChild("Head", 5)
    if not head then return end

    local bb = Instance.new("BillboardGui", head)
    bb.Size = UDim2.new(0, 220, 0, 30)
    bb.StudsOffsetWorldSpace = Vector3.new(0, 3.5, 0)
    bb.AlwaysOnTop = true

    local wallIcon = Instance.new("TextLabel", bb)
    wallIcon.BackgroundTransparency = 1
    wallIcon.Text    = ""
    wallIcon.Visible = false
    wallIcon.Font = Enum.Font.GothamBold
    wallIcon.TextSize = 14
    wallIcon.TextColor3 = Color3.fromRGB(255, 80, 80)
    wallIcon.TextStrokeColor3 = Color3.new(0, 0, 0)
    wallIcon.TextStrokeTransparency = 0

    local nameL = Instance.new("TextLabel", bb)
    nameL.BackgroundTransparency = 1
    nameL.Text    = ""
    nameL.Visible = false
    nameL.Font = Enum.Font.GothamBold
    nameL.TextSize = 14
    nameL.TextColor3 = Color3.new(1, 1, 1)
    nameL.TextStrokeColor3 = Color3.new(0, 0, 0)
    nameL.TextStrokeTransparency = 0

    local distL = Instance.new("TextLabel", bb)
    distL.BackgroundTransparency = 1
    distL.Text    = ""
    distL.Visible = false
    distL.Font = Enum.Font.GothamBold
    distL.TextSize = 14
    distL.TextColor3 = Color3.new(1, 1, 1)
    distL.TextStrokeColor3 = Color3.new(0, 0, 0)
    distL.TextStrokeTransparency = 0

    local existingHL = char:FindFirstChild("ESP_Highlight")
    if existingHL then existingHL:Destroy() end

    local hl = Instance.new("Highlight")
    hl.Name = "ESP_Highlight"; hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0; hl.Enabled = false
    hl.Adornee = char; hl.Parent = char

    espData[player] = {
        Billboard = bb, NameLabel = nameL, DistLabel = distL,
        WallIcon = wallIcon, Highlight = hl, Character = char,
    }
end

local function setupPlayer(player)
    player.CharacterAdded:Connect(function(char) task.wait(0.4) createESP(player, char) end)
    player.CharacterRemoving:Connect(function() destroyESP(player) end)
    if player.Character then createESP(player, player.Character) end
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(p) destroyESP(p) end)

local TextService = game:GetService("TextService")

local espTimer    = 0
local spacing     = 6
local distSpacing = 12

RunService.Heartbeat:Connect(function(dt)
    espTimer = espTimer + dt
    if espTimer < 0.3 then return end
    espTimer = 0

    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local myTeam = getMyTeam()
    local myPos  = myHRP.Position

    for player, d in pairs(espData) do
        local char = d.Character
        if not char or not char.Parent then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then
            d.NameLabel.Visible = false; d.DistLabel.Visible = false
            d.WallIcon.Visible  = false
            if d.Highlight then d.Highlight.Enabled = false end
            continue
        end
        local _, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            d.NameLabel.Visible = false; d.DistLabel.Visible = false
            d.WallIcon.Visible  = false
            if d.Highlight then d.Highlight.Enabled = false end
            continue
        end
        local dist = (myPos - hrp.Position).Magnitude
        if dist > 2500 then
            d.NameLabel.Visible = false; d.DistLabel.Visible = false
            d.WallIcon.Visible  = false
            if d.Highlight then d.Highlight.Enabled = false end
            continue
        end

        local visible = isVisible(char, player)

        local col
        if myTeam == nil then
            col = VIS_ON.Color
        elseif player.Team == myTeam then
            col = TEAM_COL
        else
            col = ENEMY_COL
        end

        if d.Highlight then
            if Settings.Highlight then
                d.Highlight.Enabled = true
                d.Highlight.FillColor = col
                d.Highlight.OutlineColor = col
                d.Highlight.FillTransparency = VIS_ON.Fill
                d.Highlight.OutlineTransparency = VIS_ON.Outline
            else
                d.Highlight.Enabled = false
            end
        end

        local showName        = Settings.Name
        local showDist        = Settings.Distance
        local wallIconVisible = not visible
        local nameText        = showName and player.Name or ""
        local distText        = showDist and (math.floor(dist) .. "m") or ""

        local nameWidth = 0
        if showName then
            nameWidth = TextService:GetTextSize(
                nameText, 14, Enum.Font.GothamBold, Vector2.new(9999, 30)).X
        end

        local distWidth = 0
        if showDist then
            distWidth = TextService:GetTextSize(
                distText, 14, Enum.Font.GothamBold, Vector2.new(9999, 30)).X
        end

        local totalWidth = 0
        if wallIconVisible then totalWidth = totalWidth + 20 + spacing end
        if showName then
            totalWidth = totalWidth + nameWidth
            if showDist then totalWidth = totalWidth + distSpacing end
        end
        if showDist then totalWidth = totalWidth + distWidth end

        local cursorX = math.max(0, (220 - totalWidth) / 2)

        d.WallIcon.Visible = wallIconVisible
        if wallIconVisible then
            d.WallIcon.Text        = "[!]"
            d.WallIcon.Size        = UDim2.new(0, 20, 1, 0)
            d.WallIcon.Position    = UDim2.new(0, cursorX, 0.5, -15)
            d.WallIcon.AnchorPoint = Vector2.new(0, 0.5)
            cursorX = cursorX + 20 + spacing
        end

        d.NameLabel.Visible = showName
        if showName then
            d.NameLabel.Size           = UDim2.new(0, nameWidth, 1, 0)
            d.NameLabel.Position       = UDim2.new(0, cursorX, 0.5, -15)
            d.NameLabel.AnchorPoint    = Vector2.new(0, 0.5)
            d.NameLabel.Text           = nameText
            d.NameLabel.TextXAlignment = Enum.TextXAlignment.Left
            d.NameLabel.TextColor3     = col
            cursorX = cursorX + nameWidth
            if showDist then cursorX = cursorX + distSpacing end
        end

        d.DistLabel.Visible = showDist
        if showDist then
            d.DistLabel.Size           = UDim2.new(0, distWidth, 1, 0)
            d.DistLabel.Position       = UDim2.new(0, cursorX, 0.5, -15)
            d.DistLabel.AnchorPoint    = Vector2.new(0, 0.5)
            d.DistLabel.Text           = distText
            d.DistLabel.TextXAlignment = Enum.TextXAlignment.Left
            d.DistLabel.TextColor3     = Color3.new(
                math.min(1, col.R + (1 - col.R) * 0.35),
                math.min(1, col.G + (1 - col.G) * 0.35),
                math.min(1, col.B + (1 - col.B) * 0.35)
            )
        end
    end
end)

