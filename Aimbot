local myTeamCache, teamCacheTime = nil, 0
local function getMyTeam()
    if tick() - teamCacheTime > 2 then
        myTeamCache = LocalPlayer.Team; teamCacheTime = tick()
    end
    return myTeamCache
end

local visCache  = {}
local rayParams = RaycastParams.new()
rayParams.FilterType  = Enum.RaycastFilterType.Blacklist
rayParams.IgnoreWater = true
local BODY_PARTS = { "Head", "HumanoidRootPart", "UpperTorso" }

local function isVisible(char, player)
    local cache = visCache[player]
    if cache and tick() - cache.t < 0.5 then return cache.v end
    rayParams.FilterDescendantsInstances = { LocalPlayer.Character, Camera }
    local origin  = Camera.CFrame.Position
    local visible = false
    for _, name in ipairs(BODY_PARTS) do
        local part = char:FindFirstChild(name)
        if not part then continue end
        local ray = workspace:Raycast(origin, part.Position - origin, rayParams)
        if not ray or char:IsAncestorOf(ray.Instance) then visible = true break end
    end
    visCache[player] = { v = visible, t = tick() }
    return visible
end

local espData  = {}
local VIS_ON   = { Color = Color3.fromRGB(220, 220, 235), Fill = 0.5,  Outline = 0.2 }
local VIS_OFF  = { Color = Color3.fromRGB(110, 110, 130), Fill = 0.7,  Outline = 0.5 }
local TEAM_COL = Color3.fromRGB(160, 210, 170)

local function destroyESP(player)
    local d = espData[player]
    if not d then return end
    if d.Billboard then d.Billboard:Destroy() end
    if d.Highlight  then d.Highlight:Destroy()  end
    espData[player] = nil; visCache[player] = nil
end

local function createESP(player, char)
    if player == LocalPlayer then return end
    destroyESP(player)
    local head = char:WaitForChild("Head", 5)
    if not head then return end

    -- ── Billboard maior e mais visível ────────────
    local bb = Instance.new("BillboardGui", head)
    bb.Size = UDim2.new(0, 200, 0, 60); bb.StudsOffset = Vector3.new(0, 6, 0); bb.AlwaysOnTop = true

    local nameL = Instance.new("TextLabel", bb)
    nameL.Size = UDim2.new(1,0,0,28); nameL.BackgroundTransparency = 1
    nameL.Font = Enum.Font.GothamBold; nameL.TextSize = 18
    nameL.TextColor3 = Color3.new(1,1,1)
    nameL.TextStrokeColor3 = Color3.new(0,0,0); nameL.TextStrokeTransparency = 0

    local distL = Instance.new("TextLabel", bb)
    distL.Size = UDim2.new(1,0,0,24); distL.Position = UDim2.new(0,0,0,30)
    distL.BackgroundTransparency = 1; distL.Font = Enum.Font.GothamMedium; distL.TextSize = 15
    distL.TextColor3 = Color3.new(1,1,1)
    distL.TextStrokeColor3 = Color3.new(0,0,0); distL.TextStrokeTransparency = 0

    local existingHL = char:FindFirstChild("ESP_Highlight")
    if existingHL then existingHL:Destroy() end

    local hl = Instance.new("Highlight")
    hl.Name = "ESP_Highlight"; hl.FillTransparency = 0.6
    hl.OutlineTransparency = 0; hl.Enabled = false
    hl.Adornee = char; hl.Parent = char

    espData[player] = {
        Billboard = bb, NameLabel = nameL, DistLabel = distL,
        Highlight = hl, Character = char, lastDist = -1,
    }
end

local function setupPlayer(player)
    player.CharacterAdded:Connect(function(char) task.wait(0.4) createESP(player, char) end)
    player.CharacterRemoving:Connect(function() destroyESP(player) end)
    if player.Character then createESP(player, player.Character) end
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerAdded:Connect(setupPlayer)
Players.PlayerRemoving:Connect(function(p) destroyESP(p) end)

local espTimer = 0
RunService.Heartbeat:Connect(function(dt)
    espTimer = espTimer + dt
    if espTimer < 0.3 then return end
    espTimer = 0
    local myChar = LocalPlayer.Character
    local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHRP then return end
    local myTeam = getMyTeam()
    local myPos  = myHRP.Position

    for player, d in pairs(espData) do
        local char = d.Character
        if not char or not char.Parent then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hum or not hrp or hum.Health <= 0 then
            d.NameLabel.Visible = false; d.DistLabel.Visible = false
            if d.Highlight then d.Highlight.Enabled = false end; continue
        end
        local _, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then
            d.NameLabel.Visible = false; d.DistLabel.Visible = false
            if d.Highlight then d.Highlight.Enabled = false end; continue
        end
        local dist = (myPos - hrp.Position).Magnitude
        if dist > 2500 then
            d.NameLabel.Visible = false; d.DistLabel.Visible = false
            if d.Highlight then d.Highlight.Enabled = false end; continue
        end
        local vis = isVisible(char, player)
        local cfg = vis and VIS_ON or VIS_OFF
        local col = (myTeam and player.Team == myTeam) and TEAM_COL or cfg.Color
        if d.Highlight then
            if Settings.Highlight then
                d.Highlight.Enabled = true; d.Highlight.FillColor = col
                d.Highlight.OutlineColor = col; d.Highlight.FillTransparency = cfg.Fill
                d.Highlight.OutlineTransparency = cfg.Outline
            else d.Highlight.Enabled = false end
        end
        d.NameLabel.Visible = Settings.Name
        if Settings.Name then d.NameLabel.Text = player.Name; d.NameLabel.TextColor3 = col end
        d.DistLabel.Visible = Settings.Distance
        if Settings.Distance then
            local fd = math.floor(dist)
            if d.lastDist ~= fd then
                -- 🛑 indica player atrás de parede
                d.DistLabel.Text = vis and (fd.."m") or (fd.."m 🛑"); d.lastDist = fd
            end
            d.DistLabel.TextColor3 = col
        end
    end
end)

