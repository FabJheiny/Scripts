local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")

local KronUI = {}
KronUI.__index = KronUI

-- ── Paleta base ──────────────────────────────────────
local BG      = Color3.fromRGB(16, 14, 22)
local PANEL   = Color3.fromRGB(22, 19, 31)
local CARD    = Color3.fromRGB(28, 24, 39)
local HOVER   = Color3.fromRGB(40, 34, 54)
local LINE    = Color3.fromRGB(54, 46, 70)
local ACCENT  = Color3.fromRGB(150, 90, 255)
local ACCENT2 = Color3.fromRGB(95, 60, 200)
local DIM     = Color3.fromRGB(150, 145, 165)
local MID     = Color3.fromRGB(195, 190, 215)
local W       = Color3.fromRGB(242, 240, 250)
local FONT    = Enum.Font.GothamMedium
local FONTB   = Enum.Font.GothamBold

-- ── 11 Temas prontos ─────────────────────────────────
KronUI.Themes = {
    Aurora   = { primary = Color3.fromRGB(150, 90,  255), secondary = Color3.fromRGB(95,  60,  200) },
    Chama    = { primary = Color3.fromRGB(255, 90,  30),  secondary = Color3.fromRGB(200, 50,  10)  },
    Oceano   = { primary = Color3.fromRGB(30,  180, 255), secondary = Color3.fromRGB(15,  110, 200) },
    Dourado  = { primary = Color3.fromRGB(255, 200, 50),  secondary = Color3.fromRGB(200, 145, 20)  },
    Prata    = { primary = Color3.fromRGB(210, 210, 230), secondary = Color3.fromRGB(150, 148, 170) },
    Esmeralda= { primary = Color3.fromRGB(50,  220, 130), secondary = Color3.fromRGB(20,  160, 90)  },
    Cereja   = { primary = Color3.fromRGB(255, 55,  100), secondary = Color3.fromRGB(200, 25,  65)  },
    Ciano    = { primary = Color3.fromRGB(40,  215, 215), secondary = Color3.fromRGB(15,  155, 155) },
    Coral    = { primary = Color3.fromRGB(255, 120, 80),  secondary = Color3.fromRGB(200, 80,  45)  },
    Ametista = { primary = Color3.fromRGB(190, 70,  230), secondary = Color3.fromRGB(130, 40,  180) },
    Nebula   = { primary = Color3.fromRGB(100, 140, 255), secondary = Color3.fromRGB(60,  90,  210) },
}

-- ── Helpers ───────────────────────────────────────────
local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end

local function stroke(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, par)
end

local function strokeIn(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
    }, par)
end

local function corner(par, r)
    return o("UICorner", {
        CornerRadius = (r == "pill") and UDim.new(1, 0) or UDim.new(0, r or 8)
    }, par)
end

local function tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local EASE_OUT  = function(d) return TweenInfo.new(d or 0.18, Enum.EasingStyle.Quad,   Enum.EasingDirection.Out) end
local EASE_BACK = function(d) return TweenInfo.new(d or 0.4,  Enum.EasingStyle.Back,   Enum.EasingDirection.Out) end
local EASE_SINE = function(d) return TweenInfo.new(d or 0.3,  Enum.EasingStyle.Sine,   Enum.EasingDirection.Out) end

-- ══════════════════════════════════════════════════════
--  KronUI.new
-- ══════════════════════════════════════════════════════
function KronUI.new(title, pillImage)
    local self = setmetatable({}, KronUI)

    self._accent  = ACCENT
    self._accent2 = ACCENT2

    self._themeItems     = {}
    self._themeGradients = {}
    self._themeCallbacks = {}

    function self:_registerThemeItem(obj, prop, role)
        table.insert(self._themeItems, { Object = obj, Property = prop, Role = role })
    end
    function self:_registerThemeGradient(grad)
        table.insert(self._themeGradients, grad)
    end
    function self:_registerThemeCallback(cb)
        table.insert(self._themeCallbacks, cb)
    end

    function self:SetAccent(primary, secondary)
        self._accent  = primary
        self._accent2 = secondary
        for _, item in ipairs(self._themeItems) do
            item.Object[item.Property] = (item.Role == "accent") and primary or secondary
        end
        for _, grad in ipairs(self._themeGradients) do
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0,   secondary),
                ColorSequenceKeypoint.new(0.5, primary),
                ColorSequenceKeypoint.new(1,   secondary),
            })
        end
        for _, cb in ipairs(self._themeCallbacks) do
            cb(primary, secondary)
        end
    end

    function self:SetTheme(name)
        local t = KronUI.Themes[name]
        if t then self:SetAccent(t.primary, t.secondary) end
    end

    local player = Players.LocalPlayer
    local pg     = player:WaitForChild("PlayerGui", 10) or player.PlayerGui

    local old    = pg:FindFirstChild("KronUI_Lib")
    local oldBtn = CoreGui:FindFirstChild("KronUI_FloatBtn") or pg:FindFirstChild("KronUI_FloatBtn")
    local oldNotify = CoreGui:FindFirstChild("KronUI_Notify") or pg:FindFirstChild("KronUI_Notify")
    if old       then old:Destroy()       end
    if oldBtn    then oldBtn:Destroy()    end
    if oldNotify then oldNotify:Destroy() end

    self._connections  = {}
    self._layoutOrder  = 0

    _G.KronUIScale = _G.KronUIScale or 10
    local function getUIScale(s) return 0.45 + (s - 1) * 0.04 end

    -- ── ScreenGui principal ──────────────────────────
    self.gui = o("ScreenGui", {
        Name = "KronUI_Lib", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 10,
    }, pg)

    local clickSound = o("Sound", {
        SoundId = "rbxassetid://6895079853",
        Volume  = 0.6,
        RollOffMaxDistance = 0,
    }, self.gui)
    local function playClick() clickSound:Play() end
    self._playClick = playClick

    -- ── Menu frame ───────────────────────────────────
    local MENU_W, MENU_H = 250, 340
    self.menuFrame = o("Frame", {
        Name = "MenuFrame",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ClipsDescendants = true,
    }, self.gui)
    corner(self.menuFrame, 14)
    stroke(self.menuFrame, 1, LINE)
    local menuAccentStroke = stroke(self.menuFrame, 1.5, self._accent, 0.6)
    self:_registerThemeItem(menuAccentStroke, "Color", "accent")

    local uiScaleObj = o("UIScale", { Scale = getUIScale(_G.KronUIScale) }, self.menuFrame)

    task.defer(function()
        tween(self.menuFrame, EASE_BACK(0.5), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
    end)

    -- ── TopBar ───────────────────────────────────────
    local topH     = 32
    local CORNER_R = 14
    local topBar = o("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, topH),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ZIndex = 10,
    }, self.menuFrame)
    corner(topBar, CORNER_R)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 1, -CORNER_R),
        BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 11,
    }, topBar)

    o("TextLabel", {
        Size = UDim2.new(1, -150, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = title or "Interface",
        TextColor3 = W, TextSize = 13, Font = FONTB,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 10,
    }, topBar)

    -- shimmer
    local shimmer = o("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = self._accent,
        BorderSizePixel = 0, ZIndex = 20,
    }, topBar)
    self:_registerThemeItem(shimmer, "BackgroundColor3", "accent")
    local shimmerGrad = o("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0,   self._accent2),
            ColorSequenceKeypoint.new(0.5, self._accent),
            ColorSequenceKeypoint.new(1,   self._accent2),
        }),
        Offset = Vector2.new(-1, 0),
    }, shimmer)
    self:_registerThemeGradient(shimmerGrad)
    TweenService:Create(shimmerGrad,
        TweenInfo.new(2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
        { Offset = Vector2.new(1, 0) }):Play()

    -- scale stepper
    local STEP_W, STEP_H = 62, 18
    local stepHolder = o("Frame", {
        Size = UDim2.new(0, STEP_W, 0, STEP_H),
        Position = UDim2.new(1, -(33 + 8 + STEP_W), 0.5, -STEP_H / 2),
        BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 10,
        ClipsDescendants = true,
    }, topBar)
    local sh_sk = strokeIn(stepHolder, 1, LINE)
    sh_sk.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
    corner(stepHolder, 6)

    local bsz = STEP_H; local dv = 1
    local nw  = STEP_W - 2 * bsz - 2 * dv

    local stepPlus = o("TextButton", {
        Size = UDim2.new(0, bsz, 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = "+", TextColor3 = MID, TextSize = 14, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, stepHolder)
    o("Frame", {
        Size = UDim2.new(0, dv, 1, 0), Position = UDim2.new(0, bsz, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 11,
    }, stepHolder)
    local stepBox = o("TextBox", {
        Size = UDim2.new(0, nw, 1, 0), Position = UDim2.new(0, bsz + dv, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(_G.KronUIScale),
        TextColor3 = W, TextSize = 10, Font = FONT,
        TextXAlignment = Enum.TextXAlignment.Center,
        ClearTextOnFocus = false, ZIndex = 11,
    }, stepHolder)
    o("Frame", {
        Size = UDim2.new(0, dv, 1, 0), Position = UDim2.new(0, bsz + dv + nw, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 11,
    }, stepHolder)
    local stepMinus = o("TextButton", {
        Size = UDim2.new(0, bsz, 1, 0), Position = UDim2.new(0, bsz + dv + nw + dv, 0, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Text = "−", TextColor3 = MID, TextSize = 14, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, stepHolder)

    local stepCv = _G.KronUIScale
    local function stepApply(v)
        v = math.clamp(math.floor(v), 1, 35)
        stepCv = v; _G.KronUIScale = v
        stepBox.Text = tostring(v)
        tween(uiScaleObj, EASE_OUT(0.12), { Scale = getUIScale(v) })
    end
    stepPlus.MouseButton1Click:Connect(function()  stepApply(stepCv + 1) end)
    stepMinus.MouseButton1Click:Connect(function() stepApply(stepCv - 1) end)
    stepBox.FocusLost:Connect(function()
        local n = tonumber(stepBox.Text)
        if n then stepApply(n) else stepBox.Text = tostring(stepCv) end
    end)
    for _, btn in ipairs({ stepPlus, stepMinus }) do
        btn.MouseEnter:Connect(function() btn.TextColor3 = self._accent end)
        btn.MouseLeave:Connect(function() btn.TextColor3 = MID end)
    end

    o("Frame", {
        Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -33, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 12,
    }, topBar)

    local xBtn = o("TextButton", {
        Size = UDim2.new(0, 32, 1, 0), Position = UDim2.new(1, -32, 0, 0),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        Text = "×", TextColor3 = DIM, TextSize = 17, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, topBar)
    corner(xBtn, CORNER_R)
    for _, pos in ipairs({
        UDim2.new(0, 0, 0, 0), UDim2.new(0, 0, 1, -CORNER_R), UDim2.new(1, -CORNER_R, 1, -CORNER_R),
    }) do
        o("Frame", { Size = UDim2.new(0, CORNER_R, 0, CORNER_R), Position = pos,
            BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 12 }, xBtn)
    end
    xBtn.MouseEnter:Connect(function() xBtn.TextColor3 = self._accent end)
    xBtn.MouseLeave:Connect(function() xBtn.TextColor3 = DIM end)

    -- drag topBar
    do
        local dragging, dragStart, startPos, _activeTouchId = false, nil, nil, nil
        table.insert(self._connections, topBar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; dragStart = inp.Position; startPos = self.menuFrame.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true
                dragStart = inp.Position; startPos = self.menuFrame.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                self.menuFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false; dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                dragging = false; _activeTouchId = nil; dragStart = nil; startPos = nil
            end
        end))
    end

    -- ── Content ──────────────────────────────────────
    self.contentFrame = o("Frame", {
        Size = UDim2.new(1, 0, 1, -topH),
        Position = UDim2.new(0, 0, 0, topH),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, self.menuFrame)
    corner(self.contentFrame, CORNER_R)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R), Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, self.contentFrame)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R), Position = UDim2.new(1, -CORNER_R, 0, 0),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, self.contentFrame)

    self.container = o("ScrollingFrame", {
        Size = UDim2.new(1, -4, 1, -6),
        Position = UDim2.new(0, 2, 0, 4),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
    }, self.contentFrame)
    self:_registerThemeItem(self.container, "ScrollBarImageColor3", "accent")
    o("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, self.container)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 6), PaddingRight  = UDim.new(0, 6),
        PaddingTop  = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
    }, self.container)

    -- ── Float pill ────────────────────────────────────
    self.btnGui = o("ScreenGui", {
        Name = "KronUI_FloatBtn", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 9999,
    })
    local okPill = pcall(function() self.btnGui.Parent = CoreGui end)
    if not okPill then self.btnGui.Parent = pg end

    local PILL_SIZE = 46
    local pill = o("Frame", {
        Name = "PillUI",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(1, -46, 1, -242),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        ClipsDescendants = true, Visible = false, ZIndex = 200,
    }, self.btnGui)
    corner(pill, "pill")
    stroke(pill, 1, LINE)

    -- Glow pulsante mais suave: dois strokes em camadas
    local pillGlowOuter = stroke(pill, 3, self._accent, 0.82)
    local pillGlowInner = stroke(pill, 1.5, self._accent, 0.45)
    self:_registerThemeItem(pillGlowOuter, "Color", "accent")
    self:_registerThemeItem(pillGlowInner, "Color", "accent")
    self._pill = pill

    -- Glow animado suave com Sine (mais gentil que o anterior)
    self._breatheOuter = TweenService:Create(pillGlowOuter,
        TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        { Transparency = 0.97 })
    self._breatheInner = TweenService:Create(pillGlowInner,
        TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        { Transparency = 0.75 })
    self._breatheOuter:Play()
    self._breatheInner:Play()

    local resolvedImage = tostring(pillImage or "rbxassetid://78186286433275")
    if not resolvedImage:find("rbxassetid://") then
        resolvedImage = "rbxassetid://" .. resolvedImage
    end

    local pillIcon = o("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 32, 0, 32),
        BackgroundTransparency = 1,
        Image = resolvedImage,
        ImageColor3 = W,
        ScaleType = Enum.ScaleType.Fit, ZIndex = 201,
    }, pill)

    local pillBtn = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1, Text = "",
        AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 202,
    }, pill)
    pillBtn.MouseEnter:Connect(function() tween(pillIcon, EASE_OUT(0.12), { ImageColor3 = self._accent }) end)
    pillBtn.MouseLeave:Connect(function() tween(pillIcon, EASE_OUT(0.12), { ImageColor3 = W }) end)

    local pillScale = o("UIScale", { Scale = 1 }, pill)
    pillBtn.MouseButton1Down:Connect(function() tween(pillScale, EASE_OUT(0.08), { Scale = 0.88 }) end)
    pillBtn.MouseButton1Up:Connect(function()   tween(pillScale, EASE_OUT(0.14), { Scale = 1 })    end)
    pillBtn.MouseLeave:Connect(function()        tween(pillScale, EASE_OUT(0.14), { Scale = 1 })    end)

    local function frostBurst()
        local ring = o("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = pill.Position,
            Size = UDim2.new(0, PILL_SIZE, 0, PILL_SIZE),
            BackgroundTransparency = 1, ZIndex = 250,
        }, self.btnGui)
        corner(ring, "pill")
        local rStroke = stroke(ring, 2, self._accent)
        tween(ring, EASE_OUT(0.45), { Size = UDim2.new(0, PILL_SIZE + 60, 0, PILL_SIZE + 60) })
        tween(rStroke, EASE_OUT(0.45), { Transparency = 1 })
        task.delay(0.45, function() ring:Destroy() end)
    end

    local function showPill()
        pill.Visible = true
        pill.Size = UDim2.new(0, 0, 0, 0)
        tween(pill, EASE_BACK(0.35), { Size = UDim2.new(0, PILL_SIZE, 0, PILL_SIZE) })
    end
    local function hidePill()
        local t = tween(pill, EASE_OUT(0.18), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function()
            if pill.Size.X.Offset <= 1 then pill.Visible = false end
        end)
    end
    local function showMenu()
        self.menuFrame.Visible = true
        self.menuFrame.Size = UDim2.new(0, 0, 0, 0)
        tween(self.menuFrame, EASE_BACK(0.4), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
    end
    local function hideMenu()
        local t = tween(self.menuFrame, EASE_OUT(0.2), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function()
            if self.menuFrame.Size.X.Offset <= 1 then self.menuFrame.Visible = false end
        end)
    end

    xBtn.MouseButton1Click:Connect(function()
        playClick(); hideMenu(); showPill()
    end)

    -- drag pill
    do
        local dragging, dragMoved, dragStart, startPos, _activeTouchId = false, false, nil, nil, nil
        table.insert(self._connections, pillBtn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = pill.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = pill.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                if d.Magnitude > 4 then dragMoved = true end
                pill.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if not dragging then return end
                dragging = false
                if not dragMoved then playClick(); frostBurst(); hidePill(); showMenu() end
                dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                local wasMoved = dragMoved
                dragging = false; dragMoved = false; _activeTouchId = nil
                dragStart = nil; startPos = nil
                if not wasMoved then playClick(); frostBurst(); hidePill(); showMenu() end
            end
        end))
    end

    -- ── Notify ScreenGui ─────────────────────────────
    self._notifyGui = o("ScreenGui", {
        Name = "KronUI_Notify", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 99999,
    })
    local okNf = pcall(function() self._notifyGui.Parent = CoreGui end)
    if not okNf then self._notifyGui.Parent = pg end

    local notifyList = o("Frame", {
        Name = "NotifyStack",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -14, 1, -14),
        Size = UDim2.new(0, 240, 1, -28),
        BackgroundTransparency = 1,
    }, self._notifyGui)
    o("UIListLayout", {
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, notifyList)
    self._notifyList    = notifyList
    self._notifyCounter = 0

    -- ── Seção de tema padrão ─────────────────────────
    self:AddSectionLabel("🎨 Tema")
    self:AddThemeDropdown()

    return self
end

-- ══════════════════════════════════════════════════════
--  Notify
-- ══════════════════════════════════════════════════════
--[[
    ui:Notify("Título", "Mensagem", 3)
    ui:Notify("Aviso", "Texto", 4, "warn")   -- tipo: "info"|"warn"|"error"|"success"
]]
function KronUI:Notify(title, message, duration, notifType)
    duration  = duration  or 3
    notifType = notifType or "info"

    local accent = self._accent
    local iconMap = {
        info    = "ℹ",
        warn    = "⚠",
        error   = "✕",
        success = "✓",
    }
    local colorMap = {
        info    = self._accent,
        warn    = Color3.fromRGB(255, 190, 40),
        error   = Color3.fromRGB(255, 65, 65),
        success = Color3.fromRGB(60, 210, 110),
    }
    local barColor = colorMap[notifType] or accent

    self._notifyCounter = self._notifyCounter + 1
    local card = o("Frame", {
        Name = "Notif_" .. self._notifyCounter,
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0,
        ClipsDescendants = false,
        BackgroundTransparency = 0,
        LayoutOrder = self._notifyCounter,
    }, self._notifyList)
    corner(card, 9)
    strokeIn(card, 1, barColor, 0.5)

    -- barra lateral colorida
    local bar = o("Frame", {
        Size = UDim2.new(0, 3, 0, 34),
        Position = UDim2.new(0, 6, 0.5, -17),
        BackgroundColor3 = barColor, BorderSizePixel = 0,
    }, card)
    corner(bar, 2)

    -- ícone
    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 0),
        Size = UDim2.new(0, 20, 1, 0),
        Text = iconMap[notifType] or "ℹ",
        TextColor3 = barColor, TextSize = 14, Font = FONTB,
        TextXAlignment = Enum.TextXAlignment.Center,
    }, card)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 38, 0, 7),
        Size = UDim2.new(1, -46, 0, 18),
        Text = title or "",
        TextColor3 = W, TextSize = 12, Font = FONTB,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, card)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 38, 0, 26),
        Size = UDim2.new(1, -46, 0, 20),
        Text = message or "",
        TextColor3 = MID, TextSize = 10, Font = FONT,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, card)

    -- barra de progresso na base
    local progBg = o("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = LINE, BorderSizePixel = 0,
    }, card)
    corner(progBg, 2)
    local progFill = o("Frame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = barColor, BorderSizePixel = 0,
    }, progBg)
    corner(progFill, 2)

    -- entra pela direita
    card.Position = UDim2.new(0, 260, 0, 0)
    tween(card, EASE_BACK(0.35), { Position = UDim2.new(0, 0, 0, 0) })
    tween(progFill, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) })

    task.delay(duration, function()
        tween(card, EASE_OUT(0.22), { BackgroundTransparency = 1 })
        tween(card, EASE_OUT(0.22), { Position = UDim2.new(0, 260, 0, 0) })
        task.delay(0.24, function() card:Destroy() end)
    end)

    return card
end

-- ══════════════════════════════════════════════════════
--  AddThemeDropdown (11 temas)
-- ══════════════════════════════════════════════════════
function KronUI:AddThemeDropdown()
    local options = {}
    for name in pairs(KronUI.Themes) do table.insert(options, name) end
    table.sort(options)

    self:AddDropdown("Tema", options, {}, function(selected)
        if selected and KronUI.Themes[selected] then
            self:SetTheme(selected)
        end
    end)
end

-- ══════════════════════════════════════════════════════
--  Destroy
-- ══════════════════════════════════════════════════════
function KronUI:Destroy()
    for _, conn in ipairs(self._connections) do conn:Disconnect() end
    self._connections = {}
    if self._breatheOuter then self._breatheOuter:Cancel() end
    if self._breatheInner then self._breatheInner:Cancel() end
    if self.gui         then self.gui:Destroy()         end
    if self.btnGui      then self.btnGui:Destroy()      end
    if self._notifyGui  then self._notifyGui:Destroy()  end
end

function KronUI:_nextOrder()
    self._layoutOrder = self._layoutOrder + 1
    return self._layoutOrder
end

