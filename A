        TextXAlignment = Enum.TextXAlignment.Left,
        Text = text or "",
    }, holder)

    local inputBg = o("Frame", {
        Size = UDim2.new(1, -24, 0, 20),
        Position = UDim2.new(0, 12, 0, 24),
        BackgroundColor3 = BG, BorderSizePixel = 0,
    }, holder)
    corner(inputBg, 5)
