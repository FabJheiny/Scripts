    return {
        Frame    = holder,
        GetValue = function() return box.Text end,
        SetValue = function(v)
            box.Text = tostring(v)
            if callback then task.spawn(callback, box.Text, false) end
        end,
        SetPlaceholder = function(v) box.PlaceholderText = v end,
        Clear = function() box.Text = "" end,
