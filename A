--  AddKeybind — VERSÃO CORRIGIDA (ÚNICO LISTENER)
-- ══════════════════════════════════════════════════════
function KronUI:AddKeybind(text, default, callback)
    local currentKey = default or Enum.KeyCode.RightShift
    local listening = false

    local btn = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, AutoButtonColor = false, Text = "",
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    corner(btn, 8)
    local btnStroke = strokeIn(btn, 1, LINE)

    o("TextLabel", { BackgroundTransparency = 1, Position = UDim2.new(0,12,0,0), Size = UDim2.new(1,-80,1,0), Font = FONT, TextSize = 12, TextColor3 = MID, TextXAlignment = Enum.TextXAlignment.Left, Text = text or "" }, btn)

    local keyPill = o("Frame", { AnchorPoint = Vector2.new(1,0.5), Position = UDim2.new(1,-10,0.5,0), Size = UDim2.new(0,60,0,20), BackgroundColor3 = BG }, btn)
    corner(keyPill, 5)
    strokeIn(keyPill, 1, LINE)

    local keyLabel = o("TextLabel", { Size = UDim2.new(1,0,1,0), BackgroundTransparency = 1, Font = FONTB, TextSize = 10, TextColor3 = self._accent, TextXAlignment = Enum.TextXAlignment.Center, Text = currentKey.Name }, keyPill)
    self:_registerThemeItem(keyLabel, "TextColor3", "accent")

    local function setListening(v)
        listening = v
        keyLabel.Text = v and "..." or currentKey.Name
        tween(btnStroke, EASE_OUT(0.12), { Color = v and self._accent or LINE, Transparency = v and 0.3 or 0 })
    end

    btn.MouseButton1Click:Connect(function()
        self._playClick()
        setListening(not listening)
    end)

    -- ÚNICO InputBegan
    table.insert(self._connections, UserInputService.InputBegan:Connect(function(inp, gameProcessed)
        if gameProcessed then return end

        if listening then
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                if inp.KeyCode == Enum.KeyCode.Escape then
                    setListening(false)
                    return
                end
                currentKey = inp.KeyCode
                setListening(false)
                if callback then task.spawn(callback, currentKey) end
            end
            return
        end

        -- Tecla normal
        if inp.UserInputType == Enum.UserInputType.Keyboard and inp.KeyCode == currentKey then
            if callback then task.spawn(callback, currentKey) end
        end
    end))

    btn.MouseEnter:Connect(function() btn.BackgroundColor3 = HOVER end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = CARD end)

    return {
        Frame = btn,
        GetKey = function() return currentKey end,
        SetKey = function(k) currentKey = k; keyLabel.Text = k.Name end,
    }
end

