-- ── PILL ─────────────────────────────────────────────────────────────────────
local PillGui = o("ScreenGui", {
	Name = "SpectatePillGui", ResetOnSpawn = false,
	IgnoreGuiInset = true, DisplayOrder = 9999,
	ZIndexBehavior = Enum.ZIndexBehavior.Global,
})
local ok2 = pcall(function() PillGui.Parent = CoreGui end)
if not ok2 then PillGui.Parent = Player:WaitForChild("PlayerGui") end

local pill = o("Frame", {
	Name = "PillSpectate",
	Size = UDim2.new(0, 80, 0, 20),
	Position = UDim2.new(1, -86, 1, -278),
	BackgroundColor3 = BG, BorderSizePixel = 0,
	ZIndex = 200,
}, PillGui)
o("UICorner", { CornerRadius = UDim.new(0, 5) }, pill)
stroke(pill, 1, LINE)

local pillBtn = o("TextButton", {
	Size = UDim2.new(1, 0, 1, 0),
	BackgroundTransparency = 1,
	Text = "> spectate", TextSize = 9, Font = FONT,
	TextColor3 = DIM, BorderSizePixel = 0,
	ZIndex = 201,
}, pill)
pillBtn.MouseEnter:Connect(function() pillBtn.TextColor3 = W end)
pillBtn.MouseLeave:Connect(function() pillBtn.TextColor3 = DIM end)

-- Drag da pill
do
	local dragging, dragMoved, dragStart, startPos, _tid = false, false, nil, nil, nil
	pillBtn.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			if dragging then return end
			dragging = true; dragMoved = false
			dragStart = inp.Position; startPos = pill.Position
		elseif inp.UserInputType == Enum.UserInputType.Touch then
			if _tid ~= nil then return end
			_tid = inp; dragging = true; dragMoved = false
			dragStart = inp.Position; startPos = pill.Position
		end
	end)
	UIS.InputChanged:Connect(function(inp)
		if not dragging then return end
		if inp.UserInputType == Enum.UserInputType.Touch and inp ~= _tid then return end
		local d = inp.Position - dragStart
		if math.abs(d.X) + math.abs(d.Y) > 2 then
			dragMoved = true
			pill.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)
	UIS.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			if not dragMoved then
				-- toggle igual ao original: usa Position para entrar/sair
				-- a lógica real está no pillBtn.MouseButton1Click abaixo
			end
			dragging = false; dragMoved = false; dragStart = nil; startPos = nil
		elseif inp.UserInputType == Enum.UserInputType.Touch then
			if inp ~= _tid then return end
			dragging = false; dragMoved = false; dragStart = nil; startPos = nil; _tid = nil
		end
	end)
end

-- ── LÓGICA (idêntica ao original) ────────────────────────────────────────────
local cam = workspace.CurrentCamera
local players = Players:GetPlayers()
local currentIndex = 1

task.spawn(function()
	while true do
		task.wait(10)
		players = Players:GetPlayers()
		if currentIndex > #players then
			currentIndex = #players
		end
	end
end)

local function updateCameraAndTitle(index)
	if #players == 0 then return end
	local p = players[index]
	if p and p.Character then
		cam.CameraSubject = p.Character.Humanoid
		title.Text = string.format("%s (@%s)", p.DisplayName, p.Name)
	end
end

updateCameraAndTitle(currentIndex)

-- Toggle original: Position entra/sai da tela + câmera
local debounce = false
pillBtn.MouseButton1Click:Connect(function()
	if debounce == false then
		debounce = true
		bar.Position = UDim2.new(0.5, -100, 0.88, -25)
		pcall(function()
			local p = Players:GetPlayerFromCharacter(cam.CameraSubject.Parent)
			title.Text = string.format("%s (@%s)", p.DisplayName, p.Name)
		end)
	else
		debounce = false
		pcall(function() cam.CameraSubject = Player.Character.Humanoid end)
		bar.Position = UDim2.new(-1, -100, 0.88, -25)
	end
end)

prev.MouseButton1Click:Connect(function()
	currentIndex = currentIndex - 1
	if currentIndex < 1 then currentIndex = #players end
	updateCameraAndTitle(currentIndex)
end)

nex.MouseButton1Click:Connect(function()
	currentIndex = currentIndex + 1
	if currentIndex > #players then currentIndex = 1 end
	updateCameraAndTitle(currentIndex)
end)
