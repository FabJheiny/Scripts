    Font=FONT,TextColor3=W,TextSize=14,
    AutoButtonColor=false,
})
stroke(nex,1)
nex.MouseEnter:Connect(function() nex.BackgroundColor3=D end)
nex.MouseLeave:Connect(function() nex.BackgroundColor3=B end)

local title=o("TextLabel",{
    Name="Title",Parent=bar,
    Position=UDim2.new(0.275,0,0,0),
    Size=UDim2.new(0.45,0,1,0),
    Text="",
    BackgroundTransparency=1,BorderSizePixel=0,
    Font=FONT,TextColor3=W,
    TextSize=14,TextScaled=true,
})

-- Pill
local PillGui=o("ScreenGui",{
    Name="SpectatePillGui",ResetOnSpawn=false,
    IgnoreGuiInset=true,DisplayOrder=9999,
})
local ok2=pcall(function() PillGui.Parent=CoreGui end)
if not ok2 then PillGui.Parent=Player:WaitForChild("PlayerGui") end

local pill=o("Frame",{
    Name="PillSpectate",
    Size=UDim2.new(0,60,0,18),
    Position=UDim2.new(1,-66,1,-278),
    BackgroundColor3=B,BorderSizePixel=0,
    ZIndex=200,
},PillGui)
stroke(pill,1)
local pillBtn=o("TextButton",{
    Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
    Text="> spectate",TextSize=9,Font=FONT,
    TextColor3=W,BorderSizePixel=0,ZIndex=201,
},pill)

-- Lógica
local cam = workspace.CurrentCamera
local players = Players:GetPlayers()
local currentIndex = 1

-- Atualiza lista de players a cada 10 segundos
task.spawn(function()
    while true do
        task.wait(10)
        players = Players:GetPlayers()
        -- Corrige índice caso a lista tenha encolhido
        if currentIndex > #players then
            currentIndex = #players
        end
    end
end)

local function updateCameraAndTitle(index)
    if #players == 0 then return end
    local player = players[index]
    if player and player.Character then
        cam.CameraSubject = player.Character.Humanoid
        title.Text = string.format("%s (@%s)", player.DisplayName, player.Name)
    end
end

updateCameraAndTitle(currentIndex)

local debounce = false
pillBtn.MouseButton1Click:Connect(function()
    if debounce == false then
        debounce = true
        -- Sem animação: posição direta
        bar.Position = UDim2.new(.5,-100,0.88,-50)
        pcall(function()
            local player = Players:GetPlayerFromCharacter(cam.CameraSubject.Parent)
            title.Text = string.format("%s (@%s)", player.DisplayName, player.Name)
        end)
    else
        debounce = false
        pcall(function() cam.CameraSubject = Player.Character.Humanoid end)
        -- Sem animação: posição direta
        bar.Position = UDim2.new(-1,-100,0.88,-50)
    end
end)

prev.MouseButton1Click:Connect(function()
    currentIndex = currentIndex - 1
    if currentIndex < 1 then
        currentIndex = #players
    end
    updateCameraAndTitle(currentIndex)
end)

nex.MouseButton1Click:Connect(function()
    currentIndex = currentIndex + 1
    if currentIndex > #players then
        currentIndex = 1
    end
    updateCameraAndTitle(currentIndex)
end)
