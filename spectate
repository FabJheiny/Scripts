local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local UIS     = game:GetService("UserInputService")
local Player  = Players.LocalPlayer

local BG    = Color3.fromRGB(18,  32,  20)
local CARD  = Color3.fromRGB(26,  44,  28)
local HOVER = Color3.fromRGB(34,  56,  36)
local LINE  = Color3.fromRGB(50,  75,  52)
local DIM   = Color3.fromRGB(180, 195, 180)
local MID   = Color3.fromRGB(220, 230, 220)
local W     = Color3.fromRGB(255, 255, 255)
local BLUE  = Color3.fromRGB(90,  200, 255)
local BLUEDK= Color3.fromRGB(60,  150, 200)
local FONT  = Enum.Font.GothamMedium

local BAR_TRANSPARENCY  = 0.22
local CARD_TRANSPARENCY = 0.15

local function o(cls, props, par)
	local x = Instance.new(cls)
	for k, v in pairs(props) do x[k] = v end
	if par then x.Parent = par end
	return x
end

local function stroke(par, t, c)
	o("UIStroke", {
		Color = c or LINE, Thickness = t or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, par)
end

