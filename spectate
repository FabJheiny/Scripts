local Players   = game:GetService("Players")
local CoreGui   = game:GetService("CoreGui")
local Player    = Players.LocalPlayer

local B    = Color3.fromRGB(0,0,0)
local W    = Color3.fromRGB(255,255,255)
local D    = Color3.fromRGB(15,15,15)
local FONT = Enum.Font.Code

local function o(cls,props,par)
    local x=Instance.new(cls)
    for k,v in pairs(props) do x[k]=v end
    if par then x.Parent=par end
    return x
end
local function stroke(par,t,c)
    o("UIStroke",{Color=c or W,Thickness=t or 1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},par)
end

-- ScreenGui
local sg=o("ScreenGui",{
    Name="SpectateGui",ResetOnSpawn=false,
    IgnoreGuiInset=true,DisplayOrder=2147483647,
})
local ok=pcall(function() sg.Parent=CoreGui end)
if not ok then sg.Parent=Player:WaitForChild("PlayerGui") end

-- Bar
local bar=o("Frame",{
    Name="Bar",
    Parent=sg,
    Position=UDim2.new(-1,-100,0.88,-50),
    Size=UDim2.new(0,200,0,50),
    BackgroundColor3=B,
    BackgroundTransparency=0,
    BorderSizePixel=0,
})
stroke(bar,1)

local prev=o("TextButton",{
    Name="Previous",Parent=bar,
    Size=UDim2.new(0.25,0,1,0),
    Position=UDim2.new(0,0,0,0),
    Text="<",
    BackgroundColor3=B,BorderSizePixel=0,
    Font=FONT,TextColor3=W,TextSize=14,
    AutoButtonColor=false,
})
stroke(prev,1)
prev.MouseEnter:Connect(function() prev.BackgroundColor3=D end)
prev.MouseLeave:Connect(function() prev.BackgroundColor3=B end)

local nex=o("TextButton",{
