-- =========================================================
-- Drag da bolinha
-- =========================================================
do
	local dragging, dragMoved, dragStart, startPos, _tid = false, false, nil, nil, nil
	pillBtn.InputBegan:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			if dragging then return end
			dragging = true; dragMoved = false
			dragStart = inp.Position; startPos = pill.Position
		elseif inp.UserInputType == Enum.UserInputType.Touch then
			if _tid ~= nil then return end
			_tid = inp; dragging = true; dragMoved = false
			dragStart = inp.Position; startPos = pill.Position
		end
	end)
	UIS.InputChanged:Connect(function(inp)
		if not dragging then return end
		if inp.UserInputType == Enum.UserInputType.Touch and inp ~= _tid then return end
		local d = inp.Position - dragStart
		if math.abs(d.X) + math.abs(d.Y) > 2 then
			dragMoved = true
			pill.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + d.X,
				startPos.Y.Scale, startPos.Y.Offset + d.Y
			)
		end
	end)
	UIS.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false; dragMoved = false; dragStart = nil; startPos = nil
		elseif inp.UserInputType == Enum.UserInputType.Touch then
			if inp ~= _tid then return end
			dragging = false; dragMoved = false; dragStart = nil; startPos = nil; _tid = nil
		end
	end)
end

-- =========================================================
-- Estado do spectate
-- =========================================================
local cam = workspace.CurrentCamera
local players = Players:GetPlayers()
local currentIndex = 1
local menuOpen = false

-- Atualiza a lista preservando um índice válido
local function refreshPlayers()
	players = Players:GetPlayers()
	if #players == 0 then
		currentIndex = 1
		return
	end
	if currentIndex > #players then
		currentIndex = #players
	elseif currentIndex < 1 then
		currentIndex = 1
	end
end

-- Encontra o próximo índice válido (pulando o próprio jogador)
-- dir = 1 (próximo) ou -1 (anterior)
local function findNextValid(startIdx, dir)
	if #players == 0 then return 1 end
	local i = startIdx
	-- Percorre no máximo #players vezes para evitar loop infinito
	for _ = 1, #players do
		if i < 1 or i > #players then return startIdx end
		local p = players[i]
		if p and p ~= Player then
			return i
		end
		i = i + dir
	end
	return startIdx
end

local function getCurrentTarget()
	local p = players[currentIndex]
	if p and p ~= Player then
		return p
	end
	return nil
end

local function updateCameraAndTitle(index)
	-- Se for o próprio jogador (índice 1 normalmente), restaura a câmera
	local p = players[index]
	if not p or p == Player then
		if Player.Character and Player.Character:FindFirstChild("Humanoid") then
			cam.CameraSubject = Player.Character.Humanoid
		end
		title.Text = string.format("%s (@%s)", Player.DisplayName, Player.Name)
		return
	end
	if p.Character and p.Character:FindFirstChild("Humanoid") then
		cam.CameraSubject = p.Character.Humanoid
		title.Text = string.format("%s (@%s)", p.DisplayName, p.Name)
	end
end

-- Loop de atualização periódica da lista
task.spawn(function()
	while true do
		task.wait(10)
		refreshPlayers()
	end
end)

updateCameraAndTitle(currentIndex)

-- =========================================================
-- Toggle da bolinha
-- =========================================================
pillBtn.MouseButton1Click:Connect(function()
	if not menuOpen then
		-- ABRINDO
		menuOpen = true
		refreshPlayers()
		currentIndex = 1                       -- sempre começa do zero
		bar.Position = UDim2.new(0.5, -110, 0.88, -25)
		updateCameraAndTitle(currentIndex)
	else
		-- FECHANDO
		menuOpen = false
		bar.Position = UDim2.new(-1, -100, 0.88, -25)

		-- Restaura a câmera para o próprio jogador (se possível)
		if Player.Character and Player.Character:FindFirstChild("Humanoid") then
			cam.CameraSubject = Player.Character.Humanoid
		end

		currentIndex = 1                       -- reseta para quando reabrir
	end
end)

-- =========================================================
-- Navegação (sem wrap-around, pulando o próprio jogador)
-- =========================================================
prev.MouseButton1Click:Connect(function()
	if #players == 0 then return end
	if currentIndex <= 1 then
		-- já está no início, não faz nada
		return
	end
	local newIdx = findNextValid(currentIndex - 1, -1)
	if newIdx ~= currentIndex then
		currentIndex = newIdx
		updateCameraAndTitle(currentIndex)
	end
end)

nex.MouseButton1Click:Connect(function()
	if #players == 0 then return end
	if currentIndex >= #players then
		-- já está no fim, não faz nada
		return
	end
	local newIdx = findNextValid(currentIndex + 1, 1)
	if newIdx ~= currentIndex then
		currentIndex = newIdx
		updateCameraAndTitle(currentIndex)
	end
end)

-- =========================================================
-- Teleporte ao clicar no título
-- =========================================================
title.MouseButton1Click:Connect(function()
	local target = getCurrentTarget()
	if not target then return end

	local myChar = Player.Character
	local targetChar = target.Character
	if not myChar or not targetChar then return end

	local myRoot = myChar:FindFirstChild("HumanoidRootPart")
	local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
	if not myRoot or not targetRoot then return end

	local offset = targetRoot.CFrame * CFrame.new(0, 0, -3)
	myRoot.CFrame = offset
end)
