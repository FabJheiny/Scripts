    },lsBar)
    addPressFX(lsPlus) addPressFX(lsMinus)

    local lsCv, lsConn = nil, nil
    local function lsStopLoop() if lsConn then lsConn:Disconnect() lsConn=nil end end
    local function lsStartLoop(v)
        lsStopLoop()
        local function hookHum(char)
            if not char then return end
            local hum=char:WaitForChild("Humanoid",5) if not hum then return end
            hum.WalkSpeed=v
            lsConn=hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if hum.WalkSpeed~=v then hum.WalkSpeed=v end
            end)
        end
        hookHum(LP.Character)
        LP.CharacterAdded:Connect(function(char) if lsCv then hookHum(char) end end)
    end
    local function lsApply(v)
        if v==nil then
            lsCv=nil; lsBox.Text=""; lsStopLoop()
            if LP.Character then
                local hum=LP.Character:FindFirstChildOfClass("Humanoid")
                if hum and _origSpeed then hum.WalkSpeed=_origSpeed end
            end
            _origSpeed=nil
            lsBox.PlaceholderText = tostring(getOrigSpeed())
            flashStroke(lsBarStroke); toast("Loop Speed: OFF")
            return
        end
        v=math.clamp(math.floor(v),1,5000)
        if lsCv==nil then getOrigSpeed() end
        lsCv=v; lsBox.Text=tostring(v); lsStartLoop(v)
        lsBox.PlaceholderText = tostring(v)  -- mostra o valor atual como placeholder
        flashStroke(lsBarStroke); toast("Loop Speed: "..v)
    end
