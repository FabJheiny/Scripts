local tabBtns,tabPages,cur={},{},nil
local function sw(idx)
    if cur==idx then return end
    if cur then tween(tabBtns[cur],{BackgroundColor3=B,TextColor3=W,BackgroundTransparency=0},0.15) end
    cur=idx
    tween(tabBtns[idx],{BackgroundColor3=W,TextColor3=B,BackgroundTransparency=0},0.15)
    playSfx(SFX.Click,0.3,1.1)
    for j,p in ipairs(tabPages) do
        if j==idx then
            p.Position=UDim2.new(0,14,0,0); p.Visible=true
            tween(p,{Position=UDim2.new(0,0,0,0)},0.2,Enum.EasingStyle.Quad,Enum.EasingDirection.Out)
        else p.Visible=false end
    end
end
local function makeTabBtn(name,idx)
    local tb=o("TextButton",{
        Size=UDim2.new(1,0,0,30),BackgroundColor3=B,BorderSizePixel=0,
        Text=name,TextColor3=W,TextSize=14,Font=FONT_MAIN,
        AutoButtonColor=false,LayoutOrder=idx,TextWrapped=true,
    },tlist)
    stroke(tb,1)
    tb.MouseEnter:Connect(function()
        if cur~=idx then tween(tb,{BackgroundColor3=W,BackgroundTransparency=0.88},0.12) playSfx(SFX.Hover,0.15) end
    end)
    tb.MouseLeave:Connect(function()
        if cur~=idx then tween(tb,{BackgroundColor3=B,BackgroundTransparency=0},0.12) end
    end)
    return tb
end

