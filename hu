    ijBtn.MouseEnter:Connect(function() if not ijActive then tween(ijBtn,{BackgroundColor3=W,BackgroundTransparency=0.88},0.12) end end)
    ijBtn.MouseLeave:Connect(function() if not ijActive then tween(ijBtn,{BackgroundColor3=B,BackgroundTransparency=0},0.12) end end)

    -- No Clip
    o("TextLabel",{
        Size=UDim2.new(0,ITEM_W,0,12), Position=UDim2.new(0,positions[4],0,rowY),
        BackgroundTransparency=1,Text="No Clip",TextColor3=W, TextSize=9,Font=FONT_MAIN,TextXAlignment=Enum.TextXAlignment.Center,
    },pg)
    local ncActive=false; local ncConn=nil
    local ncBtn=o("TextButton",{
        Size=UDim2.new(0,ITEM_W,0,ITEM_H), Position=UDim2.new(0,positions[4],0,rowY+13),
        BackgroundColor3=B,BorderSizePixel=0, Text="OFF",TextColor3=W,TextSize=10,Font=FONT_MAIN, AutoButtonColor=false,
    },pg)
    local ncStroke=stroke(ncBtn,1); addPressFX(ncBtn)
    local function restoreCollision(char)
        if not char then return end
        local cols={"torso","root","leg","head"}
        for _,v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                local n=v.Name:lower() local sc=false
                for _,p in ipairs(cols) do if n:find(p) then sc=true break end end
                v.CanCollide=sc
                if v.Parent and (v.Parent:IsA("Accessory") or v.Parent:IsA("Hat")) then v.Massless=true v.CanTouch=false end
            end
        end
    end
    local function setNoClip(state)
        ncActive=state; playSfx(SFX.Toggle,0.4,state and 1.2 or 0.8); flashStroke(ncStroke)
        if state then
            ncBtn.Text="ON"; tween(ncBtn,{BackgroundColor3=W,TextColor3=B},0.15)
            ncConn=RS.Stepped:Connect(function()
                if LP.Character then for _,v in pairs(LP.Character:GetDescendants()) do if v:IsA("BasePart") then v.CanCollide=false end end end
            end)
        else
            ncBtn.Text="OFF"; tween(ncBtn,{BackgroundColor3=B,TextColor3=W},0.15)
            if ncConn then ncConn:Disconnect() ncConn=nil end
            restoreCollision(LP.Character)
        end
        toast("No Clip: "..(state and "ON" or "OFF"))
    end
    ncBtn.MouseButton1Click:Connect(function() setNoClip(not ncActive) end)
    ncBtn.MouseEnter:Connect(function() if not ncActive then tween(ncBtn,{BackgroundColor3=W,BackgroundTransparency=0.88},0.12) end end)
    ncBtn.MouseLeave:Connect(function() if not ncActive then tween(ncBtn,{BackgroundColor3=B,BackgroundTransparency=0},0.12) end end)

    -- Reset
