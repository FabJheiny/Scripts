        Size=UDim2.new(0,ITEM_W,0,12), Position=UDim2.new(0,positions[5],0,rowY),
        BackgroundTransparency=1,Text="Reset",TextColor3=W, TextSize=9,Font=FONT_MAIN,TextXAlignment=Enum.TextXAlignment.Center,
    },pg)
    local resetBtn=o("TextButton",{
        Size=UDim2.new(0,ITEM_W,0,ITEM_H), Position=UDim2.new(0,positions[5],0,rowY+13),
        BackgroundColor3=B,BorderSizePixel=0, Text="Reset",TextColor3=W,TextSize=10,Font=FONT_MAIN, AutoButtonColor=false,
    },pg)
    local resetStroke=stroke(resetBtn,1); addPressFX(resetBtn)
    resetBtn.MouseEnter:Connect(function() tween(resetBtn,{BackgroundColor3=W,BackgroundTransparency=0.88},0.12) end)
    resetBtn.MouseLeave:Connect(function() tween(resetBtn,{BackgroundColor3=B,BackgroundTransparency=0},0.12) end)
    resetBtn.MouseButton1Click:Connect(function()
        playSfx(SFX.Click,0.4,0.9); flashStroke(resetStroke)
        if LP.Character then local hum=LP.Character:FindFirstChildOfClass("Humanoid") if hum then hum.Health=0 end end
        toast("Character Reset")
    end)
end

