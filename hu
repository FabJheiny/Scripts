    end)

    -- Loop Speed
    local _origSpeed=nil
    local function getOrigSpeed()
        if _origSpeed then return _origSpeed end
        if LP.Character then local hum=LP.Character:FindFirstChildOfClass("Humanoid") if hum then _origSpeed=hum.WalkSpeed end end
        return _origSpeed or 16
    end

    o("TextLabel",{
        Size=UDim2.new(0,ITEM_W,0,12), Position=UDim2.new(0,positions[2],0,rowY),
        BackgroundTransparency=1,Text="Loop Speed",TextColor3=W, TextSize=9,Font=FONT_MAIN,TextXAlignment=Enum.TextXAlignment.Center,
    },pg)
    local lsBar=o("Frame",{
        Size=UDim2.new(0,ITEM_W,0,ITEM_H), Position=UDim2.new(0,positions[2],0,rowY+13),
        BackgroundColor3=B,BorderSizePixel=0,Active=false,
    },pg)
    local lsBarStroke=stroke(lsBar,1)
    local bsz=ITEM_H local dv=1 local nw=ITEM_W-2*bsz-2*dv
    local lsPlus=o("TextButton",{
        Size=UDim2.new(0,bsz,1,0),Position=UDim2.new(0,0,0,0),
        BackgroundColor3=B,BorderSizePixel=0,Text="+",TextColor3=W, TextSize=14,Font=FONT_MAIN,AutoButtonColor=false,
    },lsBar)
    o("Frame",{Size=UDim2.new(0,dv,1,0),Position=UDim2.new(0,bsz,0,0),BackgroundColor3=W,BorderSizePixel=0},lsBar)
    local lsBox=o("TextBox",{
        Size=UDim2.new(0,nw,1,0),Position=UDim2.new(0,bsz+dv,0,0),
        BackgroundTransparency=1,Text="",PlaceholderText=tostring(getOrigSpeed()), PlaceholderColor3=W,
