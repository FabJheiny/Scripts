local function makeRow(cmd)
    local row = o("Frame", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1, BorderSizePixel = 0,
    })

    local nameW = #cmd.n * 6.5
    o("TextLabel", {
        Text = cmd.n, Font = FONT, TextSize = 10,
        TextColor3 = W, BackgroundTransparency = 1,
        Size = UDim2.new(0, nameW, 1, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)

    local afterName = nameW
    if cmd.a then
        local argW = #(" "..cmd.a) * 5.5
        o("TextLabel", {
            Text = " "..cmd.a, Font = FONT, TextSize = 10,
            TextColor3 = G, BackgroundTransparency = 1,
            Size = UDim2.new(0, argW, 1, 0),
            Position = UDim2.new(0, afterName, 0, 0),
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
        afterName = afterName + argW
    end

    o("TextLabel", {
        Text = " / "..cmd.d, Font = FONT, TextSize = 10,
        TextColor3 = DIM, BackgroundTransparency = 1,
        Size = UDim2.new(1, -(afterName + 70), 1, 0),
        Position = UDim2.new(0, afterName + 2, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    if cmd.u then
        o("TextLabel", {
            Text = cmd.u == "—" and "on/off" or cmd.u,
            Font = FONT, TextSize = 9,
            TextColor3 = G, BackgroundTransparency = 1,
            Size = UDim2.new(0, 60, 1, 0),
            Position = UDim2.new(1, -60, 0, 0),
            TextXAlignment = Enum.TextXAlignment.Right,
        }, row)
    end

    local hit = o("TextButton", {
        Text = "", BackgroundColor3 = G,
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Size = UDim2.new(1,0,1,0), ZIndex = 10,
    }, row)
    hit.MouseEnter:Connect(function()  hit.BackgroundTransparency = 0.7 end)
    hit.MouseLeave:Connect(function()  hit.BackgroundTransparency = 1   end)
    hit.MouseButton1Click:Connect(function()
        hit.BackgroundTransparency = 0.5
        task.wait(0.05)
        hit.BackgroundTransparency = 1
        print("[IY] "..cmd.n)
    end)

    return row
end

local function render(query)
    for _, ch in ipairs(scrollFrame:GetChildren()) do
        if ch:IsA("GuiObject") then ch:Destroy() end
    end
    local q = (query or ""):lower()
    local filtered = {}
    for _, cmd in ipairs(COMMANDS) do
        if q == "" or cmd.n:lower():find(q,1,true) or cmd.d:lower():find(q,1,true) then
            table.insert(filtered, cmd)
        end
    end
    if #filtered == 0 then
        o("TextLabel", {
            Text = "Nenhum comando encontrado.",
            Font = FONT, TextSize = 10,
            TextColor3 = G, BackgroundTransparency = 1,
            Size = UDim2.new(1,0,0,30),
            TextXAlignment = Enum.TextXAlignment.Center,
            LayoutOrder = 0,
        }, scrollFrame)
    else
        for i, cmd in ipairs(filtered) do
            local row = makeRow(cmd)
            row.LayoutOrder = i
            row.Parent = scrollFrame
        end
    end
end

