local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")

local KronUI = {}
KronUI.__index = KronUI

local BG      = Color3.fromRGB(5, 5, 7)
local PANEL   = Color3.fromRGB(8, 8, 11)
local CARD    = Color3.fromRGB(12, 12, 15)
local HOVER   = Color3.fromRGB(20, 20, 24)
local LINE    = Color3.fromRGB(30, 30, 36)
local ACCENT  = Color3.fromRGB(45, 40, 55)
local ACCENT2 = Color3.fromRGB(25, 22, 32)
local DIM     = Color3.fromRGB(150, 145, 165)
local MID     = Color3.fromRGB(195, 190, 215)
local W       = Color3.fromRGB(242, 240, 250)
local DARK    = Color3.fromRGB(15, 15, 20)
local FONT    = Enum.Font.GothamMedium
local FONTB   = Enum.Font.GothamBold

local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end

local function stroke(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, par)
end

local function strokeIn(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
    }, par)
end

local function corner(par, r)
    return o("UICorner", { CornerRadius = (r == "pill") and UDim.new(1, 0) or UDim.new(0, r or 8) }, par)
end

local function tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local EASE_OUT  = function(d) return TweenInfo.new(d or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) end
local EASE_BACK = function(d) return TweenInfo.new(d or 0.4,  Enum.EasingStyle.Back, Enum.EasingDirection.Out) end

local MENU_W, MENU_H   = 420, 260
local MIN_W,  MIN_H    = 320, 180
local MAX_W,  MAX_H    = 700, 500
local TOPBAR_H          = 32
local CORNER_R          = 14
local TABBAR_W          = 76

function KronUI.new(title, pillImage)
    local self = setmetatable({}, KronUI)

    self._bg      = BG
    self._panel   = PANEL
    self._card    = CARD
    self._hover   = HOVER
    self._line    = LINE
    self._accent  = ACCENT
    self._accent2 = ACCENT2

    self._xBtn = nil
    self._tabs = {}
    self._activeTabId = nil

    local player = Players.LocalPlayer
    local pg     = player:WaitForChild("PlayerGui", 10) or player.PlayerGui

    local old    = pg:FindFirstChild("KronUI_Lib")
    local oldBtn = CoreGui:FindFirstChild("KronUI_FloatBtn") or pg:FindFirstChild("KronUI_FloatBtn")
    if old    then old:Destroy()    end
    if oldBtn then oldBtn:Destroy() end

    self._connections = {}
    self._layoutOrder = 0

    _G.KronUIScale = _G.KronUIScale or 20
    local function getUIScale(s) return 0.45 + (s - 1) * 0.04 end

    self.gui = o("ScreenGui", {
        Name = "KronUI_Lib", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 10,
    }, pg)

    local clickSound = o("Sound", {
        SoundId = "rbxassetid://6895079853",
        Volume  = 0.6,
        RollOffMaxDistance = 0,
    }, self.gui)

    local function playClick() clickSound:Play() end
    self._playClick = playClick

    self.menuFrame = o("Frame", {
        Name = "MenuFrame",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = self._bg,
        BorderSizePixel = 0, Active = true, ClipsDescendants = true,
    }, self.gui)
    corner(self.menuFrame, CORNER_R)
    stroke(self.menuFrame, 1, self._line)
    stroke(self.menuFrame, 1.5, self._accent, 0.6)

    local uiScaleObj = Instance.new("UIScale")
    uiScaleObj.Scale  = getUIScale(_G.KronUIScale)
    uiScaleObj.Parent = self.menuFrame
    self._uiScaleObj = uiScaleObj

    self._targetSize = Vector2.new(MENU_W, MENU_H)

    task.defer(function()
        tween(self.menuFrame, EASE_BACK(0.5), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
    end)

    local topBar = o("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, TOPBAR_H),
        BackgroundColor3 = self._bg,
        BorderSizePixel = 0, Active = true, ZIndex = 10,
    }, self.menuFrame)
    corner(topBar, CORNER_R)

    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 1, -CORNER_R),
        BackgroundColor3 = self._bg, BorderSizePixel = 0, ZIndex = 11,
    }, topBar)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(1, -CORNER_R, 1, -CORNER_R),
        BackgroundColor3 = self._bg, BorderSizePixel = 0, ZIndex = 11,
    }, topBar)

    local titleBtn = o("TextButton", {
        Size = UDim2.new(1, -50, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = title or "Interface",
        TextColor3 = W, TextSize = 13, Font = FONTB,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false,
        ZIndex = 10,
    }, topBar)

    titleBtn.MouseEnter:Connect(function()
        tween(titleBtn, EASE_OUT(0.12), { TextColor3 = self._accent })
    end)
    titleBtn.MouseLeave:Connect(function()
        tween(titleBtn, EASE_OUT(0.12), { TextColor3 = W })
    end)

    local xBtn = o("TextButton", {
        Size = UDim2.new(0, 38, 1, 0), Position = UDim2.new(1, -38, 0, 0),
        BackgroundColor3 = self._bg, BorderSizePixel = 0,
        Text = "×", TextColor3 = W, TextSize = 26, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, topBar)
    corner(xBtn, CORNER_R)

    for _, pos in ipairs({
        UDim2.new(0, 0, 0, 0),
        UDim2.new(0, 0, 1, -CORNER_R),
        UDim2.new(1, -CORNER_R, 1, -CORNER_R),
    }) do
        o("Frame", {
            Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
            Position = pos,
            BackgroundColor3 = self._bg, BorderSizePixel = 0, ZIndex = 12,
        }, xBtn)
    end

    self._xBtn = xBtn

    xBtn.MouseEnter:Connect(function()
        tween(xBtn, EASE_OUT(0.1), { TextColor3 = self._accent })
    end)
    xBtn.MouseLeave:Connect(function()
        tween(xBtn, EASE_OUT(0.15), { TextColor3 = W })
    end)

    local topBarDragMoved = false

    do
        local dragging, dragStart, startPos, _activeTouchId = false, nil, nil, nil
        table.insert(self._connections, topBar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; topBarDragMoved = false
                dragStart = inp.Position; startPos = self.menuFrame.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true; topBarDragMoved = false
                dragStart = inp.Position; startPos = self.menuFrame.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                if d.Magnitude > 4 then topBarDragMoved = true end
                self.menuFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false; dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                dragging = false; _activeTouchId = nil
                dragStart = nil; startPos = nil
            end
        end))
    end

    self.contentFrame = o("Frame", {
        Size = UDim2.new(1, 0, 1, -TOPBAR_H),
        Position = UDim2.new(0, 0, 0, TOPBAR_H),
        BackgroundColor3 = self._panel,
        BorderSizePixel = 0,
    }, self.menuFrame)
    corner(self.contentFrame, CORNER_R)

    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = self._panel, BorderSizePixel = 0,
    }, self.contentFrame)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(1, -CORNER_R, 0, 0),
        BackgroundColor3 = self._panel, BorderSizePixel = 0,
    }, self.contentFrame)

    self.tabBar = o("Frame", {
        Name = "TabBar",
        Size = UDim2.new(0, TABBAR_W, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = self._bg,
        BorderSizePixel = 0,
    }, self.contentFrame)
    corner(self.tabBar, CORNER_R)

    for _, pos in ipairs({
        UDim2.new(0, 0, 0, 0),
        UDim2.new(1, -CORNER_R, 0, 0),
        UDim2.new(1, -CORNER_R, 1, -CORNER_R),
    }) do
        o("Frame", {
            Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
            Position = pos,
            BackgroundColor3 = self._bg, BorderSizePixel = 0,
        }, self.tabBar)
    end

    self.tabList = o("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
    }, self.tabBar)
    o("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.tabList)
    o("UIPadding", {
        PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6),
        PaddingTop  = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6),
    }, self.tabList)

    self.pagesHolder = o("Frame", {
        Name = "PagesHolder",
        Size = UDim2.new(1, -TABBAR_W, 1, 0),
        Position = UDim2.new(0, TABBAR_W, 0, 0),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, self.contentFrame)

    do
        local HANDLE_SIZE = 26
        local handle = o("TextButton", {
            Name = "ResizeHandle",
            AnchorPoint = Vector2.new(1, 1),
            Size = UDim2.new(0, HANDLE_SIZE, 0, HANDLE_SIZE),
            Position = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false,
            ZIndex = 50,
        }, self.menuFrame)

        for i = 1, 3 do
            local off = i * 4
            o("Frame", {
                Size = UDim2.new(0, 8, 0, 1.5),
                Position = UDim2.new(1, -6 - off, 1, -6),
                Rotation = -45,
                AnchorPoint = Vector2.new(1, 0.5),
                BackgroundColor3 = self._line, BorderSizePixel = 0,
                Name = "Grip" .. i,
            }, handle)
        end
        self._resizeGrips = {}
        for _, c in ipairs(handle:GetChildren()) do
            if c.Name:match("^Grip") then table.insert(self._resizeGrips, c) end
        end
        local function setGripColor(col)
            for _, g in ipairs(self._resizeGrips) do g.BackgroundColor3 = col end
        end

        local resizing, resizeStart, startSize, activeTouchId = false, nil, nil, nil
        local gripActive = false
        local function refreshGripColor()
            setGripColor(gripActive and self._accent or self._line)
        end

        handle.MouseEnter:Connect(function() gripActive = true; refreshGripColor() end)
        handle.MouseLeave:Connect(function()
            if not resizing then
                gripActive = false
                refreshGripColor()
            end
        end)

        local function applyResize(delta)
            local newW = math.clamp(startSize.X + delta.X, MIN_W, MAX_W)
            local newH = math.clamp(startSize.Y + delta.Y, MIN_H, MAX_H)
            self._targetSize = Vector2.new(newW, newH)
            self.menuFrame.Size = UDim2.new(0, newW, 0, newH)
        end

        table.insert(self._connections, handle.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if resizing then return end
                resizing = true
                resizeStart = inp.Position
                startSize = self._targetSize
                gripActive = true; refreshGripColor()
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if activeTouchId ~= nil then return end
                activeTouchId = inp
                resizing = true
                resizeStart = inp.Position
                startSize = self._targetSize
                gripActive = true; refreshGripColor()
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not resizing then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= activeTouchId then return end
            if isM or isT then
                applyResize(inp.Position - resizeStart)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if activeTouchId then return end
                resizing = false; resizeStart = nil; startSize = nil
                gripActive = false; refreshGripColor()
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= activeTouchId then return end
                resizing = false; activeTouchId = nil
                resizeStart = nil; startSize = nil
                gripActive = false; refreshGripColor()
            end
        end))
    end

    local POPUP_W, POPUP_H = 260, 96

    local clickCatcher = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false,
        Visible = false, ZIndex = 5,
    }, self.menuFrame)

    local popup = o("Frame", {
        Name = "SettingsPopup",
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0, 14, 0, TOPBAR_H + 8),
        BackgroundColor3 = self._panel,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = false, ZIndex = 100,
    }, self.menuFrame)
    corner(popup, 10)
    stroke(popup, 1, self._line)

    o("TextLabel", {
        Size = UDim2.new(1, -20, 0, 18),
        Position = UDim2.new(0, 12, 0, 10),
        BackgroundTransparency = 1,
        Text = "Configurações",
        Font = FONTB, TextSize = 12,
        TextColor3 = W,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 101,
    }, popup)

    o("TextLabel", {
        Size = UDim2.new(0, 120, 0, 14),
        Position = UDim2.new(0, 12, 0, 40),
        BackgroundTransparency = 1,
        Text = "Tamanho UI",
        Font = FONT, TextSize = 11,
        TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 101,
    }, popup)

    local scaleValueLabel = o("TextLabel", {
        Size = UDim2.new(0, 60, 0, 14),
        Position = UDim2.new(1, -72, 0, 40),
        BackgroundTransparency = 1,
        Text = tostring(_G.KronUIScale),
        Font = FONTB, TextSize = 11,
        TextColor3 = W,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 101,
    }, popup)

    local SLIDER_W = POPUP_W - 24
    local SLIDER_MIN, SLIDER_MAX = 1, 35

    local scaleTrack = o("Frame", {
        Size = UDim2.new(0, SLIDER_W, 0, 6),
        Position = UDim2.new(0, 12, 0, 62),
        BackgroundColor3 = self._line,
        BorderSizePixel = 0,
        ZIndex = 101,
    }, popup)
    corner(scaleTrack, "pill")

    local initialRel = (_G.KronUIScale - SLIDER_MIN) / (SLIDER_MAX - SLIDER_MIN)

    local scaleFill = o("Frame", {
        Size = UDim2.new(initialRel, 0, 1, 0),
        BackgroundColor3 = self._accent,
        BorderSizePixel = 0,
        ZIndex = 101,
    }, scaleTrack)
    corner(scaleFill, "pill")

    local scaleKnob = o("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(initialRel, 0, 0.5, 0),
        BackgroundColor3 = W,
        BorderSizePixel = 0,
        ZIndex = 102,
    }, scaleTrack)
    corner(scaleKnob, "pill")
    stroke(scaleKnob, 1.5, self._accent)

    local scaleGrabber = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 22),
        Position = UDim2.new(0, 0, 0.5, -11),
        BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false,
        ZIndex = 103,
    }, scaleTrack)

    local function applyScaleValue(v)
        local rel = math.clamp((v - SLIDER_MIN) / (SLIDER_MAX - SLIDER_MIN), 0, 1)
        scaleFill.Size = UDim2.new(rel, 0, 1, 0)
        scaleKnob.Position = UDim2.new(rel, 0, 0.5, 0)
        scaleValueLabel.Text = tostring(math.floor(v))
        _G.KronUIScale = v
        tween(uiScaleObj, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Scale = getUIScale(v)
        })
    end

    local function scaleFromX(x)
        local rel = math.clamp((x - scaleTrack.AbsolutePosition.X) / scaleTrack.AbsoluteSize.X, 0, 1)
        applyScaleValue(math.floor(SLIDER_MIN + (SLIDER_MAX - SLIDER_MIN) * rel))
    end

    do
        local dragging, activeTouch = false, nil
        table.insert(self._connections, scaleGrabber.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true; scaleFromX(inp.Position.X)
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if activeTouch ~= nil then return end
                activeTouch = inp; dragging = true; scaleFromX(inp.Position.X)
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            if inp.UserInputType == Enum.UserInputType.MouseMovement then
                scaleFromX(inp.Position.X)
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= activeTouch then return end
                scaleFromX(inp.Position.X)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if activeTouch then return end
                dragging = false
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= activeTouch then return end
                dragging = false; activeTouch = nil
            end
        end))
    end

    local popupOpen = false

    local function openPopup()
        popupOpen = true
        clickCatcher.Visible = true
        popup.Visible = true
        popup.Size = UDim2.new(0, 0, 0, 0)
        tween(popup, EASE_BACK(0.3), { Size = UDim2.new(0, POPUP_W, 0, POPUP_H) })
    end

    local function closePopup()
        if not popupOpen then return end
        popupOpen = false
        clickCatcher.Visible = false
        local t = tween(popup, EASE_OUT(0.15), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function()
            if popup.Size.X.Offset <= 1 then popup.Visible = false end
        end)
    end

    clickCatcher.MouseButton1Click:Connect(function()
        closePopup()
    end)

    table.insert(self._connections, titleBtn.MouseButton1Click:Connect(function()
        if topBarDragMoved then return end
        playClick()
        if popupOpen then closePopup() else openPopup() end
    end))

    self.btnGui = o("ScreenGui", {
        Name = "KronUI_FloatBtn", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 9999,
    })
    local okPill = pcall(function() self.btnGui.Parent = CoreGui end)
    if not okPill then self.btnGui.Parent = pg end

    local PILL_SIZE = 46
    local pill = o("Frame", {
        Name = "PillUI",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(1, -46, 1, -242),
        BackgroundColor3 = self._bg, BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = false, ZIndex = 200,
    }, self.btnGui)
    corner(pill, "pill")
    stroke(pill, 1, self._line)
    local pillGlow = stroke(pill, 1.5, self._accent, 0.7)
    self._pill = pill

    self._breatheTween = TweenService:Create(
        pillGlow,
        TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        { Transparency = 0.88 }
    )
    self._breatheTween:Play()

    local resolvedImage = tostring(pillImage or "rbxassetid://78186286433275")
    if not resolvedImage:find("rbxassetid://") then
        resolvedImage = "rbxassetid://" .. resolvedImage
    end

    local pillIcon = o("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 32, 0, 32),
        BackgroundTransparency = 1,
        Image = resolvedImage,
        ImageColor3 = W,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = 201,
    }, pill)

    local pillBtn = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false,
        BorderSizePixel = 0, ZIndex = 202,
    }, pill)
    pillBtn.MouseEnter:Connect(function() tween(pillIcon, EASE_OUT(0.12), { ImageColor3 = self._accent }) end)
    pillBtn.MouseLeave:Connect(function() tween(pillIcon, EASE_OUT(0.12), { ImageColor3 = W }) end)

    local pillScale = o("UIScale", { Scale = 1 }, pill)
    pillBtn.MouseButton1Down:Connect(function()
        tween(pillScale, EASE_OUT(0.08), { Scale = 0.9 })
    end)
    pillBtn.MouseButton1Up:Connect(function()
        tween(pillScale, EASE_OUT(0.12), { Scale = 1 })
    end)
    pillBtn.MouseLeave:Connect(function()
        tween(pillScale, EASE_OUT(0.12), { Scale = 1 })
    end)

    local function showPill()
        pill.Visible = true
        pill.Size = UDim2.new(0, 0, 0, 0)
        tween(pill, EASE_BACK(0.35), { Size = UDim2.new(0, PILL_SIZE, 0, PILL_SIZE) })
    end
    local function hidePill()
        local t = tween(pill, EASE_OUT(0.18), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function() if pill.Size.X.Offset <= 1 then pill.Visible = false end end)
    end
    local function showMenu()
        self.menuFrame.Visible = true
        local target = self._targetSize
        self.menuFrame.Size = UDim2.new(0, 0, 0, 0)
        tween(self.menuFrame, EASE_BACK(0.4), { Size = UDim2.new(0, target.X, 0, target.Y) })
    end
    local function hideMenu()
        closePopup()
        local t = tween(self.menuFrame, EASE_OUT(0.2), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function() if self.menuFrame.Size.X.Offset <= 1 then self.menuFrame.Visible = false end end)
    end

    xBtn.MouseButton1Click:Connect(function()
        playClick()
        hideMenu()
        showPill()
    end)

    do
        local dragging, dragMoved, dragStart, startPos, _activeTouchId =
            false, false, nil, nil, nil
        table.insert(self._connections, pillBtn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = pill.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = pill.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                if d.Magnitude > 4 then dragMoved = true end
                pill.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if not dragging then return end
                dragging = false
                if not dragMoved then
                    playClick(); hidePill(); showMenu()
                end
                dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                local wasMoved = dragMoved
                dragging = false; dragMoved = false
                _activeTouchId = nil; dragStart = nil; startPos = nil
                if not wasMoved then
                    playClick(); hidePill(); showMenu()
                end
            end
        end))
    end

    return self
end

function KronUI:Destroy()
    for _, conn in ipairs(self._connections) do conn:Disconnect() end
    self._connections = {}
    if self._breatheTween then self._breatheTween:Cancel() end
    if self.gui    then self.gui:Destroy()    end
    if self.btnGui then self.btnGui:Destroy() end
end

function KronUI:_nextOrder()
    self._layoutOrder = self._layoutOrder + 1
    return self._layoutOrder
end

local function toTabLabel(text)
    text = tostring(text or "")
    local cleaned = {}
    for i = 1, #text do
        local b = string.byte(text, i)
        if b < 0x80 then
            table.insert(cleaned, string.char(b))
        end
    end
    local ascii = table.concat(cleaned)
    ascii = ascii:gsub("^%s*[^%w]*%s*", ""):gsub("%s*[^%w]*%s*$", "")
    ascii = ascii:gsub("^%s+", ""):gsub("%s+$", "")
    if ascii == "" then return "Aba" end
    local lower = ascii:lower()
    return lower:sub(1, 1):upper() .. lower:sub(2)
end

function KronUI:_EnsureWriteTab()
    if self._writeTab then return self._writeTab end
    return self:_OpenTab("Geral")
end

function KronUI:_OpenTab(labelText)
    local tab = self:AddTab(labelText)
    self._writeTab = tab
    return tab
end

function KronUI:_SelectTab(id)
    if self._activeTabId == id then return end
    self._activeTabId = id
    for _, t in ipairs(self._tabs) do
        local isActive = (t.id == id)
        t.page.Visible = isActive
        local ti = EASE_OUT(0.14)
        if isActive then
            t.btn.BackgroundColor3 = self._card
            tween(t.btn, ti, { BackgroundTransparency = 0 })
            tween(t.indicator, ti, { BackgroundColor3 = W, Size = UDim2.new(0, 3, 0, 20) })
            t.label.TextColor3 = W
        else
            tween(t.btn, ti, { BackgroundTransparency = 1 })
            tween(t.indicator, ti, { Size = UDim2.new(0, 3, 0, 0) })
            t.label.TextColor3 = DIM
        end
    end
end

function KronUI:AddTab(name)
    name = name or ("Aba " .. (#self._tabs + 1))

    self._nextTabId = (self._nextTabId or 0) + 1
    local id = self._nextTabId

    local btn = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = self._card,
        BackgroundTransparency = 1,
        BorderSizePixel = 0, AutoButtonColor = false, Text = "",
        LayoutOrder = #self._tabs + 1,
    }, self.tabList)
    corner(btn, 7)

    local indicator = o("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(0, 3, 0, 0),
        BackgroundColor3 = W, BorderSizePixel = 0,
    }, btn)
    corner(indicator, "pill")

    local label = o("TextLabel", {
        Size = UDim2.new(1, -10, 1, 0),
        Position = UDim2.new(0, 6, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        Font = FONT, TextSize = 11, TextColor3 = DIM,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, btn)

    btn.MouseEnter:Connect(function()
        if self._activeTabId ~= id then
            btn.BackgroundColor3 = self._hover
            tween(btn, EASE_OUT(0.12), { BackgroundTransparency = 0.4 })
        end
    end)
    btn.MouseLeave:Connect(function()
        if self._activeTabId ~= id then
            tween(btn, EASE_OUT(0.12), { BackgroundTransparency = 1 })
        end
    end)

    local page = o("ScrollingFrame", {
        Size = UDim2.new(1, -4, 1, -6),
        Position = UDim2.new(0, 2, 0, 4),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
        Visible = false,
    }, self.pagesHolder)
    o("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, page)
    o("UIPadding", {
        PaddingLeft   = UDim.new(0, 6),
        PaddingRight  = UDim.new(0, 6),
        PaddingTop    = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
    }, page)

    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        self._playClick()
        self:_SelectTab(id)
    end))

    local handle = {}
    handle.Frame = page
    handle.Id    = id
    function handle:AddSectionLabel(text)                  return self._owner:_AddComponentTo(page, "SectionLabel", text) end
    function handle:AddDivider()                           return self._owner:_AddComponentTo(page, "Divider") end
    function handle:AddToggle(text, default, cb)           return self._owner:_AddComponentTo(page, "Toggle", text, default, cb) end
    function handle:AddButton(text, cb)                     return self._owner:_AddComponentTo(page, "Button", text, cb) end
    function handle:AddSlider(text, min, max, default, cb)  return self._owner:_AddComponentTo(page, "Slider", text, min, max, default, cb) end
    function handle:AddDropdown(text, options, default, cb) return self._owner:_AddComponentTo(page, "Dropdown", text, options, default, cb) end
    function handle:AddMultiDropdown(text, options, defaults, cb) return self._owner:_AddComponentTo(page, "MultiDropdown", text, options, defaults, cb) end
    handle._owner = self

    table.insert(self._tabs, { id = id, name = name, btn = btn, label = label, indicator = indicator, page = page, handle = handle })

    if not self._activeTabId then
        self:_SelectTab(id)
    end

    return handle
end

function KronUI:_AddComponentTo(parent, kind, ...)
    local prevContainer = self.container
    self.container = parent
    local ok, result = pcall(self["_Build" .. kind], self, ...)
    self.container = prevContainer
    if not ok then error(result, 0) end
    return result
end

function KronUI:AddSectionLabel(text)
    self:_OpenTab(toTabLabel(text))
end
function KronUI:AddDivider()                                  return self:_EnsureWriteTab():AddDivider() end
function KronUI:AddToggle(text, default, cb)                  return self:_EnsureWriteTab():AddToggle(text, default, cb) end
function KronUI:AddButton(text, cb)                            return self:_EnsureWriteTab():AddButton(text, cb) end
function KronUI:AddSlider(text, min, max, default, cb)         return self:_EnsureWriteTab():AddSlider(text, min, max, default, cb) end
function KronUI:AddDropdown(text, options, default, cb)        return self:_EnsureWriteTab():AddDropdown(text, options, default, cb) end
function KronUI:AddMultiDropdown(text, options, defaults, cb)  return self:_EnsureWriteTab():AddMultiDropdown(text, options, defaults, cb) end

