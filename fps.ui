local Services = {
    Players = game:GetService("Players"),
    Lighting = game:GetService("Lighting"),
    Workspace = game:GetService("Workspace")
}

-- Lighting
Services.Lighting.GlobalShadows = false
Services.Lighting.ShadowSoftness = 0
Services.Lighting.Brightness = 2
Services.Lighting.Ambient = Color3.fromRGB(178, 178, 178)
Services.Lighting.OutdoorAmbient = Color3.fromRGB(178, 178, 178)

-- Remover post-effects do Lighting
for _, obj in ipairs(Services.Lighting:GetChildren()) do
    if obj:IsA("PostEffect") or obj:IsA("BloomEffect") or obj:IsA("BlurEffect")
    or obj:IsA("ColorCorrectionEffect") or obj:IsA("SunRaysEffect") or obj:IsA("DepthOfFieldEffect") then
        obj:Destroy()
    end
end

-- Processar Workspace
for _, obj in ipairs(Services.Workspace:GetDescendants()) do
    if obj:IsA("BasePart") then
        obj.Material = Enum.Material.SmoothPlastic
        obj.Reflectance = 0
        obj.CastShadow = false
    elseif obj:IsA("Texture") or obj:IsA("Decal") then
        obj:Destroy()
    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
    or obj:IsA("Sparkles") or obj:IsA("Fire") or obj:IsA("Beam") then
        obj:Destroy()
    elseif obj:IsA("SelectionBox") or obj:IsA("SelectionSphere") then
        obj:Destroy()
    elseif obj:IsA("BillboardGui") then
        obj.Enabled = false
    elseif obj:IsA("SurfaceGui") then
        obj.Enabled = false
    elseif obj:IsA("SpecialMesh") then
        obj.TextureId = ""
    end
end

-- Monitorar novos objetos no Workspace
Services.Workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("BasePart") then
        obj.Material = Enum.Material.SmoothPlastic
        obj.Reflectance = 0
        obj.CastShadow = false
    elseif obj:IsA("Texture") or obj:IsA("Decal") then
        obj:Destroy()
    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
    or obj:IsA("Sparkles") or obj:IsA("Fire") or obj:IsA("Beam") then
        obj:Destroy()
    elseif obj:IsA("BillboardGui") then
        obj.Enabled = false
    elseif obj:IsA("SurfaceGui") then
        obj.Enabled = false
    elseif obj:IsA("PostEffect") or obj:IsA("BloomEffect") or obj:IsA("BlurEffect")
    or obj:IsA("ColorCorrectionEffect") or obj:IsA("SunRaysEffect") or obj:IsA("DepthOfFieldEffect") then
        obj:Destroy()
    end
end)

-- Personagem
local player = Services.Players.LocalPlayer

local function limparPersonagem(char)
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Sparkles")
        or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Beam") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.CastShadow = false
        end
    end

    char.DescendantAdded:Connect(function(obj)
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Sparkles")
        or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Beam") then
            obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.CastShadow = false
        end
    end)
end

if player.Character then
    limparPersonagem(player.Character)
end

player.CharacterAdded:Connect(function(char)
    task.wait(0.05)
    limparPersonagem(char)

    for _, obj in ipairs(Services.Lighting:GetChildren()) do
        if obj:IsA("BlurEffect") or obj:IsA("DepthOfFieldEffect") then
            obj:Destroy()
        end
    end
end)
