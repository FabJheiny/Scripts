local Services = {
    Players = game:GetService("Players"),
    RunService = game:GetService("RunService"),
    UserInputService = game:GetService("UserInputService"),
    CoreGui = game:GetService("CoreGui")
}

local Config = {
    Float = {
        DefaultSpeed = 0.1,
        MinSpeed = 0.1,
        MaxSpeed = 10,
        PlatformSize = Vector3.new(2, 0.5, 2),
        PlatformOffset = 3.2,
        PlatformTransparency = 0.4
    },
    UI = {
        Name = "FloatGui",
        DisplayOrder = 2147483647,
        Size = UDim2.new(0, 160, 0, 101),
        DefaultPosition = UDim2.new(0.05, 0, 0.4, 0),
        TextSize = 10,
        Font = Enum.Font.Code,
        B = Color3.fromRGB(0, 0, 0),
        W = Color3.fromRGB(255, 255, 255),
        D = Color3.fromRGB(15, 15, 15),
        G = Color3.fromRGB(50, 50, 50),
        Active = Color3.fromRGB(50, 50, 50)
    }
}

local State = {
    FloatEnabled = false,
    Direction = 0,
    FloatSpeed = Config.Float.DefaultSpeed,
    PlatformY = 0,
    Active = true,
    Dragging = false,
    DragInput = nil,
    DragStart = nil,
    StartPos = nil
}

local Platform = nil

local B    = Config.UI.B
local W    = Config.UI.W
local D    = Config.UI.D
local G    = Config.UI.G
local FONT = Config.UI.Font

local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end

local function stroke(par, t, c)
    o("UIStroke", {Color = c or W, Thickness = t or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, par)
end

local function mkBtn(txt, parent, sz, pos)
    local b = o("TextButton", {
        Size = sz, Position = pos,
        BackgroundColor3 = B, BorderSizePixel = 0,
        Text = txt, TextColor3 = W,
        TextSize = Config.UI.TextSize, Font = FONT,
        AutoButtonColor = false,
    }, parent)
    stroke(b, 1)
    b.MouseEnter:Connect(function() b.BackgroundColor3 = D end)
    b.MouseLeave:Connect(function() b.BackgroundColor3 = B end)
    return b
end

local function mkDiv(parent, pos, sz, vertical)
    o("Frame", {
        Position = pos,
        Size = sz or (vertical and UDim2.new(0, 1, 1, 0) or UDim2.new(1, 0, 0, 1)),
        BackgroundColor3 = W, BorderSizePixel = 0, ZIndex = 12,
    }, parent)
end

local PlatformController = {}
PlatformController.__index = PlatformController

function PlatformController.new(services, config, state)
    local self = setmetatable({}, PlatformController)
    self.Services = services
    self.Config = config
    self.State = state
    return self
end

function PlatformController:createPlatform()
    if Platform then return end
    local platform = Instance.new("Part")
    platform.Name = "FloatPlatform"
    platform.Size = self.Config.Float.PlatformSize
    platform.Transparency = self.Config.Float.PlatformTransparency
    platform.BrickColor = BrickColor.new("Really Black")
    platform.Material = Enum.Material.ForceField
    platform.Anchored = true
    platform.CanCollide = true
    platform.Parent = workspace
    Platform = platform
    self.State.PlatformY = 0
end

function PlatformController:destroyPlatform()
    if Platform then
        Platform:Destroy()
        Platform = nil
    end
    self.State.PlatformY = 0
end

function PlatformController:updatePlatform()
    local char = self.Services.Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local root = char.HumanoidRootPart
    local rot = root.CFrame - root.CFrame.Position
    if self.State.PlatformY == 0 then
        self.State.PlatformY = root.Position.Y - self.Config.Float.PlatformOffset
    end
    self.State.PlatformY = self.State.PlatformY + (self.State.Direction * self.State.FloatSpeed)
    if Platform then
        Platform.Position = Vector3.new(root.Position.X, self.State.PlatformY, root.Position.Z)
    end
    root.CFrame = CFrame.new(
        root.Position.X,
        self.State.PlatformY + self.Config.Float.PlatformOffset,
        root.Position.Z
    ) * rot
end

function PlatformController:handleCharacterAdded(character)
    local humanoid = character:WaitForChild("Humanoid")
    humanoid.Died:Connect(function()
        self:destroyPlatform()
    end)
end

function PlatformController:connectEvents()
    local player = self.Services.Players.LocalPlayer
    self.Connections = {}
    table.insert(self.Connections, player.CharacterAdded:Connect(function(character)
        self:handleCharacterAdded(character)
    end))
    if player.Character then
        self:handleCharacterAdded(player.Character)
    end
    table.insert(self.Connections, self.Services.RunService.RenderStepped:Connect(function()
        if not self.State.Active or not self.State.FloatEnabled then return end
        self:updatePlatform()
    end))
end

function PlatformController:cleanup()
    self:destroyPlatform()
    if self.Connections then
        for _, connection in pairs(self.Connections) do
            if connection and connection.Disconnect then
                connection:Disconnect()
            end
        end
        self.Connections = nil
    end
end

local UIController = {}
UIController.__index = UIController

function UIController.new(services, config, state, platformController)
    local self = setmetatable({}, UIController)
    self.Services = services
    self.Config = config
    self.State = state
    self.PlatformController = platformController
    self.Buttons = {}
    return self
end

function UIController:build()
    local sg = o("ScreenGui", {
        Name = self.Config.UI.Name,
        DisplayOrder = self.Config.UI.DisplayOrder,
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
    }, self.Services.Players.LocalPlayer.PlayerGui)
    self.ScreenGui = sg

    local pillSg = o("ScreenGui", {
        Name = self.Config.UI.Name .. "Pill",
        DisplayOrder = 9999,
        ResetOnSpawn = false,
    })
    local ok = pcall(function() pillSg.Parent = self.Services.CoreGui end)
    if not ok then pillSg.Parent = self.Services.Players.LocalPlayer.PlayerGui end

    local pill = o("Frame", {
        Name = "FloatPill",
        Size = UDim2.new(0, 60, 0, 18),
        Position = UDim2.new(1, -66, 1, -58),
        BackgroundColor3 = B,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 200,
    }, pillSg)
    stroke(pill, 1)

    local pillBtn = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "> float",
        TextSize = 9,
        Font = FONT,
        TextColor3 = W,
        BorderSizePixel = 0,
        ZIndex = 201,
    }, pill)
    self.Pill = pill

    local topH = 24
    local win = o("Frame", {
        Size = UDim2.new(0, 160, 0, 102),
        Position = self.Config.UI.DefaultPosition,
        BackgroundColor3 = B,
        BorderSizePixel = 0,
        Active = true,
        ClipsDescendants = true,
    }, sg)
    stroke(win, 1)
    self.MainFrame = win

    local top = o("Frame", {
        Size = UDim2.new(1, 0, 0, topH),
        BackgroundColor3 = B,
        BorderSizePixel = 0,
        Active = true,
        ZIndex = 10,
    }, win)

    o("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1,
        Text = "> FLOAT <",
        TextColor3 = W,
        TextSize = 11,
        Font = FONT,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 10,
    }, top)

    mkDiv(top, UDim2.new(1, -66, 0, 0), UDim2.new(0, 1, 1, 0))
    mkDiv(top, UDim2.new(1, -33, 0, 0), UDim2.new(0, 1, 1, 0))

    local MinBtn = o("TextButton", {
        Size = UDim2.new(0, 32, 1, 0),
        Position = UDim2.new(1, -65, 0, 0),
        BackgroundColor3 = B, BorderSizePixel = 0,
        Text = "-", TextColor3 = W,
        TextSize = 18, Font = FONT,
        AutoButtonColor = false, ZIndex = 11,
    }, top)
    local XBtn = o("TextButton", {
        Size = UDim2.new(0, 32, 1, 0),
        Position = UDim2.new(1, -32, 0, 0),
        BackgroundColor3 = B, BorderSizePixel = 0,
        Text = "x", TextColor3 = W,
        TextSize = 14, Font = FONT,
        AutoButtonColor = false, ZIndex = 11,
    }, top)
    for _, b in ipairs({MinBtn, XBtn}) do
        b.MouseEnter:Connect(function() b.BackgroundColor3 = D end)
        b.MouseLeave:Connect(function() b.BackgroundColor3 = B end)
    end

    mkDiv(win, UDim2.new(0, 0, 0, topH), UDim2.new(1, 0, 0, 1))

    local body = o("Frame", {
        Size = UDim2.new(1, 0, 1, -topH - 1),
        Position = UDim2.new(0, 0, 0, topH + 1),
        BackgroundColor3 = B,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, win)

    local floatBtn = mkBtn("FLOAT: OFF", body,
        UDim2.new(1, 0, 0, 25), UDim2.new(0, 0, 0, 0))
    floatBtn.Name = "FloatBtn"
    table.insert(self.Buttons, floatBtn)

    mkDiv(body, UDim2.new(0, 0, 0, 25), UDim2.new(1, 0, 0, 1))

    local upBtn = mkBtn("↑", body, UDim2.new(0, 32, 0, 25), UDim2.new(0, 0, 0, 26))
    upBtn.Name = "UpBtn"
    table.insert(self.Buttons, upBtn)
    mkDiv(body, UDim2.new(0, 32, 0, 26), UDim2.new(0, 1, 0, 25))

    local plusBtn = mkBtn("+", body, UDim2.new(0, 48, 0, 25), UDim2.new(0, 33, 0, 26))
    mkDiv(body, UDim2.new(0, 81, 0, 26), UDim2.new(0, 1, 0, 25))

    local speedDisplay = mkBtn(
        string.format("%.1f", self.State.FloatSpeed),
        body, UDim2.new(0, 78, 0, 25), UDim2.new(0, 82, 0, 26))
    speedDisplay.Name = "SpeedDisplay"
    table.insert(self.Buttons, speedDisplay)

    mkDiv(body, UDim2.new(0, 0, 0, 51), UDim2.new(1, 0, 0, 1))

    local downBtn = mkBtn("↓", body, UDim2.new(0, 32, 0, 25), UDim2.new(0, 0, 0, 52))
    downBtn.Name = "DownBtn"
    table.insert(self.Buttons, downBtn)
    mkDiv(body, UDim2.new(0, 32, 0, 52), UDim2.new(0, 1, 0, 25))

    local minusBtn = mkBtn("-", body, UDim2.new(0, 48, 0, 25), UDim2.new(0, 33, 0, 52))
    mkDiv(body, UDim2.new(0, 81, 0, 52), UDim2.new(0, 1, 0, 25))

    local resetBtn = mkBtn("Reset", body, UDim2.new(0, 78, 0, 25), UDim2.new(0, 82, 0, 52))

    local minimized = false
    local fullH = 102
    do
        local dragging, dragStart, startPos = false, nil, nil
        top.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = inp.Position
                startPos = win.Position
            end
        end)
        top.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1
            or inp.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        self.Services.UserInputService.InputChanged:Connect(function(inp)
            if dragging and (inp.UserInputType == Enum.UserInputType.MouseMovement
            or inp.UserInputType == Enum.UserInputType.Touch) then
                local d = inp.Position - dragStart
                win.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y
                )
            end
        end)
    end

    local function updateStates()
        for _, btn in pairs(self.Buttons) do
            if btn.Name == "FloatBtn" then
                btn.Text = self.State.FloatEnabled and "> FLOAT: ON" or "FLOAT: OFF"
                btn.BackgroundColor3 = self.State.FloatEnabled and G or B
            elseif btn.Name == "UpBtn" then
                btn.BackgroundColor3 = (self.State.Direction == 1) and G or B
            elseif btn.Name == "DownBtn" then
                btn.BackgroundColor3 = (self.State.Direction == -1) and G or B
            elseif btn.Name == "SpeedDisplay" then
                btn.Text = string.format("%.1f", self.State.FloatSpeed)
            end
        end
    end
    self.UpdateStates = updateStates

    XBtn.MouseButton1Click:Connect(function()
        win.Visible = false
        pill.Visible = true
    end)

    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            win.Size = UDim2.new(0, 160, 0, topH)
            MinBtn.Text = "+"
        else
            win.Size = UDim2.new(0, 160, 0, fullH)
            MinBtn.Text = "-"
        end
    end)

    pillBtn.MouseButton1Click:Connect(function()
        win.Visible = true
        pill.Visible = false
    end)

    floatBtn.MouseButton1Click:Connect(function()
        self.State.FloatEnabled = not self.State.FloatEnabled
        if self.State.FloatEnabled then
            self.PlatformController:createPlatform()
        else
            self.State.Direction = 0
            self.PlatformController:destroyPlatform()
        end
        updateStates()
    end)

    upBtn.MouseButton1Click:Connect(function()
        if not self.State.FloatEnabled then return end
        self.State.Direction = (self.State.Direction == 1) and 0 or 1
        updateStates()
    end)

    downBtn.MouseButton1Click:Connect(function()
        if not self.State.FloatEnabled then return end
        self.State.Direction = (self.State.Direction == -1) and 0 or -1
        updateStates()
    end)

    plusBtn.MouseButton1Click:Connect(function()
        self.State.FloatSpeed = math.min(self.State.FloatSpeed + 0.1, self.Config.Float.MaxSpeed)
        updateStates()
    end)

    minusBtn.MouseButton1Click:Connect(function()
        self.State.FloatSpeed = math.max(self.State.FloatSpeed - 0.1, self.Config.Float.MinSpeed)
        updateStates()
    end)

    resetBtn.MouseButton1Click:Connect(function()
        self.PlatformController:destroyPlatform()
        self.State.FloatEnabled = false
        self.State.Direction = 0
        self.State.FloatSpeed = self.Config.Float.DefaultSpeed
        self.State.PlatformY = 0
        updateStates()
    end)

    updateStates()
    return self
end

function UIController:cleanup()
    self.State.Active = false
    self.State.FloatEnabled = false
    self.State.Direction = 0
    self.PlatformController:destroyPlatform()
    if self.ScreenGui then
        self.ScreenGui:Destroy()
        self.ScreenGui = nil
    end
end

local MainController = {}
MainController.__index = MainController

function MainController.new()
    local self = setmetatable({}, MainController)
    self.PlatformController = PlatformController.new(Services, Config, State)
    self.UIController = UIController.new(Services, Config, State, self.PlatformController)
    self.UIController:build()
    self.PlatformController:connectEvents()
    return self
end

function MainController:cleanup()
    if self.PlatformController then self.PlatformController:cleanup() end
    if self.UIController then self.UIController:cleanup() end
end

local controller = MainController.new()

return function()
    controller:cleanup()
end
