local TweenService     = game:GetService("TweenService")
local Players          = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local CoreGui          = game:GetService("CoreGui")

local KronUI = {}
KronUI.__index = KronUI

local BG      = Color3.fromRGB(16, 14, 22)
local PANEL   = Color3.fromRGB(22, 19, 31)
local CARD    = Color3.fromRGB(28, 24, 39)
local HOVER   = Color3.fromRGB(40, 34, 54)
local LINE    = Color3.fromRGB(54, 46, 70)
local ACCENT  = Color3.fromRGB(150, 90, 255)
local ACCENT2 = Color3.fromRGB(95, 60, 200)
local DIM     = Color3.fromRGB(150, 145, 165)
local MID     = Color3.fromRGB(195, 190, 215)
local W       = Color3.fromRGB(242, 240, 250)
local FONT    = Enum.Font.GothamMedium
local FONTB   = Enum.Font.GothamBold

local function o(cls, props, par)
    local x = Instance.new(cls)
    for k, v in pairs(props) do x[k] = v end
    if par then x.Parent = par end
    return x
end

local function stroke(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, par)
end

local function strokeIn(par, t, c, transp)
    return o("UIStroke", {
        Color = c or LINE, Thickness = t or 1,
        Transparency = transp or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
    }, par)
end

local function corner(par, r)
    return o("UICorner", { CornerRadius = (r == "pill") and UDim.new(1, 0) or UDim.new(0, r or 8) }, par)
end

local function tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local EASE_OUT  = function(d) return TweenInfo.new(d or 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out) end
local EASE_BACK = function(d) return TweenInfo.new(d or 0.4,  Enum.EasingStyle.Back, Enum.EasingDirection.Out) end

-- ══════════════════════════════════════════════════════
--  11 Temas prontos
-- ══════════════════════════════════════════════════════
local THEMES = {
    { name = "Aurora",     primary = Color3.fromRGB(150, 90, 255),  secondary = Color3.fromRGB(95, 60, 200)   },
    { name = "Chama",      primary = Color3.fromRGB(255, 90, 40),   secondary = Color3.fromRGB(200, 50, 20)   },
    { name = "Oceano",     primary = Color3.fromRGB(30, 160, 255),  secondary = Color3.fromRGB(20, 100, 200)  },
    { name = "Dourado",    primary = Color3.fromRGB(255, 200, 40),  secondary = Color3.fromRGB(200, 150, 20)  },
    { name = "Prata",      primary = Color3.fromRGB(210, 210, 230), secondary = Color3.fromRGB(160, 160, 185) },
    { name = "Floresta",   primary = Color3.fromRGB(60, 210, 100),  secondary = Color3.fromRGB(30, 155, 65)   },
    { name = "Crepusculo", primary = Color3.fromRGB(255, 100, 180), secondary = Color3.fromRGB(200, 55, 130)  },
    { name = "Gelo",       primary = Color3.fromRGB(100, 220, 240), secondary = Color3.fromRGB(60, 170, 195)  },
    { name = "Carmim",     primary = Color3.fromRGB(220, 40, 80),   secondary = Color3.fromRGB(165, 20, 55)   },
    { name = "Lavanda",    primary = Color3.fromRGB(190, 130, 255), secondary = Color3.fromRGB(140, 80, 210)  },
    { name = "Neon",       primary = Color3.fromRGB(0, 255, 160),   secondary = Color3.fromRGB(0, 190, 110)   },
}

function KronUI.new(title, pillImage)
    local self = setmetatable({}, KronUI)

    self._accent  = ACCENT
    self._accent2 = ACCENT2

    self._themeItems     = {}
    self._themeGradients = {}
    self._themeCallbacks = {}
    self._xBtn           = nil  -- referência para o X, atualizada depois

    function self:_registerThemeItem(obj, prop, role)
        table.insert(self._themeItems, {Object = obj, Property = prop, Role = role})
    end
    function self:_registerThemeGradient(grad)
        table.insert(self._themeGradients, grad)
    end
    function self:_registerThemeCallback(cb)
        table.insert(self._themeCallbacks, cb)
    end

    function self:SetAccent(primary, secondary)
        self._accent  = primary
        self._accent2 = secondary
        for _, item in ipairs(self._themeItems) do
            item.Object[item.Property] = (item.Role == "accent" and primary or secondary)
        end
        for _, grad in ipairs(self._themeGradients) do
            grad.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, secondary),
                ColorSequenceKeypoint.new(0.5, primary),
                ColorSequenceKeypoint.new(1, secondary),
            })
        end
        for _, cb in ipairs(self._themeCallbacks) do
            cb(primary, secondary)
        end
    end

    local player = Players.LocalPlayer
    local pg     = player:WaitForChild("PlayerGui", 10) or player.PlayerGui

    local old    = pg:FindFirstChild("KronUI_Lib")
    local oldBtn = CoreGui:FindFirstChild("KronUI_FloatBtn") or pg:FindFirstChild("KronUI_FloatBtn")
    if old    then old:Destroy()    end
    if oldBtn then oldBtn:Destroy() end

    self._connections = {}
    self._layoutOrder = 0

    _G.KronUIScale = _G.KronUIScale or 10
    local function getUIScale(s) return 0.45 + (s - 1) * 0.04 end

    self.gui = o("ScreenGui", {
        Name = "KronUI_Lib", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 10,
    }, pg)

    local clickSound = o("Sound", {
        SoundId = "rbxassetid://6895079853",
        Volume  = 0.6,
        RollOffMaxDistance = 0,
    }, self.gui)

    local function playClick() clickSound:Play() end
    self._playClick = playClick

    local MENU_W, MENU_H = 250, 340
    self.menuFrame = o("Frame", {
        Name = "MenuFrame",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ClipsDescendants = true,
    }, self.gui)
    corner(self.menuFrame, 14)
    stroke(self.menuFrame, 1, LINE)
    local menuAccentStroke = stroke(self.menuFrame, 1.5, self._accent, 0.6)
    self:_registerThemeItem(menuAccentStroke, "Color", "accent")

    local uiScaleObj = Instance.new("UIScale")
    uiScaleObj.Scale  = getUIScale(_G.KronUIScale)
    uiScaleObj.Parent = self.menuFrame
    self._uiScaleObj = uiScaleObj

    task.defer(function()
        tween(self.menuFrame, EASE_BACK(0.5), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
    end)

    local topH     = 32
    local CORNER_R = 14
    local topBar = o("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, topH),
        BackgroundColor3 = BG,
        BorderSizePixel = 0, Active = true, ZIndex = 10,
    }, self.menuFrame)
    corner(topBar, CORNER_R)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 1, -CORNER_R),
        BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 11,
    }, topBar)

    o("TextLabel", {
        Size = UDim2.new(1, -50, 1, 0),
        Position = UDim2.new(0, 14, 0, 0),
        BackgroundTransparency = 1,
        Text = title or "Interface",
        TextColor3 = W, TextSize = 13, Font = FONTB,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 10,
    }, topBar)

    local shimmer = o("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = self._accent,
        BorderSizePixel = 0, ZIndex = 20,
    }, topBar)
    self:_registerThemeItem(shimmer, "BackgroundColor3", "accent")
    local shimmerGrad = o("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, self._accent2),
            ColorSequenceKeypoint.new(0.5, self._accent),
            ColorSequenceKeypoint.new(1, self._accent2),
        }),
        Offset = Vector2.new(-1, 0),
    }, shimmer)
    self:_registerThemeGradient(shimmerGrad)
    self._shimmerTween = TweenService:Create(
        shimmerGrad,
        TweenInfo.new(2.4, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false),
        { Offset = Vector2.new(1, 0) }
    )
    self._shimmerTween:Play()

    -- Divisor antes do X
    o("Frame", {
        Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -38, 0, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0, ZIndex = 12,
    }, topBar)

    -- X maior (TextSize 20), cor do tema em estado normal, hover muda de intensidade
    local xBtn = o("TextButton", {
        Size = UDim2.new(0, 38, 1, 0), Position = UDim2.new(1, -38, 0, 0),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        Text = "×", TextColor3 = self._accent, TextSize = 20, Font = FONTB,
        AutoButtonColor = false, ZIndex = 11,
    }, topBar)
    corner(xBtn, CORNER_R)
    -- quadrados para cortar cantos internos
    for _, pos in ipairs({
        UDim2.new(0, 0, 0, 0),
        UDim2.new(0, 0, 1, -CORNER_R),
        UDim2.new(1, -CORNER_R, 1, -CORNER_R),
    }) do
        o("Frame", {
            Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
            Position = pos,
            BackgroundColor3 = BG, BorderSizePixel = 0, ZIndex = 12,
        }, xBtn)
    end

    self._xBtn = xBtn
    self:_registerThemeItem(xBtn, "TextColor3", "accent")

    xBtn.MouseEnter:Connect(function()
        tween(xBtn, EASE_OUT(0.1), { BackgroundColor3 = Color3.fromRGB(60, 20, 20) })
        xBtn.TextColor3 = W
    end)
    xBtn.MouseLeave:Connect(function()
        tween(xBtn, EASE_OUT(0.15), { BackgroundColor3 = BG })
        xBtn.TextColor3 = self._accent
    end)

    -- Drag da janela pelo topBar
    do
        local dragging, dragStart, startPos, _activeTouchId =
            false, nil, nil, nil
        table.insert(self._connections, topBar.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true
                dragStart = inp.Position; startPos = self.menuFrame.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true
                dragStart = inp.Position; startPos = self.menuFrame.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                self.menuFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false; dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                dragging = false; _activeTouchId = nil
                dragStart = nil; startPos = nil
            end
        end))
    end

    self.contentFrame = o("Frame", {
        Size = UDim2.new(1, 0, 1, -topH),
        Position = UDim2.new(0, 0, 0, topH),
        BackgroundColor3 = PANEL,
        BorderSizePixel = 0,
    }, self.menuFrame)
    corner(self.contentFrame, CORNER_R)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, self.contentFrame)
    o("Frame", {
        Size = UDim2.new(0, CORNER_R, 0, CORNER_R),
        Position = UDim2.new(1, -CORNER_R, 0, 0),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, self.contentFrame)

    self.container = o("ScrollingFrame", {
        Size = UDim2.new(1, -4, 1, -6),
        Position = UDim2.new(0, 2, 0, 4),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
        Visible = true,
    }, self.contentFrame)
    self:_registerThemeItem(self.container, "ScrollBarImageColor3", "accent")
    o("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, self.container)
    o("UIPadding", {
        PaddingLeft   = UDim.new(0, 6),
        PaddingRight  = UDim.new(0, 6),
        PaddingTop    = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
    }, self.container)

    -- ══ Pill button ══
    self.btnGui = o("ScreenGui", {
        Name = "KronUI_FloatBtn", ResetOnSpawn = false,
        IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 9999,
    })
    local okPill = pcall(function() self.btnGui.Parent = CoreGui end)
    if not okPill then self.btnGui.Parent = pg end

    local PILL_SIZE = 46
    local pill = o("Frame", {
        Name = "PillUI",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(1, -46, 1, -242),
        BackgroundColor3 = BG, BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = false, ZIndex = 200,
    }, self.btnGui)
    corner(pill, "pill")
    stroke(pill, 1, LINE)
    local pillGlow = stroke(pill, 1.5, self._accent, 0.7)
    self:_registerThemeItem(pillGlow, "Color", "accent")
    self._pill = pill

    -- Glow pulsante mais suave: amplitude pequena (0.7 → 0.85), Sine lento
    self._breatheTween = TweenService:Create(
        pillGlow,
        TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
        { Transparency = 0.88 }
    )
    self._breatheTween:Play()

    local resolvedImage = tostring(pillImage or "rbxassetid://78186286433275")
    if not resolvedImage:find("rbxassetid://") then
        resolvedImage = "rbxassetid://" .. resolvedImage
    end

    local pillIcon = o("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 32, 0, 32),
        BackgroundTransparency = 1,
        Image = resolvedImage,
        ImageColor3 = W,
        ScaleType = Enum.ScaleType.Fit,
        ZIndex = 201,
    }, pill)

    local pillBtn = o("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "", AutoButtonColor = false,
        BorderSizePixel = 0, ZIndex = 202,
    }, pill)
    pillBtn.MouseEnter:Connect(function() tween(pillIcon, EASE_OUT(0.12), { ImageColor3 = self._accent }) end)
    pillBtn.MouseLeave:Connect(function() tween(pillIcon, EASE_OUT(0.12), { ImageColor3 = W }) end)

    local pillScale = o("UIScale", { Scale = 1 }, pill)
    pillBtn.MouseButton1Down:Connect(function()
        tween(pillScale, EASE_OUT(0.08), { Scale = 0.9 })
    end)
    pillBtn.MouseButton1Up:Connect(function()
        tween(pillScale, EASE_OUT(0.12), { Scale = 1 })
    end)
    pillBtn.MouseLeave:Connect(function()
        tween(pillScale, EASE_OUT(0.12), { Scale = 1 })
    end)

    local function frostBurst()
        local ring = o("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = pill.Position,
            Size = UDim2.new(0, PILL_SIZE, 0, PILL_SIZE),
            BackgroundTransparency = 1,
            ZIndex = 250,
        }, self.btnGui)
        corner(ring, "pill")
        local rStroke = stroke(ring, 2, self._accent)
        tween(ring, EASE_OUT(0.45), {
            Size = UDim2.new(0, PILL_SIZE + 60, 0, PILL_SIZE + 60),
        })
        tween(rStroke, EASE_OUT(0.45), { Transparency = 1 })
        task.delay(0.45, function() ring:Destroy() end)
    end

    local function showPill()
        pill.Visible = true
        pill.Size = UDim2.new(0, 0, 0, 0)
        tween(pill, EASE_BACK(0.35), { Size = UDim2.new(0, PILL_SIZE, 0, PILL_SIZE) })
    end
    local function hidePill()
        local t = tween(pill, EASE_OUT(0.18), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function() if pill.Size.X.Offset <= 1 then pill.Visible = false end end)
    end
    local function showMenu()
        self.menuFrame.Visible = true
        self.menuFrame.Size = UDim2.new(0, 0, 0, 0)
        tween(self.menuFrame, EASE_BACK(0.4), { Size = UDim2.new(0, MENU_W, 0, MENU_H) })
    end
    local function hideMenu()
        local t = tween(self.menuFrame, EASE_OUT(0.2), { Size = UDim2.new(0, 0, 0, 0) })
        t.Completed:Connect(function() if self.menuFrame.Size.X.Offset <= 1 then self.menuFrame.Visible = false end end)
    end

    xBtn.MouseButton1Click:Connect(function()
        playClick()
        hideMenu()
        showPill()
    end)

    -- Drag do pill
    do
        local dragging, dragMoved, dragStart, startPos, _activeTouchId =
            false, false, nil, nil, nil
        table.insert(self._connections, pillBtn.InputBegan:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if dragging then return end
                dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = pill.Position
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if _activeTouchId ~= nil then return end
                _activeTouchId = inp; dragging = true; dragMoved = false
                dragStart = inp.Position; startPos = pill.Position
            end
        end))
        table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
            if not dragging then return end
            local isM = inp.UserInputType == Enum.UserInputType.MouseMovement
            local isT = inp.UserInputType == Enum.UserInputType.Touch
            if isT and inp ~= _activeTouchId then return end
            if isM or isT then
                local d = inp.Position - dragStart
                if d.Magnitude > 4 then dragMoved = true end
                pill.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                if not dragging then return end
                dragging = false
                if not dragMoved then
                    playClick(); frostBurst(); hidePill(); showMenu()
                end
                dragStart = nil; startPos = nil
            elseif inp.UserInputType == Enum.UserInputType.Touch then
                if inp ~= _activeTouchId then return end
                local wasMoved = dragMoved
                dragging = false; dragMoved = false
                _activeTouchId = nil; dragStart = nil; startPos = nil
                if not wasMoved then
                    playClick(); frostBurst(); hidePill(); showMenu()
                end
            end
        end))
    end

    -- ══ Seção Tema: dropdown + slider de tamanho ══
    self:AddSectionLabel("Tema")
    self:AddThemeDropdown()
    self:_AddSizeSlider(uiScaleObj, getUIScale)

    return self
end

-- ══════════════════════════════════════════════════════
--  Dropdown de tema (11 temas)
-- ══════════════════════════════════════════════════════
function KronUI:AddThemeDropdown()
    local options = {}
    for _, t in ipairs(THEMES) do table.insert(options, t.name) end

    self:AddDropdown("Cor do tema", options, {}, function(selected)
        for _, t in ipairs(THEMES) do
            if t.name == selected then
                self:SetAccent(t.primary, t.secondary)
                return
            end
        end
    end)
end

-- ══════════════════════════════════════════════════════
--  Slider interno de tamanho da UI
-- ══════════════════════════════════════════════════════
function KronUI:_AddSizeSlider(uiScaleObj, getUIScale)
    self:AddSlider("Tamanho UI", 1, 35, _G.KronUIScale, function(v)
        _G.KronUIScale = v
        tween(uiScaleObj, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Scale = getUIScale(v)
        })
    end)
end

-- ══════════════════════════════════════════════════════
--  Destroy
-- ══════════════════════════════════════════════════════
function KronUI:Destroy()
    for _, conn in ipairs(self._connections) do conn:Disconnect() end
    self._connections = {}
    if self._breatheTween then self._breatheTween:Cancel() end
    if self._shimmerTween then self._shimmerTween:Cancel() end
    if self.gui    then self.gui:Destroy()    end
    if self.btnGui then self.btnGui:Destroy() end
end

function KronUI:_nextOrder()
    self._layoutOrder = self._layoutOrder + 1
    return self._layoutOrder
end

-- ══════════════════════════════════════════════════════
--  AddSectionLabel
-- ══════════════════════════════════════════════════════
function KronUI:AddSectionLabel(text)
    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    local bar = o("Frame", {
        Size = UDim2.new(0, 3, 0, 12),
        Position = UDim2.new(0, 2, 0.5, -6),
        BackgroundColor3 = self._accent, BorderSizePixel = 0,
    }, holder)
    self:_registerThemeItem(bar, "BackgroundColor3", "accent")
    o("TextLabel", {
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = string.upper(text or ""),
        Font = FONTB, TextSize = 10,
        TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, holder)
end

-- ══════════════════════════════════════════════════════
--  AddDivider
-- ══════════════════════════════════════════════════════
function KronUI:AddDivider()
    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 12),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    local line = o("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 0.5, 0),
        BackgroundColor3 = LINE, BorderSizePixel = 0,
    }, holder)
    o("UIGradient", {
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1),
            NumberSequenceKeypoint.new(0.5, 0.3),
            NumberSequenceKeypoint.new(1, 1),
        }),
    }, line)
end

-- ══════════════════════════════════════════════════════
--  AddToggle
-- ══════════════════════════════════════════════════════
function KronUI:AddToggle(text, default, callback)
    local state = default or false

    local btn = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, AutoButtonColor = false, Text = "",
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    local btnStroke = strokeIn(btn, 1, LINE)
    corner(btn, 8)

    local label = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -54, 1, 0),
        Font = FONT, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = text,
    }, btn)

    local trackW, trackH = 30, 14
    local track = o("Frame", {
        Size = UDim2.new(0, trackW, 0, trackH),
        Position = UDim2.new(1, -(trackW + 10), 0.5, -trackH / 2),
        BackgroundColor3 = PANEL, BorderSizePixel = 0,
    }, btn)
    corner(track, "pill")
    local trackStroke = stroke(track, 1, LINE)

    local knob = o("Frame", {
        Size = UDim2.new(0, 10, 0, 10),
        Position = UDim2.new(0, 2, 0.5, -5),
        BackgroundColor3 = DIM, BorderSizePixel = 0,
    }, track)
    corner(knob, "pill")

    local function refresh(animate)
        local ti = EASE_OUT(animate and 0.16 or 0)
        local accent  = self._accent
        local accent2 = self._accent2
        if state then
            tween(knob,       ti, { Position = UDim2.new(1, -12, 0.5, -5), BackgroundColor3 = W })
            tween(track,      ti, { BackgroundColor3 = accent2 })
            tween(trackStroke,ti, { Color = accent })
            tween(btnStroke,  ti, { Color = accent2, Transparency = 0.4 })
            label.TextColor3 = W
        else
            tween(knob,       ti, { Position = UDim2.new(0, 2, 0.5, -5), BackgroundColor3 = DIM })
            tween(track,      ti, { BackgroundColor3 = PANEL })
            tween(trackStroke,ti, { Color = LINE })
            tween(btnStroke,  ti, { Color = LINE, Transparency = 0 })
            label.TextColor3 = DIM
        end
    end
    refresh(false)

    self:_registerThemeCallback(function() refresh(false) end)

    btn.MouseEnter:Connect(function() if not state then btn.BackgroundColor3 = HOVER end end)
    btn.MouseLeave:Connect(function() btn.BackgroundColor3 = CARD end)

    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        self._playClick()
        state = not state
        refresh(true)
        if callback then task.spawn(callback, state) end
    end))

    return {
        SetState = function(v) state = v refresh(true) end,
        GetState = function() return state end,
    }
end

-- ══════════════════════════════════════════════════════
--  AddButton
-- ══════════════════════════════════════════════════════
function KronUI:AddButton(text, callback)
    local btn = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, AutoButtonColor = false, ClipsDescendants = true,
        Font = FONT, TextSize = 12,
        Text = text, TextColor3 = MID,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    local btnStroke = strokeIn(btn, 1, LINE)
    corner(btn, 8)

    local function ripple(x, y)
        local r = o("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, x, 0, y),
            Size = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = self._accent,
            BackgroundTransparency = 0.55,
            BorderSizePixel = 0, ZIndex = 5,
        }, btn)
        corner(r, "pill")
        local maxD = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 1.6
        local t = tween(r, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = UDim2.new(0, maxD, 0, maxD), BackgroundTransparency = 1 })
        t.Completed:Connect(function() r:Destroy() end)
    end

    btn.MouseEnter:Connect(function()
        tween(btn,       EASE_OUT(0.12), { BackgroundColor3 = HOVER })
        tween(btnStroke, EASE_OUT(0.12), { Color = self._accent })
        btn.TextColor3 = W
    end)
    btn.MouseLeave:Connect(function()
        tween(btn,       EASE_OUT(0.12), { BackgroundColor3 = CARD })
        tween(btnStroke, EASE_OUT(0.12), { Color = LINE })
        btn.TextColor3 = MID
    end)

    table.insert(self._connections, btn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            local x = inp.Position.X - btn.AbsolutePosition.X
            local y = inp.Position.Y - btn.AbsolutePosition.Y
            ripple(x, y)
        end
    end))
    table.insert(self._connections, btn.MouseButton1Click:Connect(function()
        self._playClick()
        if callback then task.spawn(callback) end
    end))
    return btn
end

-- ══════════════════════════════════════════════════════
--  AddSlider
-- ══════════════════════════════════════════════════════
function KronUI:AddSlider(text, min, max, default, callback)
    local value       = math.clamp(default or min, min, max)
    local dragging    = false
    local activeTouch = nil

    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 50),
        BackgroundColor3 = CARD,
        BorderSizePixel = 0,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    strokeIn(holder, 1, LINE)
    corner(holder, 8)

    local label = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 2),
        Size = UDim2.new(1, -16, 0, 26),
        Font = FONT, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextColor3 = MID,
    }, holder)

    local track = o("Frame", {
        Size = UDim2.new(1, -24, 0, 4),
        Position = UDim2.new(0, 12, 0, 36),
        BackgroundColor3 = LINE,
        BorderSizePixel = 0,
    }, holder)
    corner(track, "pill")

    local fill = o("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = self._accent, BorderSizePixel = 0,
    }, track)
    corner(fill, "pill")

    -- Gradiente animado no fill
    local fillGrad = o("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, self._accent2),
            ColorSequenceKeypoint.new(0.5, self._accent),
            ColorSequenceKeypoint.new(1, self._accent2),
        }),
        Offset = Vector2.new(-1, 0),
    }, fill)
    self:_registerThemeGradient(fillGrad)
    local fillGradTween = TweenService:Create(
        fillGrad,
        TweenInfo.new(2.0, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false),
        { Offset = Vector2.new(1, 0) }
    )
    fillGradTween:Play()

    local knob = o("Frame", {
        Size = UDim2.new(0, 11, 0, 11),
        AnchorPoint = Vector2.new(.5, .5),
        Position = UDim2.new(0, 0, .5, 0),
        BackgroundColor3 = W, BorderSizePixel = 0,
    }, track)
    corner(knob, "pill")
    local knobStroke = stroke(knob, 1.5, self._accent)
    self:_registerThemeItem(knobStroke, "Color", "accent")

    local bubble = o("TextLabel", {
        AnchorPoint = Vector2.new(0.5, 1),
        Size = UDim2.new(0, 30, 0, 18),
        BackgroundColor3 = self._accent,
        Text = "", TextColor3 = W, Font = FONTB, TextSize = 10,
        Visible = false, ZIndex = 6,
    }, track)
    self:_registerThemeItem(bubble, "BackgroundColor3", "accent")
    corner(bubble, 5)

    self:_registerThemeCallback(function(primary, secondary)
        fill.BackgroundColor3  = primary
        knobStroke.Color       = primary
        bubble.BackgroundColor3 = primary
    end)

    local function redraw()
        local rel = (value - min) / (max - min)
        fill.Size       = UDim2.new(rel, 0, 1, 0)
        knob.Position   = UDim2.new(rel, 0, .5, 0)
        label.Text      = text .. "   " .. tostring(math.floor(value))
        bubble.Position = UDim2.new(rel, 0, 0, -8)
        bubble.Text     = tostring(math.floor(value))
    end

    local function update(x)
        local rel = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        value = math.floor(min + (max - min) * rel)
        redraw()
        if callback then task.spawn(callback, value) end
    end

    redraw()

    table.insert(self._connections, track.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; bubble.Visible = true; update(inp.Position.X)
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if activeTouch ~= nil then return end
            activeTouch = inp; dragging = true; bubble.Visible = true; update(inp.Position.X)
        end
    end))
    table.insert(self._connections, knob.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; bubble.Visible = true
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if activeTouch ~= nil then return end
            activeTouch = inp; dragging = true; bubble.Visible = true
        end
    end))
    table.insert(self._connections, UserInputService.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement then
            update(inp.Position.X)
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if inp ~= activeTouch then return end
            update(inp.Position.X)
        end
    end))
    table.insert(self._connections, UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if activeTouch then return end
            dragging = false; bubble.Visible = false
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if inp ~= activeTouch then return end
            dragging = false; activeTouch = nil; bubble.Visible = false
        end
    end))

    return {
        GetValue = function() return value end,
        SetValue = function(v) value = math.clamp(v, min, max) redraw() end,
    }
end

-- ══════════════════════════════════════════════════════
--  AddDropdown
-- ══════════════════════════════════════════════════════
function KronUI:AddDropdown(text, options, default, callback)
    options = options or {}
    local selected = nil
    if default and table.find(options, default) then
        selected = default
    end
    local open = false

    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, ClipsDescendants = true,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    strokeIn(holder, 1, LINE)
    corner(holder, 8)

    local head = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        AutoButtonColor = false, Text = "",
    }, holder)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -54, 1, 0),
        Font = FONT, TextSize = 12, TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = text,
    }, head)

    local selectedLabel = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -54, 0, 0),
        Size = UDim2.new(0, 30, 1, 0),
        Font = FONTB, TextSize = 11, TextColor3 = self._accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        Text = selected or "",
    }, head)
    self:_registerThemeItem(selectedLabel, "TextColor3", "accent")

    local arrow = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -26, 0, 0),
        Size = UDim2.new(0, 20, 1, 0),
        Font = FONTB, TextSize = 16, TextColor3 = DIM,
        TextXAlignment = Enum.TextXAlignment.Center,
        Text = "▼", Rotation = 0,
    }, head)

    local LIST_MAX_H = 132
    local listWrap = o("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 32),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, holder)

    local list = o("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
    }, listWrap)
    self:_registerThemeItem(list, "ScrollBarImageColor3", "accent")
    o("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, list)
    o("UIPadding", {
        PaddingLeft   = UDim.new(0, 4),
        PaddingRight  = UDim.new(0, 4),
        PaddingTop    = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 2),
    }, list)

    local ROW_H = 26
    local rows  = {}

    local function updateRowColors(animate)
        for opt, data in pairs(rows) do
            local row      = data.row
            local check    = row:FindFirstChild("Check")
            local box      = row:FindFirstChild("Box")
            local boxStroke = box and box:FindFirstChild("UIStroke")
            local rowStroke = row:FindFirstChild("UIStroke")
            local optLabel  = row:FindFirstChild("Label")
            local ti = EASE_OUT(animate and 0.14 or 0)
            if opt == selected then
                tween(box, ti, { BackgroundColor3 = self._accent2 })
                if boxStroke then tween(boxStroke, ti, { Color = self._accent }) end
                if check     then tween(check,     ti, { TextTransparency = 0 }) end
                if rowStroke then tween(rowStroke, ti, { Color = self._accent2, Transparency = 0.4 }) end
                if optLabel  then optLabel.TextColor3 = W end
            else
                tween(box, ti, { BackgroundColor3 = PANEL })
                if boxStroke then tween(boxStroke, ti, { Color = LINE }) end
                if check     then tween(check,     ti, { TextTransparency = 1 }) end
                if rowStroke then tween(rowStroke, ti, { Color = LINE, Transparency = 0 }) end
                if optLabel  then optLabel.TextColor3 = MID end
            end
        end
    end

    self:_registerThemeCallback(function()
        updateRowColors(false)
        selectedLabel.TextColor3  = self._accent
        list.ScrollBarImageColor3 = self._accent
    end)

    local setOpen
    for i, opt in ipairs(options) do
        local row = o("TextButton", {
            Size = UDim2.new(1, 0, 0, ROW_H),
            BackgroundColor3 = PANEL,
            BorderSizePixel = 0, AutoButtonColor = false, Text = "",
            LayoutOrder = i,
        }, list)
        corner(row, 6)
        strokeIn(row, 1, LINE)

        local box = o("Frame", {
            Name = "Box",
            Size = UDim2.new(0, 13, 0, 13),
            Position = UDim2.new(0, 8, 0.5, -6.5),
            BackgroundColor3 = PANEL, BorderSizePixel = 0,
        }, row)
        corner(box, 4)
        stroke(box, 1, LINE)
        o("TextLabel", {
            Name = "Check",
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "✓", Font = FONTB, TextSize = 10,
            TextColor3 = W, TextTransparency = 1,
        }, box)
        o("TextLabel", {
            Name = "Label",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 28, 0, 0),
            Size = UDim2.new(1, -34, 1, 0),
            Font = FONT, TextSize = 11, TextColor3 = MID,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Text = tostring(opt),
        }, row)

        rows[opt] = { row = row }

        row.MouseEnter:Connect(function() if selected ~= opt then row.BackgroundColor3 = HOVER end end)
        row.MouseLeave:Connect(function() row.BackgroundColor3 = PANEL end)

        table.insert(self._connections, row.MouseButton1Click:Connect(function()
            self._playClick()
            selected = (selected == opt) and nil or opt
            selectedLabel.Text = selected or ""
            updateRowColors(true)
            if callback then task.spawn(callback, selected) end
            if setOpen then setOpen(false) end
        end))
    end

    updateRowColors(false)

    local listH = math.min(#options * (ROW_H + 4) + 4, LIST_MAX_H)

    setOpen = function(v)
        open = v
        local ti = EASE_OUT(0.2)
        tween(listWrap, ti, { Size = UDim2.new(1, 0, 0, open and listH or 0) })
        tween(arrow,    ti, { Rotation = open and 180 or 0 })
    end

    head.MouseEnter:Connect(function() if not open then holder.BackgroundColor3 = HOVER end end)
    head.MouseLeave:Connect(function() if not open then holder.BackgroundColor3 = CARD  end end)

    table.insert(self._connections, head.MouseButton1Click:Connect(function()
        self._playClick()
        setOpen(not open)
    end))

    return {
        Frame      = holder,
        GetSelected = function() return selected end,
        SetSelected = function(opt)
            selected = (opt and table.find(options, opt)) and opt or nil
            selectedLabel.Text = selected or ""
            updateRowColors(true)
        end,
        Close = function() setOpen(false) end,
    }
end

-- ══════════════════════════════════════════════════════
--  AddMultiDropdown
-- ══════════════════════════════════════════════════════
function KronUI:AddMultiDropdown(text, options, defaults, callback)
    options  = options  or {}
    defaults = defaults or {}

    local selectedSet = {}
    for _, def in ipairs(defaults) do
        if table.find(options, def) then selectedSet[def] = true end
    end

    local open       = false
    local rows       = {}
    local listH      = 0
    local LIST_MAX_H = 132
    local ROW_H      = 26

    local holder = o("Frame", {
        Size = UDim2.new(1, 0, 0, 32),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = CARD,
        BorderSizePixel = 0, ClipsDescendants = true,
        LayoutOrder = self:_nextOrder(),
    }, self.container)
    strokeIn(holder, 1, LINE)
    corner(holder, 8)

    local head = o("TextButton", {
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        AutoButtonColor = false, Text = "",
    }, holder)

    o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(1, -54, 1, 0),
        Font = FONT, TextSize = 12, TextColor3 = MID,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Text = text,
    }, head)

    local selectedLabel = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -54, 0, 0),
        Size = UDim2.new(0, 30, 1, 0),
        Font = FONTB, TextSize = 11, TextColor3 = self._accent,
        TextXAlignment = Enum.TextXAlignment.Right,
        Text = "",
    }, head)
    self:_registerThemeItem(selectedLabel, "TextColor3", "accent")

    local arrow = o("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -26, 0, 0),
        Size = UDim2.new(0, 20, 1, 0),
        Font = FONTB, TextSize = 16, TextColor3 = DIM,
        TextXAlignment = Enum.TextXAlignment.Center,
        Text = "▼", Rotation = 0,
    }, head)

    local listWrap = o("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 32),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, holder)

    local list = o("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0),
        Position = UDim2.new(0, 0, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = self._accent,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(1, 0, 0, 0),
    }, listWrap)
    self:_registerThemeItem(list, "ScrollBarImageColor3", "accent")
    o("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, list)
    o("UIPadding", {
        PaddingLeft   = UDim.new(0, 4),
        PaddingRight  = UDim.new(0, 4),
        PaddingTop    = UDim.new(0, 2),
        PaddingBottom = UDim.new(0, 2),
    }, list)

    local function updateRowState(opt, animate)
        local data = rows[opt]; if not data then return end
        local row    = data.row
        local box    = row:FindFirstChild("Box")
        local boxStk = box and box:FindFirstChild("UIStroke")
        local check  = row:FindFirstChild("Check")
        local rowStk = row:FindFirstChild("UIStroke")
        local lbl    = row:FindFirstChild("Label")
        local isSel  = selectedSet[opt] ~= nil
        local ti     = EASE_OUT(animate and 0.14 or 0)
        if isSel then
            tween(box, ti, { BackgroundColor3 = self._accent2 })
            if boxStk then tween(boxStk, ti, { Color = self._accent }) end
            if check  then tween(check,  ti, { TextTransparency = 0 }) end
            if rowStk then tween(rowStk, ti, { Color = self._accent2, Transparency = 0.4 }) end
            if lbl    then lbl.TextColor3 = W end
        else
            tween(box, ti, { BackgroundColor3 = PANEL })
            if boxStk then tween(boxStk, ti, { Color = LINE }) end
            if check  then tween(check,  ti, { TextTransparency = 1 }) end
            if rowStk then tween(rowStk, ti, { Color = LINE, Transparency = 0 }) end
            if lbl    then lbl.TextColor3 = MID end
        end
    end

    local function updateAllRows(animate)
        for opt in pairs(rows) do updateRowState(opt, animate) end
    end

    local function rebuildSelectionText()
        local sel = {}
        for opt, flag in pairs(selectedSet) do
            if flag then table.insert(sel, opt) end
        end
        table.sort(sel)
        if     #sel == 0 then selectedLabel.Text = ""
        elseif #sel == 1 then selectedLabel.Text = sel[1]
        else               selectedLabel.Text = #sel .. " sel."
        end
    end

    self:_registerThemeCallback(function()
        updateAllRows(false)
        selectedLabel.TextColor3  = self._accent
        list.ScrollBarImageColor3 = self._accent
    end)

    local function buildRows(optList)
        for _, child in ipairs(list:GetChildren()) do
            if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then child:Destroy() end
        end
        rows = {}

        for opt in pairs(selectedSet) do
            if not table.find(optList, opt) then selectedSet[opt] = nil end
        end

        for i, opt in ipairs(optList) do
            local row = o("TextButton", {
                Size = UDim2.new(1, 0, 0, ROW_H),
                BackgroundColor3 = PANEL,
                BorderSizePixel = 0, AutoButtonColor = false, Text = "",
                LayoutOrder = i,
            }, list)
            corner(row, 6)
            strokeIn(row, 1, LINE)

            local box = o("Frame", {
                Name = "Box",
                Size = UDim2.new(0, 13, 0, 13),
                Position = UDim2.new(0, 8, 0.5, -6.5),
                BackgroundColor3 = PANEL, BorderSizePixel = 0,
            }, row)
            corner(box, 4)
            stroke(box, 1, LINE)
            o("TextLabel", {
                Name = "Check",
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "v", Font = FONTB, TextSize = 10,
                TextColor3 = W, TextTransparency = 1,
            }, box)
            o("TextLabel", {
                Name = "Label",
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 28, 0, 0),
                Size = UDim2.new(1, -34, 1, 0),
                Font = FONT, TextSize = 11, TextColor3 = MID,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = tostring(opt),
            }, row)

            rows[opt] = { row = row }

            row.MouseEnter:Connect(function()
                if not selectedSet[opt] then row.BackgroundColor3 = HOVER end
            end)
            row.MouseLeave:Connect(function()
                row.BackgroundColor3 = PANEL
            end)
            row.MouseButton1Click:Connect(function()
                self._playClick()
                if selectedSet[opt] then selectedSet[opt] = nil
                else selectedSet[opt] = true end
                updateRowState(opt, true)
                rebuildSelectionText()
                if callback then
                    local selList = {}
                    for k, flag in pairs(selectedSet) do
                        if flag then table.insert(selList, k) end
                    end
                    table.sort(selList)
                    task.spawn(callback, selList)
                end
            end)
        end

        listH = math.min(#optList * (ROW_H + 4) + 4, LIST_MAX_H)
        updateAllRows(false)
        rebuildSelectionText()
    end

    buildRows(options)

    local function setOpen(v)
        open = v
        local ti = EASE_OUT(0.2)
        tween(listWrap, ti, { Size = UDim2.new(1, 0, 0, open and listH or 0) })
        tween(arrow,    ti, { Rotation = open and 180 or 0 })
    end

    head.MouseEnter:Connect(function() if not open then holder.BackgroundColor3 = HOVER end end)
    head.MouseLeave:Connect(function() if not open then holder.BackgroundColor3 = CARD  end end)

    table.insert(self._connections, head.MouseButton1Click:Connect(function()
        self._playClick()
        setOpen(not open)
    end))

    return {
        Frame      = holder,
        GetSelected = function()
            local sel = {}
            for opt, flag in pairs(selectedSet) do
                if flag then table.insert(sel, opt) end
            end
            table.sort(sel)
            return sel
        end,
        SetSelected = function(newSel)
            selectedSet = {}
            if newSel then
                for _, opt in ipairs(newSel) do
                    if rows[opt] then selectedSet[opt] = true end
                end
            end
            updateAllRows(true)
            rebuildSelectionText()
        end,
        UpdateOptions = function(newOptions)
            if open then setOpen(false) end
            buildRows(newOptions or {})
        end,
        Close = function() setOpen(false) end,
    }
end

return KronUI
