local current = "0"

local function atualizar(valor)
    display.Text = valor
end

local function adicionar(valor)
    if current == "0" then
        current = valor
    else
        current = current .. valor
    end
    atualizar(current)
end

local function calcular()
    local expr = current
    expr = expr:gsub("(%d+%.?%d*)([%+%-])(%d+%.?%d*)%%", function(base, op, percent)
        local baseNum = tonumber(base)
        local percentNum = tonumber(percent)
        local percentValue = baseNum * percentNum / 100
        if op == "+" then return tostring(baseNum + percentValue)
        elseif op == "-" then return tostring(baseNum - percentValue) end
    end)
    expr = expr:gsub("(%d+%.?%d*)%%([%*%/]?)(%d+%.?%d*)", function(percent, op, num)
        local percentNum = tonumber(percent)
        local numValue = tonumber(num)
        local percentValue = numValue * percentNum / 100
        if op == "*" or op == "" then return tostring(percentValue)
        elseif op == "/" then return tostring(percentNum / 100 / numValue) end
    end)
    expr = expr:gsub("(%d+%.?%d*)([%*/])(%d+%.?%d*)%%", function(num, op, percent)
        local numValue = tonumber(num)
        local percentNum = tonumber(percent)
        local percentValue = numValue * percentNum / 100
        if op == "*" then return tostring(percentValue)
        elseif op == "/" then return tostring(numValue / (percentNum / 100)) end
    end)
    expr = expr:gsub("(%d+%.?%d*)%%", function(num)
        return tostring(tonumber(num) / 100)
    end)
    expr = expr:gsub("×", "*"):gsub("÷", "/"):gsub(",", ".")
    local success, result = pcall(function()
        return loadstring("return " .. expr)()
    end)
    current = success and tostring(result) or "Erro"
    atualizar(current)
end

local function deletarUltimo()
    if #current <= 1 or current == "Erro" then
        current = "0"
    else
        current = current:sub(1, -2)
    end
    atualizar(current)
end

local BTN    = 36
local STEP   = 38
local STARTX = 6
local STARTY = 4

local function createButton(texto, x, y, isOperator, isEqual, isDanger)
    local b = o("TextButton", {
        Size = UDim2.new(0, BTN, 0, BTN),
        Position = UDim2.new(0, STARTX + x * STEP, 0, STARTY + y * STEP),
        BackgroundColor3 = B, BorderSizePixel = 0,
        Text = texto, Font = FONT,
        AutoButtonColor = false, ZIndex = 2,
    }, btnContainer)

    if isEqual then
        b.BackgroundColor3 = W
        b.TextColor3 = B
        b.TextSize = 15
        stroke(b, 1)
        b.MouseEnter:Connect(function() b.BackgroundColor3 = Color3.fromRGB(200,200,200) end)
        b.MouseLeave:Connect(function() b.BackgroundColor3 = W end)
    elseif isDanger then
        b.TextColor3 = Color3.fromRGB(255, 80, 80)
        b.TextSize = 10
        stroke(b, 1, Color3.fromRGB(255, 80, 80))
        b.MouseEnter:Connect(function() b.BackgroundColor3 = D end)
        b.MouseLeave:Connect(function() b.BackgroundColor3 = B end)
    elseif isOperator then
        b.TextColor3 = W
        b.TextSize = 15
        stroke(b, 1)
        b.MouseEnter:Connect(function() b.BackgroundColor3 = D end)
        b.MouseLeave:Connect(function() b.BackgroundColor3 = B end)
    else
        b.TextColor3 = W
        b.TextSize = 11
        stroke(b, 1)
        b.MouseEnter:Connect(function() b.BackgroundColor3 = D end)
        b.MouseLeave:Connect(function() b.BackgroundColor3 = B end)
    end

    b.MouseButton1Click:Connect(function()
        if texto == "AC" then
            current = "0" atualizar(current)
        elseif texto == "DEL" then
            deletarUltimo()
        elseif texto == "=" then
            calcular()
        elseif texto == "%" then
            if current ~= "0" and current ~= "Erro" then
                current = current .. "%" atualizar(current)
            end
        elseif texto == "+" or texto == "-" or texto == "×" or texto == "÷" then
            local ultimo = current:sub(-1)
            if ultimo ~= "+" and ultimo ~= "-" and ultimo ~= "×" and ultimo ~= "÷" and ultimo ~= "%" then
                current = current .. texto atualizar(current)
            end
        elseif texto == "." then
            local ultimoNumero = current:match("[%d,]+$") or ""
            if not ultimoNumero:find("%.") then
                current = current .. "." atualizar(current)
            end
        elseif texto == "," then
            local ultimoNumero = current:match("[%d%.]+$") or ""
            if not ultimoNumero:find(",") then
                current = current .. "," atualizar(current)
            end
        else
            adicionar(texto)
        end
    end)
end

local layout = {
    {"AC",  "DEL", "%",  "÷"},
    {"7",   "8",   "9",  "×"},
    {"4",   "5",   "6",  "-"},
    {"1",   "2",   "3",  "+"},
}
