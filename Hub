function Hub:Tab(name)
    -- "name" mantido apenas por compatibilidade com chamadas existentes (Hub:Tab("Nome"));
    -- não é mais exibido, já que existe só esta aba.
    local pg=o("Frame",{Size=UDim2.new(1,0,1,0),BackgroundColor3=B,BorderSizePixel=0,Visible=true,Active=false},body)
    local hotbar=o("Frame",{Size=UDim2.new(1,0,0,20),BackgroundColor3=B,BorderSizePixel=0,Active=false},pg)
    local searchW=120
    local search=o("TextBox",{Size=UDim2.new(0,searchW,1,0),BackgroundTransparency=1,BorderSizePixel=0,PlaceholderText="Search...",PlaceholderColor3=W,Text="",TextColor3=W,TextSize=11,Font=FONT_MAIN,ClearTextOnFocus=false,TextXAlignment=Enum.TextXAlignment.Left},hotbar)
    local searchStroke=stroke(search,1,W); searchStroke.Transparency=1
    search.Focused:Connect(function() searchStroke.Transparency=0 searchStroke.Thickness=1.4 end)
    search.FocusLost:Connect(function() searchStroke.Transparency=1 searchStroke.Thickness=1 end)
    o("UIPadding",{PaddingLeft=UDim.new(0,6)},search)
    local countLbl=o("TextLabel",{Size=UDim2.new(1,-searchW-8,1,0),Position=UDim2.new(0,searchW+6,0,0),BackgroundTransparency=1,Text="Scripts: 0",TextColor3=W,TextSize=10,Font=FONT_MAIN,TextXAlignment=Enum.TextXAlignment.Right,Active=false},hotbar)
    o("UIPadding",{PaddingRight=UDim.new(0,6)},countLbl)

    local GAP=6 local COLS=6 local ROWH=28
    local areaAbsW = BASE_W
    local cellW = math.floor((areaAbsW - GAP*(COLS+1)) / COLS)

    local scroll=o("ScrollingFrame",{Size=UDim2.new(1,0,1,-20),Position=UDim2.new(0,0,0,20),BackgroundTransparency=1,BorderSizePixel=0,ScrollBarThickness=2,ScrollBarImageColor3=G,CanvasSize=UDim2.new(0,0,0,0),AutomaticCanvasSize=Enum.AutomaticSize.Y},pg)
    o("UIPadding",{PaddingTop=UDim.new(0,GAP),PaddingLeft=UDim.new(0,GAP),PaddingRight=UDim.new(0,GAP),PaddingBottom=UDim.new(0,GAP)},scroll)
    o("UIGridLayout",{CellSize=UDim2.new(0,cellW,0,ROWH),CellPadding=UDim2.new(0,GAP,0,GAP),SortOrder=Enum.SortOrder.LayoutOrder,HorizontalAlignment=Enum.HorizontalAlignment.Left},scroll)
    local allBtns={}
    local function updateCount()
        local v=0 for _,b in ipairs(allBtns) do if b.Visible then v+=1 end end
        countLbl.Text="Scripts: "..v
    end
    search:GetPropertyChangedSignal("Text"):Connect(function()
        local q=search.Text:lower():gsub("%s+","")
        for _,b in ipairs(allBtns) do
            if q=="" then b.Visible=true
            else local bname=b.Name:lower():gsub("%s+","") b.Visible = string.sub(bname,1,#q)==q end
        end
        updateCount()
    end)
    local T={}
    function T:Button(txt,url)
        local b=o("TextButton",{Name=txt,BackgroundColor3=B,BorderSizePixel=0,Text=txt,TextColor3=W,TextSize=10,Font=FONT_MAIN,AutoButtonColor=false,TextWrapped=true,LineHeight=1.1},scroll)
        stroke(b,1)
        b.MouseEnter:Connect(function() b.BackgroundColor3=W b.BackgroundTransparency=0.88 end)
        b.MouseLeave:Connect(function() b.BackgroundColor3=B b.BackgroundTransparency=0 end)
        local copyTxt='loadstring(game:HttpGet("'..url..'"))()'
        b.MouseButton1Click:Connect(function()
            openModal(txt,copyTxt,function() loadstring(game:HttpGet(url))() end)
        end)
        table.insert(allBtns,b) countLbl.Text="Scripts: "..#allBtns
        return self
    end
    return T
end

-- Pill drag
do
    local dragging=false; local dragMoved=false; local dragStart=nil; local startPos=nil; local _activeTouchId=nil
    pillBtn.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if dragging then return end
            dragging=true; dragMoved=false; dragStart=inp.Position; startPos=pill.Position
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if _activeTouchId then return end
            _activeTouchId=inp; dragging=true; dragMoved=false; dragStart=inp.Position; startPos=pill.Position
        end
    end)
    UIS.InputChanged:Connect(function(inp)
        if not dragging then return end
        local isMouse = inp.UserInputType == Enum.UserInputType.MouseMovement
        local isTouch = inp.UserInputType == Enum.UserInputType.Touch
        if isTouch and inp ~= _activeTouchId then return end
        if isMouse or isTouch then
            local d=inp.Position - dragStart
            if math.abs(d.X)+math.abs(d.Y) > 2 then
                dragMoved=true
                pill.Position=UDim2.new(startPos.X.Scale, startPos.X.Offset+d.X, startPos.Y.Scale, startPos.Y.Offset+d.Y)
            end
        end
    end)
    UIS.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            if not dragging then return end
            dragging=false
            if not dragMoved then openHub() end
            dragStart=nil; startPos=nil
        elseif inp.UserInputType == Enum.UserInputType.Touch then
            if inp ~= _activeTouchId then return end
            local wasMoved=dragMoved
            dragging=false; dragMoved=false; _activeTouchId=nil; dragStart=nil; startPos=nil
            if not wasMoved then openHub() end
        end
    end)
end

UIS.InputBegan:Connect(function(inp,gp)
    if not gp and inp.KeyCode==Enum.KeyCode.RightShift then
        if win.Visible then closeHub() else openHub() end
    end
end)

return Hub
